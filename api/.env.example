
# Battle.net OAuth (Phase 3 sign-in); values in api/.env locally and Secret Manager in production
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URL=http://localhost:8080/v1/auth/battlenet/callback

# Cloudflare R2 (Phase 3 report storage). Without all four, the ingest,
# upload, and report-file routes are not mounted and the service logs it.
R2_ACCOUNT_ID=1f1504a52d74d323c0a5648a766e0871
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=foreversixty-logs

# Sessions. "none" makes the cookie host-only, which is what a local
# http://localhost run needs; production wants the default.
SESSION_COOKIE_DOMAIN=none

# The Cloud Run job that parses whole-file uploads.
PARSE_JOB_NAME=parse-report
PARSE_JOB_REGION=us-east1
PARSE_JOB_PROJECT=foreversixty
