# addon/ForeverSixty/.pkgmeta
# addon-release.yml points the packager at this directory's HEAD tree (via
# a throwaway checkout it builds, since the packager requires its topdir to
# itself be a VCS root -- see that workflow's "give the packager its own
# checkout" step for why), so this directory is the topdir and the zip's
# single top-level folder is ForeverSixty/. The addon's tests, .busted and
# .luacheckrc live one level up, outside this directory, so they cannot be
# packaged by accident.
package-as: ForeverSixty

# ForeverSixtyInbox (addon/ForeverSixtyInbox, a sibling of this folder) ships
# beside ForeverSixty in every release: a code-free addon that only owns the
# ForeverSixtyInbox saved variable, which the companion writes into
# WTF/Account/<account>/SavedVariables/ForeverSixtyInbox.lua (the client reads
# that file only for an addon of that name). addon-release.yml copies it into
# this topdir as ForeverSixtyInbox/ and the move below lifts it to the zip's
# top level, so the zip holds ForeverSixty/ and ForeverSixtyInbox/; the
# workflow checks exactly those two folders.
move-folders:
  ForeverSixty/ForeverSixtyInbox: ForeverSixtyInbox

# No libraries are embedded: this addon has no dependencies, and a nolib
# variant of a zip with no libs in it is a second artefact saying the same
# thing.
enable-nolib-creation: no

ignore:
  - .pkgmeta

# media/ is inside this topdir, so the packager ships it with no entry of
# its own. It holds the 32x32 minimap icon (addon/tools/make_minimap_icon.py)
# and media/crests/ -- the nine class crests plus the one ring texture the
# character header tints per class (addon/tools/make_class_crests.py) --
# both scripts living outside this folder and therefore unpackaged themselves.

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
