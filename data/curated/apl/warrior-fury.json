{
  "spec": "warrior-fury",
  "state": "written",
  "notes": "Vanilla Fury at 60: Bloodthirst on cooldown, Whirlwind while it is down, Execute below 20 percent, Heroic Strike as the rage dump. Rage, not the global cooldown, is the limiting resource, so Bloodrage and Death Wish are used on cooldown. Every rank named here is checked against the spellconst of the newest client build in builds/ (the one its manifest.json records last); a later Forever patch may renumber them and tests/test_apl.py will say so. Nothing here is Forever-specific yet: the validation job (design section 6) is the evidence for changing it.",
  "sources": [
    { "label": "wowsims/classic default Fury priority list", "url": "https://github.com/wowsims/classic/blob/master/ui/warrior/apls/dps_no_reck.apl.json", "kind": "community" },
    { "label": "Warcraft Tavern: Classic Fury Warrior DPS rotation", "url": "https://www.warcrafttavern.com/wow-classic/guides/dps-warrior-rotation/", "kind": "community" },
    { "label": "Forever Sixty default rotation, unvalidated until the nightly job runs", "url": "https://foreversixty.gg/sim/specs", "kind": "site" }
  ],
  "rotation": {
    "type": "TypeAPL",
    "prepullActions": [
