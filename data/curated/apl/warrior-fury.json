          "condition": { "cmp": { "op": "OpLt", "lhs": { "currentRage": {} }, "rhs": { "const": { "val": "80" } } } },
          "castSpell": { "spellId": { "spellId": 2687 } }
        }
      },
      {
        "notes": "Death Wish on cooldown.",
        "action": { "castSpell": { "spellId": { "spellId": 12328 } } }
      },
      {
        "notes": "Keep Battle Shout up.",
        "action": {
          "condition": { "not": { "val": { "auraIsActive": { "auraId": { "spellId": 25289, "rank": 7 } } } } },
          "castSpell": { "spellId": { "spellId": 25289, "rank": 7 } }
        }
      },
      {
        "notes": "Bloodthirst is the highest damage per rage button and comes off a six second cooldown.",
        "action": { "castSpell": { "spellId": { "spellId": 23894, "rank": 4 } } }
      },
      {
        "notes": "Whirlwind while Bloodthirst is down.",
