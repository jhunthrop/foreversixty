{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/guides.html",
        "http://localhost/guides/warrior/fury.html",
        "http://localhost/bis.html",
        "http://localhost/tiers.html",
        "http://localhost/tiers/tank.html",
        "http://localhost/tiers/healer.html",
        "http://localhost/bis/hunter/marksmanship.html",
        "http://localhost/setup.html",
        "http://localhost/planner.html",
        "http://localhost/logs.html",
        "http://localhost/rankings.html",
        "http://localhost/rankings/warden-kelthas.html",
        "http://localhost/premium.html",
        "http://localhost/premium/checkout.html?plan=guild&interval=yearly",
        "http://localhost/reports/fixture2abcd.html",
        "http://localhost/guild/us/pvp/olympus-xxvii.html",
        "http://localhost/sim.html",
        "http://localhost/sim/specs.html",
        "http://localhost/sim/simfixtureab.html",
        "http://localhost/sim/gear.html",
        "http://localhost/sim/talents.html",
        "http://localhost/sim/drops.html",
        "http://localhost/sim/weights.html",
        "http://localhost/changelog.html",
        "http://localhost/account.html",
        "http://localhost/privacy.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--host-resolver-rules=\"MAP api.foreversixty.gg ~NOTFOUND\"",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(?:index|planner|logs|setup)\\.html$)(?!.*/(?:account|premium/checkout)\\.html(?:\\?|$))(?!.*/reports/)(?!.*/sim(?:/specs|/gear|/talents|/drops|/weights)?\\.html$)(?!.*/sim/[a-z2-7]{12}\\.html$)(?!.*/bis/[a-z]+/[a-z]+\\.html$)(?!.*/guild/).*$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2400 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(?:account|premium/checkout)\\.html(?:\\?.*)?$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2400 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/bis/[a-z]+/[a-z]+\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2200 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/index\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
