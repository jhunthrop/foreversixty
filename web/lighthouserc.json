{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/dungeons/hall-of-thanes.html",
        "http://localhost/classes.html",
        "http://localhost/planner.html",
        "http://localhost/logs.html",
        "http://localhost/reports/fixture2abcd.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 640,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(?:index|planner|logs)\\.html$)(?!.*/reports/).*$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1600 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/index\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(?:planner|logs)\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": ".*/reports/.*\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "total-blocking-time": ["error", { "maxNumericValue": 150 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
