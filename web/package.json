{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:island": "vite build --config vite.island.config.ts && vite build --config vite.report-island.config.ts",
    "postbuild": "npm run build:island && node scripts/check-island-size.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ignore-pattern public/duckdb/",
    "lint:fix": "eslint . --ignore-pattern public/duckdb/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "FOREVER_DATA=real playwright test tests/e2e/real-data.spec.ts --project=desktop",
    "test:e2e:phone": "playwright test report-phone.spec.ts rankings-phone.spec.ts character-phone.spec.ts guild-phone.spec.ts --project=mobile",
    "lhci": "lhci autorun",
    "deploy": "npm run build && wrangler deploy",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:report-fixture": "node scripts/sync-report-fixture.mjs",
    "sync:duckdb": "node scripts/sync-duckdb.mjs",
    "upload:duckdb": "node scripts/upload-duckdb-runtime.mjs",
    "sync": "npm run sync:data && npm run sync:report-fixture && npm run sync:duckdb",
    "make:report-fixture": "node scripts/make-report-fixture.mjs",
    "predev": "npm run sync",
    "precheck": "npm run sync",
    "pretest": "FOREVER_DATA=fixture npm run sync",
    "prebuild": "npm run sync"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-pagefind": "^2.0.1",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
