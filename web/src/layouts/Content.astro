---
// web/src/layouts/Content.astro
// A `pages` collection entry (About, the legal pages): the page head with its eyebrow, title,
// Updated stamp and confidence sentence, the reading-measure body, then the Sources footer.
import Base from './Base.astro';
import SourcesList from '../components/SourcesList.astro';
import PageHead from '../components/ui/PageHead.astro';
import UpdatedStamp from '../components/UpdatedStamp.astro';
import type { Source } from '../lib/sources';
import { articleLd, breadcrumbLd } from '../lib/seo';

type Confidence = 'confirmed' | 'single-source' | 'inferred';
interface Props {
  title: string;
  description?: string;
  path: string;
  updated: Date;
  /** Absent for a page with no provenance claim (the legal pages): the layout then draws
   *  neither the confidence sentence nor its separator. */
  confidence?: Confidence;
  sources: Source[];
  /** False for the legal pages: they state no fact about the world, so no Sources footer. */
  showSources?: boolean;
  /** The page head's eyebrow (site alignment spec 2026-10-29 §5.15): ABOUT, or LEGAL on the legal pages. */
  eyebrow?: string;
}
const {
  title,
  description = '',
  path,
  updated,
  confidence,
  sources,
  showSources = true,
  eyebrow = 'About',
} = Astro.props;
const jsonLd = [articleLd({ title, description, path, updated }), breadcrumbLd(path, title)];
const confidenceCopy: Record<Confidence, string> = {
  confirmed: 'Confirmed by Blizzard or by multiple sources',
  'single-source': 'Reported by one outlet, not yet confirmed',
  inferred: 'Our inference from what has been said; may change',
};
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <meta slot="head" property="article:modified_time" content={updated.toISOString()} />
  <main id="main" tabindex="-1" class="flex w-full flex-col gap-8 px-[18px] pt-4 pb-10 md:px-0 md:pt-7">
    <PageHead eyebrow={eyebrow.toUpperCase()} title={title}>
      <Fragment slot="meta">
        <UpdatedStamp date={updated} />
        {confidence !== undefined && (
          <>
            <span> · </span>
            <span>{confidenceCopy[confidence]}</span>
          </>
        )}
      </Fragment>
    </PageHead>
    <div class="flex max-w-(--measure-reading) flex-col gap-6">
      <div class="prose-forever text-[16px] leading-[1.6]">
        <slot />
      </div>
      {showSources && <SourcesList sources={sources} />}
    </div>
  </main>
</Base>
