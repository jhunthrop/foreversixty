---
// web/src/layouts/Content.astro
import Base from './Base.astro';
import SourcesList from '../components/SourcesList.astro';
import UpdatedStamp from '../components/UpdatedStamp.astro';
import type { Source } from '../lib/sources';

type Confidence = 'confirmed' | 'single-source' | 'inferred';
interface Props { title: string; description?: string; path: string; updated: Date; confidence: Confidence; sources: Source[] }
const { title, description = '', path, updated, confidence, sources } = Astro.props;
const confidenceCopy: Record<Confidence, string> = {
  confirmed: 'Confirmed by Blizzard or by multiple sources',
  'single-source': 'Reported by one outlet, not yet confirmed',
  inferred: 'Our inference from what has been said; may change',
};
---
<Base title={title} description={description} path={path}>
  <main id="main" tabindex="-1" class="max-w-[820px] w-full mx-auto px-[18px] md:px-12 py-10 flex flex-col gap-6">
    <header class="flex flex-col gap-2 border-b border-line pb-5">
      <h1 class="text-[28px] font-bold tracking-[0.02em]">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-[13px] text-muted">
        <UpdatedStamp date={updated} />
        <span>·</span>
        <span>{confidenceCopy[confidence]}</span>
      </div>
    </header>
    <div class="prose-forever text-[16px] leading-[1.6]"><slot /></div>
    <SourcesList sources={sources} />
  </main>
</Base>
