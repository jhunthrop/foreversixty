---
// web/src/layouts/Content.astro
import Base from './Base.astro';
import SourcesList from '../components/SourcesList.astro';
import UpdatedStamp from '../components/UpdatedStamp.astro';
import type { Source } from '../lib/sources';
import { articleLd, breadcrumbLd } from '../lib/seo';

type Confidence = 'confirmed' | 'single-source' | 'inferred';
interface Props {
  title: string;
  description?: string;
  path: string;
  updated: Date;
  confidence: Confidence;
  sources: Source[];
  /** 'header' (default, unchanged): the confidence sentence sits under the title, as every
   *  `pages` collection entry still shows it. 'footer' (guides only, spec 5): it moves to a
   *  quiet line directly above Sources instead -- "under the title" was the caveat's most
   *  prominent spot on the page and spec 5 asks for the least prominent one instead. */
  confidencePlacement?: 'header' | 'footer';
}
const {
  title,
  description = '',
  path,
  updated,
  confidence,
  sources,
  confidencePlacement = 'header',
} = Astro.props;
// A page that fills the `aside` slot (the spec guides' table of contents) gets a wider main
// with the article column and a sticky rail beside it at lg; below lg the rail is simply
// not rendered by the slot's own classes, so the page keeps whatever inline version it has.
const hasAside = Astro.slots.has('aside');
const jsonLd = [articleLd({ title, description, path, updated }), breadcrumbLd(path, title)];
const confidenceCopy: Record<Confidence, string> = {
  confirmed: 'Confirmed by Blizzard or by multiple sources',
  'single-source': 'Reported by one outlet, not yet confirmed',
  inferred: 'Our inference from what has been said; may change',
};
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <meta slot="head" property="article:modified_time" content={updated.toISOString()} />
  <main
    id="main"
    tabindex="-1"
    class:list={[
      'mx-auto w-full px-[18px] py-10 md:px-12',
      hasAside
        ? 'grid max-w-[1120px] grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12'
        : 'flex max-w-[820px] flex-col gap-6',
    ]}
  >
    <div class:list={[hasAside ? 'flex min-w-0 flex-col gap-6 lg:max-w-[820px]' : 'contents']}>
      <header class="border-line flex flex-col gap-2 border-b pb-5">
        <h1 class="text-[28px] font-bold tracking-[0.02em]">{title}</h1>
        <div class="text-muted flex flex-wrap items-center gap-3 text-[13px]">
          <UpdatedStamp date={updated} />
          {confidencePlacement === 'header' && (
            <>
              <span>·</span>
              <span>{confidenceCopy[confidence]}</span>
            </>
          )}
        </div>
      </header>
      <div class="prose-forever text-[16px] leading-[1.6]">
        <slot />
      </div>
      {confidencePlacement === 'footer' && (
        <p class="text-muted text-[13px]" data-testid="confidence-footer-note">
          {confidenceCopy[confidence]}
        </p>
      )}
      <SourcesList sources={sources} />
    </div>
    {hasAside && (
      <aside class="hidden lg:sticky lg:top-6 lg:block lg:self-start" data-testid="content-aside">
        <slot name="aside" />
      </aside>
    )}
  </main>
</Base>
