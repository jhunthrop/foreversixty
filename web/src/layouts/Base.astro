---
// web/src/layouts/Base.astro
// The three self-hosted faces and Barlow's size-adjusted fallback live in
// ../styles/fonts.css, which carries the reasoning for all of it. They are a shared module
// rather than an import list here because src/planner-island.ts needs exactly the same set:
// planner-island.css is the only stylesheet the API's server-rendered /b/{id} page links,
// so a copy that lived only in this layout would leave that page in Georgia and Arial.
import '../styles/fonts.css';
// The three faces every page paints first are preloaded so the swap from the fallback face
// happens before first paint on most connections; Vite gives them the same hashed URL
// fonts.css's own @font-face rules reference (../assets/fonts/*-subset.woff2, since the
// web-font-subsets lane), so no extra bytes are fetched. Barlow 600 joins 400 here for the
// same reason: it is the weight the header and footer paint with on every page, so an
// unpreloaded 600 arrives late enough to shift them (final whole-branch review, Lighthouse
// rounds 1-3 — layout-shifts kept naming barlow-latin-600-normal.woff2's load as the
// footer's own shift, on whichever page's font timing happened to expose it that run).
//
// The data-og attributes are the selectors src/worker.ts rewrites through HTMLRewriter when
// it serves a shell page for an id that did not exist at build time. Renaming one silently
// stops that page's unfurl from updating, so src/pages/_shells.test.ts asserts they exist.
import cinzel700Url from '../assets/fonts/cinzel-700-subset.woff2?url';
import barlow400Url from '../assets/fonts/barlow-400-subset.woff2?url';
import barlow600Url from '../assets/fonts/barlow-600-subset.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccountMenu from '../components/account/AccountMenu.svelte';

import { SITE_NAME, SITE_URL, toJsonLd, websiteLd } from '../lib/seo';
// Owner-reported defect, 2026-10-01: the account chip "refreshes on every page load" --
// AccountMenu.svelte's own `/v1/me` read already answers instantly from this exact cache
// entry on a returning visit (lib/data/query.ts's stale-while-revalidate persistence), but
// the island does not hydrate (and so does not paint it) until `load` plus an 800ms floor
// (src/directives/idle-after-load.ts). The inline pre-paint script below reads that same
// localStorage entry and fills AccountMenu's `account-menu-preflight` shell before first
// paint, so a signed-in visitor never sees the signed-out "Sign in" link flash on a second
// page. These three are build-time constants (API_BASE_URL is inlined by Vite), so the
// exact storage key/TTL/version this page's visitor's browser was written under can be
// computed here, server-side, once, and handed to the inline script as literal data
// attributes -- the script itself never re-derives or hashes anything, so it can never
// drift from what query.ts/api.ts actually wrote.
import { meKey, ME_QUERY_VERSION, ME_TTL_MS } from '../lib/account/api';
import { storageKey } from '../lib/data/query';
import { API_BASE_URL } from '../lib/planner/config';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Extra JSON-LD nodes for this page; the homepage always carries the WebSite node. */
  jsonLd?: object[];
}
const { title, description, path, jsonLd = [] } = Astro.props;
const site = SITE_URL;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const ldNodes = path === '/' ? [websiteLd(), ...jsonLd] : jsonLd;
// The literal storage key AccountMenu.svelte's `/v1/me` query writes under, for the
// pre-paint script below -- only meaningful on a page that actually mounts AccountMenu.
const meStorageKey = storageKey(meKey(API_BASE_URL));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-og="title">{fullTitle}</title>
    <meta name="description" content={description} data-og="description" />
    <link rel="canonical" href={`${site}${path}`} data-og="canonical" />
    <link rel="preload" href={cinzel700Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow600Url} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} data-og="og-title" />
    <meta property="og:description" content={description} data-og="og-description" />
    <meta property="og:url" content={`${site}${path}`} data-og="og-url" />
    <meta
      property="og:image"
      content={`${site}/og${path === '/' ? '/index' : path}.png`}
      data-og="og-image"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldNodes.length > 0 && <script type="application/ld+json" set:html={toJsonLd(ldNodes)}></script>}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-[18px] focus:top-[18px] focus:z-50 focus:inline-flex focus:items-center focus:h-11 focus:px-4 focus:rounded-control focus:border focus:border-line-warm-strong focus:bg-raised focus:text-text focus:font-semibold"
    >
      Skip to content
    </a>
    <Header path={path}>
      {/* Every page carries the same account menu (owner 2026-10-04: "it should always be
          on and always be the same" -- content pages used to opt out to ship zero client
          JavaScript, so /guides and /bis showed "Sign in" to a signed-in visitor). The
          island hydrates after load (src/directives/idle-after-load.ts) and paints the
          signed-in chip pre-paint from the cached /v1/me entry, see the inline script below. */}
      <AccountMenu client:idle-after-load slot="session" />
    </Header>
    <slot />
    <Footer />
    <script
      is:inline
      data-me-storage-key={meStorageKey}
      data-me-ttl-ms={ME_TTL_MS}
      data-me-version={ME_QUERY_VERSION}
    >
      // The session hint, before first paint: the readable half of the session cookie pair
      // (fs_csrf) means someone is signed in, so anything marked data-session-hide (the home
      // page's "Sign in" block) stays hidden until its island renders the signed-in state,
      // instead of flashing for a signed-in visitor on every load (lib/account/session-cache.ts).
      if (/(?:^|;\s*)fs_csrf=[^;]+/.test(document.cookie)) document.documentElement.dataset.session = '1';
      // The current-character hint, same idea: a stored pointer (lib/current-character.ts's
      // STORAGE_KEY, repeated here because an inline script cannot import) means the
      // planner and simulator pages will show the current-character band, so its reserved
      // slot (.chip-slot, global.css) stays; without one the slot collapses before paint.
      try {
        if (localStorage.getItem('fs.currentCharacter')) document.documentElement.dataset.pointer = '1';
      } catch {
        /* storage unavailable: no pointer, no band */
      }

      // Owner-reported defect, 2026-10-01: the account chip "refreshes on every page load"
      // -- fill AccountMenu.svelte's `account-menu-preflight` shell from the exact same
      // persisted `/v1/me` cache entry query.ts/api.ts write (this script's own
      // data-me-storage-key/-ttl-ms/-version attributes are those two modules' real values,
      // computed server-side in this layout's frontmatter -- see its own import comment),
      // before first paint, so a returning signed-in visitor's second page never paints
      // "Sign in" while the island is still waiting out its post-load hydration delay. A
      // page with no AccountMenu island (no `session` prop) simply has no shell to find
      // below, and this becomes a no-op.
      try {
        const shell = document.querySelector('[data-testid="account-menu-preflight"]');
        if (shell && /(?:^|;\s*)fs_csrf=[^;]+/.test(document.cookie)) {
          const scriptEl = document.currentScript;
          const storageKey = scriptEl.dataset.meStorageKey;
          const ttlMs = Number(scriptEl.dataset.meTtlMs);
          const version = Number(scriptEl.dataset.meVersion);
          const raw = storageKey ? localStorage.getItem(storageKey) : null;
          const persisted = raw ? JSON.parse(raw) : null;
          if (
            persisted &&
            typeof persisted.savedAt === 'number' &&
            persisted.v === version &&
            Date.now() - persisted.savedAt < ttlMs
          ) {
            const me = persisted.data;
            const characters = me && Array.isArray(me.characters) ? me.characters : [];
            // Port of lib/account/main-character.ts's `mainCharacter()` -- an inline
            // script cannot import it. Keep this in sync with that function by hand; it
            // has no automated drift guard today (unlike the crest asset path below,
            // which lib/class-crest.test.ts does check).
            let main = null;
            if (characters.length > 0) {
              main =
                me.main_character_key !== undefined
                  ? characters.find((c) => c.key === me.main_character_key)
                  : undefined;
              if (main === undefined) {
                const simmable = characters.filter((c) => c.build !== undefined);
                const pool = simmable.length > 0 ? simmable : characters;
                main = pool.reduce((a, b) => {
                  if (simmable.length > 0) {
                    const atA = (a.build && a.build.captured_at) || '';
                    const atB = (b.build && b.build.captured_at) || '';
                    if (atA !== atB) return atA > atB ? a : b;
                  }
                  return (b.level || 0) > (a.level || 0) ? b : a;
                });
              }
            }
            if (main && main.class) {
              // classCrestSrc's own path pattern (lib/class-crest.ts) and classColorVar's
              // own class-token list (lib/report/format.ts), hardcoded here since an
              // inline script cannot import either -- lib/class-crest.test.ts fails if
              // the crest path ever drifts from this literal.
              const slug = main.class.toLowerCase().replace(/\s+/g, '-');
              const CLASS_TOKENS = [
                'warrior',
                'paladin',
                'hunter',
                'rogue',
                'priest',
                'shaman',
                'mage',
                'warlock',
                'druid',
                'monk',
              ];
              const crestImg = shell.querySelector('[data-testid="account-menu-preflight-crest"]');
              if (crestImg) {
                crestImg.src = `/icons/hd/crests/${slug}.webp`;
                crestImg.style.setProperty(
                  '--c',
                  CLASS_TOKENS.indexOf(slug) !== -1 ? `var(--color-class-${slug})` : 'var(--color-text)',
                );
              }
              const factionImg = shell.querySelector('[data-testid="account-menu-preflight-faction"]');
              if (factionImg) {
                if (main.faction === 'alliance' || main.faction === 'horde') {
                  // faction-mark.ts's own path pattern, hardcoded for the same reason.
                  factionImg.src = `/icons/hd/faction/${main.faction}.webp`;
                  factionImg.classList.remove('hidden');
                } else {
                  factionImg.classList.add('hidden');
                }
              }
              const nameEl = shell.querySelector('[data-testid="account-menu-preflight-name"]');
              if (nameEl) nameEl.textContent = (me.user && (me.user.battletag || me.user.email)) || '';
              shell.setAttribute('data-ready', '1');
            }
          }
        }
      } catch {
        /* malformed/unavailable cache: leave the signed-out shell exactly as it always
           renders, and hydration answers for real -- same as a cache miss. */
      }
    </script>
  </body>
</html>
