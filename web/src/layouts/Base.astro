---
// web/src/layouts/Base.astro
// The self-hosted faces and their size-adjusted fallbacks live in
// ../styles/fonts.css, which carries the reasoning for all of it. They are a shared module
// rather than an import list here because src/planner-island.ts needs exactly the same set:
// planner-island.css is the only stylesheet the API's server-rendered /b/{id} page links,
// so a copy that lived only in this layout would leave that page in Georgia and Arial.
import '../styles/fonts.css';
// The faces every page paints first are preloaded so the swap from the fallback face
// happens before first paint on most connections; Vite gives them the same hashed URL
// fonts.css's own @font-face rules reference (../assets/fonts/*-subset.woff2), so no extra
// bytes are fetched. Open Sans 400 and 600 are the body and the footer and selector weight on
// every page; Archivo 600 is the bar's doors; Marcellus is the bar's name and every heading
// (round 5), so all four are preloaded. An unpreloaded face arrives late enough to shift the
// header or footer (the Lighthouse CLS budget).
//
// The data-og attributes are the selectors src/worker.ts rewrites through HTMLRewriter when
// it serves a shell page for an id that did not exist at build time. Renaming one silently
// stops that page's unfurl from updating, so src/pages/_shells.test.ts asserts they exist.
import openSans400Url from '../assets/fonts/open-sans-400-subset.woff2?url';
import openSans600Url from '../assets/fonts/open-sans-600-subset.woff2?url';
import archivo600Url from '../assets/fonts/archivo-600-subset.woff2?url';
import marcellus400Url from '../assets/fonts/marcellus-400-subset.woff2?url';
import { artStyle, FAVICON } from '../lib/ui/assets';
import { MOBILE_UA } from '../lib/setup/visitor-platform';
import type { BandArt } from '../lib/ui/primitives';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CharacterSelector from '../components/nav/CharacterSelector.svelte';

import { SITE_NAME, SITE_URL, pageTitle, toJsonLd, websiteLd } from '../lib/seo';
import { isNoindexPath } from '../lib/noindex-paths.mjs';
// The character selector's first frame (spec 2026-10-09-nav-character-selector.md section 8):
// the inline scripts below set `data-pointer-class` before paint and fill the selector's
// server-rendered link with the stored pointer's name and spec, and the cached `/v1/me`
// entry gives the level. These are build-time constants (API_BASE_URL is inlined by Vite),
// so the exact storage key/TTL/version this page's visitor's browser was written under is
// computed here, server-side, once, and handed to the script as literal data attributes --
// the script itself never re-derives or hashes anything, so it can never drift from what
// query.ts/api.ts actually wrote.
import { meKey, ME_QUERY_VERSION, ME_TTL_MS } from '../lib/account/api';
import { storageKey } from '../lib/data/query';
import { HISTORY_MAX_RESERVE_PX, HISTORY_RESERVE_KEY } from '../lib/character/history-layout';
import { ACCOUNT_RESERVE_KEY, ACCOUNT_RESERVE_MAX_PX } from '../lib/account/layout';
import { API_BASE_URL } from '../lib/planner/config';
import { ARRIVAL_CAPTURE_SCRIPT } from '../lib/golinks/arrival';
import { ICON_FAIL_SCRIPT } from '../lib/ui/icon-fail';
import {
  LAST_ACTIVE_KEY,
  SESSION_FRESH_KEY,
  SESSION_IDLE_MS,
  SESSION_START_POINTER_KEY,
} from '../lib/character-selector/restored';
import { POINTER_HEALED_KEY } from '../lib/account/session-pointer';
import { CLASS_SLUGS } from '../lib/ui/primitives';
import { HEADER_GEARED, HEADER_GEAR_HINT_KEY } from '../lib/character-header/gear-hint';
import {
  LIVE_STORAGE_KEY as SERVER_RUNS_LIVE_KEY,
  LIVE_TTL_MS as SERVER_RUNS_LIVE_TTL_MS,
} from '../lib/sim/server-runs-poll';

interface Props {
  title: string;
  description: string;
  path: string;
  /** The canonical URL's path when it is another page's (a filtered view of a list that is
   *  already that view: the BiS /60/pre-raid page). Defaults to `path`. */
  canonicalPath?: string;
  /** Extra JSON-LD nodes for this page; the homepage always carries the WebSite node. */
  jsonLd?: object[];
  /** The art behind the bar: the painted band, or home's hero (with PageHeader's `art="hero"`). */
  art?: BandArt;
}
const { title, description, path, canonicalPath = path, jsonLd = [], art = 'band' } = Astro.props;
const site = SITE_URL;
const fullTitle = pageTitle(path, title);
const ldNodes = path === '/' ? [websiteLd(), ...jsonLd] : jsonLd;
// A personal page or a step in a flow (lib/noindex-paths.mjs, the sitemap's own list).
const noindex = isNoindexPath(path);
// The literal storage key the selector's `/v1/me` query writes under, for the fill script.
const meStorageKey = storageKey(meKey(API_BASE_URL));
---

<!doctype html>
<html lang="en" style={artStyle()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A spell icon whose file fails leaves no empty frame, hydrated or not (lib/ui/icon-fail.ts). */}
    <script is:inline set:html={ICON_FAIL_SCRIPT}></script>
    <title data-og="title">{fullTitle}</title>
    <meta name="description" content={description} data-og="description" />
    <link rel="canonical" href={`${site}${canonicalPath}`} data-og="canonical" />
    {noindex && <meta name="robots" content="noindex" />}
    {/* The faces every page paints first (round 5): Open Sans body, Archivo in the bar, Marcellus
        in the bar's name and every heading. */}
    <link rel="preload" href={openSans400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={openSans600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={marcellus400Url} as="font" type="font/woff2" crossorigin />
    {/* The ico names a size so Chrome does not prefer it over the SVG (sizes="any" would). */}
    <link rel="icon" href={FAVICON.ico} sizes="32x32" />
    <link rel="icon" href={FAVICON.svg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={FAVICON.appleTouch} />
    <meta property="og:title" content={fullTitle} data-og="og-title" />
    <meta property="og:description" content={description} data-og="og-description" />
    <meta property="og:url" content={`${site}${canonicalPath}`} data-og="og-url" />
    <meta
      property="og:image"
      content={`${site}/og${path === '/' ? '/index' : path}.png`}
      data-og="og-image"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldNodes.length > 0 && <script type="application/ld+json" set:html={toJsonLd(ldNodes)}></script>}
    <slot name="head" />
    <script
      is:inline
      data-me-storage-key={meStorageKey}
      data-server-runs-live-key={SERVER_RUNS_LIVE_KEY}
      data-server-runs-live-ttl={SERVER_RUNS_LIVE_TTL_MS}
      data-history-reserve-key={HISTORY_RESERVE_KEY}
      data-history-max-reserve={HISTORY_MAX_RESERVE_PX}
      data-account-reserve-key={ACCOUNT_RESERVE_KEY}
      data-account-max-reserve={ACCOUNT_RESERVE_MAX_PX}
      data-session-start-pointer-key={SESSION_START_POINTER_KEY}
      data-session-fresh-key={SESSION_FRESH_KEY}
      data-last-active-key={LAST_ACTIVE_KEY}
      data-session-idle-ms={SESSION_IDLE_MS}
      data-pointer-healed-key={POINTER_HEALED_KEY}
      data-header-gear-key={HEADER_GEAR_HINT_KEY}
      data-header-geared={HEADER_GEARED}
      data-class-slugs={CLASS_SLUGS.join(' ')}
      data-mobile-ua={MOBILE_UA.source}
    >
      // The hints the stylesheet keys off, before first paint. The readable half of the session
      // cookie (fs_csrf) means someone is signed in: anything marked data-session-hide (the
      // home page's "Sign in" block) stays hidden until its island renders the signed-in
      // state, and the character selector shows a skeleton instead of "Sign in"
      // (lib/data/query.ts's sessionHinted). A stored pointer (lib/current-character.ts's
      // STORAGE_KEY, repeated here because an inline script cannot import) sets data-pointer,
      // which /setup's step hints key off (global.css), and data-pointer-class, which nav.css
      // maps to the selector's crest. The class list is lib/ui/primitives.ts CLASS_SLUGS, handed
      // in as data-class-slugs (an inline script cannot import); class-crest.test.ts checks the crests.
      if (/(?:^|;\s*)fs_csrf=[^;]+/.test(document.cookie)) document.documentElement.dataset.session = '1';
      try {
        const raw = localStorage.getItem('fs.currentCharacter');
        if (raw) {
          document.documentElement.dataset.pointer = '1';
          const slug = JSON.parse(raw).classSlug;
          const CLASSES = (document.currentScript.dataset.classSlugs || '').split(' ');
          if (CLASSES.indexOf(slug) !== -1) document.documentElement.dataset.pointerClass = slug;
        }
      } catch {
        /* storage unavailable or malformed: no pointer, no crest */
      }
      // A phone or tablet (lib/setup/visitor-platform.ts's MOBILE_UA, handed in as data-mobile-ua)
      // sets data-platform, so /setup's head draws the phone's download before its island mounts.
      if (
        (navigator.userAgentData && navigator.userAgentData.mobile === true) ||
        new RegExp(document.currentScript.dataset.mobileUa, 'i').test(navigator.userAgent)
      )
        document.documentElement.dataset.platform = 'mobile';
      // The character header's skeleton shape (HEADER_GEAR_HINT_KEY's module): data-ch-gear
      // when the last header drawn was for a character with gear on file, so the loading box
      // reserves the sync line and the figures only when the header that replaces it has them.
      try {
        const el = document.currentScript;
        const root = document.documentElement;
        if (
          root.dataset.session === '1' &&
          localStorage.getItem(el.dataset.headerGearKey) === el.dataset.headerGeared
        )
          root.dataset.chGear = '1';
      } catch {
        /* storage unavailable: the skeleton takes the gearless box */
      }
      // The character this browser session started with (lib/character-selector/restored.ts),
      // recorded before any island can write a pointer, as `source:ref` (its pointerIdentity),
      // or '' for none: the selector says "Restored your last character" while the pointer
      // still names it. A fresh session (isFreshBrowserSession: nothing recorded, or no page
      // opened for SESSION_IDLE_MS) records the stored pointer and marks the tab fresh, so the
      // session rule (account/session-pointer.ts) runs again; a tab opened mid-session records
      // none, since its pointer was chosen in this visit.
      try {
        const script = document.currentScript.dataset;
        const sessionKey = script.sessionStartPointerKey;
        const now = Date.now();
        const last = Number(localStorage.getItem(script.lastActiveKey));
        const fresh = !(last > 0) || now - last >= Number(script.sessionIdleMs);
        localStorage.setItem(script.lastActiveKey, String(now));
        if (fresh || sessionStorage.getItem(sessionKey) === null) {
          let identity = '';
          try {
            const stored = JSON.parse(localStorage.getItem('fs.currentCharacter'));
            if (fresh && stored && typeof stored.source === 'string' && typeof stored.ref === 'string') {
              identity = stored.source + ':' + stored.ref;
            }
          } catch {
            /* a malformed pointer: the session started with none */
          }
          sessionStorage.setItem(sessionKey, identity);
        }
        if (fresh) {
          sessionStorage.setItem(script.sessionFreshKey, '1');
          sessionStorage.removeItem(script.pointerHealedKey);
        }
      } catch {
        /* storage unavailable: the selector never claims a restore */
      }
      // data-server-sims when the cached /v1/me says the account has server sims (the
      // entitlement, else the legacy premium flag, as account/api.ts's effectiveServerSims reads
      // them): the header hides its Premium door for it.
      try {
        const el = document.currentScript;
        const root = document.documentElement;
        const cached = localStorage.getItem(el.dataset.meStorageKey);
        const me = cached ? JSON.parse(cached).data : null;
        const payer =
          me &&
          (me.entitlements ? me.entitlements.server_sims === true : !!me.user && me.user.premium === true);
        if (root.dataset.session === '1' && payer) root.dataset.serverSims = '1';
        // The band's "server sim finished" line (spec 3.7): reserve its row when the snapshot
        // holds an unseen finished run, or a run was started or seen in flight in the last 2 h.
        const finished = me && me.finished_sims && me.finished_sims.length > 0;
        const liveSince = Number(localStorage.getItem(el.dataset.serverRunsLiveKey));
        const sinceLive = Date.now() - liveSince;
        const live = liveSince > 0 && sinceLive >= 0 && sinceLive < Number(el.dataset.serverRunsLiveTtl);
        if (root.dataset.session === '1' && payer && (finished || live)) root.dataset.finished = '1';
      } catch {
        /* storage unavailable or malformed: no hints */
      }
      // The owner's History section on a character page (spec 2026-10-24-character-history
      // 3.11): data-history when the cached /v1/me says the plan has it and lists this page's
      // character (the hint alone cannot know ownership), and the last rendered height as
      // --history-reserve. Anyone else reserves nothing.
      try {
        const el = document.currentScript;
        const root = document.documentElement;
        const cached = localStorage.getItem(el.dataset.meStorageKey);
        const me = cached ? JSON.parse(cached).data : null;
        const pageKey = decodeURIComponent(location.pathname)
          .replace(/^\/character\//, '')
          .replace(/\/+$/, '')
          .toLowerCase();
        const owns =
          location.pathname.indexOf('/character/') === 0 &&
          me &&
          me.characters &&
          me.characters.some(function (c) {
            return String(c.key).toLowerCase() === pageKey;
          });
        if (root.dataset.session === '1' && owns && me.entitlements && me.entitlements.history === true) {
          root.dataset.history = '1';
          const historyReserve = Math.round(Number(localStorage.getItem(el.dataset.historyReserveKey)));
          if (historyReserve > 0 && historyReserve <= Number(el.dataset.historyMaxReserve))
            root.style.setProperty('--history-reserve', historyReserve + 'px');
        }
      } catch {
        /* storage unavailable or malformed: the section reserves its fallback height */
      }
      // The /account loading reserve (spec 2026-10-25-discord-notifications 9.1): data-discord
      // says which Discord block the ready page will draw, from the cached /v1/me, and the last
      // rendered column heights of this viewport's layout become --account-left-reserve and
      // --account-rail-reserve, so the loading state already has the ready page's shape.
      // hintOf below is a verbatim copy of discordHintState in lib/account/layout.ts
      // (layout-reserve.test.ts evaluates this very text against the same fixtures): change both.
      try {
        const el = document.currentScript;
        const root = document.documentElement;
        if (
          (location.pathname === '/account' || location.pathname === '/account/') &&
          root.dataset.session === '1'
        ) {
          // discord-hint:begin
          function hintOf(me) {
            if (me === null || me.notifications === undefined) return 'none';
            const discord = me.notifications.discord;
            const entitled = me.entitlements && me.entitlements.notifications === true;
            if (discord === null || discord === undefined) {
              if (!entitled) return 'free';
              return me.notifications.connect === true ? 'connect' : 'form';
            }
            if (!entitled) return 'lapsed';
            return discord.disabled_reason === null ? 'saved' : 'off';
          }
          // discord-hint:end
          // discord-link-hint:begin
          function linkHintOf(me) {
            if (me === null || me.discord_link_available !== true) return 'none';
            if (me.discord_link && me.discord_link.display_name) return 'linked';
            return me.discord_link_suggested ? 'suggested' : 'unlinked';
          }
          // discord-link-hint:end
          const cached = localStorage.getItem(el.dataset.meStorageKey);
          const cachedMe = cached ? JSON.parse(cached).data : null;
          root.dataset.discord = hintOf(cachedMe);
          root.dataset.discordLink = linkHintOf(cachedMe);
          const stored = JSON.parse(localStorage.getItem(el.dataset.accountReserveKey));
          if (stored && stored.v === 1) {
            const bucket = stored[matchMedia('(min-width: 1024px)').matches ? 'lg' : 'stack'];
            const max = Number(el.dataset.accountMaxReserve);
            if (bucket && bucket.left > 0 && bucket.left <= max)
              root.style.setProperty('--account-left-reserve', Math.round(bucket.left) + 'px');
            if (bucket && bucket.rail > 0 && bucket.rail <= max)
              root.style.setProperty('--account-rail-reserve', Math.round(bucket.rail) + 'px');
          }
        }
      } catch {
        /* storage unavailable or malformed: the floors apply */
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-[18px] focus:top-[18px] focus:z-50 focus:inline-flex focus:items-center focus:h-11 focus:px-4 focus:rounded-field focus:bg-bg focus:text-gold focus:font-semibold focus:outline-2 focus:outline-gold"
    >
      Skip to content
    </a>
    {/* The band the floating bar sits over (nav.css .site-top); ui/PageHeader continues it. The bar
        sits in the one page frame (.page-column), as the page body and the footer do. */}
    <div class="site-top ui-band ui-band-end" data-art={art}>
      <div class="page-column">
        <Header path={path}>
          {/* Every page carries the same character selector (owner 2026-10-04: "it should always
            be on and always be the same"). The island hydrates after load
            (src/directives/idle-after-load.ts); until then it is a link the scripts below have
            already filled from the stored pointer. It also renders the phone Menu's first row. */}
          <CharacterSelector client:idle-after-load slot="session" />
        </Header>
      </div>
    </div>
    {/* A fixed breath above the footer (owner 2026-11-09), whatever the page's last block is. */}
    <div class="page-column" data-page-body>
      <slot />
    </div>
    <Footer />
    <script
      is:inline
      data-me-storage-key={meStorageKey}
      data-me-ttl-ms={ME_TTL_MS}
      data-me-version={ME_QUERY_VERSION}
    >
      // The character selector's server-rendered link and the phone Menu's first row, filled
      // from the stored pointer before first paint: the name and `{Spec} {Class} · {level}`
      // (the pointer's label is "Name · Fury Warrior"; the level comes from the cached
      // `/v1/me` entry query.ts/api.ts wrote, when it names this character). Mirrors
      // lib/character-selector/rows.ts (rowFromPointer, closedSecondLine); an inline script
      // cannot import it. The selector's island replaces these elements when it hydrates.
      try {
        const scriptEl = document.currentScript;
        const raw = localStorage.getItem('fs.currentCharacter');
        const pointer = raw ? JSON.parse(raw) : null;
        if (!pointer || typeof pointer.label !== 'string' || typeof pointer.classSlug !== 'string') {
          if (!document.documentElement.dataset.session) {
            document
              .querySelectorAll('.csel-btn.csel-pre')
              .forEach((el) => el.classList.add('is-signed-out'));
          }
        } else {
          const className = pointer.classSlug.charAt(0).toUpperCase() + pointer.classSlug.slice(1);
          const parts = pointer.label.split(' · ');
          const rest = parts.slice(1).join(' · ');
          const spec = rest.endsWith(' ' + className) ? rest.slice(0, -className.length - 1) : '';
          let level = '';
          let name = parts[0];
          if (pointer.source === 'armory') {
            const cached = scriptEl.dataset.meStorageKey
              ? localStorage.getItem(scriptEl.dataset.meStorageKey)
              : null;
            const persisted = cached ? JSON.parse(cached) : null;
            const fresh =
              persisted &&
              persisted.v === Number(scriptEl.dataset.meVersion) &&
              Date.now() - persisted.savedAt < Number(scriptEl.dataset.meTtlMs);
            const characters =
              fresh && persisted.data && Array.isArray(persisted.data.characters)
                ? persisted.data.characters
                : [];
            const match = characters.find((c) => c.key === pointer.ref);
            if (match && typeof match.level === 'number') level = String(match.level);
            if (match && typeof match.name === 'string') name = match.name;
          }
          const full = [spec ? spec + ' ' + className : className, level].filter(Boolean).join(' · ');
          const short = [spec || className, level].filter(Boolean).join(' · ');
          const classLine = [className, level].filter(Boolean).join(' · ');
          document.querySelectorAll('[data-csel-name]').forEach((el) => (el.textContent = name));
          document.querySelectorAll('[data-csel-sub]').forEach((el) => (el.textContent = full));
          document.querySelectorAll('[data-csel-sub-class]').forEach((el) => (el.textContent = classLine));
          document.querySelectorAll('[data-csel-sub-short]').forEach((el) => (el.textContent = short));
          // Only a Battle.net character carries a level (it may arrive with /v1/me): a pasted
          // export's control holds no level slot, as the island draws it.
          document.querySelectorAll('[data-csel-level]').forEach((el) => {
            el.textContent = level;
            el.hidden = pointer.source !== 'armory';
          });
        }
      } catch {
        /* malformed pointer or cache: leave the link as rendered, hydration answers for real */
      }
    </script>
    {/* A /go/ landing's ?golink= is kept and taken out of the address bar (lib/golinks/arrival.ts). */}
    <script is:inline set:html={ARRIVAL_CAPTURE_SCRIPT}></script>
  </body>
</html>
