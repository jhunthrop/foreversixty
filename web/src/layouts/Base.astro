---
// web/src/layouts/Base.astro
// Cinzel (display), Barlow (body), and JetBrains Mono (numbers) are the three self-hosted
// faces design/DESIGN-SYSTEM.md specifies -- see that doc for the exact weight ranges and
// where each is used. All three are self-hosted via @fontsource with `font-display: swap`,
// so first paint always uses the fallback stack in tokens.css and the real face swaps in
// once it downloads, rather than blocking render or being skipped entirely.
//
// Barlow specifically needs a size-adjusted fallback @font-face: it's the family behind the
// LCP-candidate text on every audited page (the homepage's hero label, a dungeon page's lead
// paragraph), and a naive swap reflows that text once Barlow loads (different fallback vs.
// Barlow glyph metrics change the line's width/height), which fails the CLS budget in
// lighthouserc.json. `Barlow Fallback` below is Helvetica Neue/Arial with `size-adjust` and
// the three `*-override` descriptors tuned so its em-box matches Barlow's -- computed with
// @capsizecss/unpack against the actual Barlow woff2 and the system Helvetica Neue/Arial
// (Barlow's ascent/descent/lineGap are identical across its 400/600/700 weights, so one
// fallback face covers all three). With that in place, `font-display: swap` never triggers a
// visible reflow, so it doesn't need to be avoided or preloaded to hit the LCP budget: text
// paints with the fallback face immediately (which is what the simulated-mobile LCP snapshot
// measures) and swaps in place once Barlow arrives.
// Every import below uses Fontsource's `latin-*` subset file (one @font-face rule, no
// unicode-range split across latin/latin-ext/vietnamese/etc.) instead of the combined
// `*.css` entry point. The app is English-only, so the extra subsets are dead weight -- and
// with `inlineStylesheets: 'always'` shipping this CSS inside every HTML document, that
// weight was inflating the document itself (not just an external, cacheable request), which
// cost real LCP time under lighthouserc.json's mobile budget.
//
// No font is preloaded. Both `<link rel="preload">` strategies in the task-11 fix-round-1
// review (Barlow preloaded/Cinzel not, and the reverse) measured within noise of preloading
// nothing at all once all five font files (Cinzel 700, Barlow 400/600/700, JetBrains Mono
// 500) are in play -- see the fix report for the full measurement table. Preloading only
// mattered back when two or three font files were competing for bandwidth; at five files the
// bottleneck is the total bytes needed before paint, which preloading doesn't reduce.
import '@fontsource/cinzel/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/jetbrains-mono/latin-500.css';
// The two faces every page paints first are preloaded so the swap from the fallback face
// happens before first paint on most connections; Vite gives them the same hashed URL the
// @fontsource CSS references, so no extra bytes are fetched.
import cinzel700Url from '@fontsource/cinzel/files/cinzel-latin-700-normal.woff2?url';
import barlow400Url from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const fallbackFontFace = `
@font-face {
  font-family: 'Barlow Fallback';
  src: local('Helvetica Neue'), local('Arial');
  size-adjust: 95.78%;
  ascent-override: 104.41%;
  descent-override: 20.88%;
  line-gap-override: 0%;
}
`;

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const site = 'https://foreversixty.gg';
const fullTitle = title === 'Forever Sixty' ? title : `${title} · Forever Sixty`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${path}`} />
    <link rel="preload" href={cinzel700Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow400Url} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}${path}`} />
    <meta property="og:image" content={`${site}/og${path === '/' ? '/index' : path}.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <style set:html={fallbackFontFace}></style>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-[18px] focus:top-[18px] focus:z-50 focus:inline-flex focus:items-center focus:h-11 focus:px-4 focus:rounded-control focus:border focus:border-line-warm-strong focus:bg-raised focus:text-text focus:font-semibold"
    >
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
