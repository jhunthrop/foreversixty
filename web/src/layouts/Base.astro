---
// web/src/layouts/Base.astro
// The three self-hosted faces and Barlow's size-adjusted fallback live in
// ../styles/fonts.css, which carries the reasoning for all of it. They are a shared module
// rather than an import list here because src/planner-island.ts needs exactly the same set:
// planner-island.css is the only stylesheet the API's server-rendered /b/{id} page links,
// so a copy that lived only in this layout would leave that page in Georgia and Arial.
import '../styles/fonts.css';
// The three faces every page paints first are preloaded so the swap from the fallback face
// happens before first paint on most connections; Vite gives them the same hashed URL the
// @fontsource CSS in fonts.css references, so no extra bytes are fetched. Barlow 600 joins
// 400 here for the same reason: it is the weight the header and footer paint with on every
// page, so an unpreloaded 600 arrives late enough to shift them (final whole-branch review,
// Lighthouse rounds 1-3 — layout-shifts kept naming barlow-latin-600-normal.woff2's load as
// the footer's own shift, on whichever page's font timing happened to expose it that run).
//
// The data-og attributes are the selectors src/worker.ts rewrites through HTMLRewriter when
// it serves a shell page for an id that did not exist at build time. Renaming one silently
// stops that page's unfurl from updating, so src/pages/_shells.test.ts asserts they exist.
import cinzel700Url from '@fontsource/cinzel/files/cinzel-latin-700-normal.woff2?url';
import barlow400Url from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlow600Url from '@fontsource/barlow/files/barlow-latin-600-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccountMenu from '../components/account/AccountMenu.svelte';

import { SITE_NAME, SITE_URL, toJsonLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  /**
   * True on a page that already runs client JavaScript (the tools, logs, account): the header
   * link hydrates and shows who is signed in. False, the default, on a content page: those
   * ship no client JavaScript at all (home.spec.ts pins it, and the Lighthouse budgets have
   * no room for a framework runtime behind one link), so the header carries a plain "Sign
   * in" link instead. It is never a dead end: /login tells a signed-in visitor so and links
   * to their account.
   */
  session?: boolean;
  /** Extra JSON-LD nodes for this page; the homepage always carries the WebSite node. */
  jsonLd?: object[];
}
const { title, description, path, session = false, jsonLd = [] } = Astro.props;
const site = SITE_URL;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const ldNodes = path === '/' ? [websiteLd(), ...jsonLd] : jsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-og="title">{fullTitle}</title>
    <meta name="description" content={description} data-og="description" />
    <link rel="canonical" href={`${site}${path}`} data-og="canonical" />
    <link rel="preload" href={cinzel700Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow600Url} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} data-og="og-title" />
    <meta property="og:description" content={description} data-og="og-description" />
    <meta property="og:url" content={`${site}${path}`} data-og="og-url" />
    <meta
      property="og:image"
      content={`${site}/og${path === '/' ? '/index' : path}.png`}
      data-og="og-image"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldNodes.length > 0 && <script type="application/ld+json" set:html={toJsonLd(ldNodes)}></script>}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-[18px] focus:top-[18px] focus:z-50 focus:inline-flex focus:items-center focus:h-11 focus:px-4 focus:rounded-control focus:border focus:border-line-warm-strong focus:bg-raised focus:text-text focus:font-semibold"
    >
      Skip to content
    </a>
    <Header path={path}>
      {session ? (
        <AccountMenu client:load slot="session" />
      ) : (
        <a
          slot="session"
          href="/login"
          class="text-nav hover:text-strong inline-flex min-h-11 items-center px-2 text-[13px] md:min-h-0 md:px-0"
          data-testid="session-nav-static"
        >
          Sign in
        </a>
      )}
    </Header>
    <slot />
    <Footer />
    <script is:inline>
      // The session hint, before first paint: the readable half of the session cookie pair
      // (fs_csrf) means someone is signed in, so anything marked data-session-hide (the home
      // page's "Sign in" block) stays hidden until its island renders the signed-in state,
      // instead of flashing for a signed-in visitor on every load (lib/account/session-cache.ts).
      if (/(?:^|;\s*)fs_csrf=[^;]+/.test(document.cookie)) document.documentElement.dataset.session = '1';
      // The current-character hint, same idea: a stored pointer (lib/current-character.ts's
      // STORAGE_KEY, repeated here because an inline script cannot import) means the
      // planner and simulator pages will show the current-character band, so its reserved
      // slot (.chip-slot, global.css) stays; without one the slot collapses before paint.
      try {
        if (localStorage.getItem('fs.currentCharacter')) document.documentElement.dataset.pointer = '1';
      } catch {
        /* storage unavailable: no pointer, no band */
      }
    </script>
    <script is:inline>
      // is:inline: no bundling and no request, so a content page still ships no script
      // file. It also means no TypeScript in here -- this is plain JavaScript on purpose.
      // Site-wide "/" shortcut (design/DESIGN-SYSTEM.md: "`/` keyboard hint. First
      // interactive element on every page"). Pages with a SearchBox island
      // (src/components/SearchBox.svelte, mounted on `/` and `/search`) already focus it
      // via src/directives/interaction.ts's own capture-phase "/" listener and call
      // preventDefault -- this script checks `defaultPrevented` first and steps aside when
      // that has already happened, so the two mechanisms never fight. Everywhere else
      // (every page without a search box) this is the only "/" handling that exists, and it
      // goes to /search.
      window.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target;
        const typing =
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          (target instanceof HTMLElement && target.isContentEditable);
        if (typing) return;
        const searchBox = document.querySelector('input[aria-label="Search the site"]');
        event.preventDefault();
        if (searchBox) searchBox.focus();
        else window.location.assign('/search');
      });
    </script>
  </body>
</html>
