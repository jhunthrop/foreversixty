---
// web/src/layouts/Base.astro
// The three self-hosted faces and Barlow's size-adjusted fallback live in
// ../styles/fonts.css, which carries the reasoning for all of it. They are a shared module
// rather than an import list here because src/planner-island.ts needs exactly the same set:
// planner-island.css is the only stylesheet the API's server-rendered /b/{id} page links,
// so a copy that lived only in this layout would leave that page in Georgia and Arial.
import '../styles/fonts.css';
// The three faces every page paints first are preloaded so the swap from the fallback face
// happens before first paint on most connections; Vite gives them the same hashed URL
// fonts.css's own @font-face rules reference (../assets/fonts/*-subset.woff2, since the
// web-font-subsets lane), so no extra bytes are fetched. Barlow 600 joins 400 here for the
// same reason: it is the weight the header and footer paint with on every page, so an
// unpreloaded 600 arrives late enough to shift them (final whole-branch review, Lighthouse
// rounds 1-3 — layout-shifts kept naming barlow-latin-600-normal.woff2's load as the
// footer's own shift, on whichever page's font timing happened to expose it that run).
//
// The data-og attributes are the selectors src/worker.ts rewrites through HTMLRewriter when
// it serves a shell page for an id that did not exist at build time. Renaming one silently
// stops that page's unfurl from updating, so src/pages/_shells.test.ts asserts they exist.
import cinzel700Url from '../assets/fonts/cinzel-700-subset.woff2?url';
import barlow400Url from '../assets/fonts/barlow-400-subset.woff2?url';
import barlow600Url from '../assets/fonts/barlow-600-subset.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CharacterSelector from '../components/nav/CharacterSelector.svelte';

import { SITE_NAME, SITE_URL, toJsonLd, websiteLd } from '../lib/seo';
// The character selector's first frame (spec 2026-10-09-nav-character-selector.md section 8):
// the inline scripts below set `data-pointer-class` before paint and fill the selector's
// server-rendered link with the stored pointer's name and spec, and the cached `/v1/me`
// entry gives the level. These are build-time constants (API_BASE_URL is inlined by Vite),
// so the exact storage key/TTL/version this page's visitor's browser was written under is
// computed here, server-side, once, and handed to the script as literal data attributes --
// the script itself never re-derives or hashes anything, so it can never drift from what
// query.ts/api.ts actually wrote.
import { meKey, ME_QUERY_VERSION, ME_TTL_MS } from '../lib/account/api';
import { storageKey } from '../lib/data/query';
import { API_BASE_URL } from '../lib/planner/config';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Extra JSON-LD nodes for this page; the homepage always carries the WebSite node. */
  jsonLd?: object[];
}
const { title, description, path, jsonLd = [] } = Astro.props;
const site = SITE_URL;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const ldNodes = path === '/' ? [websiteLd(), ...jsonLd] : jsonLd;
// The literal storage key the selector's `/v1/me` query writes under, for the fill script.
const meStorageKey = storageKey(meKey(API_BASE_URL));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-og="title">{fullTitle}</title>
    <meta name="description" content={description} data-og="description" />
    <link rel="canonical" href={`${site}${path}`} data-og="canonical" />
    <link rel="preload" href={cinzel700Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlow600Url} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} data-og="og-title" />
    <meta property="og:description" content={description} data-og="og-description" />
    <meta property="og:url" content={`${site}${path}`} data-og="og-url" />
    <meta
      property="og:image"
      content={`${site}/og${path === '/' ? '/index' : path}.png`}
      data-og="og-image"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldNodes.length > 0 && <script type="application/ld+json" set:html={toJsonLd(ldNodes)}></script>}
    <slot name="head" />
    <script is:inline>
      // The hints the stylesheet keys off, before first paint. The readable half of the session
      // cookie (fs_csrf) means someone is signed in: anything marked data-session-hide (the
      // home page's "Sign in" block) stays hidden until its island renders the signed-in
      // state, and the character selector shows a skeleton instead of "Sign in"
      // (lib/data/query.ts's sessionHinted). A stored pointer (lib/current-character.ts's
      // STORAGE_KEY, repeated here because an inline script cannot import) sets data-pointer,
      // which keeps the current-character band's reserved slot (.chip-slot, global.css), and
      // data-pointer-class, which nav.css maps to the selector's crest. The class list is the
      // crest files under public/icons/hd/crests (lib/class-crest.test.ts checks it).
      if (/(?:^|;\s*)fs_csrf=[^;]+/.test(document.cookie)) document.documentElement.dataset.session = '1';
      try {
        const raw = localStorage.getItem('fs.currentCharacter');
        if (raw) {
          document.documentElement.dataset.pointer = '1';
          const slug = JSON.parse(raw).classSlug;
          const CLASSES = [
            'warrior',
            'paladin',
            'hunter',
            'rogue',
            'priest',
            'shaman',
            'mage',
            'warlock',
            'druid',
          ];
          if (CLASSES.indexOf(slug) !== -1) document.documentElement.dataset.pointerClass = slug;
        }
      } catch {
        /* storage unavailable or malformed: no pointer, no band, no crest */
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-[18px] focus:top-[18px] focus:z-50 focus:inline-flex focus:items-center focus:h-11 focus:px-4 focus:rounded-control focus:border focus:border-line-warm-strong focus:bg-raised focus:text-text focus:font-semibold"
    >
      Skip to content
    </a>
    <Header path={path}>
      {/* Every page carries the same character selector (owner 2026-10-04: "it should always
          be on and always be the same"). The island hydrates after load
          (src/directives/idle-after-load.ts); until then it is a link the scripts below have
          already filled from the stored pointer. It also renders the phone Menu's first row. */}
      <CharacterSelector client:idle-after-load slot="session" />
    </Header>
    <slot />
    <Footer />
    <script
      is:inline
      data-me-storage-key={meStorageKey}
      data-me-ttl-ms={ME_TTL_MS}
      data-me-version={ME_QUERY_VERSION}
    >
      // The character selector's server-rendered link and the phone Menu's first row, filled
      // from the stored pointer before first paint: the name and `{Spec} {Class} · {level}`
      // (the pointer's label is "Name · Fury Warrior"; the level comes from the cached
      // `/v1/me` entry query.ts/api.ts wrote, when it names this character). Mirrors
      // lib/character-selector/rows.ts (rowFromPointer, closedSecondLine); an inline script
      // cannot import it. The selector's island replaces these elements when it hydrates.
      try {
        const scriptEl = document.currentScript;
        const raw = localStorage.getItem('fs.currentCharacter');
        const pointer = raw ? JSON.parse(raw) : null;
        if (!pointer || typeof pointer.label !== 'string' || typeof pointer.classSlug !== 'string') {
          if (!document.documentElement.dataset.session) {
            document
              .querySelectorAll('.csel-btn.csel-pre')
              .forEach((el) => el.classList.add('is-signed-out'));
          }
        } else {
          const className = pointer.classSlug.charAt(0).toUpperCase() + pointer.classSlug.slice(1);
          const parts = pointer.label.split(' · ');
          const rest = parts.slice(1).join(' · ');
          const spec = rest.endsWith(' ' + className) ? rest.slice(0, -className.length - 1) : '';
          let level = '';
          let name = parts[0];
          if (pointer.source === 'armory') {
            const cached = scriptEl.dataset.meStorageKey
              ? localStorage.getItem(scriptEl.dataset.meStorageKey)
              : null;
            const persisted = cached ? JSON.parse(cached) : null;
            const fresh =
              persisted &&
              persisted.v === Number(scriptEl.dataset.meVersion) &&
              Date.now() - persisted.savedAt < Number(scriptEl.dataset.meTtlMs);
            const characters =
              fresh && persisted.data && Array.isArray(persisted.data.characters)
                ? persisted.data.characters
                : [];
            const match = characters.find((c) => c.key === pointer.ref);
            if (match && typeof match.level === 'number') level = String(match.level);
            if (match && typeof match.name === 'string') name = match.name;
          }
          const full = [spec ? spec + ' ' + className : className, level].filter(Boolean).join(' · ');
          const short = [spec || className, level].filter(Boolean).join(' · ');
          document.querySelectorAll('[data-csel-name]').forEach((el) => (el.textContent = name));
          document.querySelectorAll('[data-csel-sub]').forEach((el) => (el.textContent = full));
          document.querySelectorAll('[data-csel-sub-short]').forEach((el) => (el.textContent = short));
        }
      } catch {
        /* malformed pointer or cache: leave the link as rendered, hydration answers for real */
      }
    </script>
  </body>
</html>
