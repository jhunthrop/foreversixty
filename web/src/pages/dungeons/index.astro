---
// web/src/pages/dungeons/index.astro
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryTable from '../../components/EntryTable.astro';
const dungeons = (await getCollection('dungeons')).sort((a, b) => a.data.order - b.data.order);
const rows = dungeons.map((d) => ({
  href: `/dungeons/${d.id}`,
  title: d.data.title,
  meta: d.data.zone,
  levelMin: d.data.levelMin,
  levelMax: d.data.levelMax,
}));
---
<Base title="Dungeons" description="The nine new dungeons in World of Warcraft: Forever, with what is known about each." path="/dungeons">
  <main class="max-w-[1000px] w-full mx-auto px-6 py-10 flex flex-col gap-5">
    <h1 class="text-[28px] font-bold tracking-[0.02em]">Dungeons</h1>
    <p class="text-muted text-[14px]">Level ranges are reported by one outlet and not yet confirmed by Blizzard.</p>
    <EntryTable nameHeading="Dungeon" metaHeading="Zone" rows={rows} />
  </main>
</Base>
