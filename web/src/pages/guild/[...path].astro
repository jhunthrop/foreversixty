---
// web/src/pages/guild/[...path].astro
// Fixture-only, like the report and rankings fixture pages: one guild Playwright can reach
// without a Worker. A real build prerenders none.
import Base from '../../layouts/Base.astro';
import GuildShell from '../../components/GuildShell.svelte';
import { fixtureGuildPaths } from '../../lib/report/shell-paths';

export function getStaticPaths() {
  return fixtureGuildPaths();
}

const { path } = Astro.params;
---

<Base
  title="Guild"
  description="Raid nights, roster, readiness and loot for a WoW: Forever guild."
  path={`/guild/${path}`}
>
  <main
    id="main"
    tabindex="-1"
    class="guild-main flex flex-col gap-[22px] px-(--page-inset) pt-4 pb-10 md:gap-8 md:pt-0"
  >
    <GuildShell client:after-paint />
  </main>
</Base>

<style>
  /* The guild views not yet on the primitives keep main's own 18 px phone gutter; the primitive
     Page would add its phone inset on top of it (36 px). The full-bleed PageHeader band and
     ControlBar escape main's padding, so they keep their own inset and line up at 18 px, and a
     view that opens on a band starts flush under the bar (the one head contract). */
  @media (max-width: 767.98px) {
    .guild-main :global(.ui-page) {
      padding-inline: 0;
    }
    :global(.guild-main:has(.ui-band)) {
      padding-top: 0;
    }
  }
</style>
