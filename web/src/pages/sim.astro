---
// web/src/pages/sim.astro
// Static. The island reads ?source=, ?ref= and ?code= in the browser, because the page is
// prerendered and has no request to read. The shell is the signed-out landing itself
// (SimLandingPage, spec 2026-11-06-sim §4.2): the head, the paste Plate and the best-in-slot rail
// render here as the first paint and the LCP, and the island mounts the same component over them,
// so hydration moves nothing for a cold visitor. The rail's links are build-time data
// (lib/sim/bis-set-rail.ts) handed to the island on the mount.
import activeBuild from '../data/active-build.json';
import Base from '../layouts/Base.astro';
import IslandScript from '../components/IslandScript.astro';
import SimLandingPage from '../components/sim/SimLandingPage.svelte';
import { loadBisSetRail } from '../lib/sim/bis-set-rail';
import { searchCopy } from '../lib/search-copy';
import { webApplicationLd } from '../lib/seo';

const bisSets = loadBisSetRail(activeBuild.build);
const jsonLd = [
  webApplicationLd({
    name: searchCopy.sim.appName,
    description: searchCopy.sim.description,
    path: '/sim',
    category: 'GameApplication',
  }),
];
---

<Base title={searchCopy.sim.title} description={searchCopy.sim.description} path="/sim" {jsonLd} wide>
  <link rel="stylesheet" href="/sim-island.css" slot="head" />
  <main id="main" tabindex="-1" class="sim-page">
    <div id="sim" data-sim-mount data-bis-sets={JSON.stringify(bisSets)}>
      <SimLandingPage bisSets={bisSets} />
      <noscript>
        <p class="text-muted px-[18px] text-[14px] md:px-0">
          The simulator needs JavaScript: it runs the engine in your browser rather than on our servers. The{' '}
          <a href="/planner">build planner</a> works without it.
        </p>
      </noscript>
    </div>
    <IslandScript src="/sim-island.js" />
  </main>
</Base>

<style>
  .sim-page {
    padding-bottom: 40px;
  }
</style>
