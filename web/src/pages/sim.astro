---
// web/src/pages/sim.astro
// Static. The island reads ?source= and ?ref= in the browser, because the page is
// prerendered and has no request to read.
import Base from '../layouts/Base.astro';
import { CHIP_HEIGHT, VIEW_GAP } from '../lib/current-character-layout';
import { simCopy } from '../lib/sim/copy';
import { landingCopy } from '../lib/sim/landing-copy';
import SimTabs from '../components/sim/SimTabs.astro';
import ExampleResultCard from '../components/sim/ExampleResultCard.svelte';
---

<Base
  title="Simulator"
  description="Simulate a World of Warcraft: Forever character: what your DPS is and why, free and in your own browser."
  path="/sim"
  session
>
  <link rel="stylesheet" href="/sim-island.css" slot="head" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <SimTabs currentPath="/sim" />
    <h1 class="section-title px-[18px] text-[18px] md:px-0">Simulator</h1>
    <!-- Round 2 (Lighthouse), 2026-09-26 layout pass update: the signed-out default view's
         own largest early text used to be SourceSwitcher's addon-card body; the layout
         review promotes the Battle.net sign-in to a full-width hero ahead of that card
         (Finding 2), with an intro line and a static example result above it (Finding 5),
         so those are what now paints first for a signed-out visitor and what this shell
         reproduces ahead of hydration. `ExampleResultCard` is rendered here with no
         `client:*` directive -- static, prerendered markup, identical to what the island
         renders, with no risk of the two drifting apart the way two hand-copied strings
         could. The hero card's own heading and two lines mirror
         `SourceSwitcher.svelte`'s hero branch exactly (same classes, same copy) for the
         same reason the original trick nested its paragraph in the real card's own markup:
         an identical wrap width keeps the box pixel-stable across hydration. The button and
         email-link line are not reproduced here -- they add height but not width, so they
         do not change which text box is largest/earliest; the min-h reservation below still
         covers their full height as part of the real measurement.

         sim-island.ts's replaceChildren() swaps this whole div's content for the real,
         interactive switcher, so the min-h reservation below (measured against the real
         hydrated height, mobile/desktop) keeps that swap from moving the footer -- the same
         reserved-height technique SpecGrid.svelte's skeleton already uses for the same
         reason.

         The chip slot's own reserved band (Task 5, the same gear.astro pattern) sits first,
         above this block, identically in both this shell and SimView.svelte's own render,
         wrapped together in `flex flex-col ${VIEW_GAP}` (fix round 1, Important #2) so the
         vertical gap between them matches the hydrated root's own gap too.

         2026-09-26 re-measure: with the intro line, example card and hero card all added
         ahead of the three paste cards for a signed-out visitor, a real Chromium
         build+preview (`[data-sim-mount]`'s `getBoundingClientRect().height` after zeroing
         its own `min-height`) measured 1384px at 390x844 (phone) and 795px at desktop
         widths (>=768px) for the signed-out default view -- both up from the pre-pass
         1154/620 figures, since the page now says more before the fold. Reserved 24px over
         each (lane-common's own CI-Linux-fonts-wrap-wider buffer): 1408/819. -->
    <div id="sim" data-sim-mount class="min-h-[1408px] md:min-h-[819px]">
      <div class={`flex flex-col ${VIEW_GAP}`}>
        <div class={CHIP_HEIGHT} data-testid="current-character-bar"></div>
        <section class="mx-[18px] flex flex-col gap-3 md:mx-0">
          <p class="text-muted text-[14px]">{landingCopy.introLine}</p>
          <ExampleResultCard />
          <div class="border-line bg-card-top rounded-panel flex flex-col gap-3 border p-4">
            <h2 class="section-title text-[15px]">{simCopy.sourceAccountTitle}</h2>
            <p class="text-muted text-[13px]">{landingCopy.scopeCaveat}</p>
            <p class="text-muted text-[13px]">{simCopy.signInToFindCharacters}</p>
          </div>
        </section>
      </div>
      <noscript>
        <p class="text-muted px-[18px] text-[14px] md:px-0">
          The simulator needs JavaScript: it runs the engine in your browser rather than on our servers. The{' '}
          <a href="/planner">build planner</a> works without it.
        </p>
      </noscript>
    </div>
    <script type="module" src="/sim-island.js"></script>
  </main>
</Base>
