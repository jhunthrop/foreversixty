---
// web/src/pages/character/[...path].astro
// Fixture-only, like the report and rankings fixture pages: one character Playwright can
// reach without a Worker. A real build prerenders none.
import Base from '../../layouts/Base.astro';
import Character from '../../components/Character.svelte';
import CharacterNoScript from '../../components/character/CharacterNoScript.astro';
import { fixtureCharacterPaths } from '../../lib/report/shell-paths';

export function getStaticPaths() {
  return fixtureCharacterPaths();
}

const { path } = Astro.params;
---

<Base
  title="Character"
  description="A World of Warcraft: Forever character: the gear they wear and the upgrades waiting, their Forever Score, best fights and builds."
  path={`/character/${path}`}
>
  <main id="main" tabindex="-1" class="pb-(--section-gap)">
    <Character client:load />
    <CharacterNoScript />
  </main>
</Base>
