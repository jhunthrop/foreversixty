---
// web/src/pages/logs.astro
// Rebuilt to the logs landing spec (design/specs/2026-10-04-logs-landing.md). The page
// leads with a real report -- the visitor's own newest when they have one, the site's one
// labelled sample otherwise -- in a full-bleed header band (`LogsHeroBand`, §4.A), never a
// plain "Logs" title. The spine (`CurrentCharacterBar`, §4.B) and the dungeon-framing
// sentence follow directly under the band, then the two report lists (§4.C), then the two
// ways in (§4.D): live logging through the companion, or a whole-file upload.
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
import CompanionStatus from '../components/CompanionStatus.svelte';
import CurrentCharacterBar from '../components/CurrentCharacterBar.svelte';
import LogsHeroBand from '../components/LogsHeroBand.svelte';
import Panel from '../components/Panel.astro';
import RecentReports from '../components/RecentReports.svelte';
import { RECENT_REPORTS_PRELOAD } from '../lib/reports/recent';
import Upload from '../components/Upload.svelte';
import { logsCompanionCopy, logsFraming } from '../lib/reports/copy';

const block = 'flex flex-col gap-3 p-4 md:p-5';
const blockTitle = 'label text-muted';
---

<Base
  title="Logs"
  description="Upload a World of Warcraft: Forever combat log, or log live with the Forever Sixty companion."
  path="/logs"
>
  <main id="main" tabindex="-1" class="flex flex-col gap-[22px] pb-10 md:gap-8">
    <!-- §4.A: mounted client:idle -- this region sits above the fold and names the page's
         LCP candidate (the h1), so hydration must not gate first paint on anything the
         server markup does not already carry. -->
    <LogsHeroBand client:idle />

    <div class="flex flex-col gap-[22px] px-[18px] md:gap-8 md:px-0">
      <CurrentCharacterBar client:idle spine />

      <!-- Designer ruling, logs mock review (2026-10-04): the dungeon-framing sentence
           sits directly under the spine on every viewport, before "Your reports". -->
      <p class="text-muted max-w-[720px] text-[14px] leading-relaxed" data-testid="logs-framing">
        {logsFraming}
      </p>

      <!-- The two report lists first, side by side at lg: a raid leader mostly comes back
           to read logs, not to set logging up. The two ways in follow. -->
      <div class="grid grid-cols-1 items-start gap-[22px] md:gap-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Panel title="Your reports">
            <div class="p-4 md:p-5">
              <Account client:visible mode="reports" />
            </div>
          </Panel>
        </div>
        <div class="lg:col-span-5">
          <Panel title="Recent public reports">
            <div class="p-4 md:p-5">
              <RecentReports client:visible={{ rootMargin: RECENT_REPORTS_PRELOAD }} heading={false} />
            </div>
          </Panel>
        </div>
      </div>

      <div class="grid grid-cols-1 items-start gap-[22px] md:gap-8 lg:grid-cols-12">
        <div id="companion" class="scroll-mt-6 lg:col-span-7">
          <Panel title="The companion">
            <span slot="aside" class="text-muted text-[13px]">
              Live, while you raid
            </span>
            <div class={block}>
              <!-- §4.D.1: above the pointer line, signed in with devices only. -->
              <CompanionStatus client:load />
              <p class="text-muted text-[13px]" data-testid="logs-companion-pointer">
                {logsCompanionCopy.pointer}{' '}
                <a class="text-nav underline" href="/setup">
                  {logsCompanionCopy.pointerLink}
                </a>
              </p>
            </div>
            <div class={`${block} border-line-soft border-t`}>
              <h3 class={blockTitle}>Pair it with your account</h3>
              <Account client:load mode="pairing" />
            </div>
          </Panel>
        </div>

        <div id="upload" class="scroll-mt-6 lg:col-span-5">
          <Panel title="Upload a log">
            <span slot="aside" class="text-muted text-[13px]">
              For a night already logged
            </span>
            <Upload client:load />
          </Panel>
        </div>
      </div>
    </div>
  </main>
</Base>
