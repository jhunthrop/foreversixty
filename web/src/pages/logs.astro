---
// web/src/pages/logs.astro
// The logs landing (design/specs/2026-11-07-logs-reports.md section 4): one job, "upload a log,
// or open one, and read it". The whole page is one island (components/logs/LogsPage.svelte),
// because its head's answer, its one Plate and its rail all follow one session read and one
// list read; the server markup is the signed-out page.
import Base from '../layouts/Base.astro';
import LogsPage from '../components/logs/LogsPage.svelte';
---

<Base
  title="Logs"
  description="Upload a World of Warcraft: Forever combat log, or log live with the Forever Sixty companion."
  path="/logs"
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col" data-testid="logs-page">
    <LogsPage client:load />
  </main>
</Base>
