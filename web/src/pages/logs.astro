---
// web/src/pages/logs.astro
// Where a raid leader starts. Two ways in, said first and said apart: live logging through
// the companion is the primary path, and the whole-file upload is the fallback for a night
// that was already logged. Every block is one of the site's own containers (ToolCard,
// Panel); the islands inside them are unchanged in behaviour.
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
import CurrentCharacterBar from '../components/CurrentCharacterBar.svelte';
import Panel from '../components/Panel.astro';
import RecentReports from '../components/RecentReports.svelte';
import { RECENT_REPORTS_PRELOAD } from '../lib/reports/recent';
import ToolCard from '../components/ToolCard.astro';
import Upload from '../components/Upload.svelte';
import { logsCompanionCopy, logsFraming } from '../lib/reports/copy';

/** 24px grid, 2px stroke, round caps: design/DESIGN-SYSTEM.md "Icons". */
const ICON_ATTRS = {
  width: 22,
  height: 22,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 2,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
} as const;

const entries = [
  {
    href: '#companion',
    title: 'Log live with the companion',
    description:
      'A small desktop app watches the combat log while you raid. Each fight is on the site within three seconds of ending.',
    // A pulse: something that is happening now.
    icon: '<path d="M3 12h4l3-8 4 16 3-8h4"/>',
  },
  {
    href: '#upload',
    title: 'Upload a log file',
    description:
      'A whole WoWCombatLog.txt from a night you already recorded. The way in when the companion was not running.',
    icon: '<path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>',
  },
];

const block = 'flex flex-col gap-3 p-4 md:p-5';
const blockTitle = 'label text-muted';
---

<Base
  title="Logs"
  description="Upload a World of Warcraft: Forever combat log, or log live with the Forever Sixty companion."
  path="/logs"
  session
>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <CurrentCharacterBar client:idle spine />

    <Panel title="Your reports">
      <div class="p-4 md:p-5">
        <Account client:visible mode="reports" />
      </div>
    </Panel>

    <header class="flex flex-col gap-2">
      <h1 class="section-title text-[18px]">Logs</h1>
      <p class="text-muted max-w-[720px] text-[14px] leading-relaxed">
        Every pull your raid logs, broken down and ranked: damage, healing, deaths, buffs, casts and threat,
        fight by fight. There are two ways to get a log in.
      </p>
      <p class="text-muted max-w-[720px] text-[14px] leading-relaxed" data-testid="logs-framing">
        {logsFraming}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2" data-testid="logs-entries">
      {entries.map((entry) => (
        <ToolCard title={entry.title} description={entry.description} href={entry.href}>
          <svg slot="icon" {...ICON_ATTRS} set:html={entry.icon} />
        </ToolCard>
      ))}
    </div>

    <div class="grid grid-cols-12 items-start gap-[22px] md:gap-8">
      <div id="companion" class="col-span-12 scroll-mt-6 lg:col-span-7">
        <Panel title="The companion">
          <div class={block}>
            <p class="text-muted text-[13px]" data-testid="logs-companion-pointer">
              <!-- Final-review fix (states lane, Finding 5): `pointer` is already a complete
                   sentence ending in its own period; the trailing "." this paragraph used to
                   append after the link turned "Get set up" into what read as a second,
                   overlapping sentence. Dropped, matching EmptyState's own convention
                   elsewhere on this site: one sentence, then a standalone action label with
                   no punctuation of its own. -->
              {logsCompanionCopy.pointer}{' '}
              <a class="text-nav underline" href="/setup">
                {logsCompanionCopy.pointerLink}
              </a>
            </p>
          </div>
          <div class={`${block} border-line-soft border-t`}>
            <h3 class={blockTitle}>Pair it with your account</h3>
            <Account client:load mode="pairing" />
          </div>
        </Panel>
      </div>

      <div id="upload" class="col-span-12 scroll-mt-6 lg:col-span-5">
        <Panel title="Upload a log">
          <span slot="aside" class="text-muted text-[13px]">
            For a night already logged
          </span>
          <Upload client:load />
        </Panel>
      </div>
    </div>

    <Panel title="Recent public reports">
      <div class="p-4 md:p-5">
        <RecentReports client:visible={{ rootMargin: RECENT_REPORTS_PRELOAD }} heading={false} />
      </div>
    </Panel>
  </main>
</Base>
