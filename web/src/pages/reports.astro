---
// web/src/pages/reports.astro
// "Your reports", the Logs menu's second row: every report the visitor owns, newest first. The
// head is static; the card under it is one island, because all three of its states (signed out,
// no logs yet, the list) follow one session read. /reports/<id> is a different page: the Worker
// serves report-shell.astro for it.
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import YourReports from '../components/logs/YourReports.svelte';
import { yourReportsPageCopy as copy } from '../lib/reports/my-reports-copy';
---

<Base
  title="Your reports"
  description="Every World of Warcraft: Forever combat log you uploaded or streamed, newest first."
  path="/reports"
>
  <main
    id="main"
    tabindex="-1"
    class="flex flex-col gap-[22px] px-[var(--page-inset)] pt-4 pb-10 md:gap-8 md:pt-7"
    data-testid="reports-page"
  >
    <PageHead eyebrow={copy.eyebrow} title={copy.title} job={copy.job} />
    <YourReports client:load />
  </main>
</Base>
