---
import { REPORT_SKELETON_HTML } from '../lib/report/skeleton';
// web/src/pages/reports.astro
// The report shell. src/worker.ts serves this file's output for /reports/<any id>, with
// the head values rewritten from GET /v1/reports/{id}. It carries no report data: the
// island reads the id out of the path and fetches the rest.
import Base from '../layouts/Base.astro';
---

<Base
  title="Report"
  description="A World of Warcraft: Forever combat log report: fights, damage, healing, deaths and rankings."
  path="/reports"
>
  <link rel="stylesheet" href="/report-island.css" slot="head" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <!-- The Worker serves this page as the shell for every /reports/<id>, so before the
         island boots it shows the report's skeleton; only a browser with no JavaScript
         reads the line about nothing being open. -->
    <div id="report" data-report-mount>
      <Fragment set:html={REPORT_SKELETON_HTML} />
      <noscript>
        <p class="text-muted px-[18px] text-[14px] md:px-0">
          No report is open. Upload a log or start the companion from <a href="/logs">Logs</a>.
        </p>
      </noscript>
    </div>
    <script type="module" src="/report-island.js"></script>
  </main>
</Base>
