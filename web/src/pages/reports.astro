---
// web/src/pages/reports.astro
// "Your reports", the Logs menu's second row (design/specs/2026-11-07-logs-reports.md section
// 5): every report the visitor owns, newest first. One island (components/logs/YourReports.svelte),
// because the head's count and action and the Plate's states all follow one session read.
// /reports/<id> is a different page: the Worker serves report-shell.astro for it.
import Base from '../layouts/Base.astro';
import YourReports from '../components/logs/YourReports.svelte';
---

<Base
  title="Your reports"
  description="Every World of Warcraft: Forever combat log you uploaded or streamed, newest first."
  path="/reports"
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col pb-10" data-testid="reports-page">
    <YourReports client:load />
  </main>
</Base>
