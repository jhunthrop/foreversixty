---
// web/src/pages/guides/[class]/index.astro
// The class landing (directions mock b2-guide-class, round 5): the title band (the crest, the
// class name in its colour, the Updated stamp, the signed-in answer), the identity line on the
// ground, a panel per spec (a link Row: icon, name, its one line, Read the guide ›; the header
// character's spec marked after load), then What changed from 1.12 and the Sources on their
// panels, with the Races and the raid or leveling notes boxed in the rail. index.md is split by
// its fixed heading vocabulary (class-landing.ts).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ClassCrest from '../../../components/ClassCrest.astro';
import GuideAnswer from '../../../components/guides/GuideAnswer.astro';
import GuideLede from '../../../components/guides/GuideLede.astro';
import GuideRaceList from '../../../components/guides/GuideRaceList.astro';
import GuideSources from '../../../components/guides/GuideSources.astro';
import GuideSpecRow from '../../../components/guides/GuideSpecRow.astro';
import Page from '../../../components/ui/Page.svelte';
import PageHeader from '../../../components/ui/PageHeader.svelte';
import Plate from '../../../components/ui/Plate.svelte';
import Prose from '../../../components/ui/Prose.svelte';
import Section from '../../../components/ui/Section.svelte';
import classes from '../../../data/classes.json';
import activeBuild from '../../../data/active-build.json';
import { articleLd, breadcrumbListLd } from '../../../lib/seo';
import { searchCopy } from '../../../lib/search-copy';
import type { ClassSlug } from '../../../lib/ui/primitives';
import { guidesCopy } from '../../../lib/guides/copy';
import {
  CLASS_LANDING_PANELS,
  cardLineFor,
  proseLabels,
  splitClassLanding,
} from '../../../lib/guides/class-landing';
import { dayMonth } from '../../../lib/guides/guide-header';
import { renderGuideMarkdown } from '../../../lib/guides/markdown';
import { slugify } from '../../../lib/guides/sections';
import { readSpecCatalog } from '../../../lib/bis/load';
import { dataUrl } from '../../../lib/planner/load';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.spec === undefined)
    .map((entry) => ({
      params: { class: entry.id.split('/')[0]! },
      props: {
        entry,
        specGuides: guides.filter(
          (g) => g.data.classSlug === entry.data.classSlug && g.data.spec !== undefined,
        ),
      },
    }));
}
const { entry, specGuides } = Astro.props;
const build = activeBuild.build;
const classSlug = entry.data.classSlug;
const classEntry = classes.find((c) => c.slug === classSlug);
if (classEntry === undefined) throw new Error(`guides/${classSlug}: not in classes.json`);

const landing = splitClassLanding(entry.body ?? '', `guides/${classSlug}/index.md`);
const sections = await Promise.all(
  landing.sections.map(async (section) => ({
    ...section,
    id: slugify(section.heading),
    html: proseLabels(await renderGuideMarkdown(section.markdown)),
  })),
);
const mainSections = sections.filter((s) => !CLASS_LANDING_PANELS.includes(s.heading));
const railSections = sections.filter((s) => CLASS_LANDING_PANELS.includes(s.heading));

// Tree order (`tree_index` ascending), the order the talent frame shows.
const specGuideBySlug = new Map(specGuides.map((g) => [g.data.spec, g]));
const specs = readSpecCatalog()
  .filter((s) => s.class_slug === classSlug)
  .sort((a, b) => a.tree_index - b.tree_index)
  .flatMap((s) => {
    const guide = specGuideBySlug.get(s.spec_slug);
    if (guide === undefined || guide.data.role === undefined) return [];
    return [
      {
        key: `${classSlug}/${s.spec_slug}`,
        name: s.name,
        line: cardLineFor(guide.body ?? '', `guides/${guide.id}.md`),
        icon: dataUrl(build, `icons/${s.icon}.webp`),
        href: `/guides/${classSlug}/${s.spec_slug}`,
      },
    ];
  });
if (specs.length === 0) throw new Error(`guides/${classSlug}: no spec guide to link`);
const path = `/guides/${classSlug}`;
const description = entry.data.description ?? '';
const jsonLd = [
  articleLd({ title: entry.data.title, description, path, updated: entry.data.updated }),
  breadcrumbListLd([
    { name: 'Class guides', path: '/guides' },
    { name: classEntry.name, path },
  ]),
];
const tone = { classSlug: classSlug as ClassSlug };
---

<Base title={searchCopy.classGuideTitle(classEntry.name)} {description} {path} {jsonLd} wide>
  <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />
  <main id="main" tabindex="-1" class="guide-landing" data-testid="guide-class-landing">
    <Page layout="ledger">
      <PageHeader slot="header" title={classEntry.name} tone={tone}>
        <ClassCrest slot="crest" slug={classSlug} size={56} priority />
        <span slot="meta">Updated {dayMonth(entry.data.updated)}</span>
        <GuideAnswer slot="answer" page={{ classSlug }} />
      </PageHeader>
      <div class="guide-landing-top">
        <GuideLede text={landing.identity} testid="guide-class-identity" />
        <div
          class="guide-landing-specs"
          role="region"
          aria-label={guidesCopy.classLandingSpecsHeading}
          data-testid="guide-class-spec-cards"
          style={`--specs: ${specs.length}`}
        >
          {specs.map((spec) => (
            <Plate>
              <GuideSpecRow
                specKey={spec.key}
                name={spec.name}
                href={spec.href}
                icon={spec.icon}
                iconSize={40}
                tone={tone}
                sub={spec.line}
                foot={`${guidesCopy.readTheGuide} ›`}
              />
            </Plate>
          ))}
        </div>
      </div>
    </Page>
    <Page layout="split">
      {mainSections.map((section) => (
        <Section title={section.heading} anchor={section.id} boxed testid={`class-landing-${section.id}`}>
          <Prose html={section.html} />
        </Section>
      ))}
      <GuideSources sources={entry.data.sources} />
      <Fragment slot="rail">
        {railSections.map((section) => (
          <Section title={section.heading} anchor={section.id} boxed testid={`class-landing-${section.id}`}>
            {section.heading === 'Races' && <GuideRaceList build={build} classSlug={classSlug} />}
            <Prose html={section.html} mods={['lane']} />
          </Section>
        ))}
      </Fragment>
    </Page>
  </main>
</Base>

<style>
  .guide-landing {
    padding-bottom: 40px;
  }
  .guide-landing-top {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .guide-landing-specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  @media (min-width: 1024px) {
    .guide-landing-specs {
      grid-template-columns: repeat(var(--specs), minmax(0, 1fr));
    }
  }
</style>
