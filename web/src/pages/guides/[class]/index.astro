---
// web/src/pages/guides/[class]/index.astro
// The class landing page: content/guides/<class>/index.md, id `<class>/index`. Links out to
// every spec guide for the class (content/guides/<class>/<spec>.md).
import { getCollection, render } from 'astro:content';
import Content from '../../../layouts/Content.astro';
import { plannerHref } from '../../../lib/planner/reference';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const landings = guides.filter((g) => g.data.spec === undefined);
  return landings.map((entry) => {
    const classSlug = entry.id.split('/')[0];
    const specGuides = guides
      .filter((g) => g.data.classSlug === entry.data.classSlug && g.data.spec !== undefined)
      .sort((a, b) => a.data.title.localeCompare(b.data.title));
    return { params: { class: classSlug }, props: { entry, specGuides } };
  });
}
const { entry, specGuides } = Astro.props;
const { Content: Body } = await render(entry);
---

<Content
  title={entry.data.title}
  description={entry.data.description}
  path={`/guides/${entry.data.classSlug}`}
  updated={entry.data.updated}
  confidence={entry.data.confidence}
  sources={entry.data.sources}
  confidencePlacement="footer"
>
  <p>
    <a href={plannerHref(entry.data.classSlug)}>Open the planner for this class</a>
  </p>
  <Body />
  {specGuides.length > 0 && (
    <nav aria-label="Spec guides" class="flex flex-col gap-2">
      <h2 class="section-title text-[14px]">Spec guides</h2>
      <ul class="flex flex-col gap-1 list-none p-0 m-0">
        {specGuides.map((spec) => (
          <li>
            <a href={`/guides/${spec.id}`}>{spec.data.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Content>
