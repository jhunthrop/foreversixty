---
// web/src/pages/guides/[class]/[spec].astro
// Rebuild (spec 2026-10-04, §4.C/§4.D): the plain `<h1>` title with no class identity
// (spec §3's own "Replaced" list) becomes the full `ArtPanel`+`ClassHeader` band, matching
// `/bis`, with the new `GuideActionRail` (Build/Rotation/Stat priority, §4.C) directly
// under it, inside the same `ArtPanel`. The nine-section structure (SPEC_SECTIONS) still
// renders in its existing fixed order with the same jump-list table of contents, boxed at
// the top on narrow screens and a sticky rail beside the article at lg (Content's aside
// slot); the Leveling section gains a planted component, `GuideLevelingTree` (the leveling
// tree, design/specs/2026-11-04-leveling-tree.md), the same planting convention `proseOnly` already uses for Stat
// priority and Races. No MDX is installed in this project, so a markdown file cannot embed
// a component directly -- splitSpecSections/renderGuideMarkdown (lib/guides/) render each
// of the nine sections independently instead of the whole body as one `<Body />`, which is
// what makes planting possible while every heading keeps its exact id.
//
// W.18 (22 Oct 2026): the page reads like a class guide. Every block that has icons, tables or
// ranks is built from the build data and the BiS ranker (lib/guides/*), never typed per guide;
// the Markdown keeps the prose. The sections, in order: Overview (strengths, weaknesses, in a
// raid), Talents and builds (trees, the raid-build diff, key talents), Rotation and priority
// (opener, priority, cooldowns), Stat priority, Best in slot (the /bis picks per level range),
// Enchants and consumables, Races (pills and a table), Professions, Leveling. One status note
// at the top says once what is simulated, so the sections do not hedge.
import { getCollection } from 'astro:content';
import ArtPanel from '../../../components/ArtPanel.astro';
import ClassHeader, { type SpecTabEntry } from '../../../components/ClassHeader.astro';
import GuideActionRail from '../../../components/guides/GuideActionRail.astro';
import GuideBisTable from '../../../components/guides/GuideBisTable.astro';
import GuideBuilds from '../../../components/guides/GuideBuilds.astro';
import GuideGearExtras from '../../../components/guides/GuideGearExtras.astro';
import GuideOverview from '../../../components/guides/GuideOverview.astro';
import GuideStatTable from '../../../components/guides/GuideStatTable.astro';
import KeyTalentList from '../../../components/guides/KeyTalentList.astro';
import GuideLevelingTree from '../../../components/guides/GuideLevelingTree.svelte';
import RacePillRow from '../../../components/guides/RacePillRow.astro';
import RaceTable from '../../../components/guides/RaceTable.astro';
import RotationLists from '../../../components/guides/RotationLists.astro';
import GlyphSheet from '../../../components/bis/GlyphSheet.astro';
import StatPriorityPills from '../../../components/guides/StatPriorityPills.astro';
import SpecTableOfContents from '../../../components/SpecTableOfContents.astro';
import Content from '../../../layouts/Content.astro';
import classes from '../../../data/classes.json';
import activeBuild from '../../../data/active-build.json';
import { readSpecCatalog } from '../../../lib/bis/load';
import { bandTopLevel } from '../../../lib/bis/rotation-view';
import { decodeBuildTrees } from '../../../lib/guides/build-tree';
import { describedBuildTrees, guideRotation } from '../../../lib/guides/guide-rotation';
import { band60Weights, rankedBisFile } from '../../../lib/guides/class-dps';
import { guidesCopy } from '../../../lib/guides/copy';
import { renderGuideMarkdown } from '../../../lib/guides/markdown';
import { railStatRows, rankedStatLabels } from '../../../lib/guides/rail-stats';
import { splitSpecSections, type SpecSection } from '../../../lib/guides/sections';
import { diffBuilds, buildDiffLine } from '../../../lib/guides/build-diff';
import { guideTipsUrl, proseNames, specGuideData, withTipKeys } from '../../../lib/guides/guide-tips';
import { linkProse } from '../../../lib/guides/prose-tips';
import GuideTooltips from '../../../components/guides/GuideTooltips.svelte';
import { pageScript } from '../../../lib/guides/page-script';
import { dayMonth, pageUpdatedAt } from '../../../lib/guides/guide-header';
import { guideLadderSteps } from '../../../lib/guides/leveling-builds';
import { keyTalentsFor, withoutTalentBullets } from '../../../lib/guides/key-talents';
import { splitOverview } from '../../../lib/guides/overview';
import { raceTableFor, specKindOf } from '../../../lib/guides/race-table';
import {
  litTalentsOf,
  markRaidBuildRows,
  raidBuildOnlyTalents,
  talentNamesOf,
} from '../../../lib/guides/rotation-lists';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const specGuides = guides.filter((g) => g.data.spec !== undefined);
  return specGuides.map((entry) => {
    const [classSlug, spec] = entry.id.split('/');
    return { params: { class: classSlug, spec }, props: { entry } };
  });
}

const { entry } = Astro.props;
// entry.body is the collection entry's own raw markdown source (the same field
// _sections.test.ts reads off disk directly); if `astro check` reports it missing from the
// public CollectionEntry<'guides'> type in this Astro version, fall back to
// `(entry as unknown as { body?: string }).body ?? ''` with a one-line comment saying why,
// rather than switching to a different data source -- the raw body is what splitSpecSections
// is built to consume, and it must be byte-identical to what _sections.test.ts validates.
const sections = splitSpecSections(entry.body ?? '');

/** A section's raw markdown, minus its own `## Heading` line -- for the sections that plant
 *  a component between the heading and the guide's own prose. */
function proseOnly(section: SpecSection): string {
  const raw = sections.get(section) ?? '';
  const [, ...rest] = raw.split('\n');
  return rest.join('\n').replace(/^\n+/, '');
}

/** The heading the leveling tree is planted above; the Levels 1 to 19 prose before it stays above the tree. */
const LEVELING_STRIP_HEADING = /^### Levels 20 to 60\s*$/m;

/**
 * Splits the Leveling prose at the Levels 20 to 60 heading: [prose above it, its heading, prose
 * below it]. The leveling tree goes between the first two. Without the heading the tree opens
 * the section.
 */
function splitAtLevelingStrip(markdown: string): [string, string, string] {
  const match = LEVELING_STRIP_HEADING.exec(markdown);
  if (match === null) return ['', '', markdown];
  const after = match.index + match[0].length;
  return [markdown.slice(0, match.index), match[0], markdown.slice(after)];
}

const buildCode = entry.data.build;
const build = activeBuild.build;
const classSlug = entry.data.classSlug;
const specSlug = entry.id.split('/')[1]!;
const fullSpecId = `${classSlug}-${specSlug}`;
const className = classes.find((c) => c.slug === classSlug)?.name ?? classSlug;
const role = entry.data.role ?? 'dps';

// Tooltips: the guide's gear and its tooltip bundle in one read (lib/guides/guide-tips.ts).
// Every talent, spell, racial, enchant and item the page names opens the game's tooltip; the
// bundle is published beside the page and fetched on the first hover, focus or tap.
const {
  bis: guideBis,
  extras: gearExtras,
  bundle: tipBundle,
} = specGuideData(build, classSlug, fullSpecId, entry.data.recommendedRaces);

// Talents: both builds decoded for the key-talent icons and the raid-build diff.
const buildTrees = buildCode === undefined ? [] : (decodeBuildTrees(build, buildCode) ?? []);
const raidCode = entry.data.raidBuild;
const raidTrees =
  raidCode === undefined || raidCode === buildCode ? undefined : decodeBuildTrees(build, raidCode);

// The prose's names, marked from the client data: a talent at the guide's raid build rank.
const proseTargets = proseNames(build, classSlug, raidTrees ?? buildTrees, tipBundle);
async function prose(markdown: string): Promise<string> {
  return linkProse(await renderGuideMarkdown(markdown), proseTargets);
}

// Overview: a summary sentence (the header's) and three bullet blocks.
const overview = splitOverview(sections.get('Overview') ?? '');
const hasOverviewBlocks = overview.strengths !== '' || overview.weaknesses !== '' || overview.raid !== '';
const overviewHeadingHtml = await renderGuideMarkdown('## Overview');
const overviewFallbackHtml = hasOverviewBlocks ? '' : await prose(proseOnly('Overview'));
const strengthsHtml = await prose(overview.strengths);
const weaknessesHtml = await prose(overview.weaknesses);
const raidHtml = await prose(overview.raid);

// SpecTabs: every spec of this class, in the talent tree's own left-to-right order --
// identical convention `/bis`'s own header already uses.
const catalogEntries = readSpecCatalog()
  .filter((s) => s.class_slug === classSlug)
  .sort((a, b) => a.tree_index - b.tree_index);
const specTabs: SpecTabEntry[] = catalogEntries.map((s) => ({
  specSlug: s.spec_slug,
  name: s.name,
  icon: s.icon,
  href: `/guides/${classSlug}/${s.spec_slug}`,
  active: s.spec_slug === specSlug,
}));
const specName = catalogEntries.find((s) => s.spec_slug === specSlug)?.name ?? specSlug;
const specIcon = specTabs.find((tab) => tab.active)?.icon;

const raidDiffLine =
  raidTrees === undefined || buildTrees.length === 0
    ? undefined
    : buildDiffLine(diffBuilds(buildTrees, raidTrees));
const talentsHeadingHtml = await renderGuideMarkdown('## Talents and builds');
const keyTalents = keyTalentsFor(
  proseOnly('Talents and builds'),
  buildTrees.length > 0 ? buildTrees : undefined,
  raidTrees,
);
const talentsProseHtml = await prose(withoutTalentBullets(proseOnly('Talents and builds')));

// The build the level 60 sections describe (the rail, the key talents' ranks, the rotation
// cards): the raid build when the guide has its own, else the level 60 build.
const describedTrees = describedBuildTrees(buildTrees, raidTrees);
const describedCode = raidTrees === undefined ? buildCode : raidCode;

// Rail: Rotation card's first four level-60 lines (spec §4.C.2) -- the card is omitted
// entirely when no rotation entry applies yet (spec §5's own state table), never a card
// with zero lines standing in for "no data". The Rotation section's lists read the same lines.
const rotationBandLabel = String(bandTopLevel(60));
const rotationListsUnkeyed = guideRotation(build, classSlug, fullSpecId, role, describedTrees);
// The lists follow the raid build's level 60 priority; a talent only the raid build takes is
// marked in them, so a player on the level 60 build knows to skip that row.
const raidOnlyTalents =
  raidTrees === undefined
    ? new Set<string>()
    : raidBuildOnlyTalents(
        talentNamesOf(build, classSlug),
        litTalentsOf(buildTrees),
        litTalentsOf(raidTrees),
      );
const rotationListsData =
  rotationListsUnkeyed === undefined
    ? undefined
    : withTipKeys(markRaidBuildRows(rotationListsUnkeyed, raidOnlyTalents), tipBundle);
const rotationHeadingHtml = await renderGuideMarkdown('## Rotation and priority');
const rotationProseHtml = await prose(proseOnly('Rotation and priority'));

// Rail: Stat priority card's real per-point numbers read the spec's own band-60 BiS data, at
// the faction the guide's first `recommendedRaces` entry resolves to (the same rule, stated
// once, `class-dps.ts` shares with the class landing's own Set DPS line). `rankedBisFile`
// only ever reads the real pipeline file, never the `/bis` dev fixture.
const ranked = rankedBisFile(build, fullSpecId);
// Same load path `GuideStatTable.astro` uses for the planted Stat priority table below --
// `band60Weights` is the one place this band's weights get read, so the rail card and the
// table can never disagree.
const band60 = band60Weights(build, fullSpecId, classSlug, entry.data.recommendedRaces);
const statRows =
  band60 === undefined ? [] : railStatRows(entry.data.statPriority, band60.weights, fullSpecId, band60.haste);
// The pills rank only the stats the table gives a value, in the table's order; the
// frontmatter list is only the fallback for a spec with no weights yet.
const statPills = rankedStatLabels(statRows, entry.data.statPriority);
const statPriorityHeadingHtml = await renderGuideMarkdown('## Stat priority');
const statPriorityProseHtml = await prose(proseOnly('Stat priority'));

// Best in slot: the /bis picks per level range (guideBis, above), plus the enchant and
// consumable tables that follow the level 60 band's weights (gearExtras).
const bisHref = `/bis/${classSlug}/${specSlug}`;
const gearHeadingHtml = await renderGuideMarkdown('## Best in slot');
const gearProseHtml = await prose(proseOnly('Best in slot'));
const enchantsHeadingHtml = await renderGuideMarkdown('## Enchants and consumables');
const enchantsProseHtml = await prose(proseOnly('Enchants and consumables'));

// Races: the pills as the summary, the table under them.
const raceRows = raceTableFor(
  build,
  classSlug,
  entry.data.recommendedRaces,
  specKindOf(classSlug, fullSpecId, role),
);
const racesHeadingHtml = await renderGuideMarkdown('## Races');
const racesProse = proseOnly('Races');
const racesProseHtml = await prose(racesProse);
const professionsHtml = await prose(sections.get('Professions') ?? '');

// The leveling tree is the whole journey, 10 to 60: the guide's own level 60 build climbed one
// point a level in the ladder's order (lib/guides/leveling-builds.ts guideLadderSteps), the one
// order the sim, the addon, the planner's band loads and /data/leveling-plans.json read.
const treeIndex = catalogEntries.find((s) => s.spec_slug === specSlug)?.tree_index;
const ladderSteps =
  buildCode === undefined || treeIndex === undefined
    ? []
    : guideLadderSteps(build, classSlug, fullSpecId, treeIndex, buildCode);
const talentsByLevelHeadingHtml = await renderGuideMarkdown(`### ${guidesCopy.talentsByLevel}`);
const levelingHeadingHtml = await renderGuideMarkdown('## Leveling');
// #leveling, the character home's link, opens on the Levels 1 to 19 text a new character needs;
// the tree (its own "Talents by level" heading, 10 to 60) follows it, then Levels 20 to 60.
const [levelingEarlyProse, levelingStripHeading, levelingLateProse] = splitAtLevelingStrip(
  proseOnly('Leveling'),
);
const levelingEarlyHtml = await prose(levelingEarlyProse);
const levelingStripHeadingHtml = await renderGuideMarkdown(levelingStripHeading);
const levelingLateHtml = await prose(levelingLateProse);

const updatedStamp = dayMonth(pageUpdatedAt(entry.data.updated, ranked?.generated_at));
const metaLine = guidesCopy.headerMeta(role, updatedStamp);
---

<Content
  title={entry.data.title}
  description={entry.data.description}
  path={`/guides/${entry.id}`}
  updated={entry.data.updated}
  confidence={entry.data.confidence}
  sources={entry.data.sources}
  confidencePlacement="footer"
  hideHeader
  wideProse
  hideConfidenceNote
  footnote={guidesCopy.dataSourceLine(build)}
  hideSitePill
>
  <Fragment slot="beforeMain">
    <ArtPanel classSlug={classSlug}>
      <ClassHeader
        classSlug={classSlug}
        className={className}
        specName={specName}
        specTabs={specTabs}
        bands={[]}
        build={build}
        minimal
        eyebrow={guidesCopy.eyebrow}
        summaryOverride={overview.summary !== '' ? overview.summary : entry.data.description}
        metaLine={metaLine}
        metaIcon={specIcon}
      />
      {describedCode !== undefined && (
        <div class="guide-rail-wrap">
          <GuideActionRail
            build={build}
            buildCode={describedCode}
            trees={describedTrees}
            isRaidBuild={raidTrees !== undefined}
            rotationBandLabel={rotationBandLabel}
            rotationLines={rotationListsData?.priority.slice(0, 4) ?? []}
            statRows={statRows}
          />
        </div>
      )}
    </ArtPanel>
  </Fragment>
  <SpecTableOfContents />
  <SpecTableOfContents slot="aside" placement="rail" />
  <Fragment set:html={overviewHeadingHtml} />
  {hasOverviewBlocks ? (
    <GuideOverview strengthsHtml={strengthsHtml} weaknessesHtml={weaknessesHtml} raidHtml={raidHtml} />
  ) : (
    <Fragment set:html={overviewFallbackHtml} />
  )}
  <Fragment set:html={talentsHeadingHtml} />
  {buildCode !== undefined && (
    <GuideBuilds levelingCode={buildCode} raidCode={entry.data.raidBuild} raidDiffLine={raidDiffLine} />
  )}
  <KeyTalentList build={build} entries={keyTalents} />
  <Fragment set:html={talentsProseHtml} />
  <Fragment set:html={rotationHeadingHtml} />
  {rotationListsData !== undefined && raidTrees !== undefined && (
    <p class="text-muted" data-testid="guide-rotation-build">
      {guidesCopy.rotationForRaidBuild}
    </p>
  )}
  {rotationListsData !== undefined && <RotationLists build={build} lists={rotationListsData} />}
  <Fragment set:html={rotationProseHtml} />
  <Fragment set:html={statPriorityHeadingHtml} />
  <StatPriorityPills stats={statPills} />
  <GuideStatTable
    build={build}
    spec={fullSpecId}
    classSlug={classSlug}
    recommendedRaces={entry.data.recommendedRaces}
    statPriority={entry.data.statPriority}
  />
  <Fragment set:html={statPriorityProseHtml} />
  <Fragment set:html={gearHeadingHtml} />
  {guideBis !== undefined && (
    <Fragment>
      <GlyphSheet />
      <GuideBisTable build={build} bis={guideBis} bisHref={bisHref} classSlug={classSlug} />
    </Fragment>
  )}
  <Fragment set:html={gearProseHtml} />
  <Fragment set:html={enchantsHeadingHtml} />
  {gearExtras !== undefined && <GuideGearExtras build={build} extras={gearExtras} tips={tipBundle} />}
  <Fragment set:html={enchantsProseHtml} />
  <Fragment set:html={racesHeadingHtml} />
  <RacePillRow
    build={build}
    classSlug={entry.data.classSlug}
    recommendedRaces={entry.data.recommendedRaces}
  />
  <RaceTable build={build} rows={raceRows} tips={tipBundle} prose={racesProse} />
  <Fragment set:html={racesProseHtml} />
  <Fragment set:html={professionsHtml} />
  <Fragment set:html={levelingHeadingHtml} />
  <Fragment set:html={levelingEarlyHtml} />
  {ladderSteps.length > 0 && buildCode !== undefined && (
    <Fragment>
      <Fragment set:html={talentsByLevelHeadingHtml} />
      <p class="leveling-tree-intro">{guidesCopy.levelingTreeIntro}</p>
      <GuideLevelingTree client:visible code={buildCode} spec={fullSpecId} steps={ladderSteps} />
    </Fragment>
  )}
  <Fragment set:html={levelingStripHeadingHtml} />
  <Fragment set:html={levelingLateHtml} />
  <script is:inline set:html={pageScript}></script>
  <GuideTooltips client:idle-after-load build={build} bundleUrl={guideTipsUrl(build, classSlug, specSlug)} />
</Content>

<style>
  .leveling-tree-intro {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--color-nav);
  }
  .guide-rail-wrap {
    padding: 24px var(--page-inset) 28px var(--page-inset);
  }
  @media (max-width: 1023px) {
    .guide-rail-wrap {
      padding: 18px var(--page-inset) 22px var(--page-inset);
    }
  }
</style>

<style is:global>
  /* The body shares the page head's left edge (leftovers lane A): the layout centres a
     `measure-aside` main at its own max width, which put the prose 112 px right of the head at
     1440. The 720 px prose column and the 220 px contents rail keep their widths; the grid just
     fills the page column, so the prose starts where the head starts and the rail sits at the
     column's right edge. */
  main.measure-aside {
    max-width: none;
  }
  /* A name that opens the game tooltip (GuideTooltips.svelte mounts the panel inside it). The
     row and pill hosts keep their own look; a name in the prose reads as a game link: the
     spell or talent in the strong text colour, an item in its quality, both underlined dotted
     so a reader knows it answers a hover, a focus or a tap. */
  .gtip {
    position: relative;
    cursor: help;
  }
  .gtip:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
    border-radius: 3px;
  }
  .prose span.gtip,
  .guide-prose span.gtip,
  p span.gtip,
  li > span.gtip {
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 3px;
  }
  p span.gtip:not(.gtip-item),
  li > span.gtip:not(.gtip-item) {
    color: var(--color-strong);
    font-weight: 500;
  }
  .gtip [role='tooltip'] {
    color: var(--color-text);
    text-decoration: none;
    cursor: default;
  }
</style>
