---
// web/src/pages/guides/[class]/[spec].astro
// A spec guide (directions mock b2-guide-spec, round 5): the title band (the spec and class in
// the class colour, the role and Updated stamp, the signed-in answer), the ControlBar on the band
// (the class's specs, On this page below 1024), the Overview's one sentence on the ground, the
// framed At a glance plate, then the nine sections of SPEC_SECTIONS as ReadingSections on one
// ReadingPanel: the guide's own prose beside the lane its data builds (lib/guides/*, W.18), never
// a word of the guide changed. Sources, the data line, and from 1024 the contents rail. No
// markdown component is embedded: splitSpecSections renders each section on its own, so every
// heading keeps its id.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crest from '../../../components/ui/Crest.astro';
import GuideAnswer from '../../../components/guides/GuideAnswer.astro';
import GuideBisDoll from '../../../components/guides/GuideBisDoll.svelte';
import GuideBisLane from '../../../components/guides/GuideBisLane.astro';
import GuideBuildsLane from '../../../components/guides/GuideBuildsLane.astro';
import GuideExtrasLane from '../../../components/guides/GuideExtrasLane.astro';
import GuideGlance from '../../../components/guides/GuideGlance.astro';
import GuideLevelingTree from '../../../components/guides/GuideLevelingTree.svelte';
import GuideRacesLane from '../../../components/guides/GuideRacesLane.astro';
import GuideRotationLane from '../../../components/guides/GuideRotationLane.astro';
import GuideSources from '../../../components/guides/GuideSources.astro';
import GuideSpecBar from '../../../components/guides/GuideSpecBar.astro';
import GuideStatLane from '../../../components/guides/GuideStatLane.astro';
import GuideTooltips from '../../../components/guides/GuideTooltips.svelte';
import LaneBlock from '../../../components/ui/LaneBlock.svelte';
import Page from '../../../components/ui/Page.svelte';
import PageHeader from '../../../components/ui/PageHeader.svelte';
import Prose from '../../../components/ui/Prose.svelte';
import ReadingPanel from '../../../components/ui/ReadingPanel.svelte';
import ReadingSection from '../../../components/ui/ReadingSection.svelte';
import Toc from '../../../components/ui/Toc.svelte';
import classes from '../../../data/classes.json';
import activeBuild from '../../../data/active-build.json';
import { readSpecCatalog } from '../../../lib/bis/load';
import { articleLd, breadcrumbListLd } from '../../../lib/seo';
import { searchCopy } from '../../../lib/search-copy';
import type { ClassSlug } from '../../../lib/ui/primitives';
import { decodeBuildTrees } from '../../../lib/guides/build-tree';
import { describedBuildTrees, guideRotation } from '../../../lib/guides/guide-rotation';
import { rankedBisFile } from '../../../lib/guides/class-dps';
import { guidesCopy } from '../../../lib/guides/copy';
import { atLevel60, glanceRotation, markCheapRanks, topRankAt60 } from '../../../lib/guides/glance';
import { buildRaces } from '../../../lib/guides/build-races';
import { renderGuideMarkdown } from '../../../lib/guides/markdown';
import { splitSpecSections, slugify, SPEC_SECTIONS, type SpecSection } from '../../../lib/guides/sections';
import { diffBuilds, buildDiffLine } from '../../../lib/guides/build-diff';
import { guideBuildBlocks } from '../../../lib/guides/guide-builds';
import { guideDollTooltips, guideDollViews } from '../../../lib/guides/guide-bis-doll';
import { bisPieceCount } from '../../../lib/guides/guide-bis';
import { extrasRowCount } from '../../../lib/guides/gear-extras';
import { readItemTooltipModel } from '../../../lib/items/lookup-node';
import { guideTipsUrl, proseNames, specGuideData, withTipKeys } from '../../../lib/guides/guide-tips';
import { linkProse } from '../../../lib/guides/prose-tips';
import { pageScript } from '../../../lib/guides/page-script';
import { foldScript } from '../../../lib/ui/fold';
import { pageUpdatedAt } from '../../../lib/guides/guide-header';
import { formatDate } from '../../../lib/dates';
import { guideLadderSteps } from '../../../lib/guides/leveling-builds';
import { keyTalentsFor, withoutTalentBullets } from '../../../lib/guides/key-talents';
import { splitOverview } from '../../../lib/guides/overview';
import { raceTableFor, recommendedRaceLines, specKindOf } from '../../../lib/guides/race-table';
import { guideStatLane } from '../../../lib/guides/stat-lane';
import { guideTalentTrees } from '../../../lib/guides/talent-cells';
import {
  joinPriorityRuns,
  litTalentsOf,
  markRaidBuildRows,
  raidBuildOnlyTalents,
  talentNamesOf,
} from '../../../lib/guides/rotation-lists';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.spec !== undefined)
    .map((entry) => {
      const [classSlug, spec] = entry.id.split('/');
      return { params: { class: classSlug, spec }, props: { entry } };
    });
}

const { entry } = Astro.props;
const sections = splitSpecSections(entry.body ?? '');

/** A section's raw markdown without its own `## Heading` line. */
function proseOnly(section: SpecSection): string {
  const [, ...rest] = (sections.get(section) ?? '').split('\n');
  return rest.join('\n').replace(/^\n+/, '');
}

/** Splits the Leveling prose at the Levels 20 to 60 heading: [above it, the heading, below it]. */
function splitAtLevelingStrip(markdown: string): [string, string, string] {
  const match = /^### Levels 20 to 60\s*$/m.exec(markdown);
  if (match === null) return ['', '', markdown];
  return [markdown.slice(0, match.index), match[0], markdown.slice(match.index + match[0].length)];
}

const build = activeBuild.build;
const buildCode = entry.data.build;
const classSlug = entry.data.classSlug;
const specSlug = entry.id.split('/')[1]!;
const fullSpecId = `${classSlug}-${specSlug}`;
const className = classes.find((c) => c.slug === classSlug)?.name ?? classSlug;
const role = entry.data.role ?? 'dps';
const recommendedRaces = entry.data.recommendedRaces;

// The guide's gear and its tooltip bundle in one read: every talent, spell, racial, enchant and
// item the page names opens the game's tooltip, fetched on the first hover.
const {
  bis: guideBis,
  extras: gearExtras,
  bundle: tipBundle,
} = specGuideData(build, classSlug, fullSpecId, recommendedRaces);

// Talents: both builds decoded; the plate describes the raid build when the guide has its own.
const buildTrees = buildCode === undefined ? [] : (decodeBuildTrees(build, buildCode) ?? []);
const raidCode = entry.data.raidBuild;
const raidTrees =
  raidCode === undefined || raidCode === buildCode ? undefined : decodeBuildTrees(build, raidCode);
const describedTrees = describedBuildTrees(buildTrees, raidTrees);
const describedCode = raidTrees === undefined ? buildCode : raidCode;

const proseTargets = proseNames(build, classSlug, raidTrees ?? buildTrees, tipBundle);
async function prose(markdown: string): Promise<string> {
  return linkProse(await renderGuideMarkdown(markdown), proseTargets);
}

const overview = splitOverview(sections.get('Overview') ?? '', entry.id);
const hasOverviewBlocks = overview.strengths !== '' || overview.weaknesses !== '' || overview.raid !== '';
const overviewHtml = {
  strengths: await prose(overview.strengths),
  weaknesses: await prose(overview.weaknesses),
  raid: await prose(overview.raid),
  fallback: hasOverviewBlocks ? '' : await prose(proseOnly('Overview')),
};

const catalogEntries = readSpecCatalog()
  .filter((s) => s.class_slug === classSlug)
  .sort((a, b) => a.tree_index - b.tree_index);
const specEntry = catalogEntries.find((s) => s.spec_slug === specSlug);
const specName = specEntry?.name ?? specSlug;
const title = specEntry?.full_name ?? `${specName} ${className}`;

const buildBlocks =
  buildCode === undefined
    ? []
    : guideBuildBlocks(buildCode, raidCode).map((block) => ({
        ...block,
        trees: decodeBuildTrees(build, block.code) ?? [],
      }));
const raidDiffLine =
  raidTrees === undefined || buildTrees.length === 0
    ? undefined
    : buildDiffLine(diffBuilds(buildTrees, raidTrees));
const keyTalents = keyTalentsFor(
  proseOnly('Talents and builds'),
  buildTrees.length > 0 ? buildTrees : undefined,
  raidTrees,
);

// Rotation: the raid build's level 60 priority; a talent only the raid build takes is marked,
// and a cheap rank the guide chose says so.
const unkeyed = guideRotation(build, classSlug, fullSpecId, role, describedTrees);
const raidOnly =
  raidTrees === undefined
    ? new Set<string>()
    : raidBuildOnlyTalents(
        talentNamesOf(build, classSlug),
        litTalentsOf(buildTrees),
        litTalentsOf(raidTrees),
      );
const rotation =
  unkeyed === undefined
    ? undefined
    : markCheapRanks(
        joinPriorityRuns(atLevel60(withTipKeys(markRaidBuildRows(unkeyed, raidOnly), tipBundle))),
        (name) => topRankAt60(build, classSlug, name),
        proseOnly('Rotation and priority'),
      );
const glance =
  rotation === undefined
    ? { rows: [] }
    : glanceRotation(
        rotation.priority,
        buildRaces(build).map((race) => race.name),
      );

// The Best in slot doll: the lane's level 60 picks on the shared paperdoll, each with its tooltip.
const itemTooltip = (itemId: number) => readItemTooltipModel(build, classSlug, itemId) ?? undefined;
const dollViews = guideDollViews(guideBis, itemTooltip);
const dollTooltips = guideDollTooltips(dollViews, itemTooltip);

const statLane = guideStatLane(build, classSlug, fullSpecId, recommendedRaces, entry.data.statPriority);

const raceRows = raceTableFor(
  build,
  classSlug,
  [...recommendedRaces, ...entry.data.alsoRecommendedRaces],
  specKindOf(classSlug, fullSpecId, role),
);
const racesProse = proseOnly('Races');
const raceFaction = (faction: string): string =>
  faction === 'alliance' ? guidesCopy.alliancePicksHeading : guidesCopy.hordePicksHeading;
const racePicks = recommendedRaceLines(raceRows, racesProse);
const raceLines = racePicks.map((pick) =>
  guidesCopy.recommendedRacesLine(
    raceRows.find((row) => row.slug === pick.slug)?.name ?? pick.slug,
    raceFaction(pick.faction),
    racePicks.filter((other) => other.faction === pick.faction).length === 1 ? 'the' : 'a',
    pick.names.join(' and '),
  ),
);

const treeIndex = catalogEntries.find((s) => s.spec_slug === specSlug)?.tree_index;
const ladderSteps =
  buildCode === undefined || treeIndex === undefined
    ? []
    : guideLadderSteps(build, classSlug, fullSpecId, treeIndex, buildCode);
const [levelingEarly, levelingStripHeading, levelingLate] = splitAtLevelingStrip(proseOnly('Leveling'));
const levelingHtml =
  (await prose(levelingEarly)) +
  (levelingStripHeading === '' ? '' : await renderGuideMarkdown(levelingStripHeading)) +
  (await prose(levelingLate));

const rotationHtml = await prose(proseOnly('Rotation and priority'));
const extrasHtml = await prose(proseOnly('Enchants and consumables'));

const ranked = rankedBisFile(build, fullSpecId);
const updated = pageUpdatedAt(entry.data.updated, ranked?.generated_at);
const tocItems = SPEC_SECTIONS.map((section) => ({ title: section, id: slugify(section) }));
const path = `/guides/${entry.id}`;
const description = entry.data.description ?? '';
const jsonLd = [
  articleLd({ title: entry.data.title, description, path, updated: entry.data.updated }),
  breadcrumbListLd([
    { name: 'Class guides', path: '/guides' },
    { name: className, path: `/guides/${classSlug}` },
    { name: searchCopy.specGuideCrumb(title), path },
  ]),
];
---

<Base title={searchCopy.specGuideTitle(title)} {description} {path} {jsonLd}>
  <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />
  <main id="main" tabindex="-1" class="guide-page" data-testid="guide-page">
    <Page layout="reading" tocFrom={1024} testid="guide-body">
      <PageHeader slot="header" title={title} tone={{ classSlug: classSlug as ClassSlug }}>
        <Crest slot="crest" cls={classSlug} size={56} eager />
        <span slot="meta">{guidesCopy.headerMeta(role, formatDate(updated))}</span>
        <GuideAnswer
          slot="answer"
          page={{
            classSlug,
            specSlug,
            ladder: ladderSteps.map((step) => ({ level: step.level, name: step.name })),
          }}
        />
      </PageHeader>
      <GuideSpecBar
        slot="bar"
        build={build}
        classSlug={classSlug}
        specSlug={specSlug}
        summary={title}
        specs={catalogEntries}
        sections={tocItems}
      />
      <div slot="top" class="guide-top">
        <GuideGlance
          spec={fullSpecId}
          build={build}
          code={describedCode}
          trees={guideTalentTrees(build, classSlug, describedTrees)}
          isRaidBuild={raidTrees !== undefined}
          rotation={glance}
          rotationTitle={
            role === 'healer' ? guidesCopy.healingPriorityRailTitle : guidesCopy.rotationRailTitle
          }
          stats={statLane}
        />
      </div>
      <Toc
        slot="toc"
        label={guidesCopy.tocBarLabel}
        items={tocItems}
        current={tocItems[0]?.id}
        testid="guide-toc"
      />

      <ReadingPanel testid="guide-sections">
        <ReadingSection title="Overview" anchor="overview">
          <LaneBlock slot="lane" label={guidesCopy.inARaid} testid="guide-overview-raid">
            <Prose html={overviewHtml.raid} mods={['lane']} />
          </LaneBlock>
          {hasOverviewBlocks ? (
            <div class="guide-sw">
              <div>
                <h3 class="guide-sw-head">{guidesCopy.strengths}</h3>
                <Prose html={overviewHtml.strengths} mods={['plus']} testid="guide-strengths" />
              </div>
              <div>
                <h3 class="guide-sw-head">{guidesCopy.weaknesses}</h3>
                <Prose html={overviewHtml.weaknesses} mods={['minus']} testid="guide-weaknesses" />
              </div>
            </div>
          ) : (
            <Prose html={overviewHtml.fallback} />
          )}
        </ReadingSection>

        <ReadingSection title="Talents and builds" anchor="talents-and-builds">
          <Fragment slot="lane">
            <GuideBuildsLane
              spec={fullSpecId}
              build={build}
              blocks={buildBlocks}
              raidDiffLine={raidDiffLine}
              keyTalents={keyTalents}
            />
          </Fragment>
          <Prose html={await prose(withoutTalentBullets(proseOnly('Talents and builds')))} />
        </ReadingSection>

        {rotation !== undefined ? (
          <ReadingSection title="Rotation and priority" anchor="rotation-and-priority">
            <Fragment slot="lane">
              <GuideRotationLane build={build} lists={rotation} forRaidBuild={raidTrees !== undefined} />
            </Fragment>
            <Prose html={rotationHtml} />
          </ReadingSection>
        ) : (
          <ReadingSection title="Rotation and priority" anchor="rotation-and-priority">
            <Prose html={rotationHtml} />
          </ReadingSection>
        )}

        <ReadingSection title="Stat priority" anchor="stat-priority">
          <Fragment slot="lane">
            <GuideStatLane stats={statLane} fallback={entry.data.statPriority} />
          </Fragment>
          <Prose html={await prose(proseOnly('Stat priority'))} />
        </ReadingSection>

        <ReadingSection
          title="Best in slot"
          anchor="best-in-slot"
          proseFirst
          fold={guidesCopy.foldShow(guidesCopy.foldItems(bisPieceCount(guideBis)))}
        >
          <Fragment slot="lane">
            <GuideBisLane build={build} classSlug={classSlug} bis={guideBis} specSlug={specSlug} {role} />
          </Fragment>
          <Prose html={await prose(proseOnly('Best in slot'))} />
          <GuideBisDoll
            client:visible
            views={dollViews}
            tooltips={dollTooltips}
            build={build}
            title={title}
          />
        </ReadingSection>

        {gearExtras !== undefined && extrasHtml.trim() === '' ? (
          <ReadingSection
            title="Enchants and consumables"
            anchor="enchants-and-consumables"
            fold={guidesCopy.foldShow(guidesCopy.foldExtras(extrasRowCount(gearExtras)))}
          >
            <div class="guide-extras-solo">
              <GuideExtrasLane build={build} extras={gearExtras} tips={tipBundle} />
            </div>
          </ReadingSection>
        ) : gearExtras !== undefined ? (
          <ReadingSection
            title="Enchants and consumables"
            anchor="enchants-and-consumables"
            fold={guidesCopy.foldShow(guidesCopy.foldExtras(extrasRowCount(gearExtras)))}
          >
            <Fragment slot="lane">
              <GuideExtrasLane build={build} extras={gearExtras} tips={tipBundle} />
            </Fragment>
            <Prose html={extrasHtml} />
          </ReadingSection>
        ) : (
          <ReadingSection title="Enchants and consumables" anchor="enchants-and-consumables">
            <Prose html={extrasHtml} />
          </ReadingSection>
        )}

        <ReadingSection title="Races" anchor="races" fold={guidesCopy.foldShow(`${raceRows.length} races`)}>
          <Fragment slot="lane">
            <GuideRacesLane build={build} rows={raceRows} lines={raceLines} tips={tipBundle} />
          </Fragment>
          <Prose html={await prose(racesProse)} />
        </ReadingSection>

        <ReadingSection title="Professions" anchor="professions" fold={guidesCopy.foldShow('professions')}>
          <Prose html={await prose(proseOnly('Professions'))} />
        </ReadingSection>

        {ladderSteps.length > 0 ? (
          <ReadingSection title="Leveling" anchor="leveling" fold={guidesCopy.foldShow('leveling')}>
            <LaneBlock label={guidesCopy.talentsByLevel} testid="guide-talents-by-level">
              <GuideLevelingTree
                client:visible
                build={build}
                spec={fullSpecId}
                classSlug={classSlug}
                specSlug={specSlug}
                trees={guideTalentTrees(build, classSlug, buildTrees)}
                steps={ladderSteps}
              />
            </LaneBlock>
            <Prose html={levelingHtml} />
          </ReadingSection>
        ) : (
          <ReadingSection title="Leveling" anchor="leveling" fold={guidesCopy.foldShow('leveling')}>
            <Prose html={levelingHtml} />
          </ReadingSection>
        )}
      </ReadingPanel>
      <script is:inline set:html={foldScript}></script>
      <GuideSources sources={entry.data.sources} />
    </Page>
  </main>
  <script is:inline set:html={pageScript}></script>
  <script>
    import { mountReadingWrap } from '../../../lib/ui/reading-wrap';

    mountReadingWrap();
  </script>
  <GuideTooltips client:idle-after-load build={build} bundleUrl={guideTipsUrl(build, classSlug, specSlug)} />
</Base>

<style>
  .guide-page {
    padding-bottom: 40px;
  }
  /* The contents rail from 1024 (tocFrom) without a document's top gap: the lede sits 28 px
     under the band, as the split pages' bodies do. */
  .guide-page :global(.ui-page[data-toc-from]) {
    padding-top: 28px;
  }
  /* A jump lands its heading under the guide's bar, which a document has none of. */
  .guide-page :global(.ui-page[data-toc-from] .ui-rsec) {
    scroll-margin-top: calc(var(--bar-h) + 12px);
  }
  .guide-top {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  /* Leveling runs the panel's full width from 1280 in two columns: its talent tree heads the
     first, its prose flows beside and under it, so no empty rail stands beside nine paragraphs.
     A short section (Professions) keeps the reading measure: two columns would split its one
     paragraph mid-sentence. */
  @media (min-width: 1280px) {
    .guide-page :global(#leveling .ui-rd[data-solo]) {
      grid-template-columns: minmax(0, 1fr);
    }
    .guide-page :global(#leveling .ui-rd[data-solo] > .ui-rd-prose) {
      columns: 2 320px;
      column-gap: var(--gap);
    }
    .guide-page :global(#leveling .ui-lane-block) {
      break-inside: avoid;
      margin-bottom: 24px;
    }
    .guide-page :global(#leveling li),
    .guide-page :global(#leveling p) {
      break-inside: avoid;
    }
    .guide-page :global(#leveling h3) {
      break-after: avoid;
    }
    /* A guide with no enchant prose: its lists side by side across the panel, no empty column. */
    .guide-page :global(#enchants-and-consumables .ui-rd[data-solo]) {
      grid-template-columns: minmax(0, 1fr);
    }
    .guide-extras-solo :global(.guide-extras-blocks) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      align-items: start;
      gap: 28px var(--gap);
    }
  }
  .guide-sw {
    display: grid;
    gap: 20px var(--gap);
    grid-template-columns: minmax(0, 1fr);
  }
  .guide-sw-head {
    margin: 0;
    padding-bottom: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    color: var(--color-cream);
  }
  @media (min-width: 768px) {
    .guide-sw {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
