---
// web/src/pages/guides/index.astro
// /guides in the flat system (design/specs/2026-11-08-guides.md §4.1): the PageHeader (Guides,
// the newest Updated stamp over every guide, the index line, the signed-in answer), then the one
// Plate: every class as a group, its crest and name a link to its landing, its specs in tree
// order as slim link rows with a Healer, Tank or Melee Tag; the header character's spec is
// marked after load.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ClassCrest from '../../components/ClassCrest.astro';
import GuideAnswer from '../../components/guides/GuideAnswer.astro';
import GuideSpecRow from '../../components/guides/GuideSpecRow.astro';
import Page from '../../components/ui/Page.svelte';
import PageHeader from '../../components/ui/PageHeader.svelte';
import Plate from '../../components/ui/Plate.svelte';
import Row from '../../components/ui/Row.svelte';
import RowGrid from '../../components/ui/RowGrid.svelte';
import classes from '../../data/classes.json';
import activeBuild from '../../data/active-build.json';
import { readSpecCatalog } from '../../lib/bis/load';
import { latest } from '../../lib/dates';
import type { ClassSlug } from '../../lib/ui/primitives';
import { guidesCopy } from '../../lib/guides/copy';
import { rankedBisFile } from '../../lib/guides/class-dps';
import { dayMonth, pageUpdatedAt } from '../../lib/guides/guide-header';
import { specRowTag } from '../../lib/guides/glance';
import { dataUrl } from '../../lib/planner/load';
import { searchCopy } from '../../lib/search-copy';

const build = activeBuild.build;
const guides = await getCollection('guides');
const catalog = readSpecCatalog();
// The newest date any guide page shows: its own `updated`, or the day its ranked BiS file was
// published (the nightly republishes the numbers the guide pages carry).
const updated = latest(
  guides.map((g) => {
    const spec = g.data.spec === undefined ? undefined : `${g.data.classSlug}-${g.data.spec}`;
    return pageUpdatedAt(
      g.data.updated,
      spec === undefined ? undefined : rankedBisFile(build, spec)?.generated_at,
    );
  }),
);
const groups = classes.map((c) => ({
  slug: c.slug,
  name: c.name,
  specs: catalog
    .filter((s) => s.class_slug === c.slug)
    .sort((a, b) => a.tree_index - b.tree_index)
    .map((s) => {
      const role = (['dps', 'healer', 'tank'].includes(s.role) ? s.role : 'dps') as 'dps' | 'healer' | 'tank';
      const tag = specRowTag(c.slug, s.spec, role);
      return {
        key: `${c.slug}/${s.spec_slug}`,
        name: s.name,
        href: `/guides/${c.slug}/${s.spec_slug}`,
        icon: dataUrl(build, `icons/${s.icon}.webp`),
        tag: tag === undefined ? undefined : guidesCopy.specRowTag[tag],
      };
    }),
}));
---

<Base
  title={searchCopy.guidesIndex.title}
  description={searchCopy.guidesIndex.description}
  path="/guides"
  wide
>
  <main id="main" tabindex="-1" class="guides-index" data-testid="guides-index">
    <Page layout="ledger">
      <PageHeader slot="header" title={guidesCopy.indexTitle} tone="strong" lead={guidesCopy.indexLine}>
        <span slot="meta">Updated {dayMonth(updated)}</span>
        <GuideAnswer slot="answer" page={{}} />
      </PageHeader>
      <Plate label={guidesCopy.indexTitle} testid="guides-class-picker">
        <RowGrid cols={3}>
          {groups.map((group) => (
            <div class="guides-class" data-testid={`guides-class-${group.slug}`}>
              <Row
                title={group.name}
                titleTone={{ classSlug: group.slug as ClassSlug }}
                href={`/guides/${group.slug}`}
                testid={`guides-class-link-${group.slug}`}
              >
                <ClassCrest slot="lead" slug={group.slug} size={40} />
              </Row>
              <div class="guides-class-specs">
                {group.specs.map((spec) => (
                  <GuideSpecRow
                    specKey={spec.key}
                    name={spec.name}
                    href={spec.href}
                    icon={spec.icon}
                    iconSize={28}
                    tag={spec.tag}
                  />
                ))}
              </div>
            </div>
          ))}
        </RowGrid>
      </Plate>
    </Page>
  </main>
</Base>

<style>
  .guides-class {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-bottom: 20px;
  }
  .guides-class-specs {
    display: flex;
    flex-direction: column;
  }
</style>
