---
// web/src/pages/guides/index.astro
// /guides (directions mock b2-guides, round 5): the title band (Guides, the newest Updated stamp
// over every guide, the signed-in answer),
// then the class and spec picker the BiS landing shares (ClassSpecPicker): every class on its
// panel, its crest and name a link to its landing, its specs in tree order as slim link rows; the
// header character's spec is marked after load.
import { catalogueIconUrl } from '../../lib/ui/assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ClassSpecPicker from '../../components/guides/ClassSpecPicker.astro';
import { GUIDE_LINKS, pickerClasses } from '../../lib/class-picker';
import GuideAnswer from '../../components/guides/GuideAnswer.astro';
import Page from '../../components/ui/Page.svelte';
import PageHeader from '../../components/ui/PageHeader.svelte';
import activeBuild from '../../data/active-build.json';
import { latest } from '../../lib/dates';
import { rankedBisFile } from '../../lib/guides/class-dps';
import { pageUpdatedAt } from '../../lib/guides/guide-header';
import UpdatedStamp from '../../components/UpdatedStamp.astro';
import { guidesCopy } from '../../lib/guides/copy';
import { searchCopy } from '../../lib/search-copy';

const build = activeBuild.build;
// The newest date any guide page shows: its own `updated`, or the day its ranked BiS file was
// published (the nightly republishes the numbers the guide pages carry).
const updated = latest(
  (await getCollection('guides')).map((g) =>
    pageUpdatedAt(
      g.data.updated,
      g.data.spec === undefined
        ? undefined
        : rankedBisFile(build, `${g.data.classSlug}-${g.data.spec}`)?.generated_at,
    ),
  ),
);
const groups = pickerClasses({ ...GUIDE_LINKS, specIcon: (s) => catalogueIconUrl(build, s.icon) });
---

<Base title={searchCopy.guidesIndex.title} description={searchCopy.guidesIndex.description} path="/guides">
  <main id="main" tabindex="-1" class="guides-index" data-testid="guides-index">
    <Page layout="ledger">
      <PageHeader slot="header" title={guidesCopy.indexTitle} tone="strong">
        <UpdatedStamp slot="meta" date={updated} />
        <GuideAnswer slot="answer" page={{}} />
      </PageHeader>
      <ClassSpecPicker
        classes={groups}
        label={guidesCopy.indexTitle}
        testid="guides-class-picker"
        classTestidPrefix="guides-class-"
        classLinkTestidPrefix="guides-class-link-"
      />
    </Page>
  </main>
</Base>
