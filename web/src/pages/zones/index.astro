---
// web/src/pages/zones/index.astro
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryTable from '../../components/EntryTable.astro';
import SourcesList from '../../components/SourcesList.astro';
import UpdatedStamp from '../../components/UpdatedStamp.astro';
import { latest } from '../../lib/dates';
const zones = (await getCollection('zones')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const rows = zones.map((z) => ({
  href: `/zones/${z.id}`,
  title: z.data.title,
  meta: z.data.continent,
  levelMin: z.data.levelMin,
  levelMax: z.data.levelMax,
}));
const updated = latest(zones.map((z) => z.data.updated));
const sources = zones.flatMap((z) => z.data.sources);
---
<Base title="Zones" description="The new zones in World of Warcraft: Forever, with what is known about each." path="/zones">
  <main class="max-w-[1000px] w-full mx-auto px-6 py-10 flex flex-col gap-5">
    <header class="flex flex-col gap-2">
      <h1 class="text-[28px] font-bold tracking-[0.02em]">Zones</h1>
      <UpdatedStamp date={updated} />
    </header>
    <p class="text-muted text-[14px]">Level ranges are reported where a source gives them and not yet confirmed by Blizzard unless noted.</p>
    <EntryTable nameHeading="Zone" metaHeading="Continent" rows={rows} />
    <SourcesList sources={sources} />
  </main>
</Base>
