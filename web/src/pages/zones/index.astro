---
// web/src/pages/zones/index.astro
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const zones = (await getCollection('zones')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const range = (z: (typeof zones)[number]) => z.data.levelMin && z.data.levelMax ? `${z.data.levelMin}–${z.data.levelMax}` : '—';
const color = (min?: number) => !min ? 'text-muted' : min >= 55 ? 'text-rarity-epic' : min >= 30 ? 'text-rarity-rare' : 'text-rarity-uncommon';
---
<Base title="Zones" description="The new zones in World of Warcraft: Forever, with what is known about each." path="/zones">
  <main class="max-w-[1000px] w-full mx-auto px-6 py-10 flex flex-col gap-5">
    <h1 class="text-[28px] font-bold tracking-[0.02em]">Zones</h1>
    <p class="text-muted text-[14px]">Level ranges are reported where a source gives them and not yet confirmed by Blizzard unless noted.</p>
    <div class="bg-raised border border-line rounded-panel">
      <div class="grid grid-cols-[1fr_180px_110px] gap-3 px-4 py-[10px] label text-muted border-b border-line">
        <span>Zone</span><span>Continent</span><span>Level</span>
      </div>
      {zones.map((z, i) => (
        <a href={`/zones/${z.id}`} class={`grid grid-cols-[1fr_180px_110px] gap-3 px-4 py-[14px] text-[15px] items-center hover:bg-card-top ${i < zones.length - 1 ? 'border-b border-line-soft' : ''}`}>
          <span class="font-semibold text-strong">{z.data.title}</span>
          <span class="text-muted">{z.data.continent}</span>
          <span class={`font-mono tabular ${color(z.data.levelMin)}`}>{range(z)}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
