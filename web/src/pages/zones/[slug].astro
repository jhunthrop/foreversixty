---
// web/src/pages/zones/[slug].astro
import { getCollection, render } from 'astro:content';
import Content from '../../layouts/Content.astro';
import { levelRangeLong } from '../../lib/levels';
export async function getStaticPaths() {
  return (await getCollection('zones')).map((z) => ({ params: { slug: z.id }, props: { entry: z } }));
}
const { entry } = Astro.props;
const { Content: Body } = await render(entry);
const range = levelRangeLong(entry.data.levelMin, entry.data.levelMax);
---

<Content
  title={entry.data.title}
  description={`${entry.data.continent} · ${range}`}
  path={`/zones/${entry.id}`}
  updated={entry.data.updated}
  confidence={entry.data.confidence}
  sources={entry.data.sources}
>
  <p>
    <strong>{entry.data.continent}</strong> · {range}
  </p>
  <Body />
</Content>
