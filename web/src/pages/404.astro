---
// web/src/pages/404.astro: served by Workers static assets for any path that has no file (see
// `not_found_handling` in wrangler.jsonc). The flat system (design/specs/2026-11-08-pages.md
// §4.4, rulings 0A): the PageHeader (No page here, the address that failed as its meta, the
// line; signed in, your character with your guide, your best in slot and a smaller Your
// character), Did you mean when the address is within 3 edits of a page, then the page's one
// Plate (the class picker, each spec linking its guide) and the character lookup (first, signed
// out, on a dead /character/ address). The address line and the suggestion are set inline before
// the plate paints; the answer is painted after load (lib/not-found/answer-mount.ts).
import Base from '../layouts/Base.astro';
import CharacterSearch from '../components/CharacterSearch.astro';
import NotFoundClassPicker from '../components/not-found/NotFoundClassPicker.svelte';
import CharacterAnswer from '../components/ui/CharacterAnswer.svelte';
import Notice from '../components/ui/Notice.svelte';
import Page from '../components/ui/Page.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import classes from '../data/classes.json';
import { guidesCopy } from '../lib/guides/copy';
import { notFoundCopy } from '../lib/not-found/copy';
import { knownPages, SUGGEST_SCRIPT } from '../lib/not-found/suggest';
import { SPECS } from '../lib/sim/specs';
import { REGION } from '../lib/ui/regions';

const pages = knownPages(
  classes,
  SPECS.map((spec) => ({
    classSlug: spec.class_slug,
    className: classes.find((c) => c.slug === spec.class_slug)?.name ?? spec.class_slug,
    specSlug: spec.spec_slug,
    specName: spec.name,
  })),
);
---

<Base title={notFoundCopy.docTitle} description={notFoundCopy.description} path="/404" wide>
  <main id="main" tabindex="-1" class="pb-(--section-gap)" data-testid="not-found">
    <Page layout="ledger" testid="not-found-body">
      <PageHeader slot="header" title={notFoundCopy.title} lead={notFoundCopy.job}>
        <span slot="meta" id="nf-path" class="nf-path" data-testid="nf-path"></span>
        <CharacterAnswer slot="answer" label={guidesCopy.answerLabel} id="nf-answer" testid="nf-answer" />
      </PageHeader>
      <Fragment slot="bar">
        <div id="nf-suggest" class="nf-suggest" data-region={REGION.notes} data-testid="nf-suggest" hidden>
          <Notice text={notFoundCopy.didYouMean} action={{ label: '', href: '/' }} tone="neutral" />
        </div>
        <script is:inline type="application/json" id="nf-pages" set:html={JSON.stringify(pages)}></script>
        <script is:inline set:html={SUGGEST_SCRIPT}></script>
      </Fragment>
      <NotFoundClassPicker />
      <div class="nf-lookup">
        <CharacterSearch />
      </div>
    </Page>
  </main>
  <script>
    import { afterPaint } from '../lib/after-paint';

    afterPaint(() => {
      void import('../lib/not-found/answer-mount').then((m) => m.mountNotFoundAnswer());
    });
  </script>
</Base>

<style>
  /* The failed address reserves its one line before the script fills it (no shift). */
  .nf-path {
    display: inline-block;
    min-height: 20px;
    overflow-wrap: anywhere;
  }
  .nf-suggest {
    padding-inline: var(--page-inset);
  }
  .nf-suggest[hidden] {
    display: none;
  }
  /* Signed out on a dead /character/ address the lookup comes first (ruling SHOULD). */
  :global(html[data-nf-character]:not([data-session='1'])) .nf-lookup {
    order: -1;
  }
</style>
