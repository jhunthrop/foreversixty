---
// web/src/pages/ratings.astro
// The public explanation of both numbers (design/specs/2026-11-07-logs-reports.md section 8):
// the Forever Score (five parts, tiers) and the Performance Rating (six components, the weights
// by role, ranked or absolute, the cap), linked from every rating surface ("How is this
// calculated?"). A reference page, one level down (tenet 14). Rendered at build time with no
// island (components/score/RatingsPage.svelte).
import Base from '../layouts/Base.astro';
import RatingsPage from '../components/score/RatingsPage.svelte';
import { scoreCopy } from '../lib/score/copy';
---

<Base
  title={scoreCopy.explainerPageTitle}
  description="How World of Warcraft: Forever's Forever Score and performance ratings are computed: the score's five parts and tiers, the rating's six components, their weights per role, the ranked-versus-absolute rule, and the cap."
  path="/ratings"
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col" data-testid="ratings-page-main">
    <RatingsPage />
  </main>
</Base>
