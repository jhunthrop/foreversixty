---
// web/src/pages/ratings.astro
// The public explanation page spec section 6.3 requires: the exact weight table, the
// formulas in plain language, the ranked-vs-absolute rule, the cap in the coordinator's own
// words, and that a rating comes only from a public report -- linked from every rating
// surface ("How is this calculated?"). A content page: no client JavaScript of its own
// beyond the layout's character selector island.
//
// Task L8.2 ruling 6 and fix rounds 1-2: the page covers both numbers, each in its own
// section behind a two-item jump row. The Forever Score leads with one sentence and the
// profile's own card as a sample, then what it is, then what moves each part (proportional
// bars, the tier strip beside them, a visually hidden tier table for assistive tech) and how
// logs get here. The Performance Rating follows with its bridge sentence and its own sample
// card, its headings one level down. Labels are the addon's, from the shared fixture
// (lib/score/copy.ts); every card renders statically, so the page still ships no island.
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import ForeverScoreCard from '../components/ForeverScoreCard.svelte';
import RatingCard from '../components/RatingCard.svelte';
import TierStrip from '../components/TierStrip.svelte';
import { ratingCopy } from '../lib/rating/copy';
import { scoreCopy } from '../lib/score/copy';
import { COMPONENT_MAX, tierLabel, tierRanges, type ForeverScore } from '../lib/score/score';
import { SECONDARY_BUTTON_FIXED } from '../lib/planner/styles';

/** The sample the page opens with: the same numbers the profile and the tooltip read. */
const sampleScore: ForeverScore = {
  score: 1830,
  tier: 'epic',
  as_of: '2026-11-04',
  components: { gear: 412, experience: 620, parses: 540, attendance: 180, discipline: 78 },
  experience: { dungeons: 14, raid_kills: 0, alts: 2 },
};

/** The rating's sample: six fights climbing to 65. */
const sampleTrend = [40, 45, 50, 55, 60, 65].map((overall, index) => ({
  fought_at: `2026-12-0${index + 1}T00:00:00Z`,
  overall,
}));

/** The largest ceiling, so each part's bar is drawn in proportion to what it can give. */
const LARGEST_PART = Math.max(...Object.values(COMPONENT_MAX));

const weights = [
  { component: 'Output', dps: 35, healer: 30, tank: 10 },
  { component: 'Survival', dps: 15, healer: 10, tank: 35 },
  { component: 'Mechanics', dps: 20, healer: 20, tank: 20 },
  { component: 'Utility', dps: 15, healer: 20, tank: 20 },
  { component: 'Preparation', dps: 10, healer: 10, tank: 10 },
  { component: 'Activity', dps: 5, healer: 10, tank: 5 },
];

const JUMP =
  'text-gold inline-flex min-h-11 items-center text-[14px] underline-offset-2 hover:underline md:min-h-0';
const MEASURE = 'max-w-[70ch]';
---

<Base
  title={scoreCopy.explainerPageTitle}
  description="How World of Warcraft: Forever's Forever Score and performance ratings are computed: the score's five parts and tiers, the rating's six components, their weights per role, the ranked-versus-absolute rule, and the cap."
  path="/ratings"
>
  <main id="main" tabindex="-1" class="flex flex-col gap-8 px-[18px] py-8 md:gap-10 md:px-0">
    <header class="flex flex-col gap-2">
      <h1 class="heading-page">{scoreCopy.explainerPageTitle}</h1>
      <nav aria-label={scoreCopy.explainerJumpLabel} data-testid="ratings-jump">
        <ul class="flex flex-wrap items-center gap-x-3">
          <li>
            <a class={JUMP} href="#forever-score">
              {scoreCopy.explainerHeading}
            </a>
          </li>
          <li class="text-muted" aria-hidden="true">
            ·
          </li>
          <li>
            <a class={JUMP} href="#performance-rating">
              {scoreCopy.explainerRatingHeading}
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <section id="forever-score" class="flex scroll-mt-6 flex-col gap-6" data-testid="ratings-forever-score">
      <header class={`flex flex-col gap-2 ${MEASURE}`}>
        <h2 class="section-title">{scoreCopy.explainerHeading}</h2>
        <p class="text-muted text-[13px]" data-testid="ratings-forever-caption">
          {scoreCopy.explainerScoreCaption}
        </p>
        <p class="text-[15px] leading-[22px]" data-testid="ratings-forever-lead">
          {scoreCopy.explainerLead}
        </p>
      </header>

      <div data-testid="ratings-forever-sample">
        <ForeverScoreCard forever={sampleScore} heading={false} sample />
      </div>

      <div class={`flex flex-col gap-3 ${MEASURE}`}>
        <p class="text-[14px] leading-[22px]" data-testid="ratings-forever-what">
          {scoreCopy.explainerWhat}
        </p>
        <p class="text-[14px] leading-[22px]" data-testid="ratings-forever-launch">
          {scoreCopy.explainerLaunch}
        </p>
      </div>

      <Card glyph="layers" title={scoreCopy.explainerPartsHeading} headingLevel={3} body="none">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,420px)] border-line-soft border-t px-5 py-4">
          <ul class="flex flex-col gap-4 text-[14px] leading-[22px]">
            {scoreCopy.components.map((component) => (
              <li
                class={`flex flex-col gap-1 ${MEASURE}`}
                data-testid={`ratings-forever-score-${component.key}`}
              >
                <span class="flex items-baseline gap-2">
                  <strong>{component.label}</strong>
                  <span class="text-muted numeric text-[13px]">
                    {scoreCopy.upTo(COMPONENT_MAX[component.key])}
                  </span>
                </span>
                <span class="bg-line-soft block h-2 max-w-[360px]" aria-hidden="true">
                  <span
                    class="bg-gold/60 block h-full"
                    style={`width: ${Math.round((COMPONENT_MAX[component.key] / LARGEST_PART) * 1000) / 10}%`}
                    data-testid={`ratings-forever-bar-${component.key}`}
                  />
                </span>
                <span class="block">{component.moves}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-col gap-3" data-testid="ratings-forever-tiers-block">
            <TierStrip />
            <table class="sr-only" data-testid="ratings-forever-tiers">
              <thead>
                <tr>
                  <th scope="col">{scoreCopy.tierColumn}</th>
                  <th scope="col">{scoreCopy.rangeColumn}</th>
                </tr>
              </thead>
              <tbody>
                {tierRanges().map(({ tier, range }) => (
                  <tr>
                    <th scope="row">{tierLabel(tier)}</th>
                    <td>{range}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="text-muted text-[13px] leading-[20px]" data-testid="ratings-forever-tiers-note">
              {scoreCopy.tiersNote}
            </p>
          </div>
        </div>
      </Card>

      <Card glyph="chart" title={scoreCopy.explainerLogsHeading} headingLevel={3} body="none">
        <div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-6 border-line-soft border-t px-5 py-4">
          <p class={`text-[14px] leading-[22px] ${MEASURE}`} data-testid="ratings-forever-logs">
            {scoreCopy.explainerLogsBody}
          </p>
          <a
            class={`${SECONDARY_BUTTON_FIXED} border-line-warm-strong text-strong shrink-0 px-4`}
            href={scoreCopy.explainerLogsHref}
            data-testid="ratings-forever-logs-button"
          >
            {scoreCopy.explainerLogsButton}
          </a>
        </div>
      </Card>
    </section>

    <section
      id="performance-rating"
      class="flex scroll-mt-6 flex-col gap-6"
      data-testid="ratings-performance-rating"
    >
      <header class={`flex flex-col gap-2 ${MEASURE}`}>
        <h2 class="section-title">{scoreCopy.explainerRatingHeading}</h2>
        <p class="text-muted text-[13px]" data-testid="ratings-rating-caption">
          {scoreCopy.explainerRatingCaption}
        </p>
        <p class="text-[15px] leading-[22px]" data-testid="ratings-rating-bridge">
          {/* One string: Astro drops the whitespace between two expressions ("them.Both"). */}
          {`${scoreCopy.explainerRatingBridge} ${scoreCopy.explainerPreparationShared}`}
        </p>
      </header>

      <!-- L8.5 fix round 1 item 5: the sample's 560px column is narrow at every window width, so
           the card stays one column here. -->
      <div class="max-w-[560px]" data-testid="ratings-rating-sample">
        <RatingCard
          overall={65}
          trend={sampleTrend}
          sampleSize={sampleTrend.length}
          worst="activity"
          sample
          columns={false}
        />
      </div>

      <div class={`flex flex-col gap-2 ${MEASURE}`}>
        <h3 class="section-title">How ratings work</h3>
        <p class="text-muted text-[14px] leading-relaxed" data-testid="ratings-visibility">
          A rating comes only from a public report, the same way a Warcraft Logs parse does. There is no
          cross-guild leaderboard of ratings — a rating is one fight's roster, or one character's own history,
          never a ranked list of players against each other site-wide.
        </p>
      </div>

      <Card glyph="star" title="One number first, then six parts" headingLevel={3} body="none">
        <div class="flex flex-col gap-3 text-[14px] leading-relaxed border-line-soft border-t px-5 py-4">
          <p>
            Every rating starts with one overall number, 0 to 100. That number is a weighted average of six
            components — Output, Survival, Mechanics, Utility, Preparation, Activity — each also scored 0 to
            100. A parse is not a performance: someone who tops the meter while dying to avoidable damage and
            skipping consumables does not rate well here, because Output is a fraction of the score, not the
            whole of it.
          </p>
          <p>
            A component the engine cannot score for a given fight — no curated table for this encounter, the
            simulator does not model this spec yet, too few logs to compare against — is left out and said so
            in plain words, never silently zeroed and never faked. Its weight is redistributed across the
            components that did score.
          </p>
        </div>
      </Card>

      <Card glyph="list" title="What each component measures" headingLevel={3} body="none">
        <div
          class="flex flex-col gap-3 text-[14px] leading-relaxed border-line-soft border-t px-5 py-4"
          data-testid="ratings-components"
        >
          <p>
            <strong>Output.</strong> Damage or healing done. For a DPS spec the simulator already models,
            Output is judged against how well the fight could have gone with your gear — rotation, GCD usage,
            cooldown timing — not just the raw number on the meter. A healer's Output counts effective healing
            only; overheal never adds to it. A tank still deals damage, but Output carries little weight for
            that role, since holding threat and staying alive are the job.
          </p>
          <p>
            <strong>Survival.</strong> Whether you died — an avoidable death early in a fight costs far more
            than one near the very end — blended with how much avoidable damage you took without dying. Tanks
            are judged on avoidable damage alone: taking damage on purpose is the job, so a fight's expected
            hits never count against them.
          </p>
          <p>
            <strong>Mechanics.</strong> Three things, averaged: the interrupts you made, valued by how much
            damage the interrupted cast would have done; the dispels you made, valued by the healing or damage
            they denied the enemy; and how long you personally carried a debuff that should have been
            dispelled, where less time carrying it scores better. That last part is scored on the person
            carrying the debuff, not on whoever should have cleansed it.
          </p>
          <p>
            <strong>Utility.</strong> The average uptime across every buff, debuff, and cooldown your class
            and spec are expected to keep running for the raid — not the single worst one. One dropped buff
            does not sink the whole score the way judging by your worst upkeep would; this rewards broad
            coverage instead. (Threat is not scored yet — not modeled yet, not silently left out.)
          </p>
          <p>
            <strong>Preparation.</strong> Showing up ready: the right flask, food, weapon oil or stone, and
            world buffs at the pull, plus using your class's potions during the fight — each weighed by how
            much it matters for your role.
          </p>
          <p>
            <strong>Activity.</strong> The share of the fight you spent actively doing something rather than
            idle, after fairly excluding any period the fight itself expects you to do nothing — a scripted
            phase transition, for instance — so it is not just raw uptime.
          </p>
        </div>
      </Card>

      <Card glyph="scale" title="Weights, by role" headingLevel={3} body="none">
        <div class="overflow-x-auto border-line-soft border-t px-5 py-4">
          <table class="w-full min-w-[420px] border-collapse text-[13px]" data-testid="ratings-weights">
            <thead>
              <tr>
                <th scope="col" class="quiet-label border-line-soft border-b px-2 py-2 text-left">
                  Component
                </th>
                <th scope="col" class="quiet-label border-line-soft border-b px-2 py-2 text-right">
                  DPS
                </th>
                <th scope="col" class="quiet-label border-line-soft border-b px-2 py-2 text-right">
                  Healer
                </th>
                <th scope="col" class="quiet-label border-line-soft border-b px-2 py-2 text-right">
                  Tank
                </th>
              </tr>
            </thead>
            <tbody>
              {weights.map((row) => (
                <tr>
                  <th scope="row" class="border-line-soft border-b px-2 py-2 text-left font-semibold">
                    {row.component}
                  </th>
                  <td class="border-line-soft border-b px-2 py-2 text-right numeric">{row.dps}</td>
                  <td class="border-line-soft border-b px-2 py-2 text-right numeric">{row.healer}</td>
                  <td class="border-line-soft border-b px-2 py-2 text-right numeric">{row.tank}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-muted p-3 pt-0 text-[13px]" data-testid="ratings-roles">
          Neither of the two non-DPS roles uses the DPS weights above: tanks and healers are each rated by
          their own column in that table, since a tank's Output is worth little (10 of 100) and its Survival a
          lot (35), because taking damage on purpose is the job. A healer's Output is measured on effective
          healing, never raw — overheal does not count toward it.
        </p>
        <p class="text-muted p-3 pt-0 text-[13px]" data-testid="ratings-adjustable">
          The weight table above, and the cap below, are both settings a guild's officers can change — this
          page always describes the site-wide defaults.
        </p>
      </Card>

      <Card glyph="trophy" title="Ranked against your spec, or absolute" headingLevel={3} body="none">
        <div
          class="flex flex-col gap-3 text-[14px] leading-relaxed border-line-soft border-t px-5 py-4"
          data-testid="ratings-basis"
        >
          <p>
            When at least 20 kills of the same encounter, difficulty, spec, role and roughly the same kill
            speed exist, a component is ranked against players of your spec in those other logs — "better than
            71% of Fury Warriors on this fight." Below that, there are not enough logs yet to compare players
            fairly, so the score is measured against the encounter's own numbers instead and says so plainly,
            rather than presenting a ranking built on noise.
          </p>
          <p data-testid="ratings-small-samples">
            A brand-new boss, or a kill speed nobody has repeated yet, starts on the absolute standard and
            moves to being ranked against players of your spec once its own speed band (fast, typical, or
            slow, judged against the encounter's own kill times, not a fixed expectation) reaches 20
            comparable logs.
          </p>
          <p data-testid="ratings-wipes">
            A wipe scores differently than a kill: Survival and Mechanics are still computed — a wipe is
            exactly where avoidable deaths and missed interrupts matter most — but Output, Utility,
            Preparation and Activity are not, since a wipe's damage window is cut short and is not a fair
            comparison to a full kill's.
          </p>
        </div>
      </Card>

      <Card glyph="target" title="The cap" headingLevel={3} body="none">
        <p class="text-[14px] leading-relaxed border-line-soft border-t px-5 py-4">{ratingCopy.cappedRule}</p>
      </Card>
    </section>
  </main>
</Base>
