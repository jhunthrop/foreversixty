---
import ReportSkeleton from '../components/report/ReportSkeleton.svelte';
// web/src/pages/report-shell.astro
// The report shell. src/worker.ts serves this file's output (dist/report-shell.html) for
// /reports/<any id>, with the head values rewritten from GET /v1/reports/{id}. It carries no
// report data: the island reads the id out of the path and fetches the rest. /reports itself is
// the "Your reports" list (reports.astro); the shell keeps its own name so nothing links to it.
import Base from '../layouts/Base.astro';
import IslandScript from '../components/IslandScript.astro';
---

<Base
  title="Report"
  description="A World of Warcraft: Forever combat log report: fights, damage, healing, deaths and rankings."
  path="/reports"
>
  <link rel="stylesheet" href="/report-island.css" slot="head" />
  <main id="main" tabindex="-1" class="flex w-full flex-col pb-10">
    <!-- The Worker serves this page as the shell for every /reports/<id>, so before the
         island boots it shows the report's skeleton; only a browser with no JavaScript
         reads the line about nothing being open. -->
    <div id="report" data-report-mount>
      <ReportSkeleton />
      <noscript>
        <p class="text-muted px-(--page-inset) text-[14px]">
          No report is open. Upload a log or start the companion from <a href="/logs">Logs</a>.
        </p>
      </noscript>
    </div>
    <IslandScript src="/report-island.js" />
  </main>
</Base>
