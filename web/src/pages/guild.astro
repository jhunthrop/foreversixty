---
// web/src/pages/guild.astro
// The shell src/worker.ts serves for /guild/<region>/<ruleset>/<name>. The island reads
// the three segments out of the path.
import Base from '../layouts/Base.astro';
import Guild from '../components/Guild.svelte';
---

<Base
  title="Guild"
  description="A World of Warcraft: Forever guild: progression per boss, pull counts, kill dates and roster bests."
  path="/guild"
>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <Guild client:load />
  </main>
</Base>
