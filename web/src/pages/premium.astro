---
// web/src/pages/premium.astro
// The plans page (design/specs/2026-10-27-launch-pricing.md section 3.1). Static, no client
// JavaScript files: the interval is a native radiogroup read with :has(), and the founder state
// is a root attribute set by a six-line inline head script from the window's closing instant.
// Both intervals and both founder states are always in the DOM inside fixed-height cells.
import Base from '../layouts/Base.astro';
import GuildRules from '../components/premium/GuildRules.astro';
import IntervalControl from '../components/premium/IntervalControl.astro';
import PageHead from '../components/ui/PageHead.astro';
import Card from '../components/ui/Card.astro';
import Disclosure from '../components/ui/Disclosure.astro';
import PlanCard from '../components/premium/PlanCard.astro';
import PremiumCoachSample from '../components/premium/PremiumCoachSample.astro';
import { checkoutCopy } from '../lib/billing/copy';
import { FOUNDER_WINDOW_CLOSES } from '../lib/billing/plans';
import { plansPageCopy as copy } from '../lib/billing/plans-page-copy';
---

<Base title={copy.title} description={copy.description} path="/premium">
  <script slot="head" is:inline define:vars={{ closes: FOUNDER_WINDOW_CLOSES }}>
    // With JavaScript off the attribute is never set and the page keeps showing founder prices
    // (open is the CSS default), even after the window closes. Checkout charges whatever the
    // server decides, so only the display can be stale.
    // No "before" state: founder prices apply from launch until the window closes.
    document.documentElement.dataset.founder = Date.now() < Date.parse(closes) ? 'open' : 'closed';
  </script>
  <main id="main" tabindex="-1" class="plans-page" data-testid="plans-page">
    <div class="px-[var(--page-inset)] pt-3">
      <PageHead eyebrow={copy.band.eyebrow} title={copy.band.heading} job={copy.band.lede}>
        <IntervalControl slot="aside" />
        <div slot="below" class="flex flex-col gap-1">
          <p class="founder-row" data-fd="open" data-testid="founder-row">
            <span class="pill pill-site">{copy.founder.label}</span>
            <span>{copy.founder.open}</span>
          </p>
          <p class="text-text hidden min-h-11 items-center gap-[6px] text-[13px] md:flex" data-band-guild-row>
            <span>{copy.band.guildLead}</span>
            <a
              href="#guild-leaders"
              class="inline-flex min-h-11 items-center hover:underline"
              data-testid="band-guild-link"
            >
              {copy.band.guildLink}
            </a>
          </p>
        </div>
      </PageHead>
    </div>

    <div class="body">
      <p class="canceled" role="status" data-testid="premium-canceled-notice" hidden>
        {checkoutCopy.canceled}
      </p>

      <div class="regions">
        <!-- Region A, for your character (§B3.2): no heading, the band asks the question. Free and
             Premium are one subgrid row set; the sample coach review spans that row set from 1024. -->
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-3" data-region="a">
          <PlanCard plan="free" />
          <PlanCard plan="premium" />
          <div
            class="grid md:col-span-2 md:max-w-[480px] lg:col-span-1 lg:row-span-6 lg:max-w-none"
            data-plan="coach-sample"
          >
            <PremiumCoachSample />
          </div>
        </div>

        <!-- Region B, for guild leaders (§B3.3): the band's guild link lands here. -->
        <section id="guild-leaders" class="mt-7 scroll-mt-4 md:mt-10" aria-labelledby="guild-leaders-heading">
          <h2 id="guild-leaders-heading" class="heading-section">
            {copy.guildRegion.heading}
          </h2>
          <p class="text-text mt-2 max-w-[720px] text-[14px] leading-[1.5]">{copy.guildRegion.lede}</p>
          <p class="text-muted mt-1 max-w-[720px] text-[13px] leading-[1.45]">{copy.guildRegion.members}</p>
          <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-3" data-guild-row>
            <PlanCard plan="guild" headingLevel={3} />
            <PlanCard plan="raid_guild" headingLevel={3} />
            <p
              class="history-promise md:col-span-2 lg:col-span-1 lg:row-span-6"
              data-plan="history"
              data-testid="history-promise"
            >
              {copy.historyPromise}
            </p>
          </div>
          <div class="mt-7 md:mt-8">
            <GuildRules />
          </div>
        </section>
      </div>

      <p class="foot">{copy.foot}</p>

      <Card glyph="book" title="Questions" body="rows" id="faq" testid="plans-faq">
        {copy.faq.map((entry) => (
          <Disclosure title={entry.question} row>
            <p class="text-muted m-0 max-w-[80ch] px-5 pb-4 text-[14px] leading-[22px]">{entry.answer}</p>
          </Disclosure>
        ))}
      </Card>
    </div>
  </main>

  <script is:inline>
    // is:inline: no bundle and no request, so this page ships zero client JavaScript files.
    // Stripe's cancel_url sends a visitor who backs out of Checkout to this exact page,
    // ?canceled=1; this static page is the only place that can acknowledge it.
    if (new URLSearchParams(window.location.search).get('canceled') === '1') {
      const notice = document.querySelector('[data-testid="premium-canceled-notice"]');
      if (notice) notice.hidden = false;
    }
  </script>
</Base>

<style is:global>
  /* One interval and one founder state show; the rest stay in the DOM inside fixed cells. */
  .plans-page:has(#iv-monthly:checked) [data-iv='yearly'],
  .plans-page:not(:has(#iv-monthly:checked)) [data-iv='monthly'] {
    display: none;
  }
  :root[data-founder='closed'] [data-fd='open'],
  :root:not([data-founder='closed']) [data-fd='closed'] {
    display: none;
  }
</style>

<style>
  .plans-page {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .founder-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    color: var(--color-text);
  }
  .founder-row .pill {
    flex: none;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 12px var(--page-inset) 56px;
  }
  .canceled {
    margin: 0;
    font-size: 14px;
  }
  .history-promise {
    align-self: start;
    margin: 0;
    max-width: 720px;
    padding-left: 14px;
    border-left: 2px solid var(--color-line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }
  .foot {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .body {
      gap: 32px;
      padding: 12px 0 64px;
    }
  }
</style>
