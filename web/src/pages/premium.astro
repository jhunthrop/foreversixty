---
// web/src/pages/premium.astro
// The plans page on the round 5 system (directions mock design/mocks/directions/png/b4-premium-*;
// parity twin design/mocks/ws_premium.py): the PageHeader (`Plans`, signed in the account's plan as
// the answer), the interval bar, the founder line and at most one state line, then the four plans
// side by side as panels (Free, Premium framed with the teal Subscribe, Guild, Raid guild; Premium
// first on a phone), then Questions and the guild rules beside the sample coach review. Static:
// both intervals and both founder states are in the DOM in fixed cells, and the pre-paint
// attributes (`data-iv` from ?interval=, `data-founder` from the window's closing instant,
// `data-premium` from the stored source) pick one. Signed out nothing is fetched; signed in one
// small module reads /v1/me (premium-account.ts, gap G1) for payer, seat, grant and free.
import Base from '../layouts/Base.astro';
import CoachSample from '../components/premium/CoachSample.astro';
import PlanFeatures from '../components/premium/PlanFeatures.astro';
import PlanPrice from '../components/premium/PlanPrice.astro';
import Button from '../components/ui/Button.svelte';
import ControlBar from '../components/ui/ControlBar.astro';
import Notice from '../components/ui/Notice.svelte';
import Page from '../components/ui/Page.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import PlanHead from '../components/ui/PlanHead.svelte';
import Plate from '../components/ui/Plate.svelte';
import Row from '../components/ui/Row.svelte';
import RowGrid from '../components/ui/RowGrid.svelte';
import Section from '../components/ui/Section.svelte';
import Tag from '../components/ui/Tag.svelte';
import { checkoutCopy } from '../lib/billing/copy';
import { FOUNDER_WINDOW_CLOSES, INTERVALS, type PlanKey } from '../lib/billing/plans';
import { plansPageCopy as copy } from '../lib/billing/plans-page-copy';
import { premiumSourceCopy } from '../lib/billing/premium-source-copy';
import { myReportsCopy } from '../lib/reports/my-reports-copy';
import { REGION } from '../lib/ui/regions';
import { LINK, type ControlGroup } from '../lib/ui/primitives';
import {
  FOUNDER_STATES,
  buttonLabel,
  checkoutHref,
  founderKey,
  trialParts,
} from '../components/premium/model';

const intervalGroup: ControlGroup = {
  label: copy.interval.groupLabel,
  param: 'interval',
  kind: 'segmented',
  options: INTERVALS.map((value) => ({ value, label: copy.interval.labels[value] })),
  value: 'yearly',
  defaultValue: 'yearly',
};
const priced = (plan: PlanKey) =>
  INTERVALS.flatMap((interval) =>
    FOUNDER_STATES.map((founder) => ({
      interval,
      fd: founderKey(founder),
      href: checkoutHref(plan, interval),
      label: buttonLabel(plan, interval, founder),
    })),
  );
const OWNED = Object.entries(premiumSourceCopy.premiumCard);
const trial = trialParts();
const guildPlans = [
  { tier: 'guild' as const, block: copy.guild },
  { tier: 'raid_guild' as const, block: copy.raidGuild },
];
---

<Base title={copy.title} description={copy.description} path="/premium" wide>
  <script slot="head" is:inline define:vars={{ closes: FOUNDER_WINDOW_CLOSES }}>
    // With JavaScript off neither attribute is set: founder prices (open is the CSS default) and
    // yearly show. Checkout charges whatever the server decides, so only the display can be stale.
    const root = document.documentElement;
    root.dataset.founder = Date.now() < Date.parse(closes) ? 'open' : 'closed';
    if (new URLSearchParams(location.search).get('interval') === 'monthly') root.dataset.iv = 'monthly';
  </script>
  <main id="main" tabindex="-1" class="plans-page" data-testid="plans-page">
    <PageHeader title={copy.title} tone="strong">
      <div slot="answer" class="premium-answer-slot" data-premium-slot="answer"></div>
    </PageHeader>
    <ControlBar
      id="plans-bar"
      label={copy.interval.groupLabel}
      groups={[intervalGroup]}
      testid="interval-bar"
    />
    <div class="plans-notes">
      <div data-region={REGION.notes}>
        <p class="plans-founder" data-fd="open" data-testid="founder-row">
          <Tag>{copy.founder.label}</Tag>
          <span>{copy.founder.open}</span>
        </p>
        <div class="plans-canceled" hidden data-testid="premium-canceled-notice">
          <Notice tone="neutral" text={checkoutCopy.canceled} />
        </div>
        <div data-premium-slot="state"></div>
      </div>
    </div>

    <Page layout="ledger" panels>
      <div class="plan-grid" role="group" aria-label={copy.title} data-testid="plans-plate">
        <Plate>
          <div class="plan" data-testid="plan-free" id="free">
            <PlanHead
              name={copy.free.name}
              audience={copy.free.audience}
              value={copy.free.price}
              level={2}
              lines={[{ text: copy.free.note }]}
            >
              <span slot="tag" class="your-plan your-plan-free">
                <Tag tone="success">{copy.yourPlanTag}</Tag>
              </span>
            </PlanHead>
            <PlanFeatures features={copy.free.features} testid="free-features" />
            <a
              class={`${LINK} signed-out-only plan-foot`}
              href="/login?next=%2Fpremium"
              data-testid="free-sign-in"
            >
              {myReportsCopy.signInAction} ›
            </a>
          </div>
        </Plate>
        <Plate frame="framed">
          <div class="plan plan-sold" data-testid="plan-premium" id="premium">
            <PlanHead name={copy.premium.name} audience={copy.premium.audience} value="" level={2}>
              <span slot="tag" class="your-plan your-plan-premium">
                <Tag tone="success">{copy.yourPlanTag}</Tag>
              </span>
              <PlanPrice slot="price" plan="premium" gold />
            </PlanHead>
            <PlanFeatures features={copy.premium.features} testid="premium-features" />
            <p class="text-small text-muted plan-small m-0" data-testid="premium-scope">
              {copy.premium.scope}
            </p>
            <div class="plan-act">
              {priced('premium').map((b) => (
                <span class="plan-btn" data-iv={b.interval} data-fd={b.fd}>
                  <Button tone="subscribe" href={b.href}>
                    {b.label}
                  </Button>
                </span>
              ))}
              <div class="plan-owned">
                {OWNED.map(([source, line]) => (
                  <p class="owned-line" data-source={source}>
                    {line}
                  </p>
                ))}
                <span>
                  <Button href="/account#plan">{premiumSourceCopy.buttons.seePlan}</Button>
                </span>
              </div>
              <p class="text-small text-muted m-0" data-testid="premium-support">
                {copy.premium.support}
              </p>
            </div>
          </div>
        </Plate>
        {guildPlans.map(({ tier, block }) => (
          <Plate>
            <div class="plan" data-testid={`plan-${tier}`} data-guild-column={tier} id={tier}>
              <PlanHead name={block.name} audience={block.audience} value="" level={2}>
                <span slot="tag" class="guild-tag">
                  <Tag tone="success">
                    <span data-guild-tag></span>
                  </Tag>
                </span>
                <PlanPrice slot="price" plan={tier} />
              </PlanHead>
              <PlanFeatures features={block.features} />
              <p class="text-small text-muted plan-small m-0">
                <b class="text-strong">{trial.lead}</b>
                {trial.rest}
              </p>
              <div class="plan-act">
                <div class="guild-subscribe">
                  {priced(tier).map((b) => (
                    <span class="plan-btn" data-iv={b.interval} data-fd={b.fd}>
                      <Button href={b.href}>{b.label}</Button>
                    </span>
                  ))}
                </div>
                <div class="guild-on" data-premium-slot="guild" data-tier={tier}></div>
              </div>
            </div>
          </Plate>
        ))}
      </div>

      <div class="plans-more">
        <div class="plans-more-main">
          <Section title={copy.faqTitle} meta={copy.foot} anchor="faq" testid="plans-faq" panel>
            <RowGrid cols={2}>
              {copy.faq.map((entry) => (
                <Row title={entry.question} sub={entry.answer} open />
              ))}
            </RowGrid>
          </Section>
          <Section title={copy.howItWorks} anchor="guild-leaders" testid="guild-rules" panel>
            <p class="text-small text-muted plans-members m-0">{copy.guildRegion.members}</p>
            <RowGrid cols={2}>
              {copy.rules.map((rule) => (
                <Row title={rule.term} sub={rule.sentence} open />
              ))}
            </RowGrid>
            <p class="text-small text-muted plans-history m-0" data-testid="history-promise">
              {copy.historyPromise}
            </p>
          </Section>
        </div>
        <CoachSample />
      </div>
    </Page>
  </main>

  <script>
    import { CONTROL_BAR_EVENT, type ControlBarChange } from '../lib/ui/control-bar';
    import { syncIntervalRadios } from '../components/premium/interval';

    const root = document.documentElement;
    // Stripe's cancel_url lands here with ?canceled=1; this static page is the only place that can say so.
    if (new URLSearchParams(location.search).get('canceled') === '1') {
      const notice = document.querySelector<HTMLElement>('[data-testid="premium-canceled-notice"]');
      if (notice) notice.hidden = false;
    }
    syncIntervalRadios(root.dataset.iv === 'monthly' ? 'monthly' : 'yearly');
    document.addEventListener(CONTROL_BAR_EVENT, (event) => {
      const { param, value } = (event as CustomEvent<ControlBarChange>).detail;
      if (param !== 'interval') return;
      if (value === 'monthly') root.dataset.iv = 'monthly';
      else delete root.dataset.iv;
    });
    if (root.dataset.session === '1') {
      void import('../components/premium/premium-account').then((m) => m.bootPremiumAccount());
    }
  </script>
</Base>

<style is:global>
  /* One interval and one founder state show; the others keep their box (stacked cells). */
  :root:not([data-iv='monthly']) .plans-page [data-iv='monthly'],
  :root[data-iv='monthly'] .plans-page [data-iv='yearly'] {
    display: none;
  }
  :root[data-founder='closed'] .plans-page [data-fd='open'],
  :root:not([data-founder='closed']) .plans-page [data-fd='closed'] {
    display: none;
  }
  /* Signed out the head has no answer; signed in its box is held until /v1/me answers. */
  :root:not([data-session='1']) .plans-page [data-region='head-answer'],
  :root[data-plan-mine='out'] .plans-page [data-region='head-answer'] {
    display: none;
  }
  :root[data-session='1'] .plans-page .signed-out-only {
    display: none;
  }
  /* The account's own plan: `Your plan` on Free while it has no Premium, on Premium when it has. */
  .plans-page .your-plan,
  .plans-page .guild-tag,
  .plans-page .plan-owned,
  .plans-page .owned-line {
    display: none;
  }
  :root[data-premium] .plans-page .plan-owned {
    display: flex;
  }
  :root[data-plan-mine='free']:not([data-premium]) .plans-page .your-plan-free,
  :root[data-premium] .plans-page .your-plan-premium,
  :root[data-premium='own'] .plans-page .owned-line[data-source='own'],
  :root[data-premium='seat'] .plans-page .owned-line[data-source='seat'],
  :root[data-premium='grant'] .plans-page .owned-line[data-source='grant'],
  .plans-page [data-on-plan='true'] .guild-tag {
    display: inline-flex;
  }
  :root[data-premium] .plans-page [data-testid='plan-premium'] .plan-btn,
  .plans-page [data-on-plan='true'] .guild-subscribe {
    display: none;
  }
</style>

<style>
  .plans-page {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  /* The head's row is as tall as the title block, so the answer filling in moves nothing. */
  @media (min-width: 900px) {
    .premium-answer-slot {
      min-width: 300px;
    }
  }
  .plans-notes {
    padding-inline: var(--page-inset);
  }
  .plans-founder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    padding-top: 14px;
    padding-bottom: 4px;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-text);
  }
  /* The four plans: one column on a phone (Premium first), two from 768, four from 1280. */
  .plan-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  .plan-grid > :global(*:nth-child(2)) {
    order: -1;
  }
  @media (min-width: 768px) {
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .plan-grid > :global(*:nth-child(2)) {
      order: 0;
    }
  }
  @media (min-width: 1280px) {
    .plan-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    min-width: 0;
    padding: 22px 24px;
  }
  /* On a phone the plan's buy button sits under its price, in the first screen (PR3); from 768
     every plan's button closes its panel, level across the row. */
  .plan-act {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    order: 1;
  }
  .plan :global(.ui-plh) {
    order: 0;
  }
  .plan :global(.plan-features),
  .plan-small,
  .plan-foot {
    order: 2;
  }
  @media (min-width: 768px) {
    .plan-act {
      order: 3;
      margin-top: auto;
      padding-top: 4px;
    }
  }
  .plan-btn :global(.ui-btn),
  .plan-btn :global(a),
  .plan-owned :global(a) {
    width: 100%;
  }
  /* A guild's label ("Subscribe your guild · $120 a year") wraps in a quarter of the page column
     rather than running past its panel. */
  .plan-btn :global(a) {
    display: flex;
    height: auto;
    min-height: 44px;
    padding-block: 10px;
    white-space: normal;
    text-align: center;
    text-wrap: balance;
  }
  .plan-foot {
    margin-top: auto;
  }
  .plan-owned {
    flex-direction: column;
    gap: 12px;
    align-items: stretch;
  }
  .owned-line {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-strong);
  }
  .guild-on:empty {
    display: none;
  }
  .guild-on {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* Questions and the guild rules beside the sample coach review from 1024. */
  .plans-more {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--section-gap);
  }
  .plans-more-main {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .plans-more {
      grid-template-columns: minmax(0, 1fr) 340px;
      column-gap: 28px;
      align-items: start;
    }
  }
  @media (min-width: 1760px) {
    .plans-more {
      grid-template-columns: minmax(0, 1fr) var(--rail-w);
    }
  }
  .plans-history {
    padding-top: 12px;
  }
  .plans-members {
    padding-bottom: 4px;
  }
  @media (max-width: 767px) {
    .plan {
      padding: 18px 16px;
    }
  }
</style>
