---
import { reportSkeletonHtml } from '../../lib/report/skeleton';
// web/src/pages/reports/[id].astro
// Prerendered report pages. Only the fixtures, and only under FOREVER_DATA=fixture (see
// ../../lib/report/shell-paths.ts): Playwright and Lighthouse need a /reports/<id> that
// exists without a Worker and without an API.
//
// The complete fixture inlines its GET /v1/reports/{id} payload as data-report, the way
// the API inlines data-build on /b/:id, so the page renders from static files alone and
// Lighthouse measures a real report rather than an error state. The live fixture carries
// no payload: its e2e stubs the API and the data files to exercise the fetch and poll
// paths.
import Base from '../../layouts/Base.astro';
import fixtureMeta from '../../fixtures/report/meta.json';
import { FIXTURE_REPORT_ID, fixtureReportPaths } from '../../lib/report/shell-paths';

export function getStaticPaths() {
  return fixtureReportPaths();
}

const { id } = Astro.params;
const inline = id === FIXTURE_REPORT_ID ? JSON.stringify(fixtureMeta) : undefined;
---

<Base
  title={id === FIXTURE_REPORT_ID ? fixtureMeta.title : 'Report'}
  description="A World of Warcraft: Forever combat log report: fights, damage, healing, deaths and rankings."
  path={`/reports/${id}`}
>
  <link rel="stylesheet" href="/report-island.css" slot="head" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <!--
      Reserves the report's space before the island mounts. Without it the placeholder is
      one line tall, the footer sits inside the viewport, and rendering the report shoves
      the footer down by roughly the report's own height -- a layout shift every bit as
      real whether the box grows into the reservation or past it, so a reservation smaller
      than the eventual content still costs the CLS budget. Re-measured on the fixture at
      360px (the Lighthouse profile, 360x640) after the design review 2026-09-26 loop
      collapsed the phone chart block to a one-line strip by default: the island's default
      view (first fight, the collapsed chart, Summary tab) now settles at ~2967px, up from
      an earlier round's ~1288px because Summary has grown a rating panel and a longer
      combatants list since that measurement, not because this round grew the page --
      collapsing the chart is a net reduction against what this same build would measure
      with it open. 468svh reserves ~2995px, 28px above the measured height: CI's Linux
      fonts wrap a little wider than a Mac's, so the reserve carries headroom the Mac
      measurement itself does not need. A real report's default view will not match this
      fixture's height exactly, but it lands far closer than a guess -- re-measure and move
      this number whenever the default view's content changes materially.
    
      Review round 2 (design loop): one svh figure measured on a phone was applied at every
      width, and at 1280x900 it reserved 4212px for a report that settles at 1301px -- a
      screen and a half of black above the footer. Pixel reserves per breakpoint instead,
      measured with the reserve removed in-page on the fixture's default view: 2436 at
      360x640 (Lighthouse's phone), 1532 at 800 wide, 1301 at 1280 wide; each reserve is 24px
      above its natural for the CI runner's fonts. svh would scale with a viewport the
      content does not scale with, so px is the honest unit here.
    -->
    <div
      id="report"
      data-report-mount
      data-report-id={id}
      data-report={inline}
      class="min-h-[2460px] md:min-h-[1556px] lg:min-h-[1325px]"
    >
      <Fragment set:html={reportSkeletonHtml(id === FIXTURE_REPORT_ID ? fixtureMeta.title : undefined)} />
    </div>
    <script type="module" src="/report-island.js"></script>
  </main>
</Base>
