---
import ReportSkeleton from '../../components/report/ReportSkeleton.svelte';
// web/src/pages/reports/[id].astro
// Prerendered report pages. Only the fixtures, and only under FOREVER_DATA=fixture (see
// ../../lib/report/shell-paths.ts): Playwright and Lighthouse need a /reports/<id> that
// exists without a Worker and without an API.
//
// The complete fixture inlines its GET /v1/reports/{id} payload as data-report, the way
// the API inlines data-build on /b/:id, so the page renders from static files alone and
// Lighthouse measures a real report rather than an error state. The live fixture carries
// no payload: its e2e stubs the API and the data files to exercise the fetch and poll
// paths.
import Base from '../../layouts/Base.astro';
import fixtureMeta from '../../fixtures/report/meta.json';
import { FIXTURE_REPORT_ID, fixtureReportPaths } from '../../lib/report/shell-paths';
import IslandScript from '../../components/IslandScript.astro';

export function getStaticPaths() {
  return fixtureReportPaths();
}

const { id } = Astro.params;
const inline = id === FIXTURE_REPORT_ID ? JSON.stringify(fixtureMeta) : undefined;
---

<Base
  title={id === FIXTURE_REPORT_ID ? fixtureMeta.title : 'Report'}
  description="A World of Warcraft: Forever combat log report: fights, damage, healing, deaths and rankings."
  path={`/reports/${id}`}
  wide
>
  <link rel="stylesheet" href="/report-island.css" slot="head" />
  <main id="main" tabindex="-1" class="flex w-full flex-col pb-10">
    <!--
      Reserves the report's space before the island mounts, so the footer does not jump when the
      report replaces its skeleton (a shift is a shift whether the box grows into the reservation
      or past it). Re-measured 2026-11-07 on the rebuilt frame (logs spec 2026-11-07 section 13:
      the Summary leads with its Plate, the chart under it, the rail beside it from 1024), with
      the reserve removed in-page, on the fixture's and the sample's default views. Re-measured
      2026-11-09 on the round-5 panels: 1938 / 1436 at 360, 2179 / 1793 at 800 (one column: the
      rail under main), 1530 / 1500 at 1280. Each
      reserve is the lower of the two, a little under, so a short report never stands over a gap;
      px, not svh, because the content does not scale with the viewport.
    -->
    <div
      id="report"
      data-report-mount
      data-report-id={id}
      data-report={inline}
      class="min-h-[1420px] md:min-h-[1780px] lg:min-h-[1480px]"
    >
      <ReportSkeleton title={id === FIXTURE_REPORT_ID ? fixtureMeta.title : undefined} />
    </div>
    <IslandScript src="/report-island.js" />
  </main>
</Base>
