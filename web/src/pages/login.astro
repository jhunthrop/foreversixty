---
// web/src/pages/login.astro
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
import { safeNextPath } from '../lib/account/safe-next';

const next = safeNextPath(Astro.url.searchParams.get('next'), '/logs');
---

<Base
  title="Sign in"
  description="Sign in to Forever Sixty with Battle.net or an email link to upload combat logs and claim your characters."
  path="/login"
  session
>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[640px] flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <h1 class="section-title text-[18px]">Sign in</h1>
    <p class="text-muted text-[14px]">
      An account is needed to upload logs, pair the companion and claim characters. Reading reports and
      rankings never needs one.
    </p>
    <Account client:load mode="login" next={next} />
  </main>
</Base>
