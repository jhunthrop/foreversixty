---
// web/src/pages/login.astro
// Sign in (mock design/mocks/web/web-login.html, ws_pages.py): the form page, as /account signed
// out draws it (account/AccountOut.svelte): the PageHeader, then the one Plate, which holds the
// island (account/AccountLogin.svelte through Account.svelte). The island draws the Battle.net
// button to the visitor's own `?next=`, or, already signed in, the way back to the account.
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
import Page from '../components/ui/Page.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import Plate from '../components/ui/Plate.svelte';
import { accountSignInCopy } from '../lib/account/signin-copy';
---

<Base
  title={accountSignInCopy.title}
  description="Sign in to Forever Sixty with Battle.net to upload combat logs and claim your characters."
  path="/login"
>
  <main id="main" tabindex="-1" class="flex w-full flex-col pb-(--section-gap)">
    <Page layout="form" testid="login-page">
      <PageHeader slot="header" title={accountSignInCopy.title} testid="login-head" />
      <Plate label={accountSignInCopy.title}>
        <Account client:load mode="login" next="/account?signed_in=1" />
      </Plate>
    </Page>
  </main>
</Base>
