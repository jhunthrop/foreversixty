---
// web/src/pages/search.astro
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.svelte';
---
<Base title="Search" description="Search Forever Sixty." path="/search">
  <main id="main" tabindex="-1" class="max-w-[820px] w-full mx-auto px-6 py-10 flex flex-col gap-4">
    <h1 class="text-[28px] font-bold">Search</h1>
    <SearchBox client:load />
    <p class="text-[13px] text-muted">Results need JavaScript. Without it, browse <a href="/dungeons">dungeons</a>, <a href="/zones">zones</a>, or <a href="/guides">guides</a>.</p>
  </main>
</Base>
