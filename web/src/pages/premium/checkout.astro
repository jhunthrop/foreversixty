---
// web/src/pages/premium/checkout.astro
// session=true: this page exists only to run one action, exactly like /login. This site
// builds statically (astro.config.mjs has no server output/adapter, and wrangler.jsonc's
// run_worker_first does not list this path), so this frontmatter runs once at build time
// and never sees a real visitor's query string -- Astro.url here is always the build URL,
// with no `plan`, `interval`, `guild_id`, `status` or `session_id`. Validating those params
// here would silently do nothing (they would always read as absent) and would make this
// page never work for a real visitor. CheckoutLauncher itself is the one place that reads
// and validates the query string, client-side after hydration, against a closed set --
// see its own header comment for the full reasoning and the security rule it enforces.
//
// The one exception is layout, never content: a head script reads the query string before
// first paint only to decide whether the guild step will draw (the same rule as
// showsGuildStep, never echoed), and if so marks <html data-checkout-step="guild"> with the
// skeleton card count. The CSS below then holds the guild step's loading height from the first
// paint and hides the static narrow body, so hydration and /v1/me move no footer (spec §7,
// §11: CLS at most 0.02). The same signal reveals the band's static Guild summary frame, so the
// LCP text (the size line) is in the first HTML instead of waiting for hydration, and
// `client:after-paint` keeps the island's scripts behind that first paint (as on /guild), so
// Lighthouse's throttled trace does not put hydration ahead of it.
import Base from '../../layouts/Base.astro';
import CheckoutLauncher from '../../components/CheckoutLauncher.svelte';
import {
  DEFAULT_GUILD_COUNT,
  MAX_GUILD_COUNT,
  ME_GUILD_COUNT_KEY,
  MIN_GUILD_COUNT,
} from '../../lib/account/premium-hint';
import {
  CHECKOUT_BAND_ATTRIBUTE,
  GUILD_CARDS_PROPERTY,
  GUILD_LOADING_ATTRIBUTE,
  guildFrameReserve,
} from '../../lib/billing/checkout-layout';
import { checkoutGuildCopy } from '../../lib/billing/checkout-guild-copy';
import { INTERVALS, PLANS, PLAN_ORDER } from '../../lib/billing/plans';

const guildPlans = PLAN_ORDER.filter((key) => PLANS[key].guild);
const phone = guildFrameReserve('phone');
const md = guildFrameReserve('md');
const lg = guildFrameReserve('lg');
---

<Base title="Checkout" description="Continue to checkout." path="/premium/checkout">
  <script
    slot="head"
    is:inline
    define:vars={{
      key: ME_GUILD_COUNT_KEY,
      guildPlans,
      intervals: INTERVALS,
      min: MIN_GUILD_COUNT,
      max: MAX_GUILD_COUNT,
      fallback: DEFAULT_GUILD_COUNT,
      raidGuildSizeLine: checkoutGuildCopy.sizeLine.raidGuild,
      cardsProperty: GUILD_CARDS_PROPERTY,
      loadingAttribute: GUILD_LOADING_ATTRIBUTE,
      bandAttribute: CHECKOUT_BAND_ATTRIBUTE,
    }}
  >
    // Layout only: the launcher still validates every param after hydration.
    const params = new URLSearchParams(location.search);
    if (
      guildPlans.includes(params.get('plan')) &&
      intervals.includes(params.get('interval')) &&
      !params.has('guild_id') &&
      !params.has('comeback') &&
      params.get('status') !== 'success'
    ) {
      // readMeGuildCount's clamp, so the reserve holds exactly the skeleton's card count.
      let cards = fallback;
      try {
        const stored = localStorage.getItem(key);
        const count = stored === null || stored.trim() === '' ? NaN : Math.round(Number(stored));
        if (Number.isFinite(count)) cards = Math.min(max, Math.max(min, count));
      } catch {
        // Storage blocked: the default count.
      }
      document.documentElement.dataset.checkoutStep = 'guild';
      // The band's static frame carries the Guild size line (the LCP text); Raid guild's differs.
      if (params.get('plan') === 'raid_guild') {
        document.addEventListener('DOMContentLoaded', () => {
          const line = document.querySelector('[data-testid="checkout-size-line"]');
          if (line) line.textContent = raidGuildSizeLine;
        });
      }
      document.documentElement.style.setProperty(cardsProperty, String(cards));
      document.documentElement.setAttribute(loadingAttribute, '');
    } else if (
      params.get('plan') === 'premium' &&
      intervals.includes(params.get('interval')) &&
      !params.has('guild_id')
    ) {
      // plan=premium's band carries its h1 alone and hugs it (CheckoutBand.svelte's CSS).
      document.documentElement.setAttribute(bandAttribute, 'premium');
    }
  </script>
  <!-- No measure: the island draws the full-bleed band (its h1 and its height reserve, spec
       §5.1 / §7) on its static render, then the guild step's 880 column or the narrow message
       and plan=premium column under it. -->
  <main id="main" tabindex="-1" class="checkout-main flex w-full flex-col" data-testid="checkout-main">
    <CheckoutLauncher client:after-paint />
  </main>
</Base>

<style
  define:vars={{
    phoneFixed: phone.fixedPx,
    phoneCard: phone.perCardPx,
    mdFixed: md.fixedPx,
    mdCard: md.perCardPx,
    lgFixed: lg.fixedPx,
    lgCard: lg.perCardPx,
  }}
>
  /* This page's two columns, through the site's measure classes (one column system, no page
     container of its own): .measure-form is the 640 px message and Premium panel column
     (spec §4.2), .measure-wide the guild step's 880 px column (§5.1). */
  .checkout-main {
    --measure-form: 640px;
    --measure-wide: 880px;
  }
  /* The guild step's height from the first paint while it loads: band, step padding, lead, the
     skeleton's cards and the foot (checkout-layout.ts guildFrameReserve), and at least the
     viewport, so the site footer starts below the fold. CheckoutGuildStep removes
     --checkout-guild-cards (GUILD_CARDS_PROPERTY) once rows or an empty state render, which voids
     the declaration and lets the page be as tall as its content. */
  :global(html[data-checkout-step='guild']) .checkout-main {
    min-height: max(calc((var(--phoneFixed) + var(--checkout-guild-cards) * var(--phoneCard)) * 1px), 100svh);
  }
  /* While the step loads, the site footer keeps its box but is not drawn (checkout-layout.ts
     GUILD_LOADING_ATTRIBUTE): released with the reserve, it is first drawn at its final place, so
     a card taller or shorter than its skeleton never moves it on screen. */
  :global(html[data-checkout-loading] .page-column ~ footer) {
    visibility: hidden;
  }
  /* The static render's narrow body ("Redirecting…") is never the guild step's: keep its box,
     show nothing, until hydration swaps in the step. */
  :global(html[data-checkout-step='guild']) .checkout-main :global([data-testid='checkout-body']) {
    visibility: hidden;
  }
  @media (min-width: 768px) {
    :global(html[data-checkout-step='guild']) .checkout-main {
      min-height: max(calc((var(--mdFixed) + var(--checkout-guild-cards) * var(--mdCard)) * 1px), 100svh);
    }
  }
  @media (min-width: 1024px) {
    :global(html[data-checkout-step='guild']) .checkout-main {
      min-height: max(calc((var(--lgFixed) + var(--checkout-guild-cards) * var(--lgCard)) * 1px), 100svh);
    }
  }
</style>
