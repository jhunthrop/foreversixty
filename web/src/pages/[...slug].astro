---
// web/src/pages/[...slug].astro
// One page per `pages` collection entry (the legal pages, About), drawn by
// layouts/Content.astro. The privacy page gains its Log coach section before Cookies.
import { getCollection } from 'astro:content';
import Content from '../layouts/Content.astro';
import { coachPrivacySection, withCoachSection } from '../lib/coach/privacy-section';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const html = page.rendered?.html;
if (html === undefined) throw new Error(`page ${page.id} has no rendered body`);
---

<Content
  slug={page.id}
  title={page.data.title}
  description={page.data.description}
  updated={page.data.updated}
  html={withCoachSection(page.id, html, coachPrivacySection())}
/>
