---
// web/src/pages/setup.astro
// Get set up (design/specs/2026-11-07-setup.md section 4): sign in, the addon and the companion
// as one Plate of three steps, then the Sections that explain each. The whole page is one island
// (components/setup/SetupPage.svelte), because its head's answer, its steps and its quiet install
// links all follow one account read; the server markup is the signed-out page.
import Base from '../layouts/Base.astro';
import SetupPage from '../components/setup/SetupPage.svelte';
import { addonCopy } from '../lib/addon/copy';
---

<Base title={addonCopy.setupPageTitle} description={addonCopy.pageDescription} path="/setup" wide>
  <main id="main" tabindex="-1" class="flex w-full flex-col" data-testid="setup-page">
    <!-- `client:after-paint`, not `client:load` (src/directives/after-paint.ts): the island's module
         chain stays behind the server-drawn first paint, which Lighthouse would otherwise charge to
         LCP (as on /planner, /guild and /rankings). The pre-paint hints keep the plate right until then. -->
    <SetupPage client:after-paint />
  </main>
</Base>
