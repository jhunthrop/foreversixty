---
// web/src/pages/setup.astro
// Sign in, the addon, and the companion, in one page (spec 2026-09-25 §3.4), replacing
// /addon. Reference voice: state the thing and stop.
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import AddonPasteBox from '../components/AddonPasteBox.svelte';
import CurrentCharacterBar from '../components/CurrentCharacterBar.svelte';
import { addonCopy } from '../lib/addon/copy';
import { battlenetStartUrl } from '../lib/account/api';
import { PRIMARY_BUTTON_FIXED } from '../lib/planner/styles';
import companion from '../data/companion.json';
import activeBuild from '../data/active-build.json';
import communityLinks from '../data/links.json';

// CurseForge is addressed by project id (the ids in the two TOCs' X-Curse-Project-ID lines;
// the site redirects an id to the project's page, whatever its slug), Wago by the slugs its
// pages answer to. The GitHub ones derive from links.json's githubRepo, the same source
// Footer.astro's Contribute link uses; the data pack is released nightly under its own tag.
export const CURSEFORGE_URL = 'https://www.curseforge.com/projects/1706689';
export const WAGO_URL = 'https://addons.wago.io/addons/foreversixty';
export const GITHUB_RELEASES_URL = `${communityLinks.githubRepo}/releases/latest`;
export const DATA_CURSEFORGE_URL = 'https://www.curseforge.com/projects/1706707';
export const DATA_WAGO_URL = 'https://addons.wago.io/addons/foreversixtydata';
export const DATA_GITHUB_RELEASES_URL = `${communityLinks.githubRepo}/releases?q=data-v`;

const links = [
  { label: addonCopy.installCurseForge, href: CURSEFORGE_URL },
  { label: addonCopy.installWago, href: WAGO_URL },
  { label: addonCopy.installGitHub, href: GITHUB_RELEASES_URL },
];

const dataLinks = [
  { label: addonCopy.installDataCurseForge, href: DATA_CURSEFORGE_URL },
  { label: addonCopy.installDataWago, href: DATA_WAGO_URL },
  { label: addonCopy.installDataGitHub, href: DATA_GITHUB_RELEASES_URL },
];

const flows = [
  { title: addonCopy.flowOutTitle, body: addonCopy.flowOutBody },
  { title: addonCopy.flowInTitle, body: addonCopy.flowInBody },
  { title: addonCopy.inGameTitle, body: addonCopy.inGameBody },
];
---

<Base title={addonCopy.setupPageTitle} description={addonCopy.pageDescription} path="/setup">
  <main id="main" tabindex="-1" class="measure-wide flex flex-col gap-5 px-[18px] py-10 md:px-0">
    <header class="flex flex-col gap-3">
      <h1 class="text-[28px] font-bold tracking-[0.02em]">{addonCopy.setupPageTitle}</h1>
      <p class="text-muted text-[15px]">{addonCopy.pageDescription}</p>
      <!-- The checklist at a glance. Each item has a done and a not-done reading; global.css
           shows one of them from the <html> hints, so a signed-in visitor with an export
           loaded sees two ticks before any script runs. The companion has no hint of its own
           (pairing lives on the account), so it never reads as done here. -->
      <ol class="label text-muted flex flex-wrap gap-x-5 gap-y-1" data-testid="setup-status">
        <li class="flex items-center gap-2">
          <span
            class="setup-when-out border-line-warm inline-block size-3 rounded-full border"
            aria-hidden="true"
          ></span>
          <span class="setup-when-in bg-gold inline-block size-3 rounded-full" aria-hidden="true"></span>
          <span class="setup-when-out">{addonCopy.setupStatusSignIn}</span>
          <span class="setup-when-in">{addonCopy.setupStatusSignedIn}</span>
        </li>
        <li class="flex items-center gap-2">
          <span
            class="setup-when-no-pointer border-line-warm inline-block size-3 rounded-full border"
            aria-hidden="true"
          ></span>
          <span class="setup-when-pointer bg-gold inline-block size-3 rounded-full" aria-hidden="true"></span>
          <span class="setup-when-no-pointer">{addonCopy.setupStatusAddon}</span>
          <span class="setup-when-pointer">{addonCopy.setupStatusAddonDone}</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="border-line-warm inline-block size-3 rounded-full border" aria-hidden="true"></span>
          <span>{addonCopy.setupStatusCompanion}</span>
        </li>
      </ol>
    </header>

    <Panel title={addonCopy.setupStep1Title}>
      <div class="flex flex-col gap-3 p-[18px]">
        <p class="text-muted text-[14px] leading-relaxed">{addonCopy.setupSignInBody}</p>
        <p class="text-muted text-[14px] leading-relaxed">{addonCopy.setupSignInRealmNote}</p>
        <a
          class={`setup-when-out ${PRIMARY_BUTTON_FIXED} px-5 w-fit`}
          href={battlenetStartUrl('/account?signed_in=1')}
        >
          {addonCopy.setupSignInAction}
        </a>
        <p class="setup-when-in text-[14px]" data-testid="setup-signed-in">
          {addonCopy.setupSignedInLine}{' '}
          <a class="text-nav underline" href="/account">
            {addonCopy.setupSignedInLink}
          </a>
        </p>
      </div>
    </Panel>

    <Panel title={addonCopy.setupStep2Title}>
      <div id="addon" class="flex scroll-mt-20 flex-col gap-4 p-[18px]">
        <p class="text-muted text-[13px]">{addonCopy.currentDataBuild(activeBuild.build)}</p>
        <ul class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-6">
          {links.map((link) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-[14px] font-semibold underline underline-offset-2"
                href={link.href}
                rel="noopener"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-muted text-[14px] leading-relaxed" data-testid="setup-data-addon">
          {addonCopy.installDataLead}
        </p>
        <ul class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-6">
          {dataLinks.map((link) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-[14px] font-semibold underline underline-offset-2"
                href={link.href}
                rel="noopener"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="setup-when-pointer text-[14px]" data-testid="setup-addon-done">
          {addonCopy.setupAddonDoneLine}
        </p>
        <AddonPasteBox client:idle />
        <CurrentCharacterBar client:idle hasOwnPasteBox />
        <!-- Task L8.3: what the addon does in the game, one row per surface of the addon-v2
             spec's §4 in its order, with crops of real client captures (lazy, each in a box
             of its own aspect so nothing below moves as they load); then the /fs commands
             and the companion handshake. A surface with no capture shows no image. -->
        <section
          class="flex flex-col gap-5 pt-2"
          data-testid="setup-surfaces"
          aria-labelledby="setup-surfaces-title"
        >
          <h3 id="setup-surfaces-title" class="label text-muted">
            {addonCopy.surfacesTitle}
          </h3>
          <ol class="flex flex-col gap-6">
            {addonCopy.surfaces.map((surface) => (
              <li class="flex flex-col gap-2" data-surface={surface.section}>
                <h4 class="text-[15px] font-semibold">{surface.title}</h4>
                <p class="text-muted text-[14px] leading-relaxed">{surface.body}</p>
                {surface.images.map((image) => (
                  <div
                    class={`border-line-soft rounded-control bg-raised w-full overflow-hidden border ${image.tall ? 'max-h-[900px]' : 'max-h-[420px]'}`}
                    style={`max-width: ${image.width}px; aspect-ratio: ${image.width} / ${image.height}`}
                  >
                    <a class="block h-full w-full" href={image.src}>
                      <img
                        class="block h-full w-full object-contain"
                        src={image.src}
                        width={image.width}
                        height={image.height}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </div>
                ))}
              </li>
            ))}
          </ol>
          <div class="flex flex-col gap-2" data-testid="setup-commands">
            <h3 class="label text-muted">{addonCopy.commandsTitle}</h3>
            <ul class="flex flex-col gap-1 text-[14px]">
              {addonCopy.commands.map(({ command, description }) => (
                <li>
                  <code class="font-mono text-[13px] font-bold">{command}</code>
                  <span class="text-muted">: {description}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-col gap-1 pt-1">
              <h4 class="label text-muted text-[11px]">{addonCopy.commandsTestersLabel}</h4>
              <p class="text-muted font-mono text-[12px]">{addonCopy.commandsTestersLine}</p>
            </div>
          </div>
          <div class="flex flex-col gap-2" data-testid="setup-handshake">
            <h3 class="label text-muted">{addonCopy.handshakeTitle}</h3>
            <p class="text-muted text-[14px] leading-relaxed">{addonCopy.handshake.join(' ')}</p>
            <p class="text-muted text-[14px] leading-relaxed">{addonCopy.pageNoNetwork}</p>
          </div>
        </section>
        <details class="border-line rounded-control border">
          <summary class="label text-nav flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 select-none">
            {addonCopy.setupHowItWorks}
            <span class="when-closed text-muted" aria-hidden="true">
              {addonCopy.disclosureOpen}
            </span>
            <span class="when-open text-muted" aria-hidden="true">
              {addonCopy.disclosureClose}
            </span>
          </summary>
          <div class="grid gap-4 px-4 pb-4 md:grid-cols-3">
            {flows.map((flow) => (
              <div class="border-line-soft rounded-control border p-4">
                <h3 class="label text-muted mb-2">{flow.title}</h3>
                <p class="text-muted text-[14px] leading-relaxed">{flow.body}</p>
              </div>
            ))}
          </div>
        </details>
      </div>
    </Panel>

    <Panel title={addonCopy.setupStep3Title}>
      <div id="companion" class="flex scroll-mt-20 flex-col gap-4 p-[18px]">
        <p id="logging" class="text-muted text-[14px] leading-relaxed">{addonCopy.setupCompanionBody}</p>
        <div class="flex flex-col gap-2">
          <h3 class="label text-muted">{addonCopy.setupCompanionDownloadLead}</h3>
          <ul
            class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-6"
            data-testid="setup-companion-downloads"
          >
            {companion.downloads.map((entry) => (
              <li>
                <a
                  class="inline-flex min-h-11 items-center text-[14px] font-semibold underline underline-offset-2"
                  href={`${companion.releasesUrl}/latest/download/${entry.asset}`}
                  rel="noopener"
                >
                  {entry.platform}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <p class="text-[14px]" data-testid="setup-companion-pair">{addonCopy.setupCompanionPair}</p>
      </div>
    </Panel>
  </main>
</Base>
