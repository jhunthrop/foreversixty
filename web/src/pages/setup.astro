---
// web/src/pages/setup.astro
// Sign in, the addon, and the companion, in one page (spec 2026-09-25 §3.4), replacing
// /addon. Reference voice: state the thing and stop. Each step is one gold button and, signed
// in, one line saying whether the account shows it done (W.9; UX review r5, finding 2).
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import AddonPasteBox from '../components/AddonPasteBox.svelte';
import CurrentCharacterBar from '../components/CurrentCharacterBar.svelte';
import SetupProgress from '../components/SetupProgress.svelte';
import SetupBackToClaim from '../components/claim/SetupBackToClaim.svelte';
import SetupStepLine from '../components/SetupStepLine.svelte';
import { companionPlatformsLine } from '../lib/setup/progress';
import { addonCopy } from '../lib/addon/copy';
import { battlenetStartUrl } from '../lib/account/api';
import { button } from '../lib/ui/button';
import Disclosure from '../components/ui/Disclosure.astro';
import companion from '../data/companion.json';
import activeBuild from '../data/active-build.json';
import communityLinks from '../data/links.json';

// CurseForge is addressed by project id (the ids in the two TOCs' X-Curse-Project-ID lines;
// the site redirects an id to the project's page, whatever its slug), Wago by the slugs its
// pages answer to. The GitHub ones derive from links.json's githubRepo, the same source
// Footer.astro's Contribute link uses; the data pack is released nightly under its own tag.
export const CURSEFORGE_URL = 'https://www.curseforge.com/projects/1706689';
export const WAGO_URL = 'https://addons.wago.io/addons/foreversixty';
export const GITHUB_RELEASES_URL = `${communityLinks.githubRepo}/releases/latest`;
export const DATA_GITHUB_RELEASES_URL = `${communityLinks.githubRepo}/releases?q=data-v`;

// CurseForge is the step's button; Wago and the zip are secondary buttons beside it in one row.
const otherInstalls = [
  { label: addonCopy.installWago, href: WAGO_URL },
  { label: addonCopy.installGitHub, href: GITHUB_RELEASES_URL },
];

// The manual-install disclosure keeps only the hand-install downloads: the addon zip and the data release.
const manualLinks = [
  { label: addonCopy.installGitHub, href: GITHUB_RELEASES_URL },
  { label: addonCopy.installDataGitHub, href: DATA_GITHUB_RELEASES_URL },
];

// The "how it arrives" line carries the export disclosure's title as a link that opens that disclosure.
// The pointer phrase around the link never breaks: the spaces beside the link are non-breaking and the link is nowrap.
const NO_BREAK_SPACE = '\u00A0';
const [arrivesLeadRaw, arrivesTailRaw] = addonCopy.setupHowItArrives.split(addonCopy.setupTryExport);
const arrivesLead = arrivesLeadRaw.replace(/ $/, NO_BREAK_SPACE);
const arrivesTail = arrivesTailRaw.replace(/^ /, NO_BREAK_SPACE);

const downloadUrl = (asset: string): string => `${companion.releasesUrl}/latest/download/${asset}`;
// The first download is the step's button; any other platform is a secondary button beside it.
const [primaryDownload, ...otherDownloads] = companion.downloads;
const platformsLine = companionPlatformsLine(companion.downloads.map((entry) => entry.platform));
const capture = addonCopy.setupCompanionCapture;

const flows = [
  { title: addonCopy.flowOutTitle, body: addonCopy.flowOutBody },
  { title: addonCopy.flowInTitle, body: addonCopy.flowInBody },
  { title: addonCopy.inGameTitle, body: addonCopy.inGameBody },
];

// One button per step; only the first undone step's is primary, the others stay secondary until
// their turn (global.css, .setup-btn; SetupProgress.svelte says which step is first).
const STEP_BUTTON = `${button('secondary', 'md')} setup-btn w-fit`;
const SECONDARY_ACTION = `${button('secondary', 'md')} max-w-full w-fit !h-auto min-h-11 py-2 !whitespace-normal text-center`;
---

<Base title={addonCopy.setupPageTitle} description={addonCopy.pageDescription} path="/setup">
  <main id="main" tabindex="-1" class="measure-wide flex flex-col gap-5 px-[18px] py-10 md:px-0">
    <header class="flex flex-col gap-3">
      <h1 class="heading-page">{addonCopy.setupPageTitle}</h1>
      <p class="text-muted text-[15px]">{addonCopy.setupSubline}</p>
      <!-- The checklist at a glance: three numbered anchors, gold with a check once the account
           shows the step done. They read the <html> hints before any script runs (global.css). -->
      <SetupProgress client:idle />
      <SetupBackToClaim client:only="svelte" />
    </header>

    <Card glyph="user" title={addonCopy.setupStep1Title} body="none">
      <div id="signin" class="flex scroll-mt-20 flex-col gap-3 border-line-soft border-t px-5 py-4">
        <p class="text-pretty text-muted text-[14px] leading-relaxed">{addonCopy.setupSignInBody}</p>
        <a
          class={`setup-when-out ${STEP_BUTTON}`}
          data-step="1"
          href={battlenetStartUrl('/account?signed_in=1')}
        >
          {addonCopy.setupSignInAction}
        </a>
        <SetupStepLine step="signin" client:idle />
      </div>
    </Card>

    <Card glyph="download" title={addonCopy.setupStep2Title} body="none">
      <div id="addon" class="flex scroll-mt-20 flex-col gap-4 border-line-soft border-t px-5 py-4">
        <div class="flex flex-wrap gap-3">
          <a class={STEP_BUTTON} data-step="2" href={CURSEFORGE_URL} rel="noopener">
            {addonCopy.installCurseForge}
          </a>
          {otherInstalls.map((link) => (
            <a class={SECONDARY_ACTION} href={link.href} rel="noopener">
              {link.label}
            </a>
          ))}
        </div>
        <p class="text-pretty text-muted text-[13px] leading-relaxed" data-testid="setup-data-addon">
          {addonCopy.installDataHint}
        </p>
        <p class="text-pretty text-[14px] leading-relaxed" data-testid="setup-how-it-arrives">
          {arrivesLead}
          <a href="#paste" class="whitespace-nowrap" data-open-disclosure="setup-try-export">
            {addonCopy.setupTryExport}
          </a>
          {arrivesTail}
        </p>
        <p class="text-pretty setup-when-out setup-when-pointer text-[14px]" data-testid="setup-addon-done">
          {addonCopy.setupAddonDoneLine}
        </p>
        <SetupStepLine step="addon" client:idle />
        <CurrentCharacterBar client:idle hasOwnPasteBox />

        <!-- Behind disclosures, so the step reads as one button and a line: the export paste box,
             the data addon's own links and the build number, and the manual (what the addon does
             in the game, its commands, the handshake and the flows). A link to #paste, or to a
             step's anchor, opens the disclosure that holds it (the script below). -->
        <Disclosure title={addonCopy.setupTryExport} testid="setup-try-export">
          <div class="flex flex-col gap-3 px-4 pb-4">
            <p class="text-pretty text-muted text-[14px] leading-relaxed" data-testid="setup-export-what">
              {addonCopy.setupTryExportBody}
            </p>
            <AddonPasteBox client:idle heading={false} />
          </div>
        </Disclosure>

        <Disclosure title={addonCopy.setupManualInstall} testid="setup-manual-install" open>
          <div class="flex flex-col gap-3 px-4 pb-4">
            <p class="text-pretty text-muted text-[14px] leading-relaxed">{addonCopy.installDataLead}</p>
            <div class="flex flex-wrap gap-3">
              {manualLinks.map((link) => (
                <a class={SECONDARY_ACTION} href={link.href} rel="noopener">
                  {link.label}
                </a>
              ))}
            </div>
            <p class="text-pretty text-muted text-[13px]">{addonCopy.currentDataBuild(activeBuild.build)}</p>
          </div>
        </Disclosure>

        <!-- Task L8.3: what the addon does in the game, one row per surface of the addon-v2
             spec's §4 in its order, with crops of real client captures (lazy, each in a box
             of its own aspect so nothing below moves as they load); then the /fs commands
             and the companion handshake. A surface with no capture shows no image. -->
        <Disclosure title={addonCopy.setupEverything} testid="setup-everything">
          <div class="flex flex-col gap-5 px-4 pb-4">
            <section
              class="flex flex-col gap-5 pt-2"
              data-testid="setup-surfaces"
              aria-labelledby="setup-surfaces-title"
            >
              <h3 id="setup-surfaces-title" class="label text-muted">
                {addonCopy.surfacesTitle}
              </h3>
              <ol class="flex flex-col gap-6">
                {addonCopy.surfaces.map((surface) => (
                  <li class="flex flex-col gap-2" data-surface={surface.section}>
                    <h4 class="text-[15px] font-semibold">{surface.title}</h4>
                    <p class="text-pretty text-muted text-[14px] leading-relaxed">{surface.body}</p>
                    {surface.images.map((image) => (
                      <div
                        class={`border-line-soft rounded-control bg-raised w-full overflow-hidden border ${image.tall ? 'max-h-[900px]' : 'max-h-[420px]'}`}
                        style={`max-width: ${image.width}px; aspect-ratio: ${image.width} / ${image.height}`}
                      >
                        <a class="block h-full w-full" href={image.src}>
                          <img
                            class="block h-full w-full object-contain"
                            src={image.src}
                            width={image.width}
                            height={image.height}
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      </div>
                    ))}
                  </li>
                ))}
              </ol>
              <div class="flex flex-col gap-2" data-testid="setup-commands">
                <h3 class="label text-muted">{addonCopy.commandsTitle}</h3>
                <ul class="flex flex-col gap-1 text-[14px]">
                  {addonCopy.commands.map(({ command, description }) => (
                    <li>
                      <code class="font-mono text-[13px] font-bold">{command}</code>
                      <span class="text-muted">: {description}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-col gap-2" data-testid="setup-handshake">
                <h3 class="label text-muted">{addonCopy.handshakeTitle}</h3>
                <p class="text-pretty text-muted text-[14px] leading-relaxed">
                  {addonCopy.handshake.join(' ')}
                </p>
                <p class="text-pretty text-muted text-[14px] leading-relaxed">{addonCopy.pageNoNetwork}</p>
              </div>
            </section>
            <div class="flex flex-col gap-3" data-testid="setup-flows">
              <h3 class="label text-muted">{addonCopy.setupHowItWorks}</h3>
              <div class="grid gap-4 md:grid-cols-3">
                {flows.map((flow) => (
                  <div class="border-line-soft rounded-control border p-4">
                    <h3 class="label text-muted mb-2">{flow.title}</h3>
                    <p class="text-pretty text-muted text-[14px] leading-relaxed">{flow.body}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </Disclosure>
      </div>
    </Card>

    <Card glyph="device" title={addonCopy.setupStep3Title} body="none">
      <div id="companion" class="flex scroll-mt-20 flex-col gap-4 border-line-soft border-t px-5 py-4">
        <p class="text-pretty text-muted text-[13px]" data-testid="setup-companion-note">
          {addonCopy.setupCompanionNote}
        </p>
        <div class="flex flex-wrap gap-3" data-testid="setup-companion-downloads">
          <a
            class={STEP_BUTTON}
            data-step="3"
            href={downloadUrl(primaryDownload.asset)}
            rel="noopener"
            data-testid="setup-companion-download"
          >
            {addonCopy.setupCompanionDownload(primaryDownload.platform)}
          </a>
          {otherDownloads.map((entry) => (
            <a class={SECONDARY_ACTION} href={downloadUrl(entry.asset)} rel="noopener">
              {addonCopy.setupCompanionDownload(entry.platform)}
            </a>
          ))}
        </div>
        {platformsLine !== null && (
          <p class="text-pretty text-muted text-[13px]" data-testid="setup-companion-platforms">
            {platformsLine}
          </p>
        )}
        <p id="logging" class="text-pretty text-muted text-[14px] leading-relaxed">
          {addonCopy.setupCompanionBody}
        </p>
        <p class="text-pretty text-[14px]" data-testid="setup-companion-pair">
          {addonCopy.setupCompanionPair}
        </p>
        <SetupStepLine step="companion" client:idle />
        <div class="flex flex-col gap-2">
          <div
            class="setup-capture border-line-soft rounded-control bg-raised relative w-full overflow-hidden border"
            style={`max-width: 800px; --capture-ratio: ${capture.width} / ${capture.height}; --capture-phone-ratio: ${capture.phoneWidth} / ${capture.phoneHeight}`}
            data-testid="setup-companion-capture"
          >
            <picture class="block h-full w-full">
              <source
                media="(max-width: 639px)"
                srcset={capture.phoneSrc}
                width={capture.phoneWidth}
                height={capture.phoneHeight}
              />
              <img
                class="block h-full w-full object-contain"
                src={capture.src}
                width={capture.width}
                height={capture.height}
                alt={capture.alt}
                decoding="async"
              />
            </picture>
          </div>
          <!-- Below the picture, never over it: the companion's own SETTINGS tab and text sit in its corners. -->
          <span
            class="pill pill-sample in-[html[data-session='1']]:hidden w-fit"
            data-session-hide
            data-testid="setup-companion-capture-label"
          >
            {capture.exampleLabel}
          </span>
        </div>
      </div>
    </Card>
  </main>
</Base>

<script>
  // A link to #paste, or to anything else inside a closed disclosure, opens that disclosure and
  // scrolls to the target: the export box and the manual are folded, and the hero's "paste an
  // addon export" lands here.
  function openForHash(): void {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (id === '') return;
    const target = document.getElementById(id);
    let opened = false;
    for (let el = target?.parentElement ?? null; el !== null; el = el.parentElement) {
      if (el instanceof HTMLDetailsElement && !el.open) {
        el.open = true;
        opened = true;
      }
    }
    if (opened) target?.scrollIntoView();
  }
  openForHash();
  // The export link in the how-it-arrives line: open that disclosure and scroll to it.
  document.querySelectorAll<HTMLAnchorElement>('a[data-open-disclosure]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const details = document.querySelector<HTMLDetailsElement>(
        `[data-testid="${link.dataset.openDisclosure}"]`,
      );
      if (details === null) return;
      event.preventDefault();
      details.open = true;
      details.scrollIntoView({ block: 'start' });
    });
  });
  window.addEventListener('hashchange', openForHash);
</script>
