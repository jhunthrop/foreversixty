---
// web/src/pages/setup.astro
// Sign in, the addon, and the companion, in one page (spec 2026-09-25 §3.4), replacing
// /addon. Reference voice: state the thing and stop.
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import AddonPasteBox from '../components/AddonPasteBox.svelte';
import CurrentCharacterBar from '../components/CurrentCharacterBar.svelte';
import { addonCopy } from '../lib/addon/copy';
import { battlenetStartUrl } from '../lib/account/api';
import { SECONDARY_BUTTON_FIXED } from '../lib/planner/styles';
import activeBuild from '../data/active-build.json';
import communityLinks from '../data/links.json';

// See addon.astro's own history for why these three URLs are not yet live: they are this
// addon's own project slugs on CurseForge/Wago, created once the projects exist there. The
// GitHub one is derived from links.json's githubRepo, the same source Footer.astro's
// Contribute link uses.
export const CURSEFORGE_URL = 'https://www.curseforge.com/wow/addons/foreversixty';
export const WAGO_URL = 'https://addons.wago.io/addons/foreversixty';
export const GITHUB_RELEASES_URL = `${communityLinks.githubRepo}/releases/latest`;

const links = [
  { label: addonCopy.installCurseForge, href: CURSEFORGE_URL },
  { label: addonCopy.installWago, href: WAGO_URL },
  { label: addonCopy.installGitHub, href: GITHUB_RELEASES_URL },
];

const flows = [
  { title: addonCopy.flowOutTitle, body: addonCopy.flowOutBody },
  { title: addonCopy.flowInTitle, body: addonCopy.flowInBody },
  { title: addonCopy.inGameTitle, body: addonCopy.inGameBody },
];
---

<Base title={addonCopy.pageTitle} description={addonCopy.pageDescription} path="/setup" session>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1000px] flex-col gap-5 px-[18px] py-10 md:px-12"
  >
    <header class="flex flex-col gap-2">
      <h1 class="text-[28px] font-bold tracking-[0.02em]">{addonCopy.pageTitle}</h1>
      <p class="text-muted text-[15px]">{addonCopy.pageDescription}</p>
    </header>

    <Panel title={addonCopy.setupStep1Title}>
      <div class="flex flex-col gap-3 p-[18px]">
        <p class="text-muted text-[14px] leading-relaxed">{addonCopy.setupSignInBody}</p>
        <a
          class={`${SECONDARY_BUTTON_FIXED} border-line-warm-strong text-strong px-4 w-fit`}
          href={battlenetStartUrl('/account?signed_in=1')}
        >
          {addonCopy.setupSignInAction}
        </a>
      </div>
    </Panel>

    <Panel title={addonCopy.setupStep2Title}>
      <div class="flex flex-col gap-4 p-[18px]">
        <p class="text-muted text-[13px]">{addonCopy.pageNoNetwork}</p>
        <p class="text-muted text-[13px]">{addonCopy.currentDataBuild(activeBuild.build)}</p>
        <ul class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-6">
          {links.map((link) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center text-[14px] font-semibold underline underline-offset-2"
                href={link.href}
                rel="noopener"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <AddonPasteBox client:load />
        <CurrentCharacterBar client:load hasOwnPasteBox />
        <div class="grid gap-4 md:grid-cols-2">
          {flows.map((flow) => (
            <div class="border-line rounded-control border p-4">
              <h3 class="label text-muted mb-2">{flow.title}</h3>
              <p class="text-muted text-[14px] leading-relaxed">{flow.body}</p>
            </div>
          ))}
        </div>
      </div>
    </Panel>

    <Panel title={addonCopy.setupStep3Title}>
      <p class="text-muted p-[18px] text-[14px] leading-relaxed">{addonCopy.setupCompanionBody}</p>
    </Panel>
  </main>
</Base>
