---
// web/src/pages/connect.astro
// /connect (setup spec 2026-11-07 section 6): the system Page in its form layout, one 560 px
// column under the PageHeader. The whole page is the island: its H1 is the state's title and the
// code comes from the query, which a static build only sees in the browser.
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.svelte';
---

<Base
  title="Connect your companion"
  description="Approve the Forever Sixty companion on your account."
  path="/connect"
  wide
>
  <main id="main" tabindex="-1">
    <Connect client:load />
  </main>
</Base>
