---
// web/src/pages/creators/index.astro
// /creators: the public page about the creator program (design/specs/2026-11-08-creator-program.md 3e).
// A document: the PageHeader with Apply, then a ReadingSection per part of programCopy, then Apply
// again. Indexed and in the sitemap; the footer's About column links it. Apply goes to /creators/apply,
// which asks a signed-out visitor to sign in with Battle.net and comes back there.
import Base from '../../layouts/Base.astro';
import Page from '../../components/ui/Page.svelte';
import PageHeader from '../../components/ui/PageHeader.svelte';
import Prose from '../../components/ui/Prose.svelte';
import ReadingSection from '../../components/ui/ReadingSection.svelte';
import { programCopy as copy } from '../../lib/creators/copy';
import { button } from '../../lib/ui/button';

const APPLY = '/creators/apply';
const escape = (s: string): string => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const paragraphs = (lines: readonly string[]): string => lines.map((l) => `<p>${escape(l)}</p>`).join('');
---

<Base title={copy.pageTitle} description={copy.pageDescription} path="/creators" wide>
  <main id="main" tabindex="-1" class="pb-(--section-gap)" data-testid="creators-program">
    <Page layout="reading" tocFrom={0} testid="creators-program-body">
      <PageHeader slot="header" title={copy.pageTitle} lead={copy.lead}>
        <a slot="actions" class={button('primary')} href={APPLY} data-testid="creators-apply-top">
          {copy.apply}
        </a>
      </PageHeader>
      {copy.sections.map((section) => (
        <ReadingSection title={section.title} anchor={section.id} testid={`creators-section-${section.id}`}>
          <Prose html={paragraphs(section.paragraphs)} />
        </ReadingSection>
      ))}
      <ReadingSection title={copy.applyTitle} anchor="apply" testid="creators-section-apply">
        <Prose html={paragraphs([copy.applyLead])} />
        <div class="mt-2">
          <a class={button('primary')} href={APPLY} data-testid="creators-apply-end">
            {copy.apply}
          </a>
        </div>
      </ReadingSection>
    </Page>
  </main>
</Base>
