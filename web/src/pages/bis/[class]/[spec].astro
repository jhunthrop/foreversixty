<script is:inline>
  // Not an island: a plain inline script, no framework, so `?faction=horde` opens on the
  // right panel without paying for a hydrated component the way the rest of this page
  // (two SSR lists plus a CSS radio toggle) never does either.
  (function () {
    const faction = new URLSearchParams(window.location.search).get('faction');
    if (faction === 'horde') {
      const input = document.getElementById('faction-horde');
      if (input) input.checked = true;
    }
  })();

  // Arrow-key band navigation: focus never leaves the level scale's own links, and moving
  // focus also follows the link (the same `#band-<faction>-<band>` CSS `:target` toggle a
  // click already drives), so the keyboard path and the pointer path land on the exact same
  // state rather than two behaviours to keep in sync.
  (function () {
    document.querySelectorAll('[data-band-strip]').forEach(function (strip) {
      strip.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        const links = Array.prototype.slice.call(strip.querySelectorAll('[data-band-link]'));
        const index = links.indexOf(document.activeElement);
        if (index === -1) return;
        const nextIndex =
          event.key === 'ArrowRight' ? Math.min(index + 1, links.length - 1) : Math.max(index - 1, 0);
        const next = links[nextIndex];
        if (!next) return;
        event.preventDefault();
        next.focus();
        next.click();
      });
    });
  })();

  // Edge fades for the level scale on a narrow screen (night-sim-tabs' own pattern,
  // SimTabs.astro): only present on whichever side still has tabs scrolled out of view, and
  // desktop never overflows (the level scale fits one row well under 1120px), so the fades
  // stay hidden there without a breakpoint check.
  (function () {
    const EPSILON_PX = 1;
    document.querySelectorAll('[data-band-strip]').forEach(function (nav) {
      const wrap = nav.parentElement;
      const fadeStart = wrap && wrap.querySelector('.edge-fade-start');
      const fadeEnd = wrap && wrap.querySelector('.edge-fade-end');
      if (!fadeStart || !fadeEnd) return;
      const updateFades = function () {
        const hiddenStart = nav.scrollLeft > EPSILON_PX;
        const hiddenEnd = nav.scrollLeft + nav.clientWidth < nav.scrollWidth - EPSILON_PX;
        fadeStart.classList.toggle('is-visible', hiddenStart);
        fadeEnd.classList.toggle('is-visible', hiddenEnd);
      };
      nav.addEventListener('scroll', updateFades, { passive: true });
      window.addEventListener('resize', updateFades);
      updateFades();
    });
  })();
</script>
