---
// web/src/pages/bis/[class]/[spec].astro
// One page per written spec (data/curated/specs.json -- the same catalog the rotation
// accuracy program measures against), static, no island above the fold: two SSR faction
// panels toggled by hidden radio inputs and plain CSS (the `has-[:checked]` pattern
// Upload.svelte already uses), band pills toggled by CSS `:target` within each panel. The
// only scripts on the page are tiny inline ones (never a hydrated island): one syncs the
// faction radios from `?faction=` on load, one lets arrow keys move focus along the level
// scale, and one shows/hides the level scale's own edge fades on narrow screens (the same
// pattern SimTabs.astro uses for its tab strip) -- so a shared `?faction=horde` link,
// keyboard band navigation and a scrollable phone-width level scale all work without
// shipping a framework runtime for any of them.
//
// Redesign (lane bis-ux, 2026-09-29 -- owner: "still looks like shit" on a level-20 hunter
// screenshot at 1280px): the list of gear is the product (docs/tenets.md), so it now comes
// first, one row per slot with the item's own icon, quality colour, key stats and a single
// real source line -- never a repeated-word chip stack. The level scale is a compact,
// single-row tab strip (numbers only) instead of the twelve wrapping buttons the screenshot
// showed, and "what changed since level N" is a single disclosure line under the list
// instead of a wall of diff rows sitting above it.
//
// Every gear mention on this page (a slot row, a runner-up, a "what changed" before/after)
// used to be its own `ItemHover` island (`client:idle`) -- lane `web-item-tooltips`'s own
// component (`components/ItemHover.svelte`, `components/ItemTooltip.svelte`, `lib/items/
// *`), fed a pre-resolved `model` (the shared `ItemTooltipModel`) built from `itemDetails`
// at build time. 11 bands x 17 slots x 2 factions, plus runner-ups and the diff, put roughly
// 840 of those islands on one page -- 2.5 MB of HTML and CI's own Lighthouse mobile run over
// the 100ms total-blocking-time budget (lighthouserc.json) on every deploy.
//
// Lane bis-tooltip-host (2026-09-29): every mention below is now plain server markup (an
// icon, a quality-coloured name, a `data-bis-item="<id>"` attribute) -- the row's own custom
// 36px layout inline, the smaller mentions via `ItemPill.astro` -- and the page collects
// every model it built (`tooltipFor`, unchanged) into ONE deduplicated map, handed to a
// single `BisTooltipHost` island (`client:idle`) as a sibling JSON `<script>` tag rather
// than the island's own (HTML-attribute-escaped) props. That one island owns hover/focus/
// tap open-close for the whole page, delegated from one listener set instead of 840 Svelte
// instances.
import Base from '../../../layouts/Base.astro';
import UpdatedStamp from '../../../components/UpdatedStamp.astro';
import BisTooltipHost from '../../../components/BisTooltipHost.svelte';
import ItemPill from '../../../components/bis/ItemPill.astro';
import { readItemTooltipModel } from '../../../lib/items/lookup';
import { buildWeightDisplayRows, type WeightDisplayRow } from '../../../lib/sim/weights-display';
import type { ItemTooltipModel } from '../../../lib/items/tooltip';
import SlotIcon from '../../../components/bis/SlotIcon.astro';
import SourceKindIcon from '../../../components/bis/SourceKindIcon.astro';
import GlyphSheet from '../../../components/bis/GlyphSheet.astro';
import classes from '../../../data/classes.json';
import activeBuild from '../../../data/active-build.json';
import { classIconUrl } from '../../../lib/account/character-descriptor';
import { SLOT_LABELS, type Slot } from '../../../lib/planner/types';
import { rarityClassFor } from '../../../lib/planner/items';
import { dataUrl } from '../../../lib/planner/load';
import { bisCopy } from '../../../lib/bis/copy';
import {
  bandEntry,
  bandLevels,
  changedSinceBand,
  filledSlots,
  isMissingSlot,
  itemDetails,
  loadBisFile,
  loadLootFile,
  previousBandLevel,
  readSpecCatalog,
  sourceBadgeLabel,
  type SlotRow,
} from '../../../lib/bis/load';
import {
  describeSourceCell,
  hasKnownSource,
  parseSwapNote,
  resolveSourceCell,
  type SourceCell,
} from '../../../lib/bis/source-cell';
import type { BisFile, ChangedSlot, Faction, ItemDetail, LootQuestsFile } from '../../../lib/bis/types';
import type { LootFile } from '../../../lib/sim/loot';

export async function getStaticPaths() {
  return readSpecCatalog().map((spec) => ({
    params: { class: spec.class_slug, spec: spec.spec_slug },
    props: { spec },
  }));
}

const { spec: specEntry } = Astro.props;
const className = classes.find((c) => c.slug === specEntry.class_slug)?.name ?? specEntry.class_slug;
const title = `${className} ${specEntry.name} leveling BiS`;
const description = bisCopy.metaDescription(specEntry.name, className);
const path = `/bis/${specEntry.class_slug}/${specEntry.spec_slug}`;
const guideHref = `/guides/${specEntry.class_slug}/${specEntry.spec_slug}`;
const classIconHref = classIconUrl({ name: className, class: specEntry.class_slug });

const file = loadBisFile(specEntry.spec, activeBuild.build);
const bands = file ? bandLevels(file) : [];
const details = itemDetails(activeBuild.build, specEntry.class_slug);
const loot = loadLootFile(activeBuild.build);
const factions: Faction[] = ['alliance', 'horde'];

// --- per-row view: the source cell, the verified glyph or the runner-up detail, the item
// itself -- everything the row needs, resolved once here rather than in the template. ---
interface RowView {
  slot: string;
  empty: boolean;
  itemId?: number;
  itemName?: string;
  model?: ItemTooltipModel;
  itemLevel?: number;
  sourceKind?: SourceCell['kind'];
  sourceDetail?: string;
  keyStatsLine?: string;
  verified?: boolean;
  runnerUp?: { itemId: number; model?: ItemTooltipModel; deltaDps: number; title: string };
  swapNoteRaw?: string;
  /** The item this slot's NEW pill replaced -- undefined at the file's first band (nothing
   *  was equipped before) or when the slot did not change this band. Feeds the pill's own
   *  tooltip (`bisCopy.newPillTitle`) instead of a second "was: …" row. */
  replacedName?: string;
}

// The shared item tooltip (lib/items) built off disk for this page's class; undefined when
// the item table has no row for it, in which case the id is simply absent from
// `tooltipModels` below and BisTooltipHost shows nothing for it -- this page makes no
// runtime fetch fallback (unlike ItemHover's own dual-mode), since every id here already
// came from this same build-time read.
function tooltipFor(itemId: number): ItemTooltipModel | undefined {
  return readItemTooltipModel(activeBuild.build, specEntry.class_slug, itemId) ?? undefined;
}

function buildRowView(
  row: SlotRow,
  faction: Faction,
  itemDetailsMap: ReadonlyMap<number, ItemDetail>,
  lootFile: LootFile & Partial<LootQuestsFile>,
  replacedBySlot: ReadonlyMap<string, string | undefined>,
): RowView {
  if (isMissingSlot(row) || !hasKnownSource(row)) {
    return { slot: row.slot, empty: true };
  }
  const badgeLabel = sourceBadgeLabel(row, faction);
  const cell = resolveSourceCell(row, faction, lootFile, badgeLabel);
  const model = tooltipFor(row.item_id);
  const base: RowView = {
    slot: row.slot,
    empty: false,
    itemId: row.item_id,
    itemName: row.item_name,
    model,
    itemLevel: itemDetailsMap.get(row.item_id)?.item_level,
    sourceKind: cell.kind,
    sourceDetail: describeSourceCell(cell),
    keyStatsLine: model && model.stats.length > 0 ? model.stats.slice(0, 4).join(', ') : undefined,
    verified: row.verified,
    replacedName: replacedBySlot.get(row.slot),
  };
  if (row.verified || row.swap_note === undefined) return base;
  const parsed = parseSwapNote(row.swap_note);
  if (parsed === null) return { ...base, swapNoteRaw: row.swap_note };
  return {
    ...base,
    runnerUp: {
      itemId: parsed.runnerUpItemId,
      model: tooltipFor(parsed.runnerUpItemId),
      deltaDps: parsed.higherDps - parsed.lowerDps,
      title: bisCopy.runnerUpTitle(parsed.runnerUpName, parsed.higherDps, parsed.lowerDps),
    },
  };
}

interface WeightBarRow {
  row: WeightDisplayRow;
  /** 4-100: `%` width for the row's horizontal bar, scaled against the loudest non-reference
   *  weight in the band (never 0 -- even a near-zero weight still draws a sliver, tenet 4's
   *  "nothing clipped" applied to a bar chart). The reference row is always the full-width
   *  unit row the design asks for ("Ranged attack power = 1"). */
  barPercent: number;
}

function weightBarsFor(
  weights: BisFile['bands'][number]['weights'],
  referenceStat: string,
  spec: string,
): WeightBarRow[] {
  const rows = buildWeightDisplayRows(
    weights.map((w) => ({
      stat: w.stat,
      weight: w.weight,
      error: w.error ?? 0,
      insignificant: w.insignificant ?? false,
    })),
    referenceStat,
    spec,
  );
  const maxWeight = Math.max(...rows.filter((r) => !r.isReference).map((r) => Math.abs(r.weight)), 0.0001);
  return rows.map((row) => ({
    row,
    barPercent: row.isReference ? 100 : Math.min(100, Math.max(4, (Math.abs(row.weight) / maxWeight) * 100)),
  }));
}

interface BandInfo {
  band: number;
  bandIndex: number;
  rows: RowView[];
  newSlots: ReadonlySet<string>;
  changed: ChangedSlot[] | undefined;
  previousBand: number | undefined;
  upgradesCount: number;
  setDps: number;
  dpsDelta: number | undefined;
  race: string;
  talentPoints: number;
  weightBars: WeightBarRow[];
  referenceLabel: string;
}

function bandInfosFor(faction: Faction): BandInfo[] {
  if (file === null) return [];
  return bands.flatMap((band, bandIndex): BandInfo[] => {
    const bandData = bandEntry(file, band, faction);
    if (bandData === undefined) return [];
    const changed = changedSinceBand(file, band, faction);
    const replacedBySlot = new Map<string, string | undefined>(
      (changed ?? [])
        .filter((entry) => entry.after !== undefined)
        .map((entry) => [entry.slot, entry.before?.item_name]),
    );
    const rows = filledSlots(bandData).map((row) =>
      buildRowView(row, faction, details, loot, replacedBySlot),
    );
    const newSlots = new Set(
      bandIndex === 0
        ? rows.filter((row) => !row.empty).map((row) => row.slot)
        : (changed ?? []).filter((entry) => entry.after !== undefined).map((entry) => entry.slot),
    );
    const previousBand = previousBandLevel(file, band);
    const previousSetDps =
      previousBand === undefined ? undefined : bandEntry(file, previousBand, faction)?.set_dps;
    const weightBars = weightBarsFor(bandData.weights, specEntry.reference_stat, specEntry.spec);
    return [
      {
        band,
        bandIndex,
        rows,
        newSlots,
        changed,
        previousBand,
        upgradesCount: changed?.length ?? 0,
        setDps: bandData.set_dps,
        dpsDelta: previousSetDps === undefined ? undefined : bandData.set_dps - previousSetDps,
        race: bandData.race,
        talentPoints: bandData.talent_points,
        weightBars,
        referenceLabel: weightBars[0]?.row.label ?? specEntry.reference_stat,
      },
    ];
  });
}

/** Every model this band's rows, runner-ups and "what changed" diff name, merged into
 *  `into` keyed by item id -- the single deduplicated map `BisTooltipHost` needs, built from
 *  exactly the same `tooltipFor` reads the rows already made (design step (1): "collect
 *  them once" rather than re-resolving per island the way 840 separate `ItemHover`s used
 *  to). A `Map` write is idempotent, so the same item id named twice (a runner-up that is
 *  also a later band's main pick, the same piece surviving into a "was:" line) costs one
 *  entry, not two. */
function collectModelsInto(into: Map<number, ItemTooltipModel>, bandInfos: readonly BandInfo[]): void {
  for (const info of bandInfos) {
    for (const row of info.rows) {
      if (row.itemId !== undefined && row.model !== undefined) into.set(row.itemId, row.model);
      if (row.runnerUp?.model !== undefined) into.set(row.runnerUp.itemId, row.runnerUp.model);
    }
    for (const entry of info.changed ?? []) {
      if (entry.before !== undefined) {
        const model = tooltipFor(entry.before.item_id);
        if (model !== undefined) into.set(entry.before.item_id, model);
      }
      if (entry.after !== undefined) {
        const model = tooltipFor(entry.after.item_id);
        if (model !== undefined) into.set(entry.after.item_id, model);
      }
    }
  }
}

const bandInfosByFaction: Readonly<Record<Faction, BandInfo[]>> = {
  alliance: bandInfosFor('alliance'),
  horde: bandInfosFor('horde'),
};

const tooltipModels = new Map<number, ItemTooltipModel>();
collectModelsInto(tooltipModels, bandInfosByFaction.alliance);
collectModelsInto(tooltipModels, bandInfosByFaction.horde);

// `<` -> `<` (never actual escaping of `"`/`'`) is the standard "safe to inline in a
// <script> tag" transform: JSON never emits a bare `<`, so this is the one substitution
// needed to make `</script` unreachable in the output, without the HTML-attribute quote-
// escaping an island prop of this size would otherwise cost (see the header note above).
const tooltipModelsJson = JSON.stringify(Object.fromEntries(tooltipModels)).replace(/</g, '\\u003c');
---

<Base title={title} description={description} path={path}>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1120px] flex-col gap-5 px-[18px] py-10 md:px-12"
  >
    <GlyphSheet />
    <header class="border-line flex flex-col gap-2 border-b pb-5">
      <p class="text-muted text-[13px]">
        <a href="/bis">{bisCopy.backToIndex}</a>
      </p>
      <div class="flex items-center gap-3">
        {classIconHref && (
          <img src={classIconHref} alt="" width="28" height="28" class="rounded-control border-line border" />
        )}
        <h1 class="text-[28px] font-bold tracking-[0.02em]">{title}</h1>
      </div>
      {file && <UpdatedStamp date={new Date(file.generated_at)} />}
      {file && <p class="text-muted text-[13px]">{bisCopy.generatedFrom(file.engine_version)}</p>}
    </header>

    {!file && (
      <div class="rounded-control bg-raised border-line border p-6" data-testid="bis-empty-state">
        <p class="font-semibold">{bisCopy.noDataYet}</p>
        <p class="text-muted mt-2 text-[14px]">{bisCopy.noDataYetBody}</p>
        <p class="mt-3 text-[14px]">
          <a href={guideHref}>{specEntry.name} guide</a>
        </p>
      </div>
    )}

    {file && (
      <Fragment>
        {/* One island for the whole page (see the header note): the models map rides as a
            sibling JSON script tag rather than this island's own (HTML-attribute-escaped)
            props, and BisTooltipHost reads it once, on mount, by this fixed id. */}
        <script
          is:inline
          type="application/json"
          id="bis-tooltip-models"
          set:html={tooltipModelsJson}
        ></script>
        <BisTooltipHost client:idle build={activeBuild.build} />
      </Fragment>
    )}

    {file && (
      <div class="bis-faction-root">
        <input type="radio" name="faction" id="faction-alliance" class="sr-only" checked />
        <input type="radio" name="faction" id="faction-horde" class="sr-only" />
        <div class="mb-3 flex gap-2" role="group" aria-label="Faction">
          <label for="faction-alliance" class="faction-pill" data-testid="bis-faction-toggle-alliance">
            {bisCopy.factionAlliance}
          </label>
          <label for="faction-horde" class="faction-pill" data-testid="bis-faction-toggle-horde">
            {bisCopy.factionHorde}
          </label>
        </div>

        {factions.map((faction) => {
          const bandInfos = bandInfosByFaction[faction];
          return (
            <section
              id={`panel-${faction}`}
              class="faction-panel"
              data-testid={`bis-faction-panel-${faction}`}
            >
              <div class="band-panels" id={`bands-${faction}`}>
                <div class="level-scale-wrap relative mb-5">
                  <div
                    class="level-scale flex flex-nowrap items-center gap-1 overflow-x-auto overscroll-x-contain"
                    role="group"
                    aria-label={bisCopy.levelScaleGroupLabel}
                    data-band-strip
                  >
                    {bandInfos.map(({ band, newSlots }) => (
                      <a
                        href={`#band-${faction}-${band}`}
                        class="level-tab"
                        data-band-link
                        data-testid={`bis-band-pill-${faction}-${band}`}
                      >
                        <span aria-hidden="true">{band}</span>
                        <span class="sr-only">{bisCopy.levelLabel(band)}</span>
                        {newSlots.size > 0 && (
                          <span class="level-tab-badge" data-testid={`bis-band-pill-new-${faction}-${band}`}>
                            <span class="sr-only">{bisCopy.newAtBandCount(newSlots.size)}</span>
                            <span aria-hidden="true">{newSlots.size}</span>
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                  <div
                    aria-hidden="true"
                    data-testid={`bis-level-scale-fade-start-${faction}`}
                    class="edge-fade edge-fade-start pointer-events-none absolute inset-y-0 left-0 w-6 opacity-0 transition-opacity duration-150"
                  />
                  <div
                    aria-hidden="true"
                    data-testid={`bis-level-scale-fade-end-${faction}`}
                    class="edge-fade edge-fade-end pointer-events-none absolute inset-y-0 right-0 w-6 opacity-0 transition-opacity duration-150"
                  />
                </div>

                {bandInfos.map(
                  ({
                    band,
                    bandIndex,
                    rows,
                    newSlots,
                    changed,
                    previousBand,
                    upgradesCount,
                    setDps,
                    dpsDelta,
                    race,
                    talentPoints,
                    weightBars,
                    referenceLabel,
                  }) => (
                    <div
                      id={`band-${faction}-${band}`}
                      class:list={['band-panel', bandIndex === 0 && 'band-panel-default']}
                      data-testid={`bis-band-${faction}-${band}`}
                    >
                      <h2 class="band-heading mb-2 text-[13px]">{bisCopy.bandHeading(band)}</h2>

                      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_260px]">
                        <div class="min-w-0">
                          <ul class="gear-rows" data-testid={`bis-band-${faction}-${band}-rows`}>
                            {rows.map((row) => (
                              <li
                                class:list={['gear-row', newSlots.has(row.slot) && 'gear-row-new']}
                                data-testid={`bis-slot-${faction}-${band}-${row.slot}`}
                              >
                                <span class="gear-row-lead" aria-hidden="true">
                                  <SlotIcon slot={row.slot as Slot} class="gear-row-slot-icon" />
                                </span>
                                {row.empty ? (
                                  <div class="gear-row-empty">
                                    <span class="gear-row-slot-label">
                                      {SLOT_LABELS[row.slot as Slot] ?? row.slot}
                                    </span>
                                    <span class="text-muted text-[12px]">{bisCopy.noKnownSourceForSlot}</span>
                                  </div>
                                ) : (
                                  <>
                                    <span class="gear-row-body">
                                      <span
                                        class="gear-row-item"
                                        data-testid={`item-hover-${row.itemId}`}
                                        data-bis-item={row.itemId}
                                        tabindex="0"
                                        role="button"
                                        aria-haspopup="true"
                                      >
                                        {/* `inv_misc_questionmark` is the item pipeline's own
                                            placeholder for an id it has no real icon for
                                            (thousands of ids across every class file) -- the
                                            client's literal red-bordered "?" texture, and the
                                            exact icon the owner's screenshot review named
                                            (tenet 4: "never a red '?' icon"). Drawing it would
                                            be honest about the id but not about the icon, so a
                                            row with it falls back to the same neutral slot
                                            glyph an unresolved item gets below. */}
                                        {row.model && row.model.icon !== 'inv_misc_questionmark' ? (
                                          <img
                                            src={dataUrl(activeBuild.build, `icons/${row.model.icon}.webp`)}
                                            alt=""
                                            width="36"
                                            height="36"
                                            loading="lazy"
                                            decoding="async"
                                            class="gear-row-icon rounded-control border-line border object-cover"
                                          />
                                        ) : (
                                          <span
                                            class="gear-row-icon gear-row-icon-placeholder rounded-control border-line border"
                                            aria-hidden="true"
                                          >
                                            <SlotIcon slot={row.slot as Slot} />
                                          </span>
                                        )}
                                        <span class="gear-row-content">
                                          <span class="gear-row-name-line">
                                            <span class="sr-only">
                                              {SLOT_LABELS[row.slot as Slot] ?? row.slot}:
                                            </span>
                                            <span
                                              class:list={[
                                                'gear-row-name',
                                                rarityClassFor(row.model?.quality ?? 1),
                                              ]}
                                            >
                                              {row.itemName}
                                            </span>
                                            {newSlots.has(row.slot) && (
                                              <span
                                                class="new-pill"
                                                data-testid="bis-row-new"
                                                title={bisCopy.newPillTitle(row.replacedName)}
                                              >
                                                {bisCopy.newPillLabel}
                                              </span>
                                            )}
                                            {row.verified ? (
                                              <span
                                                class="verified-glyph"
                                                title={bisCopy.verifiedGlyphTitle}
                                                aria-label={bisCopy.verifiedGlyphTitle}
                                              >
                                                <svg
                                                  width="13"
                                                  height="13"
                                                  viewBox="0 0 24 24"
                                                  fill="none"
                                                  stroke="currentColor"
                                                  stroke-width="2.4"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  aria-hidden="true"
                                                >
                                                  <use href="#bis-verified" />
                                                </svg>
                                              </span>
                                            ) : row.runnerUp ? (
                                              <details class="runner-up-details">
                                                <summary title={row.runnerUp.title}>
                                                  {bisCopy.runnerUpSummary}
                                                </summary>
                                                <span class="runner-up-body">
                                                  <ItemPill
                                                    itemId={row.runnerUp.itemId}
                                                    model={row.runnerUp.model}
                                                    build={activeBuild.build}
                                                  />
                                                  <span class="text-muted">
                                                    {bisCopy.runnerUpBeatBy(row.runnerUp.deltaDps)}
                                                  </span>
                                                </span>
                                              </details>
                                            ) : (
                                              <span
                                                class="text-muted text-[11px]"
                                                title={row.swapNoteRaw ?? bisCopy.unverifiedGlyphTitle}
                                              >
                                                {bisCopy.unverified}
                                              </span>
                                            )}
                                          </span>
                                          {row.keyStatsLine && (
                                            <span class="gear-row-stats text-muted">{row.keyStatsLine}</span>
                                          )}
                                          <span class="gear-row-source text-muted">
                                            <SourceKindIcon kind={row.sourceKind ?? 'unknown'} />
                                            {row.sourceDetail}
                                          </span>
                                        </span>
                                      </span>
                                    </span>
                                    <span
                                      class="gear-row-ilvl tabular text-muted"
                                      title={bisCopy.levelHeading}
                                    >
                                      {row.itemLevel === undefined
                                        ? '—'
                                        : bisCopy.itemLevelShort(row.itemLevel)}
                                    </span>
                                  </>
                                )}
                              </li>
                            ))}
                          </ul>

                          <div class="mt-3" data-testid={`bis-changed-since-${faction}-${band}`}>
                            {bandIndex === 0 ? (
                              <p class="text-muted text-[13px]">{bisCopy.changedSinceFirst}</p>
                            ) : upgradesCount === 0 ? (
                              <p class="text-muted text-[13px]">
                                {bisCopy.upgradesSinceHeading(0, previousBand ?? band)}
                              </p>
                            ) : (
                              <details class="upgrades-disclosure">
                                <summary class="upgrades-summary">
                                  {bisCopy.upgradesSinceHeading(upgradesCount, previousBand ?? band)}
                                </summary>
                                <ul class="upgrades-list">
                                  {(changed ?? []).map((entry) => (
                                    <li class="upgrade-row">
                                      <span class="upgrade-slot">
                                        {SLOT_LABELS[entry.slot as Slot] ?? entry.slot}
                                      </span>
                                      {entry.before === undefined ? (
                                        <span class="upgrade-new-slot">{bisCopy.newSlotLabel}</span>
                                      ) : (
                                        <ItemPill
                                          itemId={entry.before.item_id}
                                          model={tooltipFor(entry.before.item_id)}
                                          build={activeBuild.build}
                                        />
                                      )}
                                      {entry.before !== undefined && <span aria-hidden="true">&rarr;</span>}
                                      {entry.after ? (
                                        <ItemPill
                                          itemId={entry.after.item_id}
                                          model={tooltipFor(entry.after.item_id)}
                                          build={activeBuild.build}
                                        />
                                      ) : (
                                        <span class="text-muted text-[12px]">
                                          {bisCopy.noKnownSourceForSlot}
                                        </span>
                                      )}
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            )}
                          </div>
                        </div>

                        <aside class="band-aside flex flex-col gap-4 text-[13px]">
                          <div>
                            <p class="aside-label">{bisCopy.setDpsLabel}</p>
                            <p class="dps-value tabular">{setDps.toFixed(1)}</p>
                            {dpsDelta !== undefined && (
                              <p class="dps-delta text-muted tabular">{bisCopy.setDpsDelta(dpsDelta)}</p>
                            )}
                          </div>
                          <div>
                            <p class="aside-label">{bisCopy.statWeightsLabel}</p>
                            <p class="weights-explainer text-muted">
                              {bisCopy.weightsExplainer(referenceLabel)}
                            </p>
                            <ul class="weight-bars" data-testid={`bis-weights-${faction}-${band}`}>
                              {weightBars.map(({ row, barPercent }) => (
                                <li
                                  class:list={['weight-bar-row', !row.significant && 'weight-bar-row-faint']}
                                  title={row.sentence}
                                >
                                  <span class="weight-bar-top">
                                    <span class="weight-bar-label">{row.label}</span>
                                    <span class="weight-bar-value tabular">
                                      {row.isReference ? '= 1' : row.weight.toFixed(2)}
                                    </span>
                                  </span>
                                  <span class="weight-bar-track">
                                    <span class="weight-bar-fill" style={`width:${barPercent}%`} />
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </div>
                          <p class="text-muted">{bisCopy.raceTalentsLine(race, talentPoints)}</p>
                        </aside>
                      </div>
                    </div>
                  ),
                )}
              </div>
            </section>
          );
        })}
      </div>
    )}
  </main>
</Base>

