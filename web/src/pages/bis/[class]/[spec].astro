---
// web/src/pages/bis/[class]/[spec].astro
// A spec's Best in slot page at its first band, the canonical URL for that band and the hub
// every band page links back to (components/bis/BisSpecRoute.astro draws it).
import BisSpecRoute from '../../../components/bis/BisSpecRoute.astro';
import { readSpecCatalog } from '../../../lib/bis/load';

export async function getStaticPaths() {
  return readSpecCatalog().map((spec) => ({
    params: { class: spec.class_slug, spec: spec.spec_slug },
    props: { spec },
  }));
}

const { spec } = Astro.props;
---

<BisSpecRoute spec={spec} />
