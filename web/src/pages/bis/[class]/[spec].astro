---
// web/src/pages/bis/[class]/[spec].astro
// One page per written spec (data/curated/specs.json -- the same catalog the rotation
// accuracy program measures against), static, no island above the fold: two SSR faction
// panels toggled by hidden radio inputs and plain CSS (the `has-[:checked]` pattern
// Upload.svelte already uses), band pills toggled by CSS `:target` within each panel. The
// only scripts on the page are tiny inline ones (never a hydrated island): one syncs the
// faction radios from `?faction=` on load, one lets arrow keys move focus along the level
// scale, and one shows/hides the level scale's own edge fades on narrow screens (the same
// pattern SimTabs.astro uses for its tab strip).
//
// Character-panel redesign (lane bis-character-panel, 2026-09-29 -- ux-designer spec
// `2026-09-29-bis-character-panel.md`, controller rulings on top of it): the band panel is
// now the classic character panel (PaperDollFrame) borrowed literally -- two flanking gear
// columns (`.paperdoll-left` 6 slots, `.paperdoll-right` 8) around a quiet centre column
// that carries the one thing a model can't (Set DPS, the weight rail), a weapon row
// (`.paperdoll-bottom`) below. Order at `<1024px` is the client's own read order: centre
// first (so the answer needs zero scrolling on a phone), then left, then right, then
// weapons -- done with `order`/`lg:order` utilities rather than DOM reshuffling, so the
// same three-column grid at `>=1024px` and the same markup serve both.
//
// A pick now shows its alternatives (tenet 7): up to three compact rows under the pick
// (`GearRow.astro`), each a real mention (icon, quality-coloured name, one-line source, the
// DPS gap from the pick) rather than a bare chip -- every alternative id rides into the same
// shared tooltip model map a main pick's id already did. The runner-up `<details>` fallback
// (a single swapped-in alternative parsed out of `swap_note`) is gone entirely: `alternatives`
// is the one way a pick shows what else was close.
//
// `swap_note` itself is read again as of the fourth wow-player sweep (day 3, item 1): a
// verified pick with no visible evidence anywhere on the page (the sweep's own top-3
// finding) now gets one more muted line under its source line, `GearRow.astro`'s own
// evidence line, built by `lib/bis/panel-view.ts`'s `evidenceLineFor`/`parseSwapNote` from
// the ranker's own sentence rather than the raw pipeline text.
//
// The coverage line ("Sources known for N of M items") is gone from the page (tenet 7:
// pipeline counters stay out of the player's view) -- `band.coverage` itself is untouched,
// still read and defaulted by `lib/bis/load.ts`'s `normaliseBisFile` for whichever other
// surface (guardrail tooling) still wants it.
//
// The row-building and weight-rail view-model this page used to compute in its own
// frontmatter now lives in `lib/bis/panel-view.ts` -- `GearRow.astro` needs the exact same
// `RowView` shape this page does, which only a shared module (not another page's
// frontmatter) can give both.
//
// Every mention on this page is plain server markup (an icon, a quality-coloured name, a
// `data-bis-item="<id>"` attribute) collected into ONE deduplicated tooltip-model map
// (`collectModelsInto`), handed to a single `BisTooltipHost` island (`client:idle`) as a
// sibling JSON `<script>` tag -- unchanged from the list-first page's own lane
// (bis-tooltip-host, 2026-09-29): one island owns hover/focus/tap open-close for the whole
// page instead of an island per mention.
import Base from '../../../layouts/Base.astro';
import UpdatedStamp from '../../../components/UpdatedStamp.astro';
import BisTooltipHost from '../../../components/BisTooltipHost.svelte';
import GearRow from '../../../components/bis/GearRow.astro';
import ItemPill from '../../../components/bis/ItemPill.astro';
import GlyphSheet from '../../../components/bis/GlyphSheet.astro';
import { readItemTooltipModel } from '../../../lib/items/lookup';
import type { ItemTooltipModel } from '../../../lib/items/tooltip';
import classes from '../../../data/classes.json';
import activeBuild from '../../../data/active-build.json';
import { classIconUrl } from '../../../lib/account/character-descriptor';
import { SLOT_LABELS, type Slot } from '../../../lib/planner/types';
import { bisCopy } from '../../../lib/bis/copy';
import { bandLevels, itemDetails, loadBisFile, loadLootFile, readSpecCatalog } from '../../../lib/bis/load';
import { bandInfosFor, collectModelsInto, type BandInfo } from '../../../lib/bis/panel-view';
import type { Faction } from '../../../lib/bis/types';

export async function getStaticPaths() {
  return readSpecCatalog().map((spec) => ({
    params: { class: spec.class_slug, spec: spec.spec_slug },
    props: { spec },
  }));
}

const { spec: specEntry } = Astro.props;
const className = classes.find((c) => c.slug === specEntry.class_slug)?.name ?? specEntry.class_slug;
const title = `${className} ${specEntry.name} leveling BiS`;
const description = bisCopy.metaDescription(specEntry.name, className);
const path = `/bis/${specEntry.class_slug}/${specEntry.spec_slug}`;
const guideHref = `/guides/${specEntry.class_slug}/${specEntry.spec_slug}`;
const classIconHref = classIconUrl({ name: className, class: specEntry.class_slug });

const file = loadBisFile(specEntry.spec, activeBuild.build);
const bands = file ? bandLevels(file) : [];
const details = itemDetails(activeBuild.build, specEntry.class_slug);
const loot = loadLootFile(activeBuild.build);
const factions: Faction[] = ['alliance', 'horde'];

// The shared item tooltip (lib/items) built off disk for this page's class; undefined when
// the item table has no row for it, in which case the id is simply absent from
// `tooltipModels` below and BisTooltipHost shows nothing for it.
function tooltipFor(itemId: number): ItemTooltipModel | undefined {
  return readItemTooltipModel(activeBuild.build, specEntry.class_slug, itemId) ?? undefined;
}

function bandInfosForFaction(faction: Faction): BandInfo[] {
  if (file === null) return [];
  return bandInfosFor(file, bands, faction, {
    itemDetails: details,
    loot,
    tooltipFor,
    referenceStat: specEntry.reference_stat,
    spec: specEntry.spec,
  });
}

const bandInfosByFaction: Readonly<Record<Faction, BandInfo[]>> = {
  alliance: bandInfosForFaction('alliance'),
  horde: bandInfosForFaction('horde'),
};

const tooltipModels = new Map<number, ItemTooltipModel>();
collectModelsInto(tooltipModels, bandInfosByFaction.alliance, tooltipFor);
collectModelsInto(tooltipModels, bandInfosByFaction.horde, tooltipFor);

// `<` -> `<` (never actual escaping of `"`/`'`) is the standard "safe to inline in a
// <script> tag" transform: JSON never emits a bare `<`, so this is the one substitution
// needed to make `</script` unreachable in the output, without the HTML-attribute quote-
// escaping an island prop of this size would otherwise cost (see the header note above).
const tooltipModelsJson = JSON.stringify(Object.fromEntries(tooltipModels)).replace(/</g, '\\u003c');
---

<Base title={title} description={description} path={path}>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1120px] flex-col gap-5 px-[18px] py-10 md:px-12"
  >
    <GlyphSheet />
    <header class="border-line flex flex-col gap-2 border-b pb-5">
      <p class="text-muted text-[13px]">
        <a href="/bis">{bisCopy.backToIndex}</a>
      </p>
      <div class="flex items-center gap-3">
        {classIconHref && (
          <img src={classIconHref} alt="" width="28" height="28" class="rounded-control border-line border" />
        )}
        <h1 class="text-[28px] font-bold tracking-[0.02em]">{title}</h1>
      </div>
      {file && <UpdatedStamp date={new Date(file.generated_at)} />}
      {file && <p class="text-muted text-[13px]">{bisCopy.generatedFrom(file.engine_version)}</p>}
    </header>

    {!file && (
      <div class="rounded-control bg-raised border-line border p-6" data-testid="bis-empty-state">
        <p class="font-semibold">{bisCopy.noDataYet}</p>
        <p class="text-muted mt-2 text-[14px]">{bisCopy.noDataYetBody}</p>
        <p class="mt-3 text-[14px]">
          <a href={guideHref}>{specEntry.name} guide</a>
        </p>
      </div>
    )}

    {file && (
      <Fragment>
        {/* One island for the whole page (see the header note): the models map rides as a
            sibling JSON script tag rather than this island's own (HTML-attribute-escaped)
            props, and BisTooltipHost reads it once, on mount, by this fixed id. */}
        <script
          is:inline
          type="application/json"
          id="bis-tooltip-models"
          set:html={tooltipModelsJson}
        ></script>
        <BisTooltipHost client:idle build={activeBuild.build} />
      </Fragment>
    )}

    {file && (
      <div class="bis-faction-root">
        <input type="radio" name="faction" id="faction-alliance" class="sr-only" checked />
        <input type="radio" name="faction" id="faction-horde" class="sr-only" />
        <div class="mb-3 flex gap-2" role="group" aria-label="Faction">
          <label for="faction-alliance" class="faction-pill" data-testid="bis-faction-toggle-alliance">
            {bisCopy.factionAlliance}
          </label>
          <label for="faction-horde" class="faction-pill" data-testid="bis-faction-toggle-horde">
            {bisCopy.factionHorde}
          </label>
        </div>

        {factions.map((faction) => {
          const bandInfos = bandInfosByFaction[faction];
          return (
            <section
              id={`panel-${faction}`}
              class="faction-panel"
              data-testid={`bis-faction-panel-${faction}`}
            >
              <div class="band-panels" id={`bands-${faction}`}>
                <div class="level-scale-wrap relative mb-5">
                  <div
                    class="level-scale flex flex-nowrap items-center gap-1 overflow-x-auto overscroll-x-contain"
                    role="group"
                    aria-label={bisCopy.levelScaleGroupLabel}
                    data-band-strip
                  >
                    {bandInfos.map(({ band, newSlots }) => (
                      <a
                        href={`#band-${faction}-${band}`}
                        class="level-tab"
                        data-band-link
                        data-testid={`bis-band-pill-${faction}-${band}`}
                      >
                        <span aria-hidden="true">{band}</span>
                        <span class="sr-only">{bisCopy.levelLabel(band)}</span>
                        {newSlots.size > 0 && (
                          <span class="level-tab-badge" data-testid={`bis-band-pill-new-${faction}-${band}`}>
                            <span class="sr-only">{bisCopy.newAtBandCount(newSlots.size)}</span>
                            <span aria-hidden="true">{newSlots.size}</span>
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                  <div
                    aria-hidden="true"
                    data-testid={`bis-level-scale-fade-start-${faction}`}
                    class="edge-fade edge-fade-start pointer-events-none absolute inset-y-0 left-0 w-6 opacity-0 transition-opacity duration-150"
                  />
                  <div
                    aria-hidden="true"
                    data-testid={`bis-level-scale-fade-end-${faction}`}
                    class="edge-fade edge-fade-end pointer-events-none absolute inset-y-0 right-0 w-6 opacity-0 transition-opacity duration-150"
                  />
                </div>

                {bandInfos.map(
                  ({
                    band,
                    bandIndex,
                    rows,
                    newSlots,
                    changed,
                    previousBand,
                    upgradesCount,
                    setDps,
                    dpsDelta,
                    setDpsPartial,
                    setDpsPartialCount,
                    race,
                    talentPoints,
                    weightBars,
                    refAbbrevText,
                    referenceSentenceLine,
                  }) => {
                    // `rows` is always the planner's 17 slots in SLOTS' own canonical order
                    // (`filledSlots`) -- the paperdoll's own left/right/bottom split, the
                    // client's own left-hand -> right-hand -> weapon-row read order.
                    const leftRows = rows.slice(0, 6);
                    const rightRows = rows.slice(6, 14);
                    const bottomRows = rows.slice(14, 17);
                    return (
                      <div
                        id={`band-${faction}-${band}`}
                        class:list={['band-panel', bandIndex === 0 && 'band-panel-default']}
                        data-testid={`bis-band-${faction}-${band}`}
                      >
                        <h2 class="band-heading mb-2 text-[13px]">{bisCopy.bandHeading(band)}</h2>

                        <div class="paperdoll grid grid-cols-1 gap-x-6 gap-y-5 lg:grid-cols-[1fr_300px_1fr]">
                          <div class="paperdoll-left order-2 min-w-0 lg:order-1">
                            <ul class="gear-rows" data-testid={`bis-band-${faction}-${band}-left`}>
                              {leftRows.map((row) => (
                                <GearRow
                                  row={row}
                                  isNew={newSlots.has(row.slot)}
                                  build={activeBuild.build}
                                  slotTestId={`bis-slot-${faction}-${band}-${row.slot}`}
                                />
                              ))}
                            </ul>
                          </div>

                          <aside class="paperdoll-center order-1 flex flex-col gap-4 text-[13px] lg:order-2">
                            <div>
                              <p class="aside-label">{bisCopy.setDpsLabel}</p>
                              <p class="dps-value tabular">{setDps.toFixed(1)}</p>
                              {dpsDelta !== undefined && (
                                <p class="dps-delta text-muted tabular">{bisCopy.setDpsDelta(dpsDelta)}</p>
                              )}
                              {setDpsPartial && (
                                <p
                                  class="dps-partial-note text-muted"
                                  data-testid={`bis-set-dps-partial-${faction}-${band}`}
                                >
                                  {bisCopy.setDpsPartialNote(setDpsPartialCount)}
                                </p>
                              )}
                            </div>
                            <p class="text-muted">{bisCopy.raceTalentsLine(race, talentPoints)}</p>
                            <div>
                              <p class="aside-label">{bisCopy.statWeightsLabel}</p>
                              <p class="weights-reference-line">{referenceSentenceLine}</p>
                              <ul class="weight-bars" data-testid={`bis-weights-${faction}-${band}`}>
                                {weightBars.map(
                                  ({
                                    row,
                                    barPercent,
                                    dpsPerPoint,
                                    valueText,
                                    displayLabel,
                                    ratingFactorTitle,
                                  }) => (
                                    <li
                                      class:list={[
                                        'weight-bar-row',
                                        !row.significant && 'weight-bar-row-faint',
                                      ]}
                                      title={ratingFactorTitle ?? row.sentence}
                                    >
                                      {!row.isReference && row.significant && dpsPerPoint !== undefined ? (
                                        <span class="weight-bar-top">
                                          <span class="weight-bar-value-sentence tabular">
                                            {bisCopy.weightsRowDpsLine(
                                              displayLabel,
                                              row.weight,
                                              refAbbrevText,
                                              dpsPerPoint,
                                            )}
                                          </span>
                                        </span>
                                      ) : (
                                        <span class="weight-bar-top">
                                          <span class="weight-bar-label">{displayLabel}</span>
                                          <span class="weight-bar-value tabular">{valueText}</span>
                                        </span>
                                      )}
                                      {row.significant && (
                                        <span class="weight-bar-track">
                                          <span class="weight-bar-fill" style={`width:${barPercent}%`} />
                                        </span>
                                      )}
                                    </li>
                                  ),
                                )}
                              </ul>
                            </div>
                          </aside>

                          <div class="paperdoll-right order-3 min-w-0">
                            <ul class="gear-rows" data-testid={`bis-band-${faction}-${band}-right`}>
                              {rightRows.map((row) => (
                                <GearRow
                                  row={row}
                                  isNew={newSlots.has(row.slot)}
                                  build={activeBuild.build}
                                  slotTestId={`bis-slot-${faction}-${band}-${row.slot}`}
                                />
                              ))}
                            </ul>
                          </div>

                          <div class="paperdoll-bottom order-4 lg:col-span-3">
                            <ul
                              class="paperdoll-bottom-row grid grid-cols-1 gap-2 sm:grid-cols-3"
                              data-testid={`bis-band-${faction}-${band}-weapons`}
                            >
                              {bottomRows.map((row) => (
                                <GearRow
                                  row={row}
                                  isNew={newSlots.has(row.slot)}
                                  build={activeBuild.build}
                                  slotTestId={`bis-slot-${faction}-${band}-${row.slot}`}
                                />
                              ))}
                            </ul>
                          </div>
                        </div>

                        <div class="mt-3" data-testid={`bis-changed-since-${faction}-${band}`}>
                          {bandIndex === 0 ? (
                            <p class="text-muted text-[13px]">{bisCopy.changedSinceFirst}</p>
                          ) : upgradesCount === 0 ? (
                            <p class="text-muted text-[13px]">
                              {bisCopy.upgradesSinceHeading(0, previousBand ?? band)}
                            </p>
                          ) : (
                            <details class="upgrades-disclosure">
                              <summary class="upgrades-summary">
                                {bisCopy.upgradesSinceHeading(upgradesCount, previousBand ?? band)}
                              </summary>
                              <ul class="upgrades-list">
                                {(changed ?? []).map((entry) => (
                                  <li class="upgrade-row">
                                    <span class="upgrade-slot">
                                      {SLOT_LABELS[entry.slot as Slot] ?? entry.slot}
                                    </span>
                                    {entry.before === undefined ? (
                                      <span class="upgrade-new-slot">{bisCopy.newSlotLabel}</span>
                                    ) : (
                                      <ItemPill
                                        itemId={entry.before.item_id}
                                        model={tooltipFor(entry.before.item_id)}
                                        build={activeBuild.build}
                                      />
                                    )}
                                    {entry.before !== undefined && <span aria-hidden="true">&rarr;</span>}
                                    {entry.after ? (
                                      <ItemPill
                                        itemId={entry.after.item_id}
                                        model={tooltipFor(entry.after.item_id)}
                                        build={activeBuild.build}
                                      />
                                    ) : (
                                      <span class="text-muted text-[12px]">
                                        {bisCopy.noKnownSourceForSlot}
                                      </span>
                                    )}
                                  </li>
                                ))}
                              </ul>
                            </details>
                          )}
                        </div>
                      </div>
                    );
                  },
                )}
              </div>
            </section>
          );
        })}
      </div>
    )}
  </main>
</Base>

<style>
  .bis-faction-root {
    position: relative;
  }
  .faction-panel {
    display: none;
  }
  #faction-alliance:checked ~ #panel-alliance {
    display: block;
  }
  #faction-horde:checked ~ #panel-horde {
    display: block;
  }
  .faction-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border-radius: var(--radius-control, 8px);
    border: 1px solid var(--color-line, #333);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  #faction-alliance:checked ~ div .faction-pill[for='faction-alliance'],
  #faction-horde:checked ~ div .faction-pill[for='faction-horde'] {
    color: var(--color-gold, #c9a35e);
    border-color: var(--color-gold, #c9a35e);
  }

  /* --- level scale: a compact single-row tab strip, numbers only, that scrolls (never
     wraps to a second row) on a phone. --- */
  .level-scale {
    scrollbar-width: none;
    /* The strip scrolls horizontally, which also clips vertically: leave room
       for each tab's "new picks" badge (top/right -5px) inside the scroll box
       so the row above never appears to cover it (owner report, 2026-09-30). */
    padding: 6px 6px 2px 0;
    margin-top: -6px;
  }
  .level-scale::-webkit-scrollbar {
    display: none;
  }
  .level-tab {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-control, 8px);
    border: 1px solid var(--color-line, #333);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .level-tab:focus-visible {
    outline: 2px solid var(--color-gold, #c9a35e);
    outline-offset: 2px;
  }
  .level-tab-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    display: inline-flex;
    min-width: 14px;
    height: 14px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-gold, #c9a35e);
    color: #1a1400;
    padding: 0 3px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
  }
  .edge-fade-start {
    background: linear-gradient(to right, var(--color-bg), transparent);
  }
  .edge-fade-end {
    background: linear-gradient(to left, var(--color-bg), transparent);
  }
  .edge-fade.is-visible {
    opacity: 1;
  }

  .band-panel {
    display: none;
  }
  .band-panel:target {
    display: block;
  }
  .band-panels:not(:has(.band-panel:target)) .band-panel-default {
    display: block;
  }
  .band-heading {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-strong);
    text-transform: none;
    letter-spacing: normal;
  }

  /* --- the paperdoll's two gear columns: same row list either side, mirrored borders (§5:
     "left/right gear columns carry equal visual weight"). --- */
  .gear-rows {
    display: flex;
    flex-direction: column;
  }

  /* --- centre column: intentionally undecorated (§3.2) -- no border, no card background,
     distinguished from the two bordered gear columns only by whitespace. --- */
  .aside-label {
    color: var(--color-muted, #999);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    margin-bottom: 2px;
  }
  .dps-value {
    font-size: 22px;
    font-weight: 700;
  }
  .dps-delta {
    font-size: 12px;
  }
  .dps-partial-note {
    font-size: 11px;
  }
  .weights-reference-line {
    font-size: 13px;
    color: var(--color-strong, #f2eee4);
    margin-bottom: 0.4rem;
  }
  .weight-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  /* Label above its own bar, not squeezed into a fixed-width grid column -- a stat name as
     long as "Ranged attack power" (the reference row itself) must never truncate. */
  .weight-bar-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
  }
  .weight-bar-row-faint {
    opacity: 0.5;
  }
  .weight-bar-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .weight-bar-value-sentence {
    display: block;
  }
  .weight-bar-track {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--color-line-soft, #222);
    overflow: hidden;
  }
  .weight-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-gold, #c9a35e);
  }
  .weight-bar-value {
    flex-shrink: 0;
  }

  /* --- what changed: one disclosure line, never a wall of rows above the list. --- */
  .upgrades-disclosure summary {
    cursor: pointer;
    color: var(--color-muted, #999);
    font-size: 13px;
    list-style: none;
  }
  .upgrades-disclosure summary::-webkit-details-marker {
    display: none;
  }
  .upgrades-disclosure summary::before {
    content: '▸ ';
  }
  .upgrades-disclosure[open] summary::before {
    content: '▾ ';
  }
  .upgrades-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-size: 13px;
  }
  .upgrade-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .upgrade-slot {
    color: var(--color-muted, #999);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11px;
  }
  .upgrade-new-slot {
    color: var(--color-muted, #999);
    font-size: 12px;
    font-style: italic;
  }
</style>

<script is:inline>
  // Not an island: a plain inline script, no framework, so `?faction=horde` opens on the
  // right panel without paying for a hydrated component the way the rest of this page
  // (two SSR lists plus a CSS radio toggle) never does either.
  (function () {
    const faction = new URLSearchParams(window.location.search).get('faction');
    if (faction === 'horde') {
      const input = document.getElementById('faction-horde');
      if (input) input.checked = true;
    }
  })();

  // Arrow-key band navigation: focus never leaves the level scale's own links, and moving
  // focus also follows the link (the same `#band-<faction>-<band>` CSS `:target` toggle a
  // click already drives), so the keyboard path and the pointer path land on the exact same
  // state rather than two behaviours to keep in sync.
  (function () {
    document.querySelectorAll('[data-band-strip]').forEach(function (strip) {
      strip.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        const links = Array.prototype.slice.call(strip.querySelectorAll('[data-band-link]'));
        const index = links.indexOf(document.activeElement);
        if (index === -1) return;
        const nextIndex =
          event.key === 'ArrowRight' ? Math.min(index + 1, links.length - 1) : Math.max(index - 1, 0);
        const next = links[nextIndex];
        if (!next) return;
        event.preventDefault();
        next.focus();
        next.click();
      });
    });
  })();

  // Edge fades for the level scale on a narrow screen (night-sim-tabs' own pattern,
  // SimTabs.astro): only present on whichever side still has tabs scrolled out of view, and
  // desktop never overflows (the level scale fits one row well under 1120px), so the fades
  // stay hidden there without a breakpoint check.
  (function () {
    const EPSILON_PX = 1;
    document.querySelectorAll('[data-band-strip]').forEach(function (nav) {
      const wrap = nav.parentElement;
      const fadeStart = wrap && wrap.querySelector('.edge-fade-start');
      const fadeEnd = wrap && wrap.querySelector('.edge-fade-end');
      if (!fadeStart || !fadeEnd) return;
      const updateFades = function () {
        const hiddenStart = nav.scrollLeft > EPSILON_PX;
        const hiddenEnd = nav.scrollLeft + nav.clientWidth < nav.scrollWidth - EPSILON_PX;
        fadeStart.classList.toggle('is-visible', hiddenStart);
        fadeEnd.classList.toggle('is-visible', hiddenEnd);
      };
      nav.addEventListener('scroll', updateFades, { passive: true });
      window.addEventListener('resize', updateFades);
      updateFades();
    });
  })();
</script>
