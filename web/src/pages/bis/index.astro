---
// web/src/pages/bis/index.astro
// /bis in the flat system (design/specs/2026-11-07-bis-landing.md, mocks web-bis-landing*): the
// PageHeader (Best in slot, the Updated stamp, the signed-in answer: the
// header selector's character, how many of its range's pieces it wears, one button to its own
// spec at its own range), the finished server sim line when one waits, the ControlBar's level
// range (the character's own range by default, owner 2026-11-07) with the tier list link, the
// range's summary line, then the one Plate: every class as a group, its specs as slim link rows
// that open at the selected range. Everything is prerendered; lib/bis/landing-client.ts follows
// the bar and the header selector in place after paint.
import Base from '../../layouts/Base.astro';
import ClassSpecPicker, { type PickerClass } from '../../components/guides/ClassSpecPicker.astro';
import BisLandingAnswer from '../../components/bis/BisLandingAnswer.astro';
import ControlBar from '../../components/ui/ControlBar.astro';
import Page from '../../components/ui/Page.svelte';
import PageHeader from '../../components/ui/PageHeader.svelte';
import activeBuild from '../../data/active-build.json';
import { landingCopy } from '../../lib/bis/landing-copy';
import { loadLandingData } from '../../lib/bis/landing-build';
import { DEFAULT_LANDING_BAND, LANDING_BANDS, bandLabel } from '../../lib/bis/landing-bands';
import { BAND_PARAM, SPEC_ROW_PREFIX } from '../../lib/bis/landing-client';
import { specLinkHref } from '../../lib/bis/landing-links';
import { dayMonth } from '../../lib/guides/guide-header';
import { REGION } from '../../lib/ui/regions';
import { searchCopy } from '../../lib/search-copy';
import { LINK, type ControlGroup } from '../../lib/ui/primitives';

const { cards, captions, raidLabel, updated, config } = loadLandingData(activeBuild.build);
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
const groups: ControlGroup[] = [
  {
    label: landingCopy.bandGroupLabel,
    param: BAND_PARAM,
    kind: 'segmented',
    value: String(DEFAULT_LANDING_BAND),
    options: LANDING_BANDS.map((band) => ({ value: String(band), label: bandLabel(band) })),
  },
];
const summaries = captions.map((caption) => ({
  band: caption.band,
  text: landingCopy.bandSummary(caption.band === LANDING_BANDS.at(-1), raidLabel),
}));
const pickerClasses: PickerClass[] = cards.map((card) => ({
  slug: card.slug,
  name: card.name,
  specs: card.specs.map((spec) => ({
    key: `${spec.classSlug}/${spec.specSlug}`,
    name: spec.name,
    href: specLinkHref({ classSlug: spec.classSlug, specSlug: spec.specSlug, band: DEFAULT_LANDING_BAND }),
    icon: spec.iconSrc,
  })),
}));
---

<Base title={searchCopy.bisIndex.title} description={searchCopy.bisIndex.description} path="/bis" wide>
  <main id="main" tabindex="-1" class="bis-landing" data-testid="bis-landing">
    <Page layout="ledger">
      <PageHeader slot="header" title={landingCopy.title} tone="strong">
        <Fragment slot="meta">
          {updated !== null && <span data-testid="bis-landing-updated">Updated {dayMonth(updated)}</span>}
        </Fragment>
        <BisLandingAnswer slot="answer" />
      </PageHeader>
      <Fragment slot="bar">
        <div class="bis-finished" data-bis-finished data-testid="bis-finished"></div>
        <ControlBar groups={groups} label={landingCopy.bandGroupLabel} testid="bis-landing-bar">
          <span slot="end" class="bis-tier">
            <span class="text-small text-muted">{landingCopy.tierQuestion}</span>
            <a class={LINK} href={landingCopy.tierHref} data-testid="bis-index-tier-link">
              {landingCopy.tierLink} ›
            </a>
          </span>
        </ControlBar>
      </Fragment>
      <div class="bis-body">
        <p
          class="text-small text-muted bis-summary"
          data-region={REGION.summary}
          data-testid="bis-landing-summary"
        >
          {summaries.map((summary) => (
            <span data-band-text={summary.band} hidden={summary.band !== DEFAULT_LANDING_BAND}>
              {summary.text}
            </span>
          ))}{' '}
          <a
            class={LINK}
            href="?band="
            data-your-range
            data-label={landingCopy.yourRange('{band}')}
            hidden
          ></a>
        </p>
        <div id="bis-classes">
          <ClassSpecPicker
            classes={pickerClasses}
            label={landingCopy.plateLabel}
            testid="bis-class-grid"
            classTestidPrefix="bis-class-"
            rowTestidPrefix={SPEC_ROW_PREFIX}
            yoursLabel={landingCopy.yours}
          />
        </div>
      </div>
    </Page>
  </main>
  <script is:inline type="application/json" id="bis-landing-config" set:html={configJson}></script>
  <script>
    import { mountBisLanding } from '../../lib/bis/landing-client';
    import type { LandingConfig } from '../../lib/bis/landing-config';

    const node = document.getElementById('bis-landing-config');
    if (node?.textContent) mountBisLanding(JSON.parse(node.textContent) as LandingConfig);
  </script>
</Base>

<style>
  /* The page's own bottom space above the site footer, as the spec pages keep it. */
  .bis-landing {
    padding-bottom: 40px;
  }
  .bis-tier {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 8px;
  }
  .bis-summary {
    margin: 0;
    padding-bottom: 16px;
  }
  .bis-summary [hidden] {
    display: none;
  }
  .bis-finished {
    --ch-foot-h: 44px;
    --ch-foot-phone-h: 56px;
    margin-bottom: 12px;
  }
  /* Empty until the finished server sim line mounts; Base.astro's pre-paint script stamps
     data-finished when the cached account has a finished run waiting, so the line's room is held
     before it mounts and nothing below it moves. */
  .bis-finished:empty {
    display: none;
  }
  :global(html[data-finished='1']) .bis-finished:empty {
    display: block;
    min-height: var(--ch-foot-phone-h);
  }
  @media (min-width: 600px) {
    :global(html[data-finished='1']) .bis-finished:empty {
      min-height: var(--ch-foot-h);
    }
  }
</style>
