---
// web/src/pages/bis/index.astro
// Leveling BiS index: classes -> specs, one row per written spec (data/curated/specs.json,
// the same catalog the rotation-accuracy program measures against). A spec with no ranked
// list yet still gets a link -- its own page carries the empty state -- rather than being
// left off the index, which would look like the class does not exist here at all.
import Base from '../../layouts/Base.astro';
import ClassTile from '../../components/ClassTile.astro';
import UpdatedStamp from '../../components/UpdatedStamp.astro';
import classes from '../../data/classes.json';
import activeBuild from '../../data/active-build.json';
import { latest } from '../../lib/dates';
import { bisCopy } from '../../lib/bis/copy';
import { groupByClass, loadBisFile, readSpecCatalog } from '../../lib/bis/load';

const catalog = readSpecCatalog();
const grouped = groupByClass(catalog);
const loadedFiles = catalog
  .map((spec) => loadBisFile(spec.spec, activeBuild.build))
  .filter((file) => file !== null);
const updated =
  loadedFiles.length > 0 ? latest(loadedFiles.map((file) => new Date(file.generated_at))) : null;
const classesWithSpecs = classes
  .map((c) => ({
    ...c,
    specs: (grouped.find((g) => g.classSlug === c.slug)?.specs ?? []).map((spec) => ({
      ...spec,
      hasData: loadBisFile(spec.spec, activeBuild.build) !== null,
    })),
  }))
  .filter((c) => c.specs.length > 0);
---

<Base title={bisCopy.indexTitle} description={bisCopy.indexDescription} path="/bis">
  <main
    id="main"
    tabindex="-1"
    class="max-w-[1000px] w-full mx-auto px-[18px] md:px-12 py-10 flex flex-col gap-5"
  >
    <header class="flex flex-col gap-2">
      <h1 class="text-[28px] font-bold tracking-[0.02em]">{bisCopy.indexTitle}</h1>
      {updated && <UpdatedStamp date={updated} />}
    </header>
    <p class="text-muted text-[14px]">{bisCopy.indexIntro}</p>
    <div class="flex flex-col gap-3">
      {classesWithSpecs.map((c) => (
        <section id={c.slug} class="rounded-control bg-raised border border-line p-4 scroll-mt-20">
          <div class="grid grid-cols-[84px_1fr] gap-4 items-start">
            <ClassTile name={c.name} slug={c.slug} />
            <ul class="flex flex-wrap gap-x-4 gap-y-1 list-none p-0 m-0 text-[13px]">
              {c.specs.map((spec) => (
                <li>
                  <a href={`/bis/${spec.class_slug}/${spec.spec_slug}`}>
                    {spec.name}
                    {!spec.hasData && <span class="text-muted"> · {bisCopy.noDataYet}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </main>
</Base>
