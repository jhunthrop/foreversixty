---
// web/src/pages/bis/index.astro
// /bis: the best-in-slot landing (design/specs/2026-10-10-bis-landing.md). It answers one
// question, "what should I wear right now?", and gets a player from the front door to their own
// spec's list at their own band in one click: the hero, the shared character header (the selected
// character, how many of its slots it wears, one button; signed out, its one muted line), then
// the band strip and the nine class cards in game order. No spec carries a figure here -- the
// tier list owns rankings. Everything but the live header and the character's marks is
// prerendered; the page script mounts those after the page settles and follows the header
// selector in place.
import Base from '../../layouts/Base.astro';
import BisBandStrip from '../../components/bis/BisBandStrip.astro';
import BisClassCard from '../../components/bis/BisClassCard.astro';
import PageHead from '../../components/ui/PageHead.astro';
import ActionLink from '../../components/ui/ActionLink.svelte';
import BisLandingHeader from '../../components/bis/BisLandingHeader.svelte';
import UpdatedStamp from '../../components/UpdatedStamp.astro';
import activeBuild from '../../data/active-build.json';
import { landingCopy } from '../../lib/bis/landing-copy';
import { loadLandingData } from '../../lib/bis/landing-build';

const { cards, captions, raidLabel, updated, config } = loadLandingData(activeBuild.build);
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<Base title={landingCopy.title} description={landingCopy.description} path="/bis">
  <main
    id="main"
    tabindex="-1"
    class="flex flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-0 md:pt-7"
    data-testid="bis-landing"
  >
    <PageHead eyebrow={landingCopy.eyebrow} title={landingCopy.h1} job={landingCopy.jobLine}>
      <Fragment slot="meta">{updated && <UpdatedStamp date={updated} />}</Fragment>
      <div slot="aside" class="tier">
        <span class="tier-question">{landingCopy.tierQuestion}</span>{' '}
        <ActionLink href={landingCopy.tierHref} data-testid="bis-index-tier-link">
          {landingCopy.tierLink}
        </ActionLink>
      </div>
    </PageHead>

    <div data-bis-header data-testid="bis-header-slot">
      <BisLandingHeader config={config} />
    </div>
    <BisBandStrip captions={captions} raidLabel={raidLabel} />
    <div class="grid-wrap" id="bis-classes">
      <h2 class="grid-heading heading-section" data-grid-heading data-testid="bis-grid-heading">
        <span data-signed-out-only>{landingCopy.gridHeadingSignedOut}</span>
        <span data-signed-in-only>{landingCopy.gridHeadingSignedIn}</span>
      </h2>
      <div class="grid" data-testid="bis-class-grid">
        {cards.map((card) => (
          <BisClassCard name={card.name} slug={card.slug} color={card.color} specs={card.specs} />
        ))}
      </div>
    </div>
  </main>
  <script is:inline type="application/json" id="bis-landing-config" set:html={configJson}></script>
  <script>
    import { mountBisLanding } from '../../lib/bis/landing-client';
    import type { LandingConfig } from '../../lib/bis/landing-config';

    const node = document.getElementById('bis-landing-config');
    if (node?.textContent) mountBisLanding(JSON.parse(node.textContent) as LandingConfig);
  </script>
</Base>

<style>
  .tier {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 8px;
    font-size: 14px;
  }
  .tier-question {
    color: var(--color-muted);
  }
  .grid-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .grid-heading {
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
