---
// web/src/pages/planner.astro
// Static page. `?class=`, `?race=`, `?code=` and the rest are read by the island in the browser,
// because the page itself is prerendered and has no request to read. The island draws the whole
// page (spec 2026-11-08): the head, the bar, the one Plate of trees and the rail, in the wide page
// column (L3 Workbench). Its server render is the first paint: the head and the bar, the Plate's
// skeleton at the ready trees' height, so the trees arriving move nothing.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Planner from '../components/planner/Planner.svelte';
import activeBuild from '../data/active-build.json';
import { DEFAULT_CLASS_SLUG } from '../lib/planner/config';
import { loadTalentFile } from '../lib/guides/build-tree';
import type { GuideBuild } from '../lib/planner/guide-builds';
import { searchCopy } from '../lib/search-copy';
import { legalRacesFor } from '../lib/planner/rules';
import classes from '../data/generated/classes.json';
import races from '../data/generated/races.json';
import combos from '../data/generated/combos.json';
import { webApplicationLd } from '../lib/seo';

// The opening class's trees, left to right: their art painted by the loading Plate (the page's
// largest paint) and their names as its heads, so the first paint names the trees it draws.
const openingTreeFiles = (loadTalentFile(activeBuild.build, DEFAULT_CLASS_SLUG)?.trees ?? [])
  .slice()
  .sort((a, b) => a.position - b.position);
const openingArt = openingTreeFiles
  .filter((tree) => tree.background)
  .map((tree) => `trees/${tree.background}.webp`);
const openingTrees = openingTreeFiles.map((tree) => tree.name);
// Every spec guide's published builds (its levelling build, and its raid build where it has one):
// the rail's Guide builds for the class on screen.
const guideBuilds: GuideBuild[] = (await getCollection('guides')).flatMap((guide) => {
  const specSlug = guide.id.split('/')[1];
  if (guide.data.spec === undefined || specSlug === undefined) return [];
  const base = { classSlug: guide.data.classSlug, specSlug };
  return [
    ...(guide.data.build === undefined
      ? []
      : [{ ...base, kind: 'leveling' as const, code: guide.data.build }]),
    ...(guide.data.raidBuild === undefined
      ? []
      : [{ ...base, kind: 'raid' as const, code: guide.data.raidBuild }]),
  ];
});
// The opening class's legal races: the Race select's options in the server render.
const openingClassId = classes.find((row) => row.slug === DEFAULT_CLASS_SLUG)?.id ?? null;
const openingRaces = legalRacesFor(races, combos, openingClassId).map(({ slug, name }) => ({ slug, name }));
const jsonLd = [
  webApplicationLd({
    name: searchCopy.planner.appName,
    description: searchCopy.planner.description,
    path: '/planner',
    category: 'GameApplication',
  }),
];
---

<Base title={searchCopy.planner.title} description={searchCopy.planner.description} path="/planner" {jsonLd}>
  <main id="main" tabindex="-1" class="pb-(--section-gap)">
    <!-- `client:after-paint`, not `client:load` (src/directives/after-paint.ts): the island's
         server-rendered head is the page's largest contentful paint, and `client:load` put its
         whole chain ahead of that first paint (2026-11-02: a median score of 0.84 and LCP 4.1 s
         on a quiet machine, against the 0.90 budget). -->
    <Planner
      client:after-paint
      treeVersion={activeBuild.build}
      classSlug={DEFAULT_CLASS_SLUG}
      {openingArt}
      {openingTrees}
      {guideBuilds}
      {openingRaces}
    />
  </main>
</Base>
