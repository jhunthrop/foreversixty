---
// web/src/pages/sim/weights.astro
// Static. The island reads ?source= and ?ref= in the browser, because the page is
// prerendered and has no request to read.
//
// The skeleton below is the same string ToolsView.svelte renders while its view chunk
// resolves (bulk-skeleton.ts is the one source both read), so the mount swap moves nothing
// and the page holds its CLS budget -- the identical reservation technique sim/[id].astro
// and sim/specs.astro already use, and for the identical reason.
//
// The min-h reservation below is measured (Task 21): the fixture character loaded at 360px
// and 1280px, sim-tools's own rendered height rounded up -- so the mount swap moves nothing
// and the page holds its CLS budget, exactly as sim/[id].astro's own comment describes.
//
// 2026-10-31 re-measure (the "Jump to" spine bar removed, and its reserved band with it from
// the skeleton and this budget): the same method and state, the fixture character loaded by
// ?code= with no session, measured 2112.5px at 360 and 1170px at 1280 and 1440 (the previous
// figures had drifted under the hydrated height). Reserved 24px over each, the CI-fonts
// buffer the /sim shell uses.
//
// 2026-11-10 (SEO lane): the shell is no longer a skeleton. It server-renders the island's
// no-character state (WeightsShell.svelte) with the default spec's level 60 published weights,
// read here from the same BiS file the island reads, and hands that table to the island on
// the mount (data-default-weights), so a crawler without JavaScript reads the figures a player
// sees. A build whose file publishes no such band falls back to the skeleton.
import activeBuild from '../../data/active-build.json';
import Base from '../../layouts/Base.astro';
import { loadBisFile } from '../../lib/bis/load';
import { DEFAULT_WEIGHTS_SPEC, defaultPublishedWeights } from '../../lib/sim/published-weights';
import WeightsShell from '../../components/sim/tools/WeightsShell.svelte';
import { bulkCopy, simCopy } from '../../lib/sim/copy';
import { TOOL_SKELETONS } from '../../lib/sim/bulk-skeleton';
import SimToolHead from '../../components/sim/SimToolHead.svelte';
import IslandScript from '../../components/IslandScript.astro';

const defaultFile = loadBisFile(DEFAULT_WEIGHTS_SPEC, activeBuild.build);
const defaultWeights = defaultFile === null ? null : defaultPublishedWeights(defaultFile);
---

<Base title={bulkCopy.weightsTitle} description={simCopy.weightsDescription} path="/sim/weights" wide>
  <link rel="stylesheet" href="/sim-tools-island.css" slot="head" />
  <main id="main" tabindex="-1" class="sim-page">
    <SimToolHead tool="weights" title={bulkCopy.weightsTitle} lead={bulkCopy.weightsLead} />
    <div
      id="sim-tools"
      data-sim-tool="weights"
      data-default-weights={defaultWeights === null ? undefined : JSON.stringify(defaultWeights)}
      class="min-h-[2137px] md:min-h-[1194px]"
    >
      <noscript>
        {defaultWeights === null ? (
          <p
            class="text-muted px-[var(--page-inset)] pt-5 text-[14px]"
            set:html={bulkCopy.needsJs(bulkCopy.weightsTitle)}
          />
        ) : (
          <p class="text-muted px-[var(--page-inset)] pt-5 pb-2 text-[14px]">{bulkCopy.weightsNeedsJs}</p>
        )}
      </noscript>
      {defaultWeights === null ? (
        <Fragment set:html={TOOL_SKELETONS.weights} />
      ) : (
        <WeightsShell published={defaultWeights} />
      )}
    </div>
    <IslandScript src="/sim-tools-island.js" />
  </main>
</Base>

<style>
  .sim-page {
    padding-bottom: 40px;
  }
</style>
