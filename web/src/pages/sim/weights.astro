---
// web/src/pages/sim/weights.astro
// Static. The island reads ?source= and ?ref= in the browser, because the page is
// prerendered and has no request to read.
//
// The skeleton below is the same string ToolsView.svelte renders while its view chunk
// resolves (bulk-skeleton.ts is the one source both read), so the mount swap moves nothing
// and the page holds its CLS budget -- the identical reservation technique sim/[id].astro
// and sim/specs.astro already use, and for the identical reason.
//
// The min-h reservation below is measured (Task 21): the fixture character loaded at 360px
// and 1280px, sim-tools's own rendered height rounded up -- so the mount swap moves nothing
// and the page holds its CLS budget, exactly as sim/[id].astro's own comment describes.
import Base from '../../layouts/Base.astro';
import { bulkCopy } from '../../lib/sim/copy';
import { TOOL_SKELETONS } from '../../lib/sim/bulk-skeleton';
---

<Base
  title="Stat weights"
  description="What one point of each stat is worth for your character, with the caveat that comes with it."
  path="/sim/weights"
  session
>
  <link rel="stylesheet" href="/sim-tools-island.css" slot="head" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <h1 class="section-title px-[18px] text-[18px] md:px-0">{bulkCopy.weightsTitle}</h1>
    <p class="text-muted px-[18px] text-[14px] md:px-0" data-testid="sim-tool-intro">
      {bulkCopy.weightsIntro}
    </p>
    <div id="sim-tools" data-sim-tool="weights" class="min-h-[2003px] md:min-h-[1111px]">
      <Fragment set:html={TOOL_SKELETONS.weights} />
      <noscript>
        <p class="text-muted px-[18px] text-[14px] md:px-0" set:html={bulkCopy.needsJs('Stat weights')} />
      </noscript>
    </div>
    <script type="module" src="/sim-tools-island.js" is:inline></script>
  </main>
</Base>
