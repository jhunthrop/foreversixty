---
// web/src/pages/sim/specs.astro
// Which specs the simulator is trusted for, and by how much. Static; the island fetches
// GET /v1/specs.
import Base from '../../layouts/Base.astro';
import SimToolHead from '../../components/sim/SimToolHead.svelte';
import SpecGrid from '../../components/sim/SpecGrid.svelte';
import IslandScript from '../../components/IslandScript.astro';
import activeBuild from '../../data/active-build.json';
import { loadBisBenchmarks } from '../../lib/sim/bis-benchmark-load';

// Each damage row's raid BiS DPS at 60 (lib/sim/bis-benchmark.ts), build-time data.
const bisBenchmarks = loadBisBenchmarks(activeBuild.build);
---

<Base
  title="Spec support"
  description="Which World of Warcraft: Forever specs the simulator models, how close each one is to real parses, and when the rest arrive."
  path="/sim/specs"
>
  <link rel="stylesheet" href="/sim-island.css" slot="head" />
  <main id="main" tabindex="-1" class="sim-page">
    <!-- The head is static, ahead of the island: its lead was the measured LCP element (round 2,
         Lighthouse), and SpecGrid's no-rows render is the shell's reservation (round 5), the
         same component the island mounts, so the mount moves nothing. -->
    <SimToolHead tool="specs" title="Spec support" />
    <div id="sim" data-sim-mount data-sim-view="specs" data-bis-benchmarks={JSON.stringify(bisBenchmarks)}>
      <SpecGrid rows={null} error={null} onretry={() => {}} benchmarks={bisBenchmarks} />
      <noscript>
        <p class="text-muted px-[var(--page-inset)] text-[14px]">
          Spec support needs JavaScript. The <a href="/sim">simulator</a> does too.
        </p>
      </noscript>
    </div>
    <IslandScript src="/sim-island.js" />
  </main>
</Base>

<style>
  .sim-page {
    padding-bottom: 40px;
  }
</style>
