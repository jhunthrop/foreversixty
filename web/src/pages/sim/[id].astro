---
// web/src/pages/sim/[id].astro
// Only the fixture sim is prerendered, and only under FOREVER_DATA=fixture: every other id
// is served by src/worker.ts from sim.html with its head rewritten. Prerendering the fixture
// gives Lighthouse and Playwright a page with real content rather than an empty shell.
import Base from '../../layouts/Base.astro';
import { VIEW_GAP } from '../../lib/current-character-layout';
import { FIXTURE_FULL_SIM_ID, FIXTURE_SIM_ID, fixtureSimPaths } from '../../lib/report/shell-paths';
import fixtureResult from '../../fixtures/sim/result.json';
import fixtureFullResult from '../../fixtures/sim/result-full.json';
import { SIM_SAVED_SKELETON_HTML } from '../../lib/sim/skeleton';
import IslandScript from '../../components/IslandScript.astro';

export function getStaticPaths() {
  return fixtureSimPaths();
}

const { id } = Astro.params;
const FIXTURE_INLINE: Readonly<Record<string, unknown>> = {
  [FIXTURE_SIM_ID]: fixtureResult,
  [FIXTURE_FULL_SIM_ID]: fixtureFullResult,
};
const fixture = id === undefined ? undefined : FIXTURE_INLINE[id];
const inline = fixture === undefined ? undefined : JSON.stringify(fixture);
---

<Base
  title="Saved sim"
  description="A saved World of Warcraft: Forever simulation: the character, the settings, and what the engine produced."
  path={`/sim/${id}`}
  wide
>
  <link rel="stylesheet" href="/sim-island.css" slot="head" />
  <main id="main" tabindex="-1" class="sim-page">
    <!--
      Reserves the saved sim's space before the island mounts, the same reason and the same
      pattern reports/[id].astro uses: without it the shell is one line tall, the footer sits
      inside the viewport, and rendering the saved sim shoves it down by the result's own height.
      SimView.svelte's own loading state ({@html SIM_SAVED_SKELETON_HTML}) renders the identical
      string, so nothing shifts between the two moments.

      2026-11-05 re-measure (spec 2026-11-04-sim-results 4.2), on this Lighthouse fixture
      (simfixtureab) as it hydrates, each lazy card at the reserve its own data sizes
      (lib/sim/section-reserve.ts): 360px settles at 8198px, 1280 and 1440 at 5368.5px; reserved
      24px over each (the CI-fonts buffer): 8222/5393. sim-island.ts drops every min-h class once
      the island mounts, so a result shorter than this never keeps a hole above the footer.
    -->
    <div
      id="sim"
      data-sim-mount
      data-sim-id={id}
      data-sim-result={inline}
      class="min-h-[8222px] md:min-h-[5393px]"
    >
      <div class={`flex flex-col ${VIEW_GAP}`}>
        <Fragment set:html={SIM_SAVED_SKELETON_HTML} />
      </div>
    </div>
    <IslandScript src="/sim-island.js" />
  </main>
</Base>

<style>
  /* No tool tabs and no run line on a saved run (spec 2026-11-06-sim, ruling S5). */
  .sim-page {
    padding-bottom: 40px;
  }
</style>
