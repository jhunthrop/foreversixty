---
// web/src/pages/sim/[id].astro
// Only the fixture sim is prerendered, and only under FOREVER_DATA=fixture: every other id
// is served by src/worker.ts from sim.html with its head rewritten. Prerendering the fixture
// gives Lighthouse and Playwright a page with real content rather than an empty shell.
import Base from '../../layouts/Base.astro';
import { CHIP_HEIGHT, VIEW_GAP } from '../../lib/current-character-layout';
import { FIXTURE_SIM_ID, fixtureSimPaths } from '../../lib/report/shell-paths';
import fixtureResult from '../../fixtures/sim/result.json';
import { SIM_SAVED_SKELETON_HTML } from '../../lib/sim/skeleton';
import ScopeNote from '../../components/sim/ScopeNote.astro';
import SimTabs from '../../components/sim/SimTabs.astro';

export function getStaticPaths() {
  return fixtureSimPaths();
}

const { id } = Astro.params;
const inline = id === FIXTURE_SIM_ID ? JSON.stringify(fixtureResult) : undefined;
---

<Base
  title="Saved sim"
  description="A saved World of Warcraft: Forever simulation: the character, the settings, and what the engine produced."
  path={`/sim/${id}`}
>
  <link rel="stylesheet" href="/sim-island.css" slot="head" />
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <SimTabs currentPath="/sim" />
    <!-- This page has no `<h1>` of its own (the saved sim's own title comes from the island
         once it mounts), so ScopeNote sits directly below the tab strip instead, the
         nearest equivalent position. -->
    <ScopeNote />
    <!--
      Round 3 (Lighthouse): reserves the saved sim's space before the island mounts, the
      same reason and the same pattern reports/[id].astro uses -- without it the shell is
      one line tall, the footer sits inside the viewport, and rendering the saved sim
      shoves it down by roughly the result's own height (measured: 0.326 CLS on
      /sim/simfixtureab.html, the footer moving with barlow-latin-600-normal.woff2's load
      only made it visible; the mount swap alone is the real cause, on any font). Measured
      on the fixture at 360px and 1280px: the hydrated view settles at ~1234px mobile /
      ~900px desktop, so the reservation matches that height directly rather than guessing
      a multiple of the viewport. SimView.svelte's own loading state ({@html
      SIM_SAVED_SKELETON_HTML}, between mounting and a real (non-prerendered) id's fetch
      resolving) renders the identical string, so nothing shifts between the two moments
      report/skeleton.ts's own comment describes.

      Raised by the current-character chip's own reserved band (Task 5, the same
      gear.astro pattern): CHIP_HEIGHT (`h-[88px] md:h-11`) plus the view's own gap before
      the next block (`gap-[22px]` phone, `md:gap-8` desktop) -- +110px phone, +76px
      desktop, on top of the Round 3 figures above. The slot sits first, above
      SIM_SAVED_SKELETON_HTML, the same position SimView.svelte's own render puts it in --
      that skeleton string itself carries no chip slot of its own (it would double up with
      this one, which SimView.svelte also renders unconditionally, saved sim or not).

      Fix round 1, Important #2 (worst here: this is the prerendered Lighthouse fixture
      page): the slot and SIM_SAVED_SKELETON_HTML are wrapped in `flex flex-col
      ${VIEW_GAP}`, the identical gap SimView.svelte's own root uses between them once
      hydrated. Without this wrapper the two sat flush against each other pre-hydration
      but 22px/32px apart after, so the whole saved-sim skeleton -- and the real result
      that replaces it -- painted noticeably higher before hydration than after, on the
      one page this repository actually measures with Lighthouse.
    -->
    <div
      id="sim"
      data-sim-mount
      data-sim-id={id}
      data-sim-result={inline}
      class="min-h-[1344px] md:min-h-[976px]"
    >
      <div class={`flex flex-col ${VIEW_GAP}`}>
        <div class={CHIP_HEIGHT} data-testid="current-character-bar"></div>
        <Fragment set:html={SIM_SAVED_SKELETON_HTML} />
      </div>
    </div>
    <script type="module" src="/sim-island.js"></script>
  </main>
</Base>
