---
// web/src/pages/sim/gear.astro
// Static. The island reads ?source= and ?ref= in the browser, because the page is
// prerendered and has no request to read.
//
// The skeleton below is the same string ToolsView.svelte renders while its view chunk
// resolves (bulk-skeleton.ts is the one source both read), so the mount swap moves nothing
// and the page holds its CLS budget -- the identical reservation technique sim/[id].astro
// and sim/specs.astro already use, and for the identical reason.
//
// The min-h reservation below is measured (Task 21): the fixture character loaded at 360px
// and 1280px, sim-tools's own rendered height rounded up -- so the mount swap moves nothing
// and the page holds its CLS budget, exactly as sim/[id].astro's own comment describes.
//
// 2026-10-31 re-measure (the "Jump to" spine bar removed, and its reserved band with it from
// the skeleton and this budget): the same method and state, the fixture character loaded by
// ?code= with no session, measured 3444.5px at 360 and 1994px at 1280 and 1440 (the previous
// figures had drifted under the hydrated height). Reserved 24px over each, the CI-fonts
// buffer the /sim shell uses.
import Base from '../../layouts/Base.astro';
import { bulkCopy, simCopy } from '../../lib/sim/copy';
import { TOOL_SKELETONS } from '../../lib/sim/bulk-skeleton';
import SimToolHead from '../../components/sim/SimToolHead.svelte';
import IslandScript from '../../components/IslandScript.astro';
import IslandStyle from '../../components/IslandStyle.astro';
---

<Base title={bulkCopy.gearTitle} description={simCopy.gearDescription} path="/sim/gear">
  <IslandStyle href="/sim-tools-island.css" slot="head" />
  <main id="main" tabindex="-1" class="sim-page">
    <SimToolHead tool="gear" title={bulkCopy.gearTitle} />
    <div id="sim-tools" data-sim-tool="gear" class="min-h-[3469px] md:min-h-[2018px]">
      <Fragment set:html={TOOL_SKELETONS.gear} />
      <noscript>
        <p
          class="text-muted px-[var(--page-inset)] pt-5 text-[14px]"
          set:html={bulkCopy.needsJs(bulkCopy.gearTitle)}
        />
      </noscript>
    </div>
    <IslandScript src="/sim-tools-island.js" />
  </main>
</Base>

<style>
  .sim-page {
    padding-bottom: 40px;
  }
</style>
