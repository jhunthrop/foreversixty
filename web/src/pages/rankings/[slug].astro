---
// web/src/pages/rankings/[slug].astro
// Only under FOREVER_DATA=fixture: one encounter Playwright can navigate to without a
// Worker. A real build prerenders none of these; every /rankings/<slug> is the shell.
import Base from '../../layouts/Base.astro';
import Rankings from '../../components/Rankings.svelte';
import { fixtureRankingsPaths } from '../../lib/report/shell-paths';
import { titleize } from '../../lib/report/og-meta';

export function getStaticPaths() {
  return fixtureRankingsPaths();
}

const { slug } = Astro.params;
---

<Base
  title={`${titleize(slug ?? '')} rankings`}
  description="World of Warcraft: Forever rankings by encounter: characters, guilds, specs and phases."
  path={`/rankings/${slug}`}
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col">
    <!-- `client:after-paint`, not `client:load` (src/directives/after-paint.ts): the island's
         server-rendered header and board skeleton are the page's largest contentful paint, and
         `client:load` put its ~60-module chain ahead of that first paint, so Lighthouse's
         simulation charged it to LCP (2026-11-06: 3.5 s, performance 0.88). -->
    <Rankings client:after-paint slug={slug ?? ''} />
  </main>
</Base>
