---
// web/src/pages/app/auth.astro
// Where the API's app sign-in hands its one-time code (api/internal/auth/app_auth.go):
// https://foreversixty.gg/app/auth?code=…&state=…. The phone apps catch this link
// themselves; this page shows only when they did not. Its handoff script runs first thing
// in <head>: the code and state leave the address bar before paint and live only in that
// script's memory, and the button carries them back to the app. public/_headers serves
// /app/* with no referrer and no caching. Only /app/* opens the apps (app-links.json).
// The message page (mock web-app-auth, ws_app_auth.py; directions mock b4-app-auth): the title alone
// in the band, then one framed Plate in the form layout: the sentence, the one primary and the two
// quiet lines.
import Base from '../../layouts/Base.astro';
import appLinks from '../../../app-links.json';
import { appHandoff } from '../../lib/app-links/handoff';
import { handoffCopy } from '../../lib/app-links/handoff-copy';
import Page from '../../components/ui/Page.svelte';
import PageHeader from '../../components/ui/PageHeader.svelte';
import Plate from '../../components/ui/Plate.svelte';
import { button } from '../../lib/ui/button';

const handoffScript = `(${appHandoff.toString()})(window, ${JSON.stringify(appLinks.androidPackage)});`;
---

<Base title={handoffCopy.title} description={handoffCopy.description} path="/app/auth">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <script is:inline set:html={handoffScript}></script>
  </Fragment>
  <main id="main" tabindex="-1">
    <Page layout="form">
      <PageHeader slot="header" title={handoffCopy.heading} />
      <Plate frame="framed" label={handoffCopy.heading}>
        <div class="flex flex-col items-start gap-3 px-5 pt-4 pb-[18px]">
          <p class="text-strong m-0 text-[16px] leading-6">{handoffCopy.body}</p>
          <button type="button" class={button('primary')} data-app-handoff hidden>
            {handoffCopy.button}
          </button>
          <p class="text-small text-muted m-0" data-app-handoff-missing hidden>
            {handoffCopy.missing}
          </p>
          <p class="text-small text-muted m-0">{handoffCopy.notYou}</p>
        </div>
      </Plate>
    </Page>
  </main>
</Base>
