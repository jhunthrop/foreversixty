---
// web/src/pages/account.astro
// Your account (design/specs/2026-11-08-premium-account.md section 7): the whole page is one island
// (components/account/AccountPage.svelte through Account.svelte) over one /v1/me read; the server
// markup is its loading state, which reserves the ready page's shape for a hinted visitor.
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';

/** Freezes the pre-paint pointer hint (Base.astro's data-pointer) for the loading head's answer
 *  reserve (AccountHead.svelte): the header may write a pointer while the page loads. */
const ANSWER_HINT_SCRIPT =
  "if(document.documentElement.dataset.pointer==='1')document.documentElement.dataset.accountAnswer='1'";
---

<Base
  title="Your account"
  description="Your Forever Sixty account: your characters, your plan, paired devices, Discord and how your name appears."
  path="/account"
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col">
    <script is:inline set:html={ANSWER_HINT_SCRIPT}></script>
    <!-- `client:after-paint`, not `client:load` (src/directives/after-paint.ts): the island's module
         chain stays behind the server-drawn first paint (its loading frame, or the sign-in page
         without a session hint), which Lighthouse would otherwise charge to LCP, as on /setup. -->
    <Account client:after-paint mode="account" />
  </main>
</Base>
