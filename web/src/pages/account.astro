---
// web/src/pages/account.astro
// Your account (design/specs/2026-11-08-premium-account.md section 7): the whole page is one island
// (components/account/AccountPage.svelte through Account.svelte) over one /v1/me read; the server
// markup is its loading state, which reserves the ready page's shape for a hinted visitor.
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
---

<Base
  title="Your account"
  description="Your Forever Sixty account: your characters, your plan, paired devices, Discord and how your name appears."
  path="/account"
  wide
>
  <main id="main" tabindex="-1" class="flex w-full flex-col">
    <Account client:load mode="account" />
  </main>
</Base>
