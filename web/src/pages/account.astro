---
// web/src/pages/account.astro
import Base from '../layouts/Base.astro';
import Account from '../components/Account.svelte';
---

<Base
  title="Your account"
  description="Your Forever Sixty account: paired devices, linked characters, and how your name appears."
  path="/account"
  session
>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <!-- The title lives inside Account.svelte itself, not here (brief 2026-09-22 §B1: it
         sits beside the identity line at lg, and both come from the same `me` load) --
         same "the island owns its own <h1>" pattern character.astro uses for
         Character.svelte, rather than the two rendering a duplicate heading. -->
    <Account client:load mode="account" />
  </main>
</Base>
