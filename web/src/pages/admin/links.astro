---
// web/src/pages/admin/links.astro
// /admin/links: the owner's tracked links (foreversixty.gg/go/<slug>) and the funnel of each.
// The PageHeader is static; the body under it is one island (GoLinksAdmin: a split Page, the
// links' Plate and the New link rail), because every state follows one session read and the API
// decides who is the owner. Never indexed, never in the sitemap.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/ui/PageHeader.svelte';
import GoLinksAdmin from '../../components/admin/GoLinksAdmin.svelte';
import { adminLinksCopy as copy } from '../../lib/golinks/admin-copy';
---

<Base title={copy.pageTitle} description={copy.pageDescription} path="/admin/links">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" tabindex="-1" class="pb-(--section-gap)" data-testid="admin-links-page">
    <PageHeader title={copy.pageTitle} lead={copy.job} />
    <GoLinksAdmin client:load />
  </main>
</Base>
