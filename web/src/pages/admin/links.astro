---
// web/src/pages/admin/links.astro
// /admin/links: the owner's tracked links (foreversixty.gg/go/<slug>) and the funnel of each.
// The head is static; the card under it is one island, because every state follows one session
// read and the API decides who is the owner. Never indexed, never in the sitemap.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/ui/PageHead.astro';
import GoLinksAdmin from '../../components/admin/GoLinksAdmin.svelte';
import { adminLinksCopy as copy } from '../../lib/golinks/admin-copy';
---

<Base title={copy.pageTitle} description={copy.pageDescription} path="/admin/links">
  <meta slot="head" name="robots" content="noindex" />
  <main
    id="main"
    tabindex="-1"
    class="flex flex-col gap-[22px] px-[var(--page-inset)] pt-4 pb-10 md:gap-8 md:pt-7"
    data-testid="admin-links-page"
  >
    <PageHead eyebrow={copy.eyebrow} title={copy.pageTitle} job={copy.job} />
    <GoLinksAdmin client:load />
  </main>
</Base>
