---
// web/src/pages/index.astro
// The landing page, rebuilt to the home rebuild experience spec (2026-09-30): tenet 14's
// one sentence, "pick your class" as the front door signed out, "your character" as the
// front door signed in. The site Header (logo, nav, search, account chip) is a separate
// lane's surface (site-logo) and is out of scope here -- this page begins at the sky
// band's hero content, below Base.astro's own Header.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { HOME_DESCRIPTION, SITE_NAME } from '../lib/seo';
import { heroCardFor } from '../lib/home/hero-card';
import { latestNews } from '../lib/home/news';
import SkyBand from '../components/SkyBand.astro';
import HomeDatesLine from '../components/HomeDatesLine.astro';
import CharacterSearch from '../components/CharacterSearch.astro';
import IconTile from '../components/ui/IconTile.svelte';
import StatTile from '../components/ui/StatTile.svelte';
import Glyph from '../components/ui/Glyph.svelte';
import HomeOutcomeRows from '../components/HomeOutcomeRows.astro';
import ClassCrest from '../components/ClassCrest.astro';
import Card from '../components/ui/Card.astro';
import ActionLink from '../components/ui/ActionLink.svelte';
import FeedRow from '../components/FeedRow.astro';
import HomeAccountPanel from '../components/HomeAccountPanel.svelte';
import HomeGetSetUp, { HOME_GET_SET_UP_SIGNED_OUT_ID } from '../components/HomeGetSetUp.svelte';
import RecentReports from '../components/RecentReports.svelte';
import HomeTopGuilds from '../components/HomeTopGuilds.svelte';
import { HOME_SIGNED_OUT_ID, homePanelCopy } from '../lib/home-panel-copy';
import {
  HOME_UPGRADES_FALLBACK_PX,
  HOME_UPGRADES_MAX_RESERVE_PX,
  HOME_UPGRADES_RESERVE_KEY,
  HOME_UPGRADES_RESERVE_VAR,
} from '../lib/home/upgrades-layout';
import {
  homeAroundTheSiteCopy,
  homeClassPickerCopy,
  homeCompanionRow,
  homeHeroCopy,
  homeHeroStatePanelCopy,
} from '../lib/home-landing-copy';
import { battlenetStartUrl } from '../lib/account/api';
import { BUTTON_MD, BUTTON_PRIMARY, button } from '../lib/ui/button';
import classes from '../data/classes.json';
import dates from '../data/dates.json';
// Generated by scripts/hero-font.py -- do not hand-edit; see that file for why this exists.
// A Barlow Condensed 800 subset containing exactly the hero headline's own capitals ("Play
// your class better.", per home rebuild spec §1, set uppercase in the heading face per polish
// spec 2026-10-28 §4.4), inlined so the hero paints in its real face at first paint instead
// of waiting on the full heading-face download (that wait is this page's LCP: the
// hero h1 below is the LCP element, and Chrome does not count fallback-face text as an LCP
// candidate -- see lane reports web-home-lcp and web-home-chunks). Declared only on this
// page's own head, not Base.astro, so no other page pays for it.
import heroFontCss from '../styles/hero-font.css?raw';

// A "This site" item older than a month is left out (lib/home/news.ts): the page is built once per
// deploy, so the script at the foot of the page hides one that has gone stale since.
const changelog = latestNews(await getCollection('changelog'));

// The hero card follows the clock like the timeline (lib/home/hero-card.ts): built for the deploy's
// date here, re-read against the visitor's clock by the script at the foot of the page.
const heroCard = heroCardFor(dates);

// The countdown tiles' figures: two digits each, the way the tiles read.
const countdownParts = (['days', 'hours', 'minutes'] as const).map((unit) => ({
  unit,
  label: homeHeroStatePanelCopy.countdownLabels[unit],
  value: String(heroCard.countdown?.[unit] ?? 0).padStart(2, '0'),
}));
---

<Base title={SITE_NAME} description={HOME_DESCRIPTION} path="/">
  <main id="main" tabindex="-1" class="flex flex-col">
    <SkyBand>
      <div class="page-column flex flex-col gap-[22px] px-[18px] py-7 lg:py-8">
        <div class="flex flex-col gap-8 lg:grid lg:grid-cols-12 lg:items-end lg:gap-8">
          <!-- §3.A.1 Hero left column (7/12): eyebrow, headline, sentence, nine-class
               picker, sign-in action. The signed-in hero (HomeAccountPanel) occludes this
               same grid cell once /v1/me answers signed-in -- the established "server shell
               first, island swaps in place" trick, unchanged from before this rebuild. -->
          <div class="home-account-cell grid min-w-0 lg:col-span-7" data-testid="home-account-block">
            <div
              id={HOME_SIGNED_OUT_ID}
              data-session-hide
              class="home-signed-out-block [grid-area:1/1] flex min-w-0 flex-col gap-[16px]"
              data-testid="home-signed-out"
            >
              <p class="label text-gold flex items-center gap-[10px]">
                <i class="bg-gold inline-block h-px w-7" aria-hidden="true"></i>
                {homeHeroCopy.eyebrow}
              </p>
              <h1
                class="heading-hero max-w-[640px]"
                style="font-family: 'Barlow Condensed Hero', var(--font-heading);"
              >
                <span class="text-strong">{homeHeroCopy.headlineLead}</span>{' '}
                <span class="gold-text">{homeHeroCopy.headlineAccent}</span>
              </h1>
              <p class="max-w-[560px] text-[15px] leading-relaxed text-[#c9c2b2]">{homeHeroCopy.sentence}</p>
              <!-- Owner-reported defect, 2026-10-01: `overflow-x-auto` forces the vertical
                   axis to clip too, flattening every crest's outside ring/focus outline at
                   this row's top and bottom. Padding (ring + focus-outline clearance: 6px
                   top/bottom, 4px sides) cancelled by an equal negative margin on the same
                   box widens the scrollport's clip boundary without moving this row in the
                   hero's own flow (margin-box unchanged) -- the "Another class" row below
                   (§3.B.5) needed the identical fix. -->
              <div
                class="-mx-1 -my-1.5 grid min-w-0 grid-cols-5 gap-x-3 gap-y-4 px-1 py-1.5 md:flex md:max-w-[760px] md:gap-2 md:overflow-x-auto"
                data-testid="home-class-picker"
              >
                {classes.map((c) => (
                  <a
                    href={`/guides/${c.slug}`}
                    class="flex shrink-0 flex-col items-center gap-[6px]"
                    data-testid={`home-class-picker-${c.slug}`}
                  >
                    <ClassCrest slug={c.slug} size={56} priority />
                    <span class="heading-name text-[10px]" style={`color: ${c.color}`}>
                      {c.name}
                    </span>
                  </a>
                ))}
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-4">
                <a class={`${BUTTON_PRIMARY} ${BUTTON_MD}`} href={battlenetStartUrl('/account?signed_in=1')}>
                  {homePanelCopy.signInButton}
                </a>
                <a
                  class="text-[13px] font-semibold tracking-[0.06em] uppercase text-nav"
                  href={homeHeroCopy.addonAltHref}
                >
                  {homeHeroCopy.addonAltLabel}
                </a>
              </div>
            </div>
            <HomeAccountPanel client:idle-after-load />
          </div>

          <!-- Task L8.2 (fix rounds 1-2, item 7): the character lookup. Signed out it sits here: on
               a phone between the hero and the launch card (DOM order); from lg the grid puts it on its
               own full-width row under the hero row (order-last). Signed in it is moved, before first
               paint, into the `home-lookup-slot` under "Your upgrades" (the inline script there). -->
          <div
            class="min-w-0 lg:order-last lg:col-span-12"
            id="home-lookup-cell"
            data-testid="home-lookup-cell"
          >
            <CharacterSearch />
          </div>

          <!-- §3.A.2 Hero right column (5/12): the launch card, signed out only -- the next
               milestone as three countdown tiles and a link row into the real Hunter list.
               With a session hinted (global.css) this cell collapses and the signed-in hero
               takes the whole row (home signed-in panel spec 2026-10-10). -->
          <div class="home-example-cell grid lg:col-span-5 min-w-0" data-testid="home-launch-block">
            <div class="[grid-area:1/1] min-w-0" data-session-hide data-testid="home-launch-panel-wrap">
              <div class="card-surface flex flex-col gap-4 px-5 py-[18px]" data-testid="home-launch-panel">
                <div
                  class="flex items-center justify-between"
                  data-testid="home-hero-card"
                  data-entries={JSON.stringify(dates)}
                  data-mode={heroCard.mode}
                >
                  <span class="label text-gold flex items-center gap-2">
                    <i
                      class="bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
                      aria-hidden="true"
                    ></i>
                    <span data-part="eyebrow">{heroCard.eyebrow}</span>
                  </span>
                  <span class="numeric text-[12px] text-muted" data-part="tag">
                    {heroCard.tag}
                  </span>
                </div>
                <div
                  class:list={['grid grid-cols-3 gap-3', heroCard.countdown === null && 'hidden']}
                  data-testid="home-hero-countdown"
                >
                  {countdownParts.map((part) => (
                    <StatTile
                      value={part.value}
                      label={part.label}
                      testid={`home-hero-countdown-${part.unit}`}
                    />
                  ))}
                </div>
                <a
                  href={homeHeroStatePanelCopy.linkHref}
                  class="border-line-soft group -mx-2 flex items-center gap-[14px] rounded-control border-t px-2 pt-4 pb-1"
                  data-testid="home-hero-link"
                >
                  <ClassCrest slug="hunter" size={44} priority />
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="heading-name text-[15px]" style="color: #aad372">
                      {homeHeroStatePanelCopy.linkTitle}
                    </span>
                    <span class="text-[13px] text-muted" data-part="bands" data-testid="home-hero-bands">
                      {heroCard.bandsLine}
                    </span>
                  </span>
                  <span class="text-gold group-hover:text-gold-hover flex shrink-0" aria-hidden="true">
                    <Glyph name="chevron" size={18} />
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </SkyBand>

    <!-- §3.A.3 The dates line, directly under the hero for everyone (polish spec 2026-10-28 §5.6):
         one thin line, absent once every date has passed. It sits OUTSIDE SkyBand's own wrapper,
         a sibling of the sky band, so the atmosphere (stars, the ember/night radial glows) never
         bleeds under it. The line carries its own negative bottom margin (short line-to-content gap, and nothing
         left in the column when it is hidden or gone). Signed out it hides while the launch card counts down. -->
    <div class="flex flex-col gap-8 md:gap-12 px-[18px] md:px-0 pb-8 pt-1">
      <HomeDatesLine dates={dates} />

      <!-- §3.A.4 "Best in slot by class" (signed out only) / §3.B.3 "Your upgrades"
           (signed in only) share this position. Toggled by the pre-paint session hint
           (Base.astro's inline script), synchronous and before first paint (global.css's
           data-signed-out-only rule) -- so a `display:none` swap here costs no layout shift
           either way. -->
      <div data-signed-out-only>
        <Card
          glyph="sword"
          title={homeClassPickerCopy.bestInSlotByClassHeading}
          testid="home-class-picker-large"
        >
          <span slot="aside" class="flex flex-wrap items-center justify-end gap-x-4">
            <ActionLink href={homeClassPickerCopy.tierListHref} data-testid="home-tier-list-link">
              {homeClassPickerCopy.tierListLink}
            </ActionLink>
            <ActionLink href={homeClassPickerCopy.allSpecsHref}>
              {homeClassPickerCopy.allSpecsLink}
            </ActionLink>
          </span>
          <div class="grid grid-cols-3 gap-[10px] sm:grid-cols-9">
            {classes.map((c) => (
              <a
                href={`/guides/${c.slug}`}
                class="flex flex-col items-center gap-[10px] rounded-control border border-line bg-raised px-2 pb-[14px] pt-4 transition-colors duration-150 hover:border-[var(--c)]"
                style={`box-shadow: inset 0 2px 0 ${c.color}; --c: ${c.color};`}
              >
                <ClassCrest slug={c.slug} size={64} />
                <span class="heading-name text-[12px]" style={`color: ${c.color}`}>
                  {c.name}
                </span>
              </a>
            ))}
          </div>
        </Card>
      </div>

      <section id="upgrades" data-signed-in-only data-testid="home-upgrades">
        <!-- Home rebuild spec §3.B.3: the real worn-vs-BiS table now that `MeCharacter.
             build.gear` exists (the API lane's own extension to the contract). The header
             row's own aside link names the real spec/band ("Full list for Marksmanship 20
             to 29"), which cannot be known before `/v1/me` and the BiS file both answer, so
             the whole region -- header and body -- is one mounted island
             (`HomeUpgradesPanel.svelte`, mounted by `HomeAccountPanel.svelte` the same
             dynamic-import-once-signed-in way as the hero cards), not
             split between static Astro markup and a slot. `min-h` approximates the ready
             panel's own height so the mount does not visibly shift the rows beneath it. The
             height is the one the island settled at on the last visit (the script below sets it
             before first paint); a first visit holds the smallest real state, so an empty list
             leaves no void. -->
        <div
          id="home-upgrades-slot"
          style={`min-height: var(${HOME_UPGRADES_RESERVE_VAR}, ${HOME_UPGRADES_FALLBACK_PX}px)`}
          data-testid="home-upgrades-slot"
        ></div>
        <script
          is:inline
          define:vars={{
            key: HOME_UPGRADES_RESERVE_KEY,
            prop: HOME_UPGRADES_RESERVE_VAR,
            max: HOME_UPGRADES_MAX_RESERVE_PX,
          }}
        >
          (function () {
            try {
              const slot = document.getElementById('home-upgrades-slot');
              const reserve = Math.round(Number(localStorage.getItem(key)));
              if (slot && reserve > 0 && reserve <= max) slot.style.setProperty(prop, reserve + 'px');
            } catch {
              // Storage is a convenience; the fallback height stands.
            }
          })();
        </script>
      </section>

      <!-- Signed in, the lookup follows "Your upgrades" (owner 2026-10-29). The cell is moved here
           by this inline script while the page is still parsing, off the same pre-paint session
           hint (Base.astro) that shows this slot, so nothing shifts after paint. It is hidden
           signed out, where the lookup stays in the hero. -->
      <div data-signed-in-only data-testid="home-lookup-slot" id="home-lookup-slot"></div>
      <script is:inline>
        (function () {
          const root = document.documentElement;
          const slot = document.getElementById('home-lookup-slot');
          const cell = document.getElementById('home-lookup-cell');
          if (root.dataset.session === '1' && slot && cell) slot.append(cell);
        })();
      </script>
      <HomeOutcomeRows />

      <!-- §3.B.5 "Another class" (signed in only): the signed-in equivalent of the
           signed-out "Best in slot by class" row above -- a smaller, 44px crest row, since
           a signed-in visitor's own class already has its answer in the hero. -->
      <div data-signed-in-only data-testid="home-another-class">
        <Card glyph="user" title={homeClassPickerCopy.anotherClassHeading}>
          <span slot="aside" class="flex flex-wrap items-center justify-end gap-x-4">
            <ActionLink href={homeClassPickerCopy.tierListHref} data-testid="home-tier-list-link">
              {homeClassPickerCopy.tierListLink}
            </ActionLink>
            <ActionLink href={homeClassPickerCopy.allSpecsHref}>
              {homeClassPickerCopy.allSpecsLink}
            </ActionLink>
          </span>
          <!-- Owner-reported defect, 2026-10-01: `overflow-x-auto` forces the vertical axis to clip
               too, which cut ClassCrest's outside ring and focus outline flat at this row's top
               and bottom. Padding (ring + focus-outline clearance: 6px top/bottom, 4px sides)
               cancelled by an equal negative margin on the SAME box widens the clip boundary
               without moving the row in the card's flow. -->
          <div class="-mx-1 -my-1.5 flex min-w-0 gap-4 overflow-x-auto px-1 py-1.5 md:justify-between md:gap-4">
            {classes.map((c) => (
              <a href={`/guides/${c.slug}`} class="flex shrink-0 flex-col items-center gap-[6px]">
                <ClassCrest slug={c.slug} size={44} />
                <span class="heading-name text-[10px]" style={`color: ${c.color}`}>
                  {c.name}
                </span>
              </a>
            ))}
          </div>
        </Card>
      </div>

      <section
        class="grid grid-cols-1 items-start gap-[22px] lg:grid-cols-2 lg:gap-8"
        data-testid="home-around-the-site"
      >
        <Card
          glyph="chart"
          title={homeAroundTheSiteCopy.reportsLabel}
          action={{ label: homeAroundTheSiteCopy.seeAll, href: '/logs' }}
        >
          <RecentReports client:idle-after-load compact heading={false} />
        </Card>
        <Card
          glyph="trophy"
          title={homeAroundTheSiteCopy.guildsLabel}
          action={{ label: homeAroundTheSiteCopy.seeAll, href: '/rankings?board=guild' }}
        >
          <HomeTopGuilds client:idle-after-load />
        </Card>
      </section>

      <section class="flex flex-col" data-testid="home-companion-row">
        <div
          id={HOME_GET_SET_UP_SIGNED_OUT_ID}
          data-session-hide
          class="grid grid-cols-1 gap-4"
          data-testid="home-get-set-up-signed-out"
        >
          {homeCompanionRow.map((card) => (
            <a
              href={card.href}
              class="card-surface text-strong hover:border-gold-deep flex flex-col gap-4 p-5 transition-colors duration-150 md:h-24 md:flex-row md:items-center md:gap-5 md:py-0"
              data-testid="home-get-set-up-card"
            >
              <span class="flex min-w-0 items-center gap-4">
                <IconTile glyph="device" />
                <span class="flex min-w-0 flex-col gap-1">
                  <span class="heading-name text-strong text-[18px]">{card.title}</span>
                  <span class="text-[13px] leading-snug text-muted">{card.description}</span>
                </span>
              </span>
              <span class={`${button('secondary', 'md')} w-full md:w-auto`} data-testid="tool-card-button">
                {card.buttonLabel}
              </span>
            </a>
          ))}
        </div>
        <HomeGetSetUp client:visible />
      </section>

      <Card
        glyph="news"
        title="Latest"
        action={{ label: 'Everything we know', href: '/changelog' }}
        body="rows"
      >
        {changelog.map((e, i) => (
          <div
            class={`hover:bg-row-hover ${i === 0 ? 'border-line-soft border-t' : ''}`}
            data-testid="home-news-item"
            data-kind={e.data.kind}
            data-date={e.data.date.toISOString()}
          >
            <FeedRow
              date={e.data.date}
              kind={e.data.kind}
              title={e.data.title}
              href={`/changelog#${e.id}`}
              note={e.data.note}
              last={i === changelog.length - 1}
            />
          </div>
        ))}
      </Card>
    </div>
  </main>
  <style slot="head" set:html={heroFontCss}></style>
</Base>

<script>
  import { afterPaint } from '../lib/after-paint';
  import type { DateEntry } from '../lib/home/timeline';

  // Re-read after first paint (src/lib/after-paint.ts): the markup is right for the deploy's
  // date, and the two modules this needs were ahead of the hero's paint (W.16). The countdown
  // tiles then tick once a minute.
  afterPaint(() => {
    void Promise.all([import('../lib/home/hero-card'), import('../lib/home/news')]).then(
      ([{ heroCardFor }, { isStaleSiteNews }]) => {
        // The page is built once per deploy: re-read the hero card and the LATEST block against the
        // visitor's clock, so the beta card stops saying live the night the beta ends and a This site
        // item that has aged out of the month goes, with no edit and no redeploy.
        const card = document.querySelector<HTMLElement>('[data-testid="home-hero-card"]');
        const refreshCard = (): void => {
          if (!card?.dataset.entries) return;
          const next = heroCardFor(JSON.parse(card.dataset.entries) as DateEntry[], new Date());
          card.dataset.mode = next.mode;
          const set = (selector: string, text: string): void => {
            const el = document.querySelector(selector);
            if (el !== null && el.textContent !== text) el.textContent = text;
          };
          set('[data-testid="home-hero-card"] [data-part="eyebrow"]', next.eyebrow);
          set('[data-testid="home-hero-card"] [data-part="tag"]', next.tag);
          set('[data-testid="home-hero-bands"]', next.bandsLine);
          document
            .querySelector('[data-testid="home-hero-countdown"]')
            ?.classList.toggle('hidden', next.countdown === null);
          for (const unit of ['days', 'hours', 'minutes'] as const) {
            const figure = document.querySelector(`[data-testid="home-hero-countdown-${unit}"] .figure-stat`);
            if (figure !== null && next.countdown !== null)
              figure.textContent = String(next.countdown[unit]).padStart(2, '0');
          }
        };
        refreshCard();
        window.setInterval(refreshCard, 60_000);
        const now = new Date();
        for (const item of document.querySelectorAll<HTMLElement>('[data-testid="home-news-item"]')) {
          if (isStaleSiteNews(item.dataset.kind ?? '', new Date(item.dataset.date ?? ''), now))
            item.hidden = true;
        }
      },
    );
  });
</script>
