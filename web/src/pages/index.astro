---
// web/src/pages/index.astro
// The landing page (spec 2026-09-23, "the landing page is the product, not the wiki"; spec
// 2026-09-25 §3.5 drops the Reference band and Still unknown panel): sign in with Battle.net
// and your character is planned, simmed, logged and ranked here, with your guild.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkyBand from '../components/SkyBand.astro';
import HomeTimeline from '../components/HomeTimeline.astro';
import ToolCard from '../components/ToolCard.astro';
import Panel from '../components/Panel.astro';
import FeedRow from '../components/FeedRow.astro';
import SubscribeBox from '../components/SubscribeBox.svelte';
import HomeGuildLink from '../components/HomeGuildLink.svelte';
import HomeAccountPanel from '../components/HomeAccountPanel.svelte';
import HomeNextSteps, { HOME_NEXT_STEPS_SIGNED_OUT_ID } from '../components/HomeNextSteps.svelte';
import HomeGetSetUp, { HOME_GET_SET_UP_SIGNED_OUT_ID } from '../components/HomeGetSetUp.svelte';
import RecentReports from '../components/RecentReports.svelte';
import HomeTopGuilds from '../components/HomeTopGuilds.svelte';
import { HOME_SIGNED_OUT_ID, homePanelCopy } from '../lib/home-panel-copy';
import {
  homeAroundTheSiteCopy,
  homeCompanionRow,
  homeGuildPanelCopy,
  homeHeroCopy,
  homeProductPanels,
} from '../lib/home-landing-copy';
import { battlenetStartUrl } from '../lib/account/api';
import { PRIMARY_BUTTON_FIXED } from '../lib/planner/styles';
import dates from '../data/dates.json';
import communityLinks from '../data/links.json';

const changelog = (await getCollection('changelog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const updated = changelog[0]?.data.updated;

// The "Get set up" card's only icon (spec 2026-09-25 §3.5 collapses the addon/companion row
// to one card, so this no longer needs to be a lookup map).
const addonIconPath =
  '<path d="M9 2v4"/><path d="M15 2v4"/><path d="M6 8h12l-1 5a5 5 0 0 1-10 0z"/><path d="M12 17v5"/>';
---

<Base
  title="Forever Sixty"
  description="World of Warcraft: Forever, planned, simmed, logged and ranked. Sign in with Battle.net."
  path="/"
  session
>
  <main id="main" tabindex="-1" class="flex flex-col">
    <SkyBand>
      <div class="flex w-full max-w-[1344px] flex-col gap-[18px] px-[18px] py-7 mx-auto md:px-12 lg:py-8">
        <p class="label text-gold font-body">{homeHeroCopy.eyebrow}</p>
        <!-- Review round 1 fix item 4: at lg this becomes a two-column band (the character
             card/sign-in block 7/12, the dates timeline 5/12) so the art's right half carries
             real content instead of empty decoration; below lg the two stack in the same
             order they always have (hero, then timeline), just one level deeper in the DOM. -->
        <div class="flex flex-col gap-8 lg:grid lg:grid-cols-12 lg:items-start lg:gap-8">
          <div class="grid lg:col-span-7" data-testid="home-account-block">
            <div
              id={HOME_SIGNED_OUT_ID}
              data-session-hide
              class="[grid-area:1/1] flex flex-col gap-[18px]"
              data-testid="home-signed-out"
            >
              <h1 class="font-display text-[22px] font-bold leading-tight text-strong">
                {homeHeroCopy.headline}
              </h1>
              <p class="text-[14px] leading-relaxed max-w-[560px]">{homePanelCopy.signedOutLine}</p>
              <div class="flex flex-wrap items-center gap-3">
                <a class={`${PRIMARY_BUTTON_FIXED} px-4`} href={battlenetStartUrl('/account?signed_in=1')}>
                  {homePanelCopy.signInButton}
                </a>
                <a class="text-nav text-[13px]" href={homeHeroCopy.addonAltHref}>
                  {homeHeroCopy.addonAltLabel}
                </a>
              </div>
            </div>
            <HomeAccountPanel client:visible />
          </div>
          <div class="lg:col-span-5">
            <HomeTimeline dates={dates} updated={updated} />
          </div>
        </div>
      </div>
    </SkyBand>

    <div class="flex flex-col gap-8 md:gap-12 w-full max-w-[1344px] mx-auto px-[18px] md:px-12 pt-9 pb-8">
      <section class="flex flex-col gap-4">
        <div class="grid" data-testid="home-next-steps-block">
          <div
            id={HOME_NEXT_STEPS_SIGNED_OUT_ID}
            data-session-hide
            class="[grid-area:1/1] grid grid-cols-1 items-stretch gap-4 md:grid-cols-2 lg:grid-cols-5"
            data-testid="home-next-steps-signed-out"
          >
            {homeProductPanels.map((panel) => (
              <div
                class="bg-raised border-line flex flex-col gap-2 rounded-panel border px-[18px] py-[16px]"
                data-testid={`home-next-${panel.label.toLowerCase()}-signed-out`}
              >
                <div class="flex items-center gap-2">
                  <span
                    class="bg-gold h-2 w-2 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
                    aria-hidden="true"
                  />
                  <span class="label text-gold">{panel.label}</span>
                </div>
                <p class="text-muted text-[13px]">{panel.sentence}</p>
                <a class="text-nav mt-auto w-fit text-[13px] font-semibold" href={panel.href}>
                  {panel.linkLabel}
                </a>
              </div>
            ))}
          </div>
          <HomeNextSteps client:idle />
        </div>
      </section>

      <section class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-testid="home-around-the-site">
        <Panel title={homeAroundTheSiteCopy.reportsLabel}>
          <a slot="aside" href="/logs" class="text-[13px] font-semibold">
            {homeAroundTheSiteCopy.seeAll}
          </a>
          <div class="p-[18px]">
            <RecentReports client:visible compact heading={false} />
          </div>
        </Panel>
        <Panel title={homeAroundTheSiteCopy.guildsLabel}>
          <a slot="aside" href="/rankings?board=guild" class="text-[13px] font-semibold">
            {homeAroundTheSiteCopy.seeAll}
          </a>
          <div class="p-[18px]">
            <HomeTopGuilds client:visible />
          </div>
        </Panel>
      </section>

      <Panel title={homeGuildPanelCopy.label}>
        <div class="p-[18px]">
          <HomeGuildLink client:visible />
        </div>
      </Panel>

      <section class="flex flex-col" data-testid="home-companion-row">
        <div
          id={HOME_GET_SET_UP_SIGNED_OUT_ID}
          data-session-hide
          class="grid grid-cols-1 gap-4"
          data-testid="home-get-set-up-signed-out"
        >
          {homeCompanionRow.map((card) => (
            <ToolCard title={card.title} description={card.description} href={card.href}>
              <svg
                slot="icon"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={addonIconPath}
              />
            </ToolCard>
          ))}
        </div>
        <HomeGetSetUp client:idle />
      </section>

      <div class="grid grid-cols-12 gap-[22px] md:gap-8">
        <Panel title="What changed" class="col-span-12 lg:col-span-8">
          <a slot="aside" href="/changelog" class="text-[13px] font-semibold">
            Full changelog
          </a>
          {changelog.map((e, i) => (
            <FeedRow
              date={e.data.date}
              kind={e.data.kind}
              title={e.data.title}
              href={`/changelog#${e.id}`}
              note={e.data.note}
              last={i === changelog.length - 1}
            />
          ))}
        </Panel>
        <div class="col-span-12 lg:col-span-4 flex flex-col gap-[22px] md:gap-8">
          <Panel title="Help build this">
            <div class="flex flex-col gap-3 p-[18px]">
              <p class="text-[14px] leading-relaxed">
                Every page here is written and checked by players. Spot a wrong level range, a missing quest,
                a bad route? Fix it, or tell us.
              </p>
              <div class="flex flex-wrap gap-[10px]">
                <a
                  href={communityLinks.reportErrorIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Report an error
                </a>
                <a
                  href={communityLinks.writeGuideIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Write a guide
                </a>
              </div>
              <SubscribeBox client:visible fallbackHref={communityLinks.subscribeFallback} />
            </div>
          </Panel>
        </div>
      </div>
    </div>
  </main>
</Base>
