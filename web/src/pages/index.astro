---
// web/src/pages/index.astro
// Home (design/specs/2026-11-06-home.md), built from the ui/ primitives and matched to its mocks
// (design/mocks/web/web-home-*.html, the parity gate in tests/e2e/parity-home.spec.ts).
// Signed out, server-rendered: the title and Sign in, "Pick your class", one class at every band
// on the page's one Plate, and how to start. Signed in, the HomeSignedIn island draws the selected
// character; the session hint hides the signed-out page before paint (global.css, HOME_OUT_ATTR).
import Base from '../layouts/Base.astro';
import { HOME_DESCRIPTION, SITE_NAME } from '../lib/seo';
import { battlenetStartUrl } from '../lib/account/api';
import { homeExample, HOME_EXAMPLE } from '../lib/home/example';
import { homeCopy, shortDate } from '../lib/home/home-view';
import Button from '../components/ui/Button.svelte';
import ItemRow from '../components/ui/ItemRow.svelte';
import Page from '../components/ui/Page.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import Plate from '../components/ui/Plate.svelte';
import Row from '../components/ui/Row.svelte';
import Section from '../components/ui/Section.svelte';
import HomeClassPicker from '../components/home/HomeClassPicker.svelte';
import HomeSignedIn from '../components/home/HomeSignedIn.svelte';
import activeBuild from '../data/active-build.json';
import dates from '../data/dates.json';

const example = homeExample(activeBuild.build, (first, last) =>
  homeCopy.example(HOME_EXAMPLE.name, first, last),
);
// The raid opening, while it is still ahead (the page is rebuilt every day).
const raids = dates.find((entry) => 'role' in entry && entry.role === 'raids');
const raidsLine =
  raids !== undefined && new Date(raids.iso).getTime() > Date.now()
    ? homeCopy.firstRaids(shortDate(raids.iso))
    : null;
const signInHref = battlenetStartUrl('/account?signed_in=1');
---

<Base title={SITE_NAME} description={HOME_DESCRIPTION} path="/" wide>
  <main id="main" tabindex="-1" data-testid="home">
    <div class="home-out" data-testid="home-signed-out">
      <Page layout="ledger">
        <PageHeader slot="header" title={homeCopy.signedOutTitle}>
          <Fragment slot="meta">
            <span>{homeCopy.signedOutMeta}</span>
            {raidsLine !== null && <span data-testid="home-raids-line">{raidsLine}</span>}
          </Fragment>
          <Button slot="actions" tone="primary" href={signInHref} testid="home-sign-in">
            {homeCopy.signIn}
          </Button>
        </PageHeader>
        <HomeClassPicker />
      </Page>
      <Page layout="split">
        {example !== null && (
          <Section
            title={example.title}
            action={{ label: homeCopy.exampleAction, href: HOME_EXAMPLE.bisHref }}
            testid="home-example"
          >
            <Plate label={homeCopy.exampleLabel}>
              {example.rows.map((row) => (
                <ItemRow
                  item={row.item}
                  build={activeBuild.build}
                  slotLabel={row.label}
                  source={row.source}
                  gain={{ value: row.setDps, unit: 'DPS', caption: homeCopy.exampleCaption }}
                  testid="home-example-row"
                />
              ))}
            </Plate>
          </Section>
        )}
        <Fragment slot="rail">
          <Section title={homeCopy.howToStart} testid="home-how-to-start">
            <Row
              rank="1"
              title={homeCopy.steps[0].title}
              sub={homeCopy.steps[0].sub}
              href={signInHref}
              open
            />
            <Row rank="2" title={homeCopy.steps[1].title} sub={homeCopy.steps[1].sub} href="/setup" open />
          </Section>
        </Fragment>
      </Page>
    </div>
    <HomeSignedIn client:idle-after-load />
  </main>
</Base>
