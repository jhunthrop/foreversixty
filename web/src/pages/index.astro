---
// web/src/pages/index.astro
// The landing page, rebuilt to the home rebuild experience spec (2026-09-30): tenet 14's
// one sentence, "pick your class" as the front door signed out, "your character" as the
// front door signed in. The site Header (logo, nav, search, account chip) is a separate
// lane's surface (site-logo) and is out of scope here -- this page begins at the sky
// band's hero content, below Base.astro's own Header.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkyBand from '../components/SkyBand.astro';
import HomeTimeline from '../components/HomeTimeline.astro';
import ToolCard from '../components/ToolCard.astro';
import ClassCrest from '../components/ClassCrest.astro';
import Panel from '../components/Panel.astro';
import FeedRow from '../components/FeedRow.astro';
import SubscribeBox from '../components/SubscribeBox.svelte';
import HomeAccountPanel from '../components/HomeAccountPanel.svelte';
import HomeGetSetUp, { HOME_GET_SET_UP_SIGNED_OUT_ID } from '../components/HomeGetSetUp.svelte';
import RecentReports from '../components/RecentReports.svelte';
import HomeTopGuilds from '../components/HomeTopGuilds.svelte';
import { HOME_SIGNED_OUT_ID, homeHeroCardsCopy, homePanelCopy } from '../lib/home-panel-copy';
import {
  homeAroundTheSiteCopy,
  homeClassPickerCopy,
  homeCompanionRow,
  homeHeroCopy,
  homeHeroStatePanelCopy,
  homeProductPanels,
} from '../lib/home-landing-copy';
import { battlenetStartUrl } from '../lib/account/api';
import { PRIMARY_BUTTON_FIXED } from '../lib/planner/styles';
import { rarityBorderColorFor } from '../lib/planner/items';
import { dataUrl } from '../lib/planner/load';
import { bandEntry, itemDetails, loadBisFile } from '../lib/bis/load';
import classes from '../data/classes.json';
import dates from '../data/dates.json';
import communityLinks from '../data/links.json';
import activeBuild from '../data/active-build.json';
// Generated by scripts/hero-font.py -- do not hand-edit; see that file for why this exists.
// A Cinzel 700 subset containing exactly the hero headline's own glyphs ("Play your class
// better.", per home rebuild spec §1), inlined so the hero paints in its real face at first
// paint instead of waiting on the full Cinzel download (that wait is this page's LCP: the
// hero h1 below is the LCP element, and Chrome does not count fallback-face text as an LCP
// candidate -- see lane reports web-home-lcp and web-home-chunks). Declared only on this
// page's own head, not Base.astro, so no other page pays for it.
import heroFontCss from '../styles/hero-font.css?raw';

const changelog = (await getCollection('changelog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const updated = changelog[0]?.data.updated;

// The "Get set up" card's only icon (spec 2026-09-25 §3.5 collapses the addon/companion row
// to one card, so this no longer needs to be a lookup map).
const addonIconPath =
  '<path d="M9 2v4"/><path d="M15 2v4"/><path d="M6 8h12l-1 5a5 5 0 0 1-10 0z"/><path d="M12 17v5"/>';

// Home rebuild spec §3.A.2: the signed-out hero's right-column example panel -- a real
// leveling BiS preview for one stand-in class (Marksmanship Hunter), never a claim about
// the visitor's own character (the "Example" pill says so). Read at build time, the same
// straight-off-disk path every /bis page already uses (lib/bis/load.ts) -- this panel has
// no loading/empty/error state (§4) because it is not a fetch, it is the same static data
// the page itself is built from.
const HERO_EXAMPLE_SPEC = 'hunter-marksmanship';
const HERO_EXAMPLE_CLASS_SLUG = 'hunter';
const HERO_EXAMPLE_BAND = 20;
const HERO_EXAMPLE_FACTION = 'alliance' as const;
const heroExampleBisFile = loadBisFile(HERO_EXAMPLE_SPEC, activeBuild.build);
const heroExampleBand =
  heroExampleBisFile === null
    ? undefined
    : bandEntry(heroExampleBisFile, HERO_EXAMPLE_BAND, HERO_EXAMPLE_FACTION);
const heroExampleItemDetails = itemDetails(activeBuild.build, HERO_EXAMPLE_CLASS_SLUG);
// Three representative picks (spec: "the first three bands[0].slots") with a real icon --
// this spec's data has no explicit "both factions" flag (a single band entry names one
// faction/race at a time), so the mock's "both factions" clause is omitted rather than
// invented (tenet 8); every band this file covers does carry a horde AND an alliance entry,
// but nothing in the file itself asserts that as a fact this panel can cite.
const heroExampleIcons = (heroExampleBand?.slots ?? [])
  .slice(0, 3)
  .map((slot) => {
    const detail = heroExampleItemDetails.get(slot.item_id);
    return detail === undefined || detail.icon === 'inv_misc_questionmark'
      ? null
      : { itemId: slot.item_id, itemName: slot.item_name, icon: detail.icon, quality: detail.quality };
  })
  .filter(
    (icon): icon is { itemId: number; itemName: string; icon: string; quality: number } => icon !== null,
  );
---

<Base
  title="Forever Sixty"
  description="World of Warcraft: Forever, planned, simmed, logged and ranked. Sign in with Battle.net."
  path="/"
  session
>
  <main id="main" tabindex="-1" class="flex flex-col">
    <SkyBand>
      <div class="flex w-full max-w-[1344px] flex-col gap-[22px] px-[18px] py-7 mx-auto md:px-12 lg:py-8">
        <div class="flex flex-col gap-8 lg:grid lg:grid-cols-12 lg:items-end lg:gap-8">
          <!-- §3.A.1 Hero left column (7/12): eyebrow, headline, sentence, nine-class
               picker, sign-in action. The signed-in hero (HomeAccountPanel) occludes this
               same grid cell once /v1/me answers signed-in -- the established "server shell
               first, island swaps in place" trick, unchanged from before this rebuild. -->
          <div class="grid min-w-0 lg:col-span-7" data-testid="home-account-block">
            <div
              id={HOME_SIGNED_OUT_ID}
              data-session-hide
              class="[grid-area:1/1] flex min-w-0 flex-col gap-[16px]"
              data-testid="home-signed-out"
            >
              <p class="label text-gold flex items-center gap-[10px]">
                <i class="bg-gold inline-block h-px w-7" aria-hidden="true"></i>
                {homeHeroCopy.eyebrow}
              </p>
              <h1
                class="gold-text font-display max-w-[640px] text-[34px] font-bold leading-[1.1]"
                style="font-family: 'Cinzel Hero', var(--font-display);"
              >
                {homeHeroCopy.headline}
              </h1>
              <p class="max-w-[560px] text-[15px] leading-relaxed text-[#c9c2b2]">{homeHeroCopy.sentence}</p>
              <div
                class="flex min-w-0 gap-3 overflow-x-auto pb-1 md:max-w-[760px] md:gap-2"
                data-testid="home-class-picker"
              >
                {classes.map((c) => (
                  <a
                    href={`/guides/${c.slug}`}
                    class="flex shrink-0 flex-col items-center gap-[6px]"
                    data-testid={`home-class-picker-${c.slug}`}
                  >
                    <ClassCrest slug={c.slug} size={56} priority />
                    <span class="font-display text-[10px] font-bold" style={`color: ${c.color}`}>
                      {c.name}
                    </span>
                  </a>
                ))}
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-4">
                <a class={`${PRIMARY_BUTTON_FIXED} px-4`} href={battlenetStartUrl('/account?signed_in=1')}>
                  {homePanelCopy.signInButton}
                </a>
                <a
                  class="text-[13px] font-semibold tracking-[0.06em] uppercase text-nav"
                  href={homeHeroCopy.addonAltHref}
                >
                  {homeHeroCopy.addonAltLabel}
                </a>
              </div>
            </div>
            <HomeAccountPanel client:idle-after-load />
          </div>

          <!-- §3.A.2 Hero right column (5/12): the leveling-BiS example panel signed out,
               occluded the same grid-overlay way the old guild card was (§3.B.4: the
               signed-in version of this column is the Switch character panel, mounted by
               HomeAccountPanel.svelte into `home-switch-character-slot` once /v1/me
               answers -- so a signed-out page never fetches that module). Demoted visual
               weight vs. the crest picker (v3 review item 1): a bordered, muted-background
               box, not the primary gold action's equal. -->
          <div class="grid lg:col-span-5 min-w-0" data-testid="home-example-block">
            <div class="[grid-area:1/1] min-w-0" data-session-hide data-testid="home-example-panel-wrap">
              <div
                class="bg-raised/85 border-line flex flex-col gap-3 rounded-panel border px-5 py-[18px]"
                data-testid="home-example-panel"
              >
                <div class="flex items-center justify-between">
                  <span class="label text-gold flex items-center gap-2">
                    <i
                      class="bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
                      aria-hidden="true"
                    ></i>
                    {homeHeroStatePanelCopy.betaEyebrow}
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="mono text-[12px] text-muted">{homeHeroStatePanelCopy.levelCapLabel}</span>
                    <span class="pill pill-sample">{homeHeroStatePanelCopy.examplePill}</span>
                  </span>
                </div>
                <div class="flex items-center gap-[14px]">
                  <ClassCrest slug={HERO_EXAMPLE_CLASS_SLUG} size={56} priority />
                  <div class="flex flex-col gap-1">
                    <span class="font-display text-[15px] font-bold" style="color: #aad372">
                      Marksmanship Hunter
                    </span>
                    <span class="text-[13px] text-muted">{homeHeroStatePanelCopy.bandsLine}</span>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  {heroExampleIcons.map((icon) => (
                    <img
                      src={dataUrl(activeBuild.build, `icons/${icon.icon}.webp`)}
                      alt={icon.itemName}
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                      class="rounded-control border object-cover"
                      style={`border-color: ${rarityBorderColorFor(icon.quality)}`}
                    />
                  ))}
                  <a
                    href={homeClassPickerCopy.allSpecsHref}
                    class="ml-1 self-center text-[12px] font-bold uppercase tracking-[0.06em] text-gold"
                  >
                    {homeClassPickerCopy.allSpecsLink}
                  </a>
                </div>
              </div>
            </div>
            <div
              class="home-switch-character-slot [grid-area:1/1] min-w-0"
              data-testid="home-switch-character-slot"
            ></div>
          </div>
        </div>
      </div>
    </SkyBand>

    <!-- §3.A.3 Timeline strip, below the two-column hero, OUTSIDE SkyBand's own wrapper
         (v3 review item 6, must-fix): the sky gradient's own background belongs to the
         element it's painted on, so moving this strip to a sibling section -- rather than
         a third child sharing SkyBand's slot -- is what actually guarantees the atmosphere
         (stars, the ember/night radial glows) never bleeds under it, not a CSS tweak to a
         gradient that would otherwise have to fade perfectly by some fraction of a
         two-column hero's own variable height. -->
    <div class="w-full max-w-[1344px] mx-auto px-[18px] md:px-12 -mt-2">
      <HomeTimeline dates={dates} updated={updated} />
    </div>

    <div class="flex flex-col gap-8 md:gap-12 w-full max-w-[1344px] mx-auto px-[18px] md:px-12 pt-8 pb-8">
      <!-- §3.A.4 "Best in slot by class" (signed out only) / §3.B.3 "Your upgrades"
           (signed in only) share this position. Toggled by the pre-paint session hint
           (Base.astro's inline script), the same synchronous, before-first-paint timing
           `html:not([data-session='1']) .chip-slot` already relies on elsewhere in
           global.css -- so a `display:none` swap here costs no layout shift either way. -->
      <section class="flex flex-col gap-[14px]" data-signed-out-only data-testid="home-class-picker-large">
        <div class="flex items-baseline justify-between">
          <h2 class="display text-[18px] font-bold tracking-[0.10em] text-strong">
            {homeClassPickerCopy.bestInSlotByClassHeading}
          </h2>
          <a
            href={homeClassPickerCopy.allSpecsHref}
            class="text-[12px] font-bold uppercase tracking-[0.12em] text-gold"
          >
            {homeClassPickerCopy.allSpecsLink}
          </a>
        </div>
        <div class="grid grid-cols-3 gap-[10px] sm:grid-cols-9">
          {classes.map((c) => (
            <a
              href={`/guides/${c.slug}`}
              class="flex flex-col items-center gap-[10px] rounded-control border border-line bg-raised px-2 pb-[14px] pt-4 transition-colors duration-150 hover:border-[var(--c)]"
              style={`box-shadow: inset 0 2px 0 ${c.color}; --c: ${c.color};`}
            >
              <ClassCrest slug={c.slug} size={64} />
              <span class="font-display text-[12px] font-bold" style={`color: ${c.color}`}>
                {c.name}
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="flex flex-col gap-[14px]" data-signed-in-only data-testid="home-upgrades">
        <div id="upgrades" class="flex items-baseline justify-between">
          <h2 class="display text-[18px] font-bold tracking-[0.10em] text-strong">Your upgrades</h2>
          <a
            href={homeClassPickerCopy.allSpecsHref}
            class="text-[12px] font-bold uppercase tracking-[0.12em] text-gold"
          >
            {homeClassPickerCopy.allSpecsLink}
          </a>
        </div>
        <div class="bg-raised border-line rounded-panel border px-5 py-[18px]">
          <!-- Blocking gap (spec §3.B.3): nothing today joins a signed-in character's
               actually-worn gear against a BiS list (`MeCharacter` carries no equipped-item
               list at all), so this region cannot render the mock's worn-vs-BiS rows
               without inventing item names on a real character -- tenet 8 forbids that.
               One honest line instead, until the addon sync reports equipped items. -->
          <p
            class="flex min-h-11 flex-wrap items-center gap-3 text-[14px]"
            data-testid="home-upgrades-not-yet-available"
          >
            <span class="text-muted">{homeHeroCardsCopy.bestInSlotNotAvailable}</span>
          </p>
        </div>
      </section>

      <section class="flex flex-col gap-[14px]" data-testid="home-five-doors">
        <h2 class="display text-[18px] font-bold tracking-[0.10em] text-strong">Five doors</h2>
        <div class="grid grid-cols-1 gap-[14px] sm:grid-cols-2 lg:grid-cols-5">
          {homeProductPanels.map((panel) => (
            <ToolCard
              title={panel.label}
              description={panel.sentence}
              href={panel.href}
              linkLabel={panel.linkLabel}
              testid={`home-five-doors-${panel.label.toLowerCase()}`}
            >
              <svg
                slot="icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
              </svg>
            </ToolCard>
          ))}
        </div>
      </section>

      <!-- §3.B.5 "Another class" (signed in only): the signed-in equivalent of the
           signed-out "Best in slot by class" row above -- a smaller, 44px crest row, since
           a signed-in visitor's own class already has its answer in the hero. -->
      <section class="flex flex-col gap-[14px]" data-signed-in-only data-testid="home-another-class">
        <div class="flex items-baseline justify-between">
          <h2 class="display text-[18px] font-bold tracking-[0.10em] text-strong">
            {homeClassPickerCopy.anotherClassHeading}
          </h2>
          <a
            href={homeClassPickerCopy.allSpecsHref}
            class="text-[12px] font-bold uppercase tracking-[0.12em] text-gold"
          >
            {homeClassPickerCopy.allSpecsLink}
          </a>
        </div>
        <div class="bg-raised border-line rounded-panel flex min-w-0 gap-4 overflow-x-auto border px-6 py-[14px] md:justify-between md:gap-4">
          {classes.map((c) => (
            <a href={`/guides/${c.slug}`} class="flex shrink-0 flex-col items-center gap-[6px]">
              <ClassCrest slug={c.slug} size={44} />
              <span class="font-display text-[10px] font-bold" style={`color: ${c.color}`}>
                {c.name}
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="grid grid-cols-1 lg:grid-cols-2 gap-4" data-testid="home-around-the-site">
        <Panel title={homeAroundTheSiteCopy.reportsLabel}>
          <a slot="aside" href="/logs" class="text-[13px] font-semibold">
            {homeAroundTheSiteCopy.seeAll}
          </a>
          <div class="p-[18px]">
            <RecentReports client:visible compact heading={false} />
          </div>
        </Panel>
        <Panel title={homeAroundTheSiteCopy.guildsLabel}>
          <a slot="aside" href="/rankings?board=guild" class="text-[13px] font-semibold">
            {homeAroundTheSiteCopy.seeAll}
          </a>
          <div class="p-[18px]">
            <HomeTopGuilds client:visible />
          </div>
        </Panel>
      </section>

      <section class="flex flex-col" data-testid="home-companion-row">
        <div
          id={HOME_GET_SET_UP_SIGNED_OUT_ID}
          data-session-hide
          class="grid grid-cols-1 gap-4"
          data-testid="home-get-set-up-signed-out"
        >
          {homeCompanionRow.map((card) => (
            <ToolCard title={card.title} description={card.description} href={card.href}>
              <svg
                slot="icon"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={addonIconPath}
              />
            </ToolCard>
          ))}
        </div>
        <HomeGetSetUp client:idle-after-load />
      </section>

      <div class="grid grid-cols-12 gap-[22px] md:gap-8">
        <Panel title="Latest" class="col-span-12 lg:col-span-8">
          <a slot="aside" href="/changelog" class="text-[13px] font-semibold">
            Everything we know
          </a>
          {changelog.map((e, i) => (
            <FeedRow
              date={e.data.date}
              kind={e.data.kind}
              title={e.data.title}
              href={`/changelog#${e.id}`}
              note={e.data.note}
              last={i === changelog.length - 1}
            />
          ))}
        </Panel>
        <div class="col-span-12 lg:col-span-4 flex flex-col gap-[22px] md:gap-8">
          <Panel title="Help build this">
            <div class="flex flex-col gap-3 p-[18px]">
              <p class="text-[14px] leading-relaxed">
                Every page here is written and checked by players. Spot a wrong level range, a missing quest,
                a bad route? Fix it, or tell us.
              </p>
              <div class="flex flex-wrap gap-[10px]">
                <a
                  href={communityLinks.reportErrorIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Report an error
                </a>
                <a
                  href={communityLinks.writeGuideIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Write a guide
                </a>
              </div>
              <SubscribeBox client:visible fallbackHref={communityLinks.subscribeFallback} />
            </div>
          </Panel>
        </div>
      </div>
    </div>
  </main>
  <style slot="head" set:html={heroFontCss}></style>
</Base>
