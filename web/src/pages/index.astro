---
// web/src/pages/index.astro
// The landing page (spec 2026-09-23, "the landing page is the product, not the wiki"): sign
// in with Battle.net and your character is planned, simmed, logged and ranked here, with
// your guild. The reference (search, Classes/Guides/Zones/Dungeons, Popular links) is the
// second tier, not the front door.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkyBand from '../components/SkyBand.astro';
import StatePanel from '../components/StatePanel.astro';
import HomeProductPanel from '../components/HomeProductPanel.astro';
import ClassTile from '../components/ClassTile.astro';
import RecentReports from '../components/RecentReports.svelte';
import HomeTopGuilds from '../components/HomeTopGuilds.svelte';
import ToolCard from '../components/ToolCard.astro';
import Panel from '../components/Panel.astro';
import FeedRow from '../components/FeedRow.astro';
import SearchBox from '../components/SearchBox.svelte';
import SubscribeBox from '../components/SubscribeBox.svelte';
import HomeGuildLink from '../components/HomeGuildLink.svelte';
import HomeAccountPanel from '../components/HomeAccountPanel.svelte';
import { HOME_SIGNED_OUT_ID, homePanelCopy } from '../lib/home-panel-copy';
import {
  homeCompanionRow,
  homeGuildPanelCopy,
  homeHeroCopy,
  homeProductPanels,
  homeReferenceCopy,
} from '../lib/home-landing-copy';
import { battlenetStartUrl } from '../lib/account/api';
import { SECONDARY_BUTTON_FIXED } from '../lib/planner/styles';
import { dpsSpecs, specLabel } from '../lib/sim/spec-label';
import dates from '../data/dates.json';
import toolsData from '../data/tools.json';
import unknowns from '../data/unknowns.json';
import classes from '../data/classes.json';
import communityLinks from '../data/links.json';
import type { ToolStatusKind } from '../lib/sources';

interface Tool {
  title: string;
  description: string;
  href: string;
  status: { label: string; kind: ToolStatusKind };
  icon: string;
}
// Every remaining row is a Reference tile (spec §2 item 4): Classes, Guides, Zones,
// Dungeons -- the product panels below carry their own copy, not this file's.
const referenceTiles = toolsData as Tool[];

const [plannerPanel, simPanel, logsPanel, rankingsPanel] = homeProductPanels;

const changelog = (await getCollection('changelog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const updated = changelog[0]?.data.updated;

const icons: Record<string, string> = {
  talents:
    '<circle cx="12" cy="5" r="2"/><circle cx="6" cy="12" r="2"/><circle cx="18" cy="12" r="2"/><circle cx="12" cy="19" r="2"/><path d="M12 7v10M8 11l3-4M16 11l-3-4M8 13l3 4M16 13l-3 4"/>',
  simulator: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-6"/><path d="M2 20h20"/>',
  logs: '<path d="M4 19V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14"/><path d="M4 19h16"/><path d="M8 15v-4M12 15V8M16 15v-6"/>',
  addon: '<path d="M9 2v4"/><path d="M15 2v4"/><path d="M6 8h12l-1 5a5 5 0 0 1-10 0z"/><path d="M12 17v5"/>',
  guides:
    '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h13"/><path d="M9 7h6M9 11h4"/>',
  dungeon: '<path d="M4 20V8l8-5 8 5v12"/><path d="M9 20v-6h6v6"/>',
  map: '<path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/>',
};
const popular = [
  ['Skyborne race', '/skyborne'],
  ['Undead Paladin', '/guides/paladin'],
  ['Hall of Thanes', '/dungeons/hall-of-thanes'],
  ['Mount Hyjal', '/zones/mount-hyjal'],
  ["What's in the $29.99 pack", '/editions'],
] as const;
---

<Base
  title="Forever Sixty"
  description="World of Warcraft: Forever, planned, simmed, logged and ranked. Sign in with Battle.net."
  path="/"
  session
>
  <main id="main" tabindex="-1" class="flex flex-col">
    <SkyBand>
      <div class="grid grid-cols-12 gap-[22px] md:gap-8 items-start w-full max-w-[1344px] mx-auto px-[18px] md:px-12 pt-7 pb-10">
        <div class="col-span-12 lg:col-span-7 flex flex-col gap-[18px]">
          <p class="label text-gold font-body">{homeHeroCopy.eyebrow}</p>
          <h1 class="font-display text-[22px] font-bold leading-tight text-strong">
            {homeHeroCopy.headline}
          </h1>
          <div class="grid" data-testid="home-account-block">
            <div
              id={HOME_SIGNED_OUT_ID}
              class="[grid-area:1/1] flex flex-col gap-[14px]"
              data-testid="home-signed-out"
            >
              <p class="text-[14px] leading-relaxed">{homePanelCopy.signedOutLine}</p>
              <div class="flex flex-wrap items-center gap-3">
                <a
                  class={`${SECONDARY_BUTTON_FIXED} border-line-warm-strong text-strong px-4`}
                  href={battlenetStartUrl('/account?signed_in=1')}
                >
                  {homePanelCopy.signInButton}
                </a>
                <a class="text-nav text-[13px]" href={homeHeroCopy.addonAltHref}>
                  {homeHeroCopy.addonAltLabel}
                </a>
              </div>
            </div>
            <HomeAccountPanel client:visible />
          </div>
        </div>
        <div class="col-span-12 lg:col-span-5">
          <StatePanel
            title="Right now"
            updated={updated}
            rows={dates.map(({ key, value, note, highlight }) => ({ key, value, note, highlight }))}
          />
        </div>
      </div>
    </SkyBand>

    <div class="flex flex-col gap-[22px] md:gap-8 w-full max-w-[1344px] mx-auto px-[18px] md:px-12 pt-9 pb-8">
      <section class="flex flex-col gap-4" data-testid="home-product-panels">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <HomeProductPanel
            label={plannerPanel.label}
            sentence={plannerPanel.sentence}
            href={plannerPanel.href}
            linkLabel={plannerPanel.linkLabel}
          >
            <div class="grid grid-cols-3 sm:grid-cols-9 gap-2">
              {classes.map((c) => (
                <ClassTile name={c.name} slug={c.slug} compact />
              ))}
            </div>
          </HomeProductPanel>

          <HomeProductPanel
            label={simPanel.label}
            sentence={simPanel.sentence}
            href={simPanel.href}
            linkLabel={simPanel.linkLabel}
          >
            <div class="flex flex-wrap gap-2">
              {dpsSpecs().map((row) => (
                // Plain /sim, not /sim?spec=<slug> (review fix): the simulator's own URL
                // state (lib/sim/url.ts's SimState) has no `spec` field and never reads
                // one, so a per-spec query string would look distinct while landing on the
                // identical generic page for every pill -- these pills are the simulator's
                // real spec coverage, not a working per-spec deep link (that would need a
                // change to /sim itself, out of this lane's scope).
                <a href="/sim" class="pill pill-site">
                  {specLabel(row.spec)}
                </a>
              ))}
            </div>
          </HomeProductPanel>

          <HomeProductPanel
            label={logsPanel.label}
            sentence={logsPanel.sentence}
            href={logsPanel.href}
            linkLabel={logsPanel.linkLabel}
          >
            <div class="min-h-[120px]">
              <RecentReports client:visible compact heading={false} />
            </div>
          </HomeProductPanel>

          <HomeProductPanel
            label={rankingsPanel.label}
            sentence={rankingsPanel.sentence}
            href={rankingsPanel.href}
            linkLabel={rankingsPanel.linkLabel}
          >
            <div class="min-h-[220px]">
              <HomeTopGuilds client:visible />
            </div>
          </HomeProductPanel>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <div class="flex flex-col gap-[10px]">
          <SearchBox client:interaction />
          <p class="text-[13px] text-muted">{homeReferenceCopy.sentence}</p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-testid="reference-tiles">
          {referenceTiles.map((t) => (
            <ToolCard title={t.title} description={t.description} href={t.href} status={t.status}>
              <svg
                slot="icon"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[t.icon]}
              />
            </ToolCard>
          ))}
        </div>
        <p class="flex flex-wrap gap-[10px] text-[13px]">
          <span class="text-muted">Popular:</span>
          {popular.map(([label, href], i) => (
            <>
              <a href={href}>{label}</a>
              {i < popular.length - 1 && <span class="text-muted">·</span>}
            </>
          ))}
        </p>
      </section>

      <Panel title={homeGuildPanelCopy.label}>
        <div class="p-[18px]">
          <HomeGuildLink client:visible />
        </div>
      </Panel>

      <section class="grid grid-cols-1 md:grid-cols-2 gap-4" data-testid="home-companion-row">
        {homeCompanionRow.map((card) => (
          <ToolCard title={card.title} description={card.description} href={card.href}>
            <svg
              slot="icon"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[card.href === '/addon' ? 'addon' : 'logs']}
            />
          </ToolCard>
        ))}
      </section>

      <div class="grid grid-cols-12 gap-[22px] md:gap-8">
        <Panel title="What changed" class="col-span-12 lg:col-span-8">
          <a slot="aside" href="/changelog" class="text-[13px] font-semibold">
            Full changelog
          </a>
          {changelog.map((e, i) => (
            <FeedRow
              date={e.data.date}
              kind={e.data.kind}
              title={e.data.title}
              href={`/changelog#${e.id}`}
              note={e.data.note}
              last={i === changelog.length - 1}
            />
          ))}
        </Panel>
        <div class="col-span-12 lg:col-span-4 flex flex-col gap-[22px] md:gap-8">
          <Panel title="Still unknown">
            {unknowns.map((u, i) => (
              <div
                class={`flex flex-col gap-[3px] px-[18px] py-[14px] text-[14px] ${i < unknowns.length - 1 ? 'border-b border-line-soft' : ''}`}
              >
                <span class="text-strong font-semibold">{u.title}</span>
                <span class="text-[13px] text-muted">{u.note}</span>
              </div>
            ))}
          </Panel>
          <Panel title="Help build this">
            <div class="flex flex-col gap-3 p-[18px]">
              <p class="text-[14px] leading-relaxed">
                Every page here is written and checked by players. Spot a wrong level range, a missing quest,
                a bad route? Fix it, or tell us.
              </p>
              <div class="flex flex-wrap gap-[10px]">
                <a
                  href={communityLinks.reportErrorIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Report an error
                </a>
                <a
                  href={communityLinks.writeGuideIssue}
                  class="inline-flex items-center min-h-11 md:min-h-[38px] px-[14px] border border-line-warm-strong rounded-control text-[13px] font-semibold tracking-[0.06em] uppercase text-text"
                >
                  Write a guide
                </a>
              </div>
              <SubscribeBox client:visible fallbackHref={communityLinks.subscribeFallback} />
            </div>
          </Panel>
        </div>
      </div>

      <section class="flex flex-col gap-4">
        <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
          <h2 class="section-title">Guides by class</h2>
          <span class="text-[13px] text-muted">
            Leveling, talents, pre-raid gear. Written after we play it, not before.
          </span>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-3">
          {classes.map((c) => (
            <ClassTile name={c.name} slug={c.slug} />
          ))}
        </div>
      </section>
    </div>
  </main>
</Base>
