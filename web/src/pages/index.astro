---
// web/src/pages/index.astro
// Home, round 5 (design/specs/2026-11-09-directions.md "Home"; mocks design/mocks/directions/png/
// g-home-*; the parity gate in tests/e2e/parity-home.spec.ts). Signed out, server-rendered on the
// camp-road hero: "Pick your class" with Sign in beside it, the nine classes leading, then Latest
// on Forever with the rail beside it: How to start and the raid plaque (the first raids opening). Signed in, the HomeSignedIn island
// draws the selected character; the session hint hides the signed-out page before paint
// (global.css, HOME_OUT_ATTR). The feed's floor of real dated site events is built here, at build
// time. After an account deletion (`/?deleted=1`) a one-time notice sits under the head.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { HOME_DESCRIPTION, SITE_NAME } from '../lib/seo';
import { battlenetStartUrl } from '../lib/account/api';
import { homeCopy } from '../lib/home/home-view';
import { FLOOR_MIN } from '../lib/home/feed';
import { buildFloor } from '../lib/home/floor';
import { floorInputs, raidsOpenIso } from '../lib/home/floor-load';
import { loadRaidFacts } from '../lib/home/raid-facts-load';
import Button from '../components/ui/Button.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import HomeClassPicker from '../components/home/HomeClassPicker.svelte';
import HomeDeletedNotice from '../components/home/HomeDeletedNotice.svelte';
import HomeFeed from '../components/home/HomeFeed.svelte';
import HomeFirstRaids from '../components/home/HomeFirstRaids.svelte';
import HomeGrid from '../components/home/HomeGrid.svelte';
import HomeHowToStart from '../components/home/HomeHowToStart.svelte';
import HomeSignedIn from '../components/home/HomeSignedIn.svelte';
import activeBuild from '../data/active-build.json';

const now = new Date();
const raidsOpen = raidsOpenIso(now);
const guides = (await getCollection('guides')).map((g) => ({
  classSlug: g.data.classSlug,
  spec: g.data.spec,
  updated: g.data.updated,
}));
const changelog = (await getCollection('changelog')).map((e) => ({
  id: e.id,
  title: e.data.title,
  date: e.data.date,
}));
const floor = buildFloor(floorInputs(guides, changelog, now));
const signInHref = battlenetStartUrl('/account?signed_in=1');
const raids = loadRaidFacts();
---

<Base title={SITE_NAME} description={HOME_DESCRIPTION} path="/" wide art="hero">
  <main id="main" tabindex="-1" data-testid="home">
    <div class="home-out" data-testid="home-signed-out">
      <PageHeader title={homeCopy.pickClass} art="hero">
        <Button slot="actions" tone="primary" href={signInHref} testid="home-sign-in">
          {homeCopy.signIn}
        </Button>
      </PageHeader>
      <HomeDeletedNotice client:idle-after-load />
      <HomeGrid>
        <HomeClassPicker slot="lead" headless />
        <HomeFeed
          client:idle-after-load
          signedIn={false}
          floor={floor.slice(0, FLOOR_MIN)}
          build={activeBuild.build}
        />
        <HomeHowToStart slot="rail" {signInHref} />
        <HomeFirstRaids slot="rail" client:idle-after-load {raidsOpen} {raids} build={activeBuild.build} />
      </HomeGrid>
    </div>
    <HomeSignedIn client:idle-after-load {floor} {raidsOpen} {raids} />
  </main>
</Base>

<style is:global>
  /* Home's title band sits at the foot of the camp-road art (directions mock g-home): the title
     drops below the bar so the art reads above it (the band's 16 px top plus the lift). Home is the only `art="hero"` band. */
  [data-art='hero'] .ui-page-header {
    padding-top: calc(16px + var(--home-band-lift));
  }
  :root {
    --home-band-lift: 16px;
  }
  @media (min-width: 900px) {
    :root {
      --home-band-lift: 40px;
    }
  }
</style>
