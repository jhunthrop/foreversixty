---
// web/src/pages/rankings.astro
// The shell src/worker.ts serves for /rankings/<any slug>, with its unfurl tags rewritten
// from GET /v1/rankings. The island reads the slug out of the path.
import Base from '../layouts/Base.astro';
import Rankings from '../components/Rankings.svelte';
---

<Base
  title="Rankings"
  description="World of Warcraft: Forever rankings by encounter: characters, guilds, specs and phases."
  path="/rankings"
  session
>
  <main
    id="main"
    tabindex="-1"
    class="mx-auto flex w-full max-w-[1344px] flex-col gap-[22px] px-[18px] pt-4 pb-10 md:gap-8 md:px-12 md:pt-7"
  >
    <Rankings client:load />
  </main>
</Base>
