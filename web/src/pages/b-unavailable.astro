---
// web/src/pages/b-unavailable.astro
// Served by src/worker.ts with status 503 when api.foreversixty.gg cannot answer a /b/:id
// request. Static, so it works precisely when nothing else does. The message page of the shared
// build (premium spec 2026-11-08 section 8, mock web-b-unavailable): the PageHeader with the
// sentence as its meta line over the form layout, then the planner as the primary and the guides'
// builds as a link, the shape of the API's own not-found and error pages (api/internal/site/page.go).
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.svelte';
import Page from '../components/ui/Page.svelte';
import PageHeader from '../components/ui/PageHeader.svelte';
import { LINK } from '../lib/ui/primitives';

const title = 'Build unavailable';
const sentence =
  'Shared builds are stored by the Forever Sixty API, which is not answering right now. The build itself is ' +
  'not lost; the link will work again once the API is back. In the meantime, the build planner works without it.';
---

<Base title={title} description="This shared build cannot be loaded right now." path="/b-unavailable">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" tabindex="-1">
    <Page layout="form">
      <PageHeader slot="header" title={title}>
        <span slot="meta" class="max-w-[80ch]">
          {sentence}
        </span>
      </PageHeader>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-[10px]">
        <Button tone="primary" href="/planner" testid="b-unavailable-planner">
          Open the build planner
        </Button>
        <a class={LINK} href="/guides">
          Talent builds in the class guides ›
        </a>
      </div>
    </Page>
  </main>
</Base>
