---
// web/src/components/CharacterSearch.astro
// "Look up a character" (pages spec 2026-11-08 §4.4; /characters and the 404): the lookup's one
// wrapper around its body (CharacterSearchForm.astro: the name field, Region and Ruleset, Look up,
// the status line and the wiring script). The 404: an open Section with its heading and aside.
// /characters (round 5, mock b2-characters, `panel`): the page's framed Plate, no heading under
// the title band that already names the page.
import { homeCharacterSearchCopy as copy } from '../lib/home-landing-copy';
import CharacterSearchForm from './CharacterSearchForm.astro';
import Plate from './ui/Plate.svelte';
import Section from './ui/Section.svelte';

interface Props {
  /** /characters: the framed panel (CharacterSearchForm `panel`). Off (the 404), as before. */
  panel?: boolean;
}
const { panel = false } = Astro.props;
---

{panel ? (
  <Plate frame="framed" flush={false} label={copy.heading} testid="home-character-search">
    <CharacterSearchForm panel />
  </Plate>
) : (
  <Section title={copy.heading} anchor="lookup" testid="home-character-search">
    <CharacterSearchForm />
  </Section>
)}
