---
// web/src/components/HomeTimeline.astro
// Spec 2026-09-24 §2.2: the site dates as a horizontal timeline, the quietest panel
// treatment. The page is built once per deploy, so the markup is classified at build time
// (`now` is a prop only so the SSR test can pin it) and a small script re-classifies against
// the visitor's clock on load: a date that has passed since the deploy reads as past, in the
// past tense, with no edit. Each row carries its whole entry as JSON for that script.
import UpdatedStamp from './UpdatedStamp.astro';
import { dotIndex, timelineDisplayRows, timelineRows, type DateEntry } from '../lib/home/timeline';

interface Props {
  dates: DateEntry[];
  updated?: Date;
  now?: Date;
}
const { dates, updated, now } = Astro.props;
const shownRows = timelineDisplayRows(timelineRows(dates, now));
const dotAt = dotIndex(shownRows);
const rows = shownRows.map((row, index) => ({
  row,
  dot: index === dotAt,
}));
---

<div
  class="bg-raised/85 border-line grid grid-cols-2 gap-3 rounded-panel border px-[18px] py-[14px] md:flex md:items-stretch md:gap-0 md:overflow-x-auto"
  data-testid="home-timeline"
  data-entries={JSON.stringify(dates)}
  tabindex="0"
  role="group"
  aria-label="Key dates timeline"
>
  {rows.map(({ row, dot }) => (
    <div
      class="timeline-row flex min-w-0 flex-col gap-1 px-3 py-1 md:min-w-[150px] md:flex-1 md:border-line-soft md:border-r"
      data-testid="home-timeline-row"
      data-status={row.status}
      data-iso={row.iso}
    >
      <div class="flex items-center gap-2">
        {dot && (
          <span
            class="bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
            data-testid="home-timeline-dot"
            aria-hidden="true"
          />
        )}
        <span class="font-mono tabular text-[12px] text-muted" data-part="key">
          {row.key}
        </span>
      </div>
      <span class="timeline-value text-[13px] font-semibold text-strong" data-part="value">
        {row.value}
      </span>
      {row.note && (
        <span class="text-muted text-[12px]" data-part="note">
          {row.note}
        </span>
      )}
    </div>
  ))}
  {updated && (
    <div
      class="flex items-end pl-1 md:ml-auto md:shrink-0 md:items-center md:self-center"
      data-testid="home-timeline-updated"
    >
      <UpdatedStamp date={updated} />
    </div>
  )}
</div>

<style>
  .timeline-row:last-of-type {
    border-right-width: 0;
  }
</style>

<script>
  import { afterPaint } from '../lib/after-paint';
  import type { DateEntry, TimelineRow } from '../lib/home/timeline';

  const ROW_CLASS =
    'timeline-row flex min-w-0 flex-col gap-1 px-3 py-1 md:min-w-[150px] md:flex-1 md:border-line-soft md:border-r';
  const DOT_CLASS = 'bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]';

  function part(className: string, text: string, name: string): HTMLElement {
    const el = document.createElement('span');
    el.className = className;
    el.textContent = text;
    el.dataset.part = name;
    return el;
  }

  function buildRow(row: TimelineRow, withDot: boolean): HTMLElement {
    const el = document.createElement('div');
    el.className = ROW_CLASS;
    el.dataset.testid = 'home-timeline-row';
    el.dataset.status = row.status;
    el.dataset.iso = row.iso;
    const head = document.createElement('div');
    head.className = 'flex items-center gap-2';
    if (withDot) {
      const dot = document.createElement('span');
      dot.className = DOT_CLASS;
      dot.dataset.testid = 'home-timeline-dot';
      dot.setAttribute('aria-hidden', 'true');
      head.append(dot);
    }
    head.append(part('font-mono tabular text-[12px] text-muted', row.key, 'key'));
    const children: HTMLElement[] = [
      head,
      part('timeline-value text-[13px] font-semibold text-strong', row.value, 'value'),
    ];
    if (row.note) children.push(part('text-muted text-[12px]', row.note, 'note'));
    el.append(...children);
    return el;
  }

  // Wired after first paint (src/lib/after-paint.ts); the server markup is already right.
  afterPaint(() => {
    void import('../lib/home/timeline').then(({ dotIndex, timelineDisplayRows, timelineRows }) => {
      // Re-classify against the visitor's clock. The server markup is right at deploy time; this
      // only rebuilds the strip on a page that has outlived (or predates) the date that moves a row.
      const root = document.querySelector<HTMLElement>('[data-testid="home-timeline"]');
      if (!root?.dataset.entries) return;
      const shown = timelineDisplayRows(
        timelineRows(JSON.parse(root.dataset.entries) as DateEntry[], new Date()),
      );
      const dotAt = dotIndex(shown);
      const current = Array.from(root.querySelectorAll<HTMLElement>('[data-testid="home-timeline-row"]'));
      const same =
        current.length === shown.length &&
        shown.every(
          (row, index) =>
            current[index]?.dataset.iso === row.iso && current[index]?.dataset.status === row.status,
        );
      if (same) return;
      const rowEls = shown.map((row, index) => buildRow(row, index === dotAt));
      const updated = root.querySelector('[data-testid="home-timeline-updated"]');
      root.replaceChildren(...rowEls, ...(updated === null ? [] : [updated]));
    });
  });
</script>
