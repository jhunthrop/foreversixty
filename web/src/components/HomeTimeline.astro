---
// web/src/components/HomeTimeline.astro
// Spec 2026-09-24 §2.2: the site dates as a horizontal timeline, the quietest panel
// treatment. The page is built once per deploy, so the markup is classified at build time
// (`now` is a prop only so the SSR test can pin it) and a small script re-classifies against
// the visitor's clock on load: a date that has passed since the deploy reads as past, in the
// past tense, with no edit. Each row carries its whole entry as JSON for that script.
import UpdatedStamp from './UpdatedStamp.astro';
import { timelineDisplayRows, timelineRowText, timelineRows, type DateEntry } from '../lib/home/timeline';

interface Props {
  dates: DateEntry[];
  updated?: Date;
  now?: Date;
}
const { dates, updated, now } = Astro.props;
const rows = timelineDisplayRows(timelineRows(dates, now)).map((row) => ({
  row,
  text: timelineRowText(row),
}));
---

<div
  class="bg-raised/85 border-line grid grid-cols-2 gap-3 rounded-panel border px-[18px] py-[14px] md:flex md:items-stretch md:gap-0 md:overflow-x-auto"
  data-testid="home-timeline"
  data-entries={JSON.stringify(dates)}
  tabindex="0"
  role="group"
  aria-label="Key dates timeline"
>
  {rows.map(({ row, text }) => (
    <div
      class="timeline-row flex min-w-0 flex-col gap-1 px-3 py-1 md:min-w-[150px] md:flex-1 md:border-line-soft md:border-r data-[status=past]:opacity-60"
      data-testid="home-timeline-row"
      data-status={row.status}
    >
      <div class="flex items-center gap-2">
        {row.status === 'next' && (
          <span
            class="bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
            data-testid="home-timeline-dot"
            aria-hidden="true"
          />
        )}
        <span class="font-mono tabular text-[12px] text-muted" data-part="key">
          {text.key}
        </span>
      </div>
      <span class="timeline-value text-[13px] font-semibold text-strong" data-part="value">
        {text.value}
      </span>
      {text.note && (
        <span class="text-muted text-[12px]" data-part="note">
          {text.note}
        </span>
      )}
    </div>
  ))}
  {updated && (
    <div
      class="flex items-end pl-1 md:ml-auto md:shrink-0 md:items-center md:self-center"
      data-testid="home-timeline-updated"
    >
      <UpdatedStamp date={updated} />
    </div>
  )}
</div>

<style>
  .timeline-row:last-of-type {
    border-right-width: 0;
  }
  .timeline-row[data-status='past'] .timeline-value {
    color: var(--color-muted);
  }
</style>

<script>
  import { timelineDisplayRows, timelineRowText, timelineRows, type DateEntry } from '../lib/home/timeline';

  // Re-classify against the visitor's clock. The server markup is already right at deploy
  // time; this only changes anything on a page that has outlived the date that moves a row.
  const root = document.querySelector<HTMLElement>('[data-testid="home-timeline"]');
  if (root?.dataset.entries) {
    const dates = JSON.parse(root.dataset.entries) as DateEntry[];
    const shown = timelineDisplayRows(timelineRows(dates, new Date()));
    const rowEls = Array.from(root.querySelectorAll<HTMLElement>('[data-testid="home-timeline-row"]'));
    const same = shown.every((row, index) => rowEls[index]?.dataset.status === row.status);
    if (rowEls.length === shown.length && !same) {
      const make = (tag: string, className: string, text: string, part: string): HTMLElement => {
        const el = document.createElement(tag);
        el.className = className;
        el.textContent = text;
        el.dataset.part = part;
        return el;
      };
      shown.forEach((row, index) => {
        const el = rowEls[index];
        const text = timelineRowText(row);
        el.dataset.status = row.status;
        const head = document.createElement('div');
        head.className = 'flex items-center gap-2';
        if (row.status === 'next') {
          const dot = document.createElement('span');
          dot.className = 'bg-gold h-2 w-2 shrink-0 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]';
          dot.dataset.testid = 'home-timeline-dot';
          dot.setAttribute('aria-hidden', 'true');
          head.append(dot);
        }
        head.append(make('span', 'font-mono tabular text-[12px] text-muted', text.key, 'key'));
        const children: HTMLElement[] = [
          head,
          make('span', 'timeline-value text-[13px] font-semibold text-strong', text.value, 'value'),
        ];
        if (text.note) children.push(make('span', 'text-muted text-[12px]', text.note, 'note'));
        el.replaceChildren(...children);
      });
    }
  }
</script>
