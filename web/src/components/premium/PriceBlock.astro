---
// web/src/components/premium/PriceBlock.astro
// One fixed-height cell holding every price state (interval x founder). The page's CSS shows
// exactly one; the others stay in the DOM, so no state changes the card's height. The guild
// plans are secondary (spec 2026-10-27-launch-pricing §B3.3): a smaller figure, and a cost line in
// a box reserved for three lines, so the block is a fixed 144 px on phone and 152 px from 768.
import { INTERVALS, PLANS, type PlanKey } from '../../lib/billing/plans';
import { FOUNDER_STATES, costLine, founderKey, priceCell } from './model';

interface Props {
  plan: PlanKey;
}
const { plan } = Astro.props;
const guild = PLANS[plan].guild;
// Guild budget with the founder line, every line one line high: phone 32 + 16 + 16 + (4 + 16)
// + (6 + 54) = 144, no slack; from 768 34 + 16 + 16 + (2 + 14) + (6 + 54) = 142, 10 px slack. The
// spec fixes 144, and no margin here can absorb a wrapped 16 px line, so the one-line lines are a
// precondition, not slack: the founder line is about 270 px of 12 px text against about 282 px of
// card text width at 360, and 277 px at 1024-1279. Capture row 18 checks 360 and 1024 for a wrap;
// a wrap goes back to the ux-designer for a new height rather than smaller type.
const blockClass = guild ? 'h-[144px] md:h-[152px]' : 'h-[86px] md:h-[112px]';
const amountClass = guild ? 'text-[22px] md:text-[24px]' : 'text-[28px] md:text-[32px]';
---

<div class:list={['price-block', blockClass]} data-testid={`price-${plan}`}>
  {INTERVALS.flatMap((interval) =>
    FOUNDER_STATES.map((founder) => {
      const cell = priceCell(plan, interval, founder);
      const cost = costLine(plan, interval, founder);
      return (
        <div class="price-state" data-iv={interval} data-fd={founderKey(founder)}>
          <p class="price-line">
            <span class:list={['amount tabular', amountClass]}>{cell.amount}</span>
            <span class="suffix">{cell.suffix}</span>
          </p>
          <p class="list-line">{cell.listLine}</p>
          <p class="second-line">{cell.secondLine}</p>
          {cell.founderLine && <p class="founder-line">{cell.founderLine}</p>}
          {cost && (
            <p
              class="cost-line text-text mt-[6px] h-[54px] text-[13px] leading-[18px]"
              data-testid="cost-line"
            >
              {cost}
            </p>
          )}
        </div>
      );
    }),
  )}
</div>

<style>
  .price-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    height: 32px;
    line-height: 32px;
  }
  .amount {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-strong);
  }
  .suffix {
    font-size: 15px;
    color: var(--color-muted);
    margin-right: 2px;
  }
  .list-line {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    color: var(--color-muted);
  }
  .second-line {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    color: var(--color-muted);
  }
  .founder-line {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-gold);
  }
  @media (min-width: 768px) {
    .price-line {
      height: 34px;
      line-height: 34px;
    }
    .founder-line {
      margin-top: 2px;
      line-height: 14px;
    }
  }
</style>
