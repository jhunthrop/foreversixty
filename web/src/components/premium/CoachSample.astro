---
// web/src/components/premium/CoachSample.astro
// /premium's rail panel (premium spec 2026-11-08 section 4.8): one sample coach review, rendered at build
// from the coach's own Fury fixture, labelled Sample in its head and its caption. Static.
import SpellIcon from '../ui/SpellIcon.astro';
import Row from '../ui/Row.svelte';
import Section from '../ui/Section.svelte';
import Tag from '../ui/Tag.svelte';
import Crest from '../ui/Crest.astro';
import { coachSampleView, loadCoachSampleAnswer, type CoachSampleView } from '../../lib/billing/coach-sample';
import { buildSpellIconOf } from '../../lib/billing/coach-sample-icons';
import { plansPageCopy } from '../../lib/billing/plans-page-copy';

interface Props {
  view?: CoachSampleView;
}
const { view = coachSampleView(loadCoachSampleAnswer(), buildSpellIconOf()) } = Astro.props;
const copy = plansPageCopy.coachSample;
---

<Section title={copy.label} testid="coach-sample" panel>
  <Tag slot="head" tone="muted" testid="coach-sample-tag">
    {copy.tag}
  </Tag>
  <div class="coach">
    <div class="coach-who">
      <Crest cls={view.classSlug} size={40} />
      <span>
        <b>{view.title}</b>
        <span class="text-small text-muted block">{view.context}</span>
      </span>
    </div>
    <p class="coach-opening">{view.opening}</p>
    {/* A slot passed conditionally still reserves the Row's lead column, so a row with no icon
        is drawn without the slot. Fix first is an open row like the rest: its label sets it apart. */}
    {view.fixFirst && (
      <>
        <span class="t-label">{copy.fixFirst}</span>
        <div class="coach-rows" data-testid="coach-sample-fix-first">
          {view.fixFirst.icon ? (
            <Row title={view.fixFirst.title} sub={view.fixFirst.why} open testid="coach-sample-fix-title">
              <SpellIcon slot="lead" url={view.fixFirst.icon} size={40} />
            </Row>
          ) : (
            <Row title={view.fixFirst.title} sub={view.fixFirst.why} open testid="coach-sample-fix-title" />
          )}
        </div>
      </>
    )}
    {view.then.length > 0 && (
      <>
        <span class="t-label">{copy.then}</span>
        <div class="coach-rows" data-testid="coach-sample-then">
          {view.then.map((item) =>
            item.icon ? (
              <Row title={item.title} sub={item.why} open>
                <SpellIcon slot="lead" url={item.icon} size={32} />
              </Row>
            ) : (
              <Row title={item.title} sub={item.why} open />
            ),
          )}
        </div>
      </>
    )}
    {view.doingWell.length > 0 && (
      <>
        <span class="t-label">{copy.doingWell}</span>
        <div class="coach-rows" data-testid="coach-sample-well">
          {view.doingWell.map((item) =>
            item.icon ? (
              <Row title={item.text} density="slim" open>
                <SpellIcon slot="lead" url={item.icon} size={24} />
              </Row>
            ) : (
              <Row title={item.text} density="slim" open />
            ),
          )}
        </div>
      </>
    )}
    <p class="text-small text-muted m-0" data-testid="coach-sample-caption">
      {copy.caption}
    </p>
  </div>
</Section>

<style>
  .coach {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .coach-who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .coach-who b {
    font: 700 16px/20px var(--font-body);
    color: var(--color-strong);
  }
  .coach-opening {
    margin: 0;
    font-size: 15px;
    line-height: 23px;
  }
  .coach-rows {
    display: flex;
    flex-direction: column;
  }
  .t-label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-muted);
  }
</style>
