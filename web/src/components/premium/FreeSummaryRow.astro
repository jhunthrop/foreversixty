---
// web/src/components/premium/FreeSummaryRow.astro
// Phone only: one 64 px row that keeps the free promise above Premium and links to the full
// Free card at the foot of the page.
import { plansPageCopy } from '../../lib/billing/plans-page-copy';

const { summary } = plansPageCopy.free;
---

<a href="#free" class="summary-row" data-testid="free-summary">
  <span class="text">
    <span class="name">{summary.name}</span>
    <span class="line">{summary.line}</span>
  </span>
  <span class="price tabular">{summary.price}</span>
  <span class="sr-only">{summary.srOnly}</span>
</a>

<style>
  .summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding: 8px 20px;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: 6px;
  }
  .summary-row:hover {
    background: var(--color-card-top);
  }
  .summary-row:active {
    background: #171d2b;
  }
  .summary-row:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -2px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-strong);
  }
  .line {
    font-size: 13px;
    color: var(--color-muted);
  }
  .price {
    font-family: var(--font-mono);
    font-size: 20px;
    color: var(--color-strong);
  }
  @media (min-width: 768px) {
    .summary-row {
      display: none;
    }
  }
</style>
