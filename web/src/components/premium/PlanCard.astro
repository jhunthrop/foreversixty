---
// web/src/components/premium/PlanCard.astro
// One plan card: name, audience, price block, button, slot, features. Fixed-height
// regions on desktop so the prices and buttons in a row sit on one line each. `plan="free"`
// renders the Free card (no button; its slot holds the sign-in line).
import { INTERVALS, PLANS, type PlanKey } from '../../lib/billing/plans';
import { plansPageCopy } from '../../lib/billing/plans-page-copy';
import { SECONDARY_BUTTON_FIXED } from '../../lib/planner/styles';
import { premiumSourceCopy } from '../../lib/billing/premium-source-copy';
import { CARD, CARD_SURFACE } from '../../lib/ui/card';
import PriceBlock from './PriceBlock.astro';
import { FOUNDER_STATES, buttonLabel, checkoutHref, founderKey, planBlock, trialParts } from './model';

interface Props {
  plan: PlanKey | 'free';
  /** The name's heading level: 2 in region A, 3 under region B's `For guild leaders` h2. */
  headingLevel?: 2 | 3;
}
const { plan, headingLevel = 2 } = Astro.props;
const Name = headingLevel === 3 ? 'h3' : 'h2';
const { free } = plansPageCopy;
const block = plan === 'free' ? free : planBlock(plan);
const priced = plan === 'free' ? null : plan;
const guild = priced !== null && PLANS[priced].guild;
// Gold on this page belongs to Premium's button; the guild buttons are plain (spec §B3.3, §B6).
const buttonTone = guild
  ? 'border-line-warm-strong text-text active:bg-card-top'
  : 'plan-button-gold border-gold text-gold';
const buttonClass = `${SECONDARY_BUTTON_FIXED} plan-button ${buttonTone} w-full justify-center text-center`;
// The owned state's neutral link: never gold, even on the gold card.
const ownedButtonClass = `${SECONDARY_BUTTON_FIXED} plan-button plan-owned border-line-warm-strong text-strong w-full justify-center text-center`;
const OWNED_SOURCES = Object.entries(premiumSourceCopy.premiumCard);
const trial = trialParts();
const cardId = plan === 'free' ? 'free' : undefined;
---

<article
  class={`plan-card ${guild ? CARD_SURFACE : CARD}`}
  id={cardId}
  data-testid={`plan-${plan}`}
  data-plan={plan}
  data-highlight={guild ? undefined : ''}
>
  <Name class="plan-name">{block.name}</Name>
  {plan === 'premium' ? (
    <div class="audience-cell" data-part="audience">
      <p class="audience" data-default>
        {block.audience}
      </p>
      {OWNED_SOURCES.map(([source, line]) => (
        <p class="audience owned-line" data-source={source}>
          {line}
        </p>
      ))}
    </div>
  ) : (
    <p class="audience">{block.audience}</p>
  )}

  {priced ? (
    <PriceBlock plan={priced} />
  ) : (
    <div class="free-price">
      <p class="free-amount tabular">{free.price}</p>
      <p class="free-note">{free.note}</p>
    </div>
  )}

  <div class="action-slot min-h-11">
    {priced ? (
      INTERVALS.flatMap((interval) =>
        FOUNDER_STATES.map((founder) => (
          <a
            href={checkoutHref(priced, interval)}
            class={buttonClass}
            data-iv={interval}
            data-fd={founderKey(founder)}
          >
            {buttonLabel(priced, interval, founder)}
          </a>
        )),
      )
    ) : (
      <p class="free-note">{free.signIn}</p>
    )}
    {plan === 'premium' && (
      <a href="/account#plan" class={ownedButtonClass} data-owned>
        {premiumSourceCopy.buttons.seePlan}
      </a>
    )}
  </div>

  <div class="slot min-h-10" data-part="slot">
    {plan === 'premium' && (
      <p class="slot-line" data-testid="premium-support">
        {plansPageCopy.premium.support}
      </p>
    )}
    {guild && (
      <p class="slot-line">
        <strong>{trial.lead}</strong>
        {trial.rest}
      </p>
    )}
  </div>

  <div class="feature-block">
    <ul class="features">
      {block.features.map((line) => (
        <li class="feature">
          <svg class="tick" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
            <path
              d="M2.5 7.5l3 3 6-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{line}</span>
        </li>
      ))}
    </ul>
    {plan === 'free' && <p class="promise">{free.promise}</p>}
    {plan === 'premium' && (
      <p class="scope" data-testid="premium-scope">
        {plansPageCopy.premium.scope}
      </p>
    )}
  </div>
</article>

<style>
  .plan-card {
    display: flex;
    flex-direction: column;
    padding: 12px 20px 20px;
    scroll-margin-top: 16px;
  }
  .plan-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    line-height: 24px;
    color: var(--color-strong);
  }
  .audience,
  .free-note {
    margin: 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }
  .audience {
    margin-bottom: 4px;
  }
  /* Premium's audience line: the default and the three source lines stack in one grid cell, so the
     cell is as tall as the tallest and the card never changes height; the unpicked ones are
     visibility:hidden (out of the accessibility tree too). data-premium is set before first paint. */
  .audience-cell {
    display: grid;
    margin-bottom: 4px;
  }
  .audience-cell > .audience {
    grid-area: 1 / 1;
    margin-bottom: 0;
  }
  .owned-line {
    visibility: hidden;
  }
  :global(html[data-premium]) .audience-cell [data-default] {
    visibility: hidden;
  }
  :global(html[data-premium='own']) .owned-line[data-source='own'],
  :global(html[data-premium='seat']) .owned-line[data-source='seat'],
  :global(html[data-premium='grant']) .owned-line[data-source='grant'] {
    visibility: visible;
  }
  /* The See your plan link replaces the subscribe buttons in the same 44 px slot. */
  .plan-owned {
    display: none;
  }
  :global(html[data-premium]) .plan-owned {
    display: inline-flex;
  }
  :global(html[data-premium]) .action-slot .plan-button:not(.plan-owned) {
    display: none;
  }
  .free-price {
    height: 86px;
  }
  .free-amount {
    margin: 0;
    height: 32px;
    line-height: 32px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 28px;
    color: var(--color-strong);
  }
  .action-slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
  }
  .plan-button {
    height: auto;
    min-height: 44px;
    padding: 8px 10px;
    line-height: 1.25;
  }
  /* Spec 4: the card button's hover ground. */
  .plan-button-gold:hover {
    background: rgba(229, 185, 85, 0.08);
  }
  /* One subgrid cell: the guild cards' trial line, Premium's support line, blank on Free. */
  .slot {
    margin: 8px 0 0;
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    color: var(--color-text);
  }
  .slot-line {
    margin: 0;
  }
  .slot strong {
    font-weight: 600;
    color: var(--color-strong);
  }
  .slot:empty {
    display: none;
  }
  .features {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--color-text);
  }
  .feature {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    min-height: 32px;
    padding-block: 6px;
    border-top: 1px solid var(--color-line-soft);
    line-height: 20px;
  }
  .tick {
    flex: none;
    margin-top: 3px;
    color: var(--color-kill);
  }
  .scope {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }
  .promise {
    margin: 12px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-strong);
  }
  @media (min-width: 768px) {
    .plan-card {
      padding: 12px 20px 20px;
    }
    .audience,
    .audience-cell {
      margin-bottom: 8px;
    }
    /* 44 px, the spec's button (gate fix L2): two lines of the 11 px label plus 6 px padding
       (about 40 px) fit, and the answer (price and button) stays above y 520 at 1280 x 800
       (spec B1). The slot and the button are one height, so Free's slot line centres in it. */
    .action-slot {
      height: 44px;
    }
    /* The guild label is too wide for one line in a 1024px column, so every button is the same
       44 px box at the slot's top: tops and heights match whether a label wraps or not. */
    .plan-button {
      height: 44px;
      align-self: flex-start;
      padding: 6px 8px;
      font-size: 11px;
      letter-spacing: 0.03em;
    }
    /* Each card is a six-row subgrid (PLAN_CARD_ROWS in model.ts) of its region's grid in
       premium.astro, so the slot is as
       tall as the tallest slot line in its row: at 1024 the guild line wraps to three lines and
       the features still start on one line (UX 1). */
    .plan-card {
      display: grid;
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .slot:empty {
      display: block;
    }
    .free-price {
      height: 84px;
    }
    .free-amount {
      height: 34px;
      line-height: 34px;
    }
  }
  /* Capture-row note (rows 15 and 17, not yet run): written for the old four-column row; the rows
     are now three columns, about 299 px each at 1024, where the 20 px padding may fit. This
     16 px padding, no extra tracking and 6 px inset is the conservative setting (UX N5). */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .plan-card {
      padding: 16px;
    }
    .plan-button {
      padding-inline: 6px;
      letter-spacing: 0;
    }
  }
</style>
