---
// web/src/components/premium/PlanCard.astro
// One plan card: name, audience, price block, button, slot, features. Fixed-height
// regions on desktop so the prices and buttons in a row sit on one line each. `plan="free"`
// renders the Free card (no button; its slot holds the sign-in line).
import { INTERVALS, PLANS, type PlanKey } from '../../lib/billing/plans';
import { plansPageCopy } from '../../lib/billing/plans-page-copy';
import { BUTTON_MD, BUTTON_PRIMARY } from '../../lib/ui/button';
import { SECONDARY_BUTTON_FIXED } from '../../lib/planner/styles';
import { premiumSourceCopy } from '../../lib/billing/premium-source-copy';
import { CARD, CARD_QUIET } from '../../lib/ui/card';
import PriceBlock from './PriceBlock.astro';
import {
  FOUNDER_STATES,
  buttonLabel,
  checkoutHref,
  featureLines,
  founderKey,
  isFirstOfAnchor,
  planBlock,
  trialParts,
} from './model';

interface Props {
  plan: PlanKey | 'free';
  /** The name's heading level: 2 in region A, 3 under region B's `For guild leaders` h2. */
  headingLevel?: 2 | 3;
}
const { plan, headingLevel = 2 } = Astro.props;
const Name = headingLevel === 3 ? 'h3' : 'h2';
const { free } = plansPageCopy;
const block = plan === 'free' ? free : planBlock(plan);
const priced = plan === 'free' ? null : plan;
const guild = priced !== null && PLANS[priced].guild;
// Premium's button is the page's one filled element; the guild buttons are plain (polish spec
// 2026-10-28 §3.3, launch-pricing §B6).
const buttonClass = guild
  ? `${SECONDARY_BUTTON_FIXED} plan-button border-line-warm-strong text-text active:bg-card-top w-full justify-center text-center`
  : `${BUTTON_PRIMARY} ${BUTTON_MD} plan-button w-full text-center`;
// The owned state's neutral link: never gold, even on the gold card.
const ownedButtonClass = `${SECONDARY_BUTTON_FIXED} plan-button plan-owned border-line-warm-strong text-strong w-full justify-center text-center`;
const OWNED_SOURCES = Object.entries(premiumSourceCopy.premiumCard);
const trial = trialParts();
// The account panel's Plan row lands on the Premium card (spec 2026-10-29-premium-entry section 8).
const cardId = plan === 'free' || plan === 'premium' ? plan : undefined;
const lines = featureLines(block.features);
---

<article
  class={`plan-card ${guild ? CARD_QUIET : CARD}`}
  id={cardId}
  data-testid={`plan-${plan}`}
  data-plan={plan}
  data-highlight={guild ? undefined : ''}
>
  <Name class="plan-name heading-plan">{block.name}</Name>
  {plan === 'premium' ? (
    <div class="audience-cell" data-part="audience">
      <span class="pill pill-site founder-tag" data-fd="open" data-testid="premium-founder-tag">
        {plansPageCopy.founder.label}
      </span>
      <p class="audience" data-default>
        {block.audience}
      </p>
      {OWNED_SOURCES.map(([source, line]) => (
        <p class="audience owned-line" data-source={source}>
          {line}
        </p>
      ))}
    </div>
  ) : (
    <p class="audience">{block.audience}</p>
  )}

  {priced ? (
    <PriceBlock plan={priced} />
  ) : (
    <div class="free-price">
      <p class="free-amount tabular">{free.price}</p>
      <p class="free-note">{free.note}</p>
    </div>
  )}

  <div class="action-slot min-h-11">
    {priced
      ? INTERVALS.flatMap((interval) =>
          FOUNDER_STATES.map((founder) => (
            <a
              href={checkoutHref(priced, interval)}
              class={buttonClass}
              data-iv={interval}
              data-fd={founderKey(founder)}
            >
              {buttonLabel(priced, interval, founder)}
            </a>
          )),
        )
      : null}
    {plan === 'premium' && (
      <a href="/account#plan" class={ownedButtonClass} data-owned>
        {premiumSourceCopy.buttons.seePlan}
      </a>
    )}
  </div>

  <div class="slot min-h-10" data-part="slot">
    {plan === 'premium' && (
      <p class="slot-line" data-testid="premium-support">
        {plansPageCopy.premium.support}
      </p>
    )}
    {guild && (
      <p class="slot-line">
        <strong>{trial.lead}</strong>
        {trial.rest}
      </p>
    )}
  </div>

  <div class="feature-block">
    <ul class="features">
      {lines.map((line, index) => (
        <li
          class="feature"
          id={isFirstOfAnchor(lines, index) ? (line.anchor ?? undefined) : undefined}
          data-anchor={line.anchor ?? undefined}
        >
          <svg class="tick" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
            <path
              d="M2.5 7.5l3 3 6-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{line.text}</span>
        </li>
      ))}
    </ul>
    {plan === 'premium' && (
      <p class="scope" data-testid="premium-scope">
        {plansPageCopy.premium.scope}
      </p>
    )}
  </div>
</article>

<style>
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 12px 20px 20px;
    scroll-margin-top: 16px;
  }
  /* Premium is the gold card (polish spec 2026-10-28 §3.3). */
  .plan-card[data-plan='premium'] {
    border-color: rgba(229, 185, 85, 0.45);
    box-shadow:
      inset 0 1px 0 var(--card-highlight),
      0 0 0 1px rgba(229, 185, 85, 0.12),
      0 18px 48px rgba(229, 185, 85, 0.1);
  }
  /* The Founder tag sits top-right while the founder window is open (spec §3.3). */
  .founder-tag {
    position: absolute;
    top: 14px;
    right: 20px;
  }
  .plan-name {
    margin: 0;
    line-height: 24px;
  }
  .audience,
  .free-note {
    margin: 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }
  .audience {
    margin-bottom: 4px;
  }
  /* Premium's audience line: the default and the three source lines stack in one grid cell, so the
     cell is as tall as the tallest and the card never changes height; the unpicked ones are
     visibility:hidden (out of the accessibility tree too). data-premium is set before first paint. */
  .audience-cell {
    display: grid;
    margin-bottom: 4px;
  }
  .audience-cell > .audience {
    grid-area: 1 / 1;
    margin-bottom: 0;
  }
  .owned-line {
    visibility: hidden;
  }
  :global(html[data-premium]) .audience-cell [data-default] {
    visibility: hidden;
  }
  :global(html[data-premium='own']) .owned-line[data-source='own'],
  :global(html[data-premium='seat']) .owned-line[data-source='seat'],
  :global(html[data-premium='grant']) .owned-line[data-source='grant'] {
    visibility: visible;
  }
  /* The See your plan link replaces the subscribe buttons in the same 44 px slot. */
  .plan-owned {
    display: none;
  }
  :global(html[data-premium]) .plan-owned {
    display: inline-flex;
  }
  :global(html[data-premium]) .action-slot .plan-button:not(.plan-owned) {
    display: none;
  }
  .free-price {
    height: 82px;
  }
  .free-amount {
    margin: 0;
    height: 44px;
    line-height: 44px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 44px;
    color: var(--color-strong);
  }
  /* Free has no button and no slot line (polish spec 2026-10-28 §3.3, player ruling): both cells
     are hidden, and from 768 the feature list starts in the button's row (below), so no dead gap
     sits between the price note and the list. */
  .plan-card[data-plan='free'] .action-slot,
  .plan-card[data-plan='free'] .slot {
    display: none;
  }
  .action-slot {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
  }
  .plan-button {
    height: auto;
    min-height: 44px;
    padding: 8px 10px;
    line-height: 1.25;
  }
  /* One subgrid cell: the guild cards' trial line, Premium's support line, blank on Free. */
  .slot {
    margin: 8px 0 0;
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    color: var(--color-text);
  }
  .slot-line {
    margin: 0;
  }
  .slot strong {
    font-weight: 600;
    color: var(--color-strong);
  }
  .slot:empty {
    display: none;
  }
  .features {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--color-text);
  }
  /* Every line carries the landing highlight's padding and radius at all times, so the
     highlight changes no box (spec 2026-10-29-premium-entry section 8). The landing margin is a
     third of the viewport, and never less than the coach line's depth in the card (about 260 px
     at every width, measured), so the card's name stays in view on a 360 px phone (A15). */
  .feature {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    min-height: 32px;
    padding: 6px 8px;
    border-top: 1px solid var(--color-line-soft);
    border-radius: var(--radius-control);
    line-height: 20px;
    scroll-margin-top: max(33vh, 280px);
  }
  /* The landing highlight: the lines whose data-anchor matches the :target, a tint and an inset
     2 px gold rule (a shadow, not a border, so nothing reflows). No animation, no script. */
  .features:has(#coach:target) [data-anchor='coach'],
  .features:has(#server-sims:target) [data-anchor='server-sims'],
  .features:has(#history:target) [data-anchor='history'],
  .features:has(#notifications:target) [data-anchor='notifications'] {
    background: rgba(229, 185, 85, 0.08);
    box-shadow: inset 2px 0 0 var(--color-gold);
  }
  .tick {
    flex: none;
    margin-top: 3px;
    color: var(--color-kill);
  }
  .scope {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .plan-card {
      padding: 12px 20px 20px;
    }
    .audience,
    .audience-cell {
      margin-bottom: 8px;
    }
    /* 44 px, the spec's button (gate fix L2): two lines of the 11 px label plus 6 px padding
       (about 40 px) fit, and the answer (price and button) stays above y 520 at 1280 x 800
       (spec B1). The slot and the button are one height, so Free's slot line centres in it. */
    .action-slot {
      height: 44px;
    }
    /* The guild label is too wide for one line in a 1024px column, so every button is the same
       44 px box at the slot's top: tops and heights match whether a label wraps or not. */
    .plan-button {
      height: 44px;
      align-self: flex-start;
      padding: 6px 8px;
      font-size: 11px;
      letter-spacing: 0.03em;
    }
    /* Each card is a six-row subgrid (PLAN_CARD_ROWS in model.ts) of its region's grid in
       premium.astro, so the slot is as
       tall as the tallest slot line in its row: at 1024 the guild line wraps to three lines and
       the features still start on one line (UX 1). */
    .plan-card {
      display: grid;
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .slot:empty {
      display: block;
    }
    .plan-card[data-plan='free'] .feature-block {
      grid-row: 4 / 7;
    }
    .free-price {
      height: 86px;
    }
    .free-amount {
      height: 52px;
      line-height: 52px;
      font-size: 52px;
    }
  }
  /* Capture-row note (rows 15 and 17, not yet run): written for the old four-column row; the rows
     are now three columns, about 299 px each at 1024, where the 20 px padding may fit. This
     16 px padding, no extra tracking and 6 px inset is the conservative setting (UX N5). */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .plan-card {
      padding: 16px;
    }
    .plan-button {
      padding-inline: 6px;
      letter-spacing: 0;
    }
  }
</style>
