---
// web/src/components/premium/GuildRules.astro
// The rules an officer reads before putting the plan on a card. Never a disclosure. It sits
// inside the plans page's #guild-leaders section, so it is a Card with an h3 head (site
// alignment spec 2026-10-29 §5.13): each rule is a full-bleed row, the term (15 px 600) and the
// answer (14/22 --text), no chevron.
import { plansPageCopy } from '../../lib/billing/plans-page-copy';
import Card from '../ui/Card.astro';
---

<Card
  glyph="book"
  title={plansPageCopy.howItWorks}
  headingLevel={3}
  body="none"
  id="guild-rules"
  testid="guild-rules"
>
  <dl class="m-0">
    {plansPageCopy.rules.map((rule) => (
      <div class="border-line-soft flex flex-col gap-1 border-t px-5 py-3 lg:grid lg:min-h-14 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-4">
        <dt class="text-strong text-[15px] leading-6 font-semibold" data-rule-term>
          {rule.term}
        </dt>
        <dd class="text-text m-0 max-w-[80ch] text-[14px] leading-[22px]">{rule.sentence}</dd>
      </div>
    ))}
  </dl>
</Card>
