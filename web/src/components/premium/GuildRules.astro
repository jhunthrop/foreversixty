---
// web/src/components/premium/GuildRules.astro
// The eight rules an officer reads before putting the plan on a card. Never a disclosure.
import { plansPageCopy } from '../../lib/billing/plans-page-copy';
---

<section class="rules" aria-labelledby="guild-rules-heading">
  <h2 id="guild-rules-heading" class="section-title">
    {plansPageCopy.howItWorks}
  </h2>
  <dl>
    {plansPageCopy.rules.map((rule) => (
      <div class="row">
        <dt class="label">{rule.term}</dt>
        <dd>{rule.sentence}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .rules {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rules h2 {
    margin: 0;
  }
  dl {
    margin: 0;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 10px;
    border-top: 1px solid var(--color-line-soft);
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    margin: 0;
    max-width: 80ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }
  @media (min-width: 1024px) {
    .row {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 16px;
      min-height: 44px;
    }
  }
</style>
