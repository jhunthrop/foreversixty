---
// web/src/components/SpecTableOfContents.astro
// Every spec guide renders the same nine sections in the same order (SPEC_SECTIONS); this
// gives the reader a fixed jump list instead of scrolling to find Gear or Stat priority.
// Two placements, the way Icy Veins and Wowhead do it: `rail` is the sticky column beside
// the article at lg (Content.astro's aside slot), `inline` the boxed list at the top of the
// article for narrower screens. The guide renders both; each hides itself where the other
// shows, so a reader never sees two.
import { SPEC_SECTIONS, slugify } from '../lib/guides/sections';
import { guidesCopy } from '../lib/guides/copy';

interface Props {
  placement?: 'inline' | 'rail';
}
const { placement = 'inline' } = Astro.props;
---

{placement === 'rail' ? (
  <nav aria-label="Sections in this guide" class="flex flex-col gap-2" data-testid="guide-toc-rail">
    <h2 class="section-title text-[13px]">On this page</h2>
    <ol class="m-0 flex list-none flex-col gap-1 p-0 text-[13px]">
      {SPEC_SECTIONS.map((section) => (
        <li>
          <a
            class="toc-rail-link text-nav inline-flex min-h-7 items-center"
            href={`#${slugify(section)}`}
            data-toc-link={slugify(section)}
          >
            {section}
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <nav aria-label="Sections in this guide" class="sticky top-0 z-20 lg:hidden" data-testid="guide-toc-inline">
    <!-- Sticky and closed by default below lg: a nine-link box scrolled away after the
           first screen of a seven-screen page, so a reader who wanted Stat priority after
           Overview had to scroll back up. One 44px line rides under the header instead. -->
    <details class="bg-bg border-line-soft border-b">
      <summary class="label text-nav flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 select-none">
        {guidesCopy.tocBarLabel}
        <span class="toc-bar-hint text-nav" aria-hidden="true">
          {guidesCopy.tocBarHint}
          <svg viewBox="0 0 12 12" width="12" height="12" class="toc-bar-chevron">
            <path
              d="M2 4l4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </summary>
      <ol class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 pb-3 text-[13px]">
        {SPEC_SECTIONS.map((section) => (
          <li>
            <a class="inline-flex min-h-9 items-center" href={`#${slugify(section)}`}>
              {section}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style is:global>
  .toc-rail-link {
    border-left: 2px solid transparent;
    padding-left: 10px;
  }
  .toc-rail-link:hover {
    color: var(--color-strong);
  }
  .toc-rail-link:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
    color: var(--color-strong);
  }
  .toc-rail-link[aria-current='location'] {
    color: var(--color-strong);
    border-left-color: var(--color-gold);
    font-weight: 700;
  }
  .toc-bar-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }
  details[open] .toc-bar-chevron {
    transform: rotate(180deg);
  }
</style>
