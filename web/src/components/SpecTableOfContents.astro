---
// web/src/components/SpecTableOfContents.astro
// Every spec guide renders the same nine sections in the same order (SPEC_SECTIONS); this
// gives the reader a fixed jump list at the top of the page instead of scrolling to find
// Gear or Stat priority.
import { SPEC_SECTIONS, slugify } from '../lib/guides/sections';
---

<nav aria-label="Sections in this guide" class="rounded-control bg-raised border border-line p-4">
  <h2 class="section-title text-[13px]">On this page</h2>
  <ol class="flex flex-wrap gap-x-4 gap-y-1 list-none p-0 m-0 mt-2 text-[13px]">
    {SPEC_SECTIONS.map((section) => (
      <li>
        <a href={`#${slugify(section)}`}>{section}</a>
      </li>
    ))}
  </ol>
</nav>
