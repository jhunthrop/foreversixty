---
// web/src/components/sim/SimTabs.astro
// The one tab strip every simulator page carries (task-1-brief.md): Quick Sim, Top Gear,
// Droptimizer, Talents, Weights and Spec support, so the other three tools are reachable
// from anywhere in the lane instead of "from nowhere" (the newcomer and raid-leader
// persona reviews). Server-rendered -- SIM_TABS (lib/sim/tabs.ts) is the one source of the
// six entries -- and needs no min-h reservation: every page puts it above the `<h1>` and
// above the island's own measured mount, where it cannot shift anything the CLS budget
// already accounts for. Its own inline script (below the markup) only ever toggles the
// edge-fade overlays and scrolls the active tab into view -- it never touches layout, so
// the CLS budget still owes this component nothing. Drawn by the shared TabStrip (site
// alignment spec 2026-10-29 D3), inset by the phone gutter so no tab starts past it.
//
// A client script still rewrites these hrefs once a character is loaded (lib/sim/tabs.ts's
// `syncTabHrefs`, called from both islands): this component only ever renders the bare
// path, exactly as a signed-out visitor with nothing loaded sees it.
import { SIM_TABS, SIM_TAB_ATTR } from '../../lib/sim/tabs';
import { simCopy } from '../../lib/sim/copy';
import TabStrip from '../ui/TabStrip.astro';
import type { TabItem } from '../../lib/ui/tabs';

interface Props {
  /**
   * The current page's own path, e.g. `/sim/gear` -- never `Astro.url.pathname` read
   * inside this component: `/sim/[id].astro` (a saved-sim permalink) passes `/sim` here to
   * mark Quick Sim current without this component special-casing that route, and a caller
   * that does pass `Astro.url.pathname` may carry a trailing slash this component strips
   * before comparing, so neither caller has to normalize it first.
   */
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedPath = currentPath.length > 1 ? currentPath.replace(/\/+$/, '') : currentPath;

const tabs: TabItem[] = SIM_TABS.map((tab) => ({
  id: tab.id,
  label: tab.label,
  href: tab.href,
  testid: `sim-nav-tab-${tab.id}`,
  attrs: { [SIM_TAB_ATTR]: tab.id },
}));
const active = SIM_TABS.find((tab) => tab.href === normalizedPath)?.id ?? '';
---

<div class="px-[var(--page-inset)]">
  <TabStrip tabs={tabs} active={active} label={simCopy.simTabsLabel} testid="sim-nav-tabs" />
</div>
