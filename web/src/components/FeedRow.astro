---
import SourcePill from './SourcePill.astro';
import { formatDate } from '../lib/dates';
import type { SourceKind } from '../lib/sources';
interface Props { date: Date; kind: SourceKind; title: string; href: string; note?: string; last?: boolean; pillLabel?: string }
const { date, kind, title, href, note, last = false, pillLabel } = Astro.props;
---
<article class={`grid grid-cols-[84px_110px_1fr] gap-4 px-5 py-4 items-start ${last ? '' : 'border-b border-line-soft'}`}>
  <time class="font-mono tabular text-[13px] text-muted pt-[2px]" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  <span><SourcePill kind={kind} label={pillLabel} /></span>
  <div class="flex flex-col gap-1">
    <a href={href} class="text-[15px] font-semibold text-strong hover:text-gold">{title}</a>
    {note && <span class="text-[13px] text-muted">{note}</span>}
  </div>
</article>
