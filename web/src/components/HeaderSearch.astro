---
// web/src/components/HeaderSearch.astro
// The compact character lookup in the site header, on every page (Task L8.2 fix round 2 item
// 7). From 1024px: a 44px magnifier button in the bar (the "/" hint beside it from 1280px,
// the width the four doors leave room for: nav.css's bar budget)
// that opens a small panel (the overlay surface, ui/overlay.css) under the bar holding the design system's Search at its small size.
// Below 1024: the same small Search as the first row of the Menu. A name, or Name-Realm as the
// game writes it, opens the profile at the site's default region and ruleset
// (lib/character-search.ts); the home page's full box is the one with the region and ruleset
// pickers. "/" outside a text field focuses the home box where there is one, else opens this.
// Each form's status line is a live region, so it stays in the page while empty (fix round 4
// item 2: `empty:mt-0` closes the gap without hiding it from assistive tech).
import { homeCharacterSearchCopy as copy } from '../lib/home-landing-copy';
import { button } from '../lib/ui/button';
import { FIELD_CONTROL, FIELD_FOCUS, fieldEdge } from '../lib/ui/field';
import { ICON_SEARCH } from '../lib/ui/ui-icons';
import Icon from './ui/Icon.astro';

interface Props {
  /** `bar` is the desktop button and its panel; `menu` is the Menu's own row. */
  place: 'bar' | 'menu';
}

const { place } = Astro.props;
const id = `site-search-${place}`;
/** The Field primitive's input (lib/ui/field.ts), 44 px tall with room for the magnifier. */
const FIELD = [FIELD_CONTROL, FIELD_FOCUS, fieldEdge(false), 'h-11 min-w-0 pl-10'].join(' ');
const SUBMIT = `${button('secondary', 'md')} shrink-0`;
---

{place === 'bar' ? (
  <div class="site-search" data-header-search>
    <button
      type="button"
      class="site-search-button"
      aria-expanded="false"
      aria-controls={`${id}-panel`}
      aria-label={copy.heading}
      aria-keyshortcuts="/"
      data-header-search-toggle
      data-testid="site-search-toggle"
    >
      <Icon icon={ICON_SEARCH} size={20} />
      <kbd class="site-search-kbd" aria-hidden="true">
        {copy.slashKey}
      </kbd>
    </button>
    <div
      id={`${id}-panel`}
      class="site-search-panel ui-overlay"
      data-kind="menu"
      hidden
      data-header-search-panel
    >
      <form
        class="flex gap-2"
        role="search"
        data-character-search
        data-header-search-form
        data-status-id={`${id}-status`}
        data-empty={copy.empty}
        data-invalid={copy.invalid}
        novalidate
      >
        <label class="sr-only" for={`${id}-name`}>
          {copy.nameLabel}
        </label>
        <span class="relative min-w-0 flex-1">
          <Icon
            icon={ICON_SEARCH}
            size={18}
            class="text-gold pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
          />
          <input
            id={`${id}-name`}
            name="name"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder={copy.namePlaceholder}
            aria-describedby={`${id}-status`}
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`${id}-listbox`}
            class={FIELD}
            data-testid="site-search-input"
          />
          <div class="typeahead" data-typeahead>
            <ul
              id={`${id}-listbox`}
              class="typeahead-list ui-overlay"
              data-kind="menu"
              role="listbox"
              hidden
            />
          </div>
        </span>
        <button type="submit" class={SUBMIT}>
          {copy.submit}
        </button>
      </form>
      <p id={`${id}-status`} class="text-strong mt-1 text-[13px] empty:mt-0" role="status" />
    </div>
  </div>
) : (
  <div class="site-menu-search" data-header-search-menu>
    <form
      class="flex gap-2"
      role="search"
      data-character-search
      data-status-id={`${id}-status`}
      data-empty={copy.empty}
      data-invalid={copy.invalid}
      novalidate
    >
      <label class="sr-only" for={`${id}-name`}>
        {copy.nameLabel}
      </label>
      <span class="relative min-w-0 flex-1">
        <Icon
          icon={ICON_SEARCH}
          size={18}
          class="text-gold pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
        />
        <input
          id={`${id}-name`}
          name="name"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={copy.namePlaceholder}
          aria-describedby={`${id}-status`}
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls={`${id}-listbox`}
          class={FIELD}
          data-testid="site-menu-search-input"
        />
        <div class="typeahead" data-typeahead>
          <ul id={`${id}-listbox`} class="typeahead-list ui-overlay" data-kind="menu" role="listbox" hidden />
        </div>
      </span>
      <button type="submit" class={SUBMIT}>
        {copy.submit}
      </button>
    </form>
    <p id={`${id}-status`} class="text-strong mt-1 text-[13px] empty:mt-0" role="status" />
  </div>
)}
