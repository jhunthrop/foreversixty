---
interface Props { title: string; description: string; href: string; status: { label: string; kind: 'site' | 'community' } }
const { title, description, href, status } = Astro.props;
---
<a href={href} class="flex flex-col gap-[10px] p-[18px_16px] rounded-panel border border-line bg-gradient-to-b from-card-top to-raised shadow-[inset_0_-1px_0_rgba(229,185,85,.35)] text-strong hover:border-gold-deep transition-colors duration-150">
  <div class="flex items-center justify-between">
    <span class="text-gold"><slot name="icon" /></span>
    <span class={`pill pill-${status.kind}`}>{status.label}</span>
  </div>
  <span class="font-display text-[15px] font-bold">{title}</span>
  <span class="text-[13px] leading-snug text-muted">{description}</span>
</a>
