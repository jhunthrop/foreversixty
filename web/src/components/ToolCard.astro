---
import type { ToolStatusKind } from '../lib/sources';
import { PRIMARY_BUTTON_FIXED } from '../lib/planner/styles';
interface Props {
  title: string;
  description: string;
  href: string;
  /** Omitted where a card is a way into a section rather than a tool with data of its own. */
  status?: { label: string; kind: ToolStatusKind };
  /** Home rebuild spec §3.A.5: the bottom gold 12px/700/uppercase "OPEN THE PLANNER" line
   *  every "Five doors" card shows -- an extension of this existing component (tenet 10),
   *  not a new one. Plain text inside the card's one anchor, never a second nested <a>.
   *  Omitted everywhere else this component is used today, unchanged. */
  linkLabel?: string;
  /** Optional `data-testid` on the card's own anchor -- Astro.props does not spread
   *  unknown attributes automatically, so a caller that wants one passes it explicitly. */
  testid?: string;
  /** A gold button drawn inside the card's anchor (W.9: the landing's "Get set up" card had no
   *  button): full width on a phone, at the right edge from md. Plain text in a span, never a
   *  second <a>. */
  buttonLabel?: string;
}
const { title, description, href, status, linkLabel, testid, buttonLabel } = Astro.props;
---

<a
  href={href}
  class="flex flex-col gap-[10px] p-[18px_16px] rounded-panel border border-line bg-gradient-to-b from-card-top to-raised shadow-[inset_0_-1px_0_rgba(229,185,85,.35)] text-strong hover:border-gold-deep transition-colors duration-150"
  data-testid={testid}
>
  <div class="flex items-center justify-between">
    <span class="text-gold">
      <slot name="icon" />
    </span>
    {status && <span class={`pill pill-${status.kind}`}>{status.label}</span>}
  </div>
  <span class="font-display text-[15px] font-bold">{title}</span>
  <span class="text-[13px] leading-snug text-muted">{description}</span>
  {buttonLabel && (
    <span
      class={`${PRIMARY_BUTTON_FIXED} mt-1 justify-center self-stretch px-5 md:self-end`}
      data-testid="tool-card-button"
    >
      {buttonLabel}
    </span>
  )}
  {linkLabel && (
    <span class="text-gold mt-auto text-[12px] font-bold uppercase tracking-[0.06em]">{linkLabel}</span>
  )}
</a>
