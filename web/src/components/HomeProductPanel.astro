---
// web/src/components/HomeProductPanel.astro
// The home page's "four things" grid (spec 2026-09-23 §2 item 3): the design system's state
// panel shell -- gold dot, label, an Updated/Sample-style right slot not needed here -- with
// a one-sentence description, a slotted live element, and the panel's own link at the
// bottom. Astro-only twin of `ui/StatePanel.svelte`'s label row (that component is
// `components/ui/**`, off limits to this lane per the spec's binding constraint 6): the
// markup below matches its gold-dot row exactly, so the two read as one system.
interface Props {
  label: string;
  sentence: string;
  href: string;
  linkLabel: string;
}
const { label, sentence, href, linkLabel } = Astro.props;
const testid = `home-product-${label.toLowerCase()}`;
---

<div
  class="bg-raised border-line rounded-panel flex flex-col gap-4 border px-4 py-4 md:px-6 md:py-5"
  data-testid={testid}
>
  <div class="flex items-center gap-[10px]">
    <span
      class="bg-gold h-2 w-2 rounded-full shadow-[0_0_10px_rgba(229,185,85,.8)]"
      aria-hidden="true"
    ></span>
    <span class="label text-gold">{label}</span>
  </div>
  <p class="text-[14px] leading-relaxed">{sentence}</p>
  <div class="flex-1">
    <slot />
  </div>
  <a href={href} class="text-nav w-fit text-[13px] font-semibold">
    {linkLabel}
  </a>
</div>
