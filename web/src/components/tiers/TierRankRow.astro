---
// web/src/components/tiers/TierRankRow.astro
// One tier row: the ui/RankRow preset filled from lib/tiers/tier-row-view.ts, with the spec's
// circular crest (RankRow draws it from the class). The page script marks the visitor's own row (aria-current, the accent tint).
import RankRow from '../ui/RankRow.svelte';
import type { TierRow } from '../../lib/tiers/tier-list';
import { rankRowProps } from '../../lib/tiers/tier-row-view';

interface Props {
  row: TierRow;
  /** The row's list, for its bar's floor and "Best of the 3 tanks". */
  rows: readonly TierRow[];
}

const { row, rows } = Astro.props;
---

<RankRow {...rankRowProps(row, rows)} />
