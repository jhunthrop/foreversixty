---
// web/src/components/ui/TabStrip.astro
// The static twin of TabStrip.svelte's link tabs (site alignment spec 2026-10-29 D3, S7): a `nav`
// of links in the shared underline recipe (lib/ui/tabs.ts), the current one aria-current="page".
// Its one small script keeps the 24 px edge fades current and scrolls the current tab into view
// in the strip (never the page); it never touches layout. `testid` names the nav itself; its fades
// are `${testid}-fade-start` and `-fade-end`.
import { TAB_STRIP, tabClass, tabStripFadeTestids, type TabItem } from '../../lib/ui/tabs';

interface Props {
  tabs: readonly TabItem[];
  active: string;
  label: string;
  testid?: string;
}

const { tabs, active, label, testid } = Astro.props;
const fades = tabStripFadeTestids(testid);
---

<div class={TAB_STRIP.wrapper} data-tab-strip>
  <nav class={TAB_STRIP.strip} aria-label={label} data-testid={testid}>
    {tabs.map((tab) => {
      const current = tab.id === active;
      return tab.href !== undefined && tab.disabled !== true ? (
        <a
          href={tab.href}
          aria-current={current ? 'page' : undefined}
          class={tabClass(current, false)}
          data-tab-id={tab.id}
          data-testid={tab.testid}
          {...tab.attrs}
        >
          {tab.label}
          {tab.suffix !== undefined && <span class={TAB_STRIP.suffix}>{tab.suffix}</span>}
        </a>
      ) : (
        <span
          aria-disabled="true"
          class={tabClass(false, true)}
          data-tab-id={tab.id}
          data-testid={tab.testid}
          {...tab.attrs}
        >
          {tab.label}
        </span>
      );
    })}
  </nav>
  <div class={TAB_STRIP.fadeStart} aria-hidden="true" data-testid={fades.start}></div>
  <div class={TAB_STRIP.fadeEnd} aria-hidden="true" data-testid={fades.end}></div>
</div>

<script>
  import { scrollFade } from '../../lib/scroll-fade';
  import { scrollTabIntoView } from '../../lib/ui/tabs';

  for (const wrapper of document.querySelectorAll<HTMLElement>('[data-tab-strip]')) {
    const nav = wrapper.querySelector<HTMLElement>('nav');
    if (nav === null) continue;
    const current = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (current !== null) scrollTabIntoView(nav, current);
    scrollFade(nav);
  }
</script>
