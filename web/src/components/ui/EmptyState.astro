---
// web/src/components/ui/EmptyState.astro
// The static twin of ui/EmptyState.svelte for pages with no Svelte runtime (the tier pages): the
// same three shapes and the same classes, so an empty reads the same on every page.
import { LINK } from '../../lib/ui/primitives';
import { button } from '../../lib/ui/button';

interface Props {
  message: string;
  fill?: string;
  action?: { label: string; href: string };
  secondary?: { label: string; href: string };
  inset?: boolean;
  testid?: string;
}

const { message, fill, action, secondary, inset = false, testid = 'empty-state' } = Astro.props;
---

{
  inset ? (
    <p class="text-muted p-4 text-[14px] leading-6" data-testid={testid}>
      {message}
    </p>
  ) : fill !== undefined ? (
    <div class="flex flex-col gap-1 py-1" data-testid={testid}>
      <p class="text-strong font-semibold">{message}</p>
      <p class="text-muted text-[14px] leading-5">{fill}</p>
      {(action || secondary) && (
        <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
          {action && (
            <a class={button('primary', 'sm')} href={action.href} data-testid={`${testid}-action`}>
              {action.label}
            </a>
          )}
          {secondary && (
            <a class={LINK} href={secondary.href} data-testid={`${testid}-secondary`}>
              {secondary.label} ›
            </a>
          )}
        </div>
      )}
    </div>
  ) : (
    <div class="flex min-h-11 flex-wrap items-center gap-3 text-[14px]" data-testid={testid}>
      <span class="text-muted">{message}</span>
      {action && (
        <a
          class="text-text inline-flex min-h-11 items-center text-[13px] font-semibold underline md:min-h-0"
          href={action.href}
          data-testid={`${testid}-action`}
        >
          {action.label}
        </a>
      )}
    </div>
  )
}
