---
// web/src/components/Seal.astro
// The owner's LX seal (owner 2026-11-08: "keep the logo"): the flat SVG seal at 44 px and below (the
// nav), the painted seal v4 above (the footer). The file comes from the asset manifest
// (lib/ui/assets.ts), which picks the size's file.
import { sealFor } from '../lib/ui/seal';

interface Props {
  size: number;
  /** Eager on the nav, the page's first image; lazy elsewhere. */
  eager?: boolean;
  class?: string;
}

const { size, eager = false, class: className } = Astro.props;
---

<img
  src={sealFor(size)}
  width={size}
  height={size}
  alt=""
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
