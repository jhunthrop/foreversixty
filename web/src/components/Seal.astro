---
// web/src/components/Seal.astro
// The owner's LX seal (design/assets/logo, owner 2026-11-08: "keep the logo"): the painted seal
// v4 at every size the site draws it (the nav, the footer, the medallion fallback, the favicons);
// there is no flat seal. The file comes from the asset manifest (lib/ui/assets.ts), which picks the
// size's file.
import { sealFor } from '../lib/ui/assets';

interface Props {
  size: number;
  /** Eager on the nav, the page's first image; lazy elsewhere. */
  eager?: boolean;
  class?: string;
}

const { size, eager = false, class: className } = Astro.props;
---

<img
  src={sealFor(size)}
  width={size}
  height={size}
  alt=""
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
