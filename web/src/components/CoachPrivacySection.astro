---
// web/src/components/CoachPrivacySection.astro
// The privacy page's Log coach section; what leaves the site and who handles it.
import type { CoachPrivacySection } from '../lib/coach/privacy-section';

interface Props {
  section: CoachPrivacySection;
}
const { section } = Astro.props;
---

<>
  <h2>{section.heading}</h2>
  {section.paragraphs.map((text) => (
    <p>{text}</p>
  ))}
  <ul>
    {section.links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
</>
