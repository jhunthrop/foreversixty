---
// web/src/components/CoachPrivacySection.astro
// The privacy page's Log coach section; renders nothing until the coach line does.
import type { CoachPrivacySection } from '../lib/coach/privacy-section';

interface Props {
  section: CoachPrivacySection | null;
}
const { section } = Astro.props;
---

{section && (
  <>
    <h2>{section.heading}</h2>
    {section.paragraphs.map((text) => (
      <p>{text}</p>
    ))}
    <p>
      See <a href={section.link.href}>{section.link.label}</a>.
    </p>
  </>
)}
