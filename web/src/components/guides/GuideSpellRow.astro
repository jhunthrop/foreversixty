---
// web/src/components/guides/GuideSpellRow.astro
// One rotation line as a slim open Row (guides spec 2026-11-08 §4.3): the spell icon 28, the
// name, rank and tag (GuideSpellName), and the clause under it. A line that names no spell
// ("Trinkets, racials and potions") takes a Row with no lead at all, never an empty socket: an
// Astro slot passed conditionally still reaches the Svelte Row as a lead, so it is two Rows.
import SpellIcon from '../ui/SpellIcon.astro';
import Row from '../ui/Row.svelte';
import GuideSpellName from './GuideSpellName.astro';
import { iconUrl } from '../../lib/ui/assets';
import type { RotationItem } from '../../lib/guides/rotation-lists';

interface Props {
  build: string;
  item: RotationItem;
  /** The line's number in a numbered list (Opener, Priority). */
  rank?: string;
  testid?: string;
}
const { build, item, rank, testid } = Astro.props;
const row = { title: item.name, sub: item.clause, density: 'slim' as const, open: true, rank, testid };
---

{item.icon !== undefined ? (
  <Row {...row}>
    <SpellIcon slot="lead" url={iconUrl(build, item.icon)} size={28} />
    <GuideSpellName slot="titleContent" {item} />
  </Row>
) : (
  <Row {...row}>
    <GuideSpellName slot="titleContent" {item} />
  </Row>
)}
