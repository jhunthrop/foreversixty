---
// web/src/components/guides/GuideRacesLane.astro
// The Races lane (guides spec 2026-11-08 §4.3, rulings 0A): the Alliance races, then the Horde,
// the recommended ones first (the prose names the picks), each led by its portrait (ui/SpellIcon)
// with the racials
// that matter for this spec under it (GuideRacials); a line for a recommended race the prose
// does not name. A race the build ships no portrait for takes a Row with no lead, so its name
// never sits behind an empty lead column.
import SpellIcon from '../ui/SpellIcon.astro';
import Row from '../ui/Row.svelte';
import GuideRacials from './GuideRacials.astro';
import { guidesCopy } from '../../lib/guides/copy';
import { raceIconsFor } from '../../lib/guides/build-races';
import { racesByFaction } from '../../lib/guides/glance';
import type { GuideRaceRow } from '../../lib/guides/race-table';
import type { GuideTipBundle } from '../../lib/tooltips/game-tip';

interface Props {
  build: string;
  rows: readonly GuideRaceRow[];
  lines: readonly string[];
  tips: GuideTipBundle;
}
const { build, rows, lines, tips } = Astro.props;
const groups = racesByFaction(rows);
const raceIcons = raceIconsFor(build);
---

<div class="guide-race-lane" data-testid="guide-race-table" data-wrap-list>
  {groups.map((group) => (
    <div class="guide-race-group" data-faction={group.faction}>
      <h4 class="guide-race-sub">
        {group.faction === 'alliance' ? guidesCopy.alliancePicksHeading : guidesCopy.hordePicksHeading}
      </h4>
      <div class="guide-race-rows">
        {group.rows.map((race) => {
          const row = {
            title: race.name,
            titleTone: { faction: group.faction },
            open: true,
            testid: `guide-race-${race.slug}`,
          };
          const portrait = raceIcons.get(race.slug);
          return portrait !== undefined ? (
            <Row {...row}>
              <SpellIcon slot="lead" url={portrait} size={28} />
              <GuideRacials slot="foot" {build} racials={race.racials} {tips} />
            </Row>
          ) : (
            <Row {...row}>
              <GuideRacials slot="foot" {build} racials={race.racials} {tips} />
            </Row>
          );
        })}
      </div>
    </div>
  ))}
  {lines.map((line) => (
    <p class="text-small text-muted m-0">{line}</p>
  ))}
</div>

<style>
  /* The section heading names the lane (Races): the faction names head its two groups, with no
     lane title above them. */
  .guide-race-lane {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  /* A faction is one block, its name over its rows: past the prose the whole block wraps under
     it (lib/ui/reading-wrap.ts), never a race parted from its racials or its faction. */
  .guide-race-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* The faction's name in the lane heading's cream, not a grey caps eyebrow. */
  .guide-race-sub {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    color: var(--color-cream);
  }
  .guide-race-rows {
    display: flex;
    flex-direction: column;
  }
</style>
