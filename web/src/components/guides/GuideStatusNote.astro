---
// web/src/components/guides/GuideStatusNote.astro
// The one status note for the whole guide. The sections below it are written as a guide; the
// beta cap and the "simulated, not played" fact are said here, once, in a muted callout.
import { guidesCopy } from '../../lib/guides/copy';
---

<aside class="guide-status-note" aria-label={guidesCopy.statusNoteLabel} data-testid="guide-status-note">
  <p class="text-muted">{guidesCopy.statusNote()}</p>
</aside>

<style>
  .guide-status-note {
    background: var(--surface-card);
    border: 1px solid var(--color-line-card);
    border-top: 2px solid var(--color-line-warm-strong);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-card);
    padding: 10px 14px;
    margin: 0 0 6px;
  }
  .guide-status-note p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    max-width: none;
  }
</style>
