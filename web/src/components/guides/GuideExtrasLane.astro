---
// web/src/components/guides/GuideExtrasLane.astro
// The Enchants and consumables lane (guides spec 2026-11-08 §4.3, MUST 6): each slot's enchant
// and every consumable as the same slim icon rows, the enchant opening its spell tooltip and a
// consumable its item tooltip when the guide's tooltip data carries them. Each list is one
// block with its label: past the prose a whole block wraps under it (lib/ui/reading-wrap.ts),
// never rows parted from their heading.
import LaneBlock from '../ui/LaneBlock.svelte';
import Row from '../ui/Row.svelte';
import { dataUrl } from '../../lib/planner/load';
import { guidesCopy } from '../../lib/guides/copy';
import {
  consumableLines,
  consumableNote,
  mergedEnchants,
  type ConsumableRow,
  type GearExtras,
} from '../../lib/guides/gear-extras';
import { consumableItemId } from '../../lib/guides/guide-tips';
import { enchantTipKey, type GuideTipBundle } from '../../lib/tooltips/game-tip';

interface Props {
  build: string;
  extras: GearExtras;
  tips: GuideTipBundle;
}
interface ConsumableGroup {
  label: string;
  rows: ConsumableRow[];
}
const { build, extras, tips } = Astro.props;
const enchantKey = (id: number): string | undefined =>
  tips.tips[enchantTipKey(id)] === undefined ? undefined : enchantTipKey(id);
const consumableItem = (id: string): number | undefined => {
  const itemId = consumableItemId(build, id);
  return itemId !== undefined && tips.items[String(itemId)] !== undefined ? itemId : undefined;
};
/** The flasks and elixirs under Consumables, then each header's rows under that header. */
const groups = consumableLines(extras.consumables).reduce<ConsumableGroup[]>((out, line) => {
  if ('header' in line) return [...out, { label: line.header, rows: [] }];
  const last = out.at(-1);
  if (last === undefined) return [{ label: guidesCopy.consumables, rows: [line.row] }];
  return [...out.slice(0, -1), { ...last, rows: [...last.rows, line.row] }];
}, []);
---

<div class="guide-extras-blocks" data-wrap-list>
  {extras.enchants.length > 0 && (
    <LaneBlock label={guidesCopy.enchants} testid="guide-enchants">
      <div class="guide-extras-rows">
        {mergedEnchants(extras.enchants).map((row) => (
          <Row title={row.name} sub={row.slotLabel} density="slim" open testid={`guide-enchant-${row.slot}`}>
            {row.icon !== undefined && (
              <img
                slot="lead"
                src={dataUrl(build, `icons/${row.icon}.webp`)}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
                class="guide-extras-icon ui-socket"
              />
            )}
            <span
              slot="titleContent"
              class:list={[enchantKey(row.id) !== undefined && 'gtip guide-extras-tip']}
              tabindex={enchantKey(row.id) !== undefined ? 0 : undefined}
              data-game-tip={enchantKey(row.id)}
            >
              {row.name}
            </span>
          </Row>
        ))}
      </div>
    </LaneBlock>
  )}
  {groups.map((group, index) => (
    <LaneBlock label={group.label} testid={index === 0 ? 'guide-consumables' : undefined}>
      <div class="guide-extras-rows">
        {group.rows.map((row) => (
          <Row
            title={row.name}
            sub={consumableNote(row.gives)}
            density="slim"
            open
            testid={`guide-consumable-${row.id}`}
          >
            {row.icon !== undefined && (
              <img
                slot="lead"
                src={dataUrl(build, `icons/${row.icon}.webp`)}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
                class="guide-extras-icon ui-socket"
              />
            )}
            <span
              slot="titleContent"
              class:list={[consumableItem(row.id) !== undefined && 'gtip guide-extras-tip']}
              tabindex={consumableItem(row.id) !== undefined ? 0 : undefined}
              data-bis-item={consumableItem(row.id)}
            >
              {row.name}
            </span>
          </Row>
        ))}
      </div>
    </LaneBlock>
  ))}
</div>

<style>
  .guide-extras-blocks {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .guide-extras-rows {
    display: flex;
    flex-direction: column;
  }
  /* The icon's frame: a file that does not load shows the dark socket every missing icon shows.
     A row with no icon has no lead at all, so no empty square sits in its gutter. */
  .guide-extras-icon {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-icon);
  }
  .guide-extras-tip {
    position: relative;
    cursor: pointer;
  }
  .guide-extras-tip:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
</style>
