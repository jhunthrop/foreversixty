---
// web/src/components/guides/GuideAnswer.astro
// The signed-in answer in the PageHeader of /guides, a class landing and a spec guide (guides
// spec 2026-11-08 §4.4): the shared ui/CharacterAnswer (crest at the outer edge), reserved at its
// final size while the account loads when a session is hinted (no reserve signed out), then
// painted by lib/guides/guide-answer-mount.ts after load from the header selector's character.
import CharacterAnswer from '../ui/CharacterAnswer.svelte';
import { guidesCopy } from '../../lib/guides/copy';
import type { GuideAnswerPage } from '../../lib/guides/guide-answer';

interface Props {
  page: GuideAnswerPage;
}
const { page } = Astro.props;
---

<CharacterAnswer
  label={guidesCopy.answerLabel}
  id="guide-answer"
  page={page}
  testid="guide-answer"
  crest="end"
/>

<script>
  import { afterPaint } from '../../lib/after-paint';

  afterPaint(() => {
    void import('../../lib/guides/guide-answer-mount').then((m) => m.mountGuideAnswer());
  });
</script>
