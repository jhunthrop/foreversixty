---
// web/src/components/guides/GuideRotationLane.astro
// The Rotation and priority lane (guides spec 2026-11-08 §4.3): "For the raid build." when it
// applies and no row carries a Raid build only tag (the tags say it), then Opener and Priority (numbered) and Cooldowns as slim spell rows. A row for a
// talent only the raid build takes carries its own Raid build only tag, with no legend above.
// The lists are the guide's own (guideRotation), every line at its full clause. Past the prose,
// a whole list wraps under it with its heading (lib/ui/reading-wrap.ts), never a list split from
// its label.
import LaneBlock from '../ui/LaneBlock.svelte';
import GuideSpellRow from './GuideSpellRow.astro';
import { guidesCopy } from '../../lib/guides/copy';
import type { RotationLists } from '../../lib/guides/rotation-lists';

interface Props {
  build: string;
  lists: RotationLists;
  forRaidBuild: boolean;
}
const { build, lists, forRaidBuild } = Astro.props;
// The rows' own Raid build only tags already say whose list it is: the line goes when one shows.
const tagged = [...lists.opener, ...lists.priority, ...lists.cooldowns].some((item) => item.raidBuildOnly);
const blocks = [
  { key: 'opener', label: guidesCopy.opener, items: lists.opener, numbered: true },
  { key: 'priority', label: guidesCopy.priority, items: lists.priority, numbered: true },
  { key: 'cooldowns', label: guidesCopy.cooldowns, items: lists.cooldowns, numbered: false },
].filter((block) => block.items.length > 0);
---

{forRaidBuild && !tagged && (
  <p class="text-small text-muted m-0" data-testid="guide-rotation-build">
    {guidesCopy.rotationForRaidBuild}
  </p>
)}
<div class="guide-rotation-blocks" data-wrap-list>
  {blocks.map((block) => (
    <LaneBlock label={block.label} testid={`guide-rotation-${block.key}`}>
      <div class="guide-rotation-rows" id={block.key === 'priority' ? 'priority' : undefined}>
        {block.items.map((item, i) => (
          <GuideSpellRow
            build={build}
            item={item}
            rank={block.numbered ? String(i + 1) : undefined}
            testid={`guide-rotation-${block.key}-row`}
          />
        ))}
      </div>
    </LaneBlock>
  ))}
</div>

<style>
  .guide-rotation-blocks {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .guide-rotation-rows {
    display: flex;
    flex-direction: column;
  }
</style>
