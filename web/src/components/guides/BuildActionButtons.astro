---
// web/src/components/guides/BuildActionButtons.astro
// The two links under a spec guide's embedded tree (spec 5): "Load this build" and "Sim this
// build". Plain links, not buttons with client handlers -- Planner.svelte's own
// writePlannerPointer and sim's sources.ts already write the current-character pointer
// unconditionally whenever their page loads with a ?code=, so there is nothing for a click
// handler here to do that the destination page does not already do on arrival.
//
// The guide rebuild (spec §4.C.1) plants a second copy of this pair in the action rail,
// above the fold -- two links on one page sharing the visible text "Load this build" need
// distinct accessible names (WCAG 2.4.4/2.4.9, this site's own tenet 9), so the rail's own
// caller passes `loadAriaLabel`/`simAriaLabel` (and its own `loadTestId`/`simTestId`, so a
// test can target either copy unambiguously); the copy under the full tree keeps the
// defaults, unchanged from before this rebuild.
//
// Round-1 fix (polish): these links rendered in sentence case with no shared recipe --
// design/DESIGN-SYSTEM.md's secondary button is uppercase 12px 700 with 0.06em tracking
// (`SECONDARY_BUTTON`, `lib/planner/styles.ts`), the same recipe `StatWeightsPanel`'s own
// addon button already uses. `SECONDARY_BUTTON_FIXED` specifically (not the plain, md:h-9-
// shrinking `SECONDARY_BUTTON`): this component's own pre-existing test pins a 44px hit
// target on BOTH links at every breakpoint, which only the FIXED recipe guarantees.
import { guidesCopy } from '../../lib/guides/copy';
import { loadBuildHref, simBuildHref } from '../../lib/guides/build-links';
import { SECONDARY_BUTTON_FIXED } from '../../lib/planner/styles';

interface Props {
  code: string;
  loadTestId?: string;
  simTestId?: string;
  loadAriaLabel?: string;
  simAriaLabel?: string;
}
const {
  code,
  loadTestId = 'guide-load-build',
  simTestId = 'guide-sim-build',
  loadAriaLabel,
  simAriaLabel,
} = Astro.props;
---

<div class="flex flex-wrap gap-3" data-testid="guide-build-actions">
  <a
    href={loadBuildHref(code)}
    class={`${SECONDARY_BUTTON_FIXED} border-line-warm text-text justify-center px-4`}
    data-testid={loadTestId}
    aria-label={loadAriaLabel}
  >
    {guidesCopy.loadThisBuild}
  </a>
  <a
    href={simBuildHref(code)}
    class={`${SECONDARY_BUTTON_FIXED} border-line-warm text-text justify-center px-4`}
    data-testid={simTestId}
    aria-label={simAriaLabel}
  >
    {guidesCopy.simThisBuild}
  </a>
</div>
