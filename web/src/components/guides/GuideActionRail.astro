---
// web/src/components/guides/GuideActionRail.astro
// The spec guide's 3-up action rail (rebuild spec §4.C), directly under the header, inside
// the same `ArtPanel` as `ClassHeader` (its caller's own job -- this component renders only
// the three `panel-box` cards themselves). Build card: a fixed-height, non-interactive
// thumbnail of all three of the build's trees on their real grid (`decodeBuildTrees`, build time --
// the real, loadable tree still renders below, unchanged, under "Talents and builds") plus
// `BuildActionButtons`. Rotation card: the level-60 entry's first four lines, in `PlayItPanel`'s
// own per-line shape, plus a jump link to the full priority section. Stat priority card: one
// line per stat with its real per-point scale number (`railStatRows`), round-1 mock review
// finding 4 -- never the bare, mostly-empty pill row the first mock board shipped.
import BuildActionButtons from './BuildActionButtons.astro';
import { guidesCopy } from '../../lib/guides/copy';
import { dataUrl } from '../../lib/planner/load';
import type { DecodedTreeView } from '../../lib/guides/build-tree';
import type { RailStatRow } from '../../lib/guides/rail-stats';
import type { RotationLineView } from '../../lib/bis/rotation-view';

interface Props {
  build: string;
  buildCode: string;
  trees: DecodedTreeView[];
  rotationBandLabel: string;
  rotationLines: RotationLineView[];
  statRows: RailStatRow[];
}

const { build, buildCode, trees, rotationBandLabel, rotationLines, statRows } = Astro.props;

// Ruling (round-1 fix, owner): a spec with no ranked BiS file (Protection) has no real
// per-point numbers to show, so the Stat priority card is omitted rather than rendered with
// a label and no rows -- the rail becomes 2-up (Build + Rotation), or 1-up if the spec also
// has no rotation entry at this band (neither exists on real data today, but the layout
// degrades honestly either way). Never a card standing in for missing data (tenet 8).
const hasRotation = rotationLines.length > 0;
const hasStatPriority = statRows.length > 0;
const cardCount = 1 + (hasRotation ? 1 : 0) + (hasStatPriority ? 1 : 0);
---

<div class="guide-rail" data-testid="guide-action-rail" style={`--guide-rail-cols: ${cardCount}`}>
  <div class="panel-box guide-rail-card" data-testid="guide-rail-build">
    <span class="label">{guidesCopy.buildRailLabel}</span>
    {trees.length > 0 && (
      <div class="guide-rail-trees" aria-hidden="true" data-testid="guide-rail-tree-thumbnail">
        {trees.map((tree) => (
          <div class="guide-rail-tree">
            <span class="guide-rail-tree-name">
              {tree.name} <span class="font-mono tabular">{tree.points}</span>
            </span>
            <div
              class="guide-rail-tree-grid"
              style={`--tree-cols:${Math.max(4, ...tree.talents.map((t) => t.column + 1))}`}
            >
              {tree.talents.map((talent) => (
                <span
                  class="guide-rail-tree-cell"
                  style={`grid-row:${talent.tier + 1};grid-column:${talent.column + 1};${talent.rank > 0 ? '' : 'opacity:0.3'}`}
                >
                  <img
                    src={dataUrl(build, `icons/${talent.icon}.webp`)}
                    alt=""
                    width="28"
                    height="28"
                    loading="eager"
                    decoding="async"
                  />
                  {talent.rank > 0 && (
                    <span class="font-mono tabular guide-rail-tree-rank">{talent.rank}</span>
                  )}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
    <BuildActionButtons
      code={buildCode}
      loadTestId="guide-rail-load-build"
      simTestId="guide-rail-sim-build"
      loadAriaLabel={guidesCopy.loadBuildRailAriaLabel}
      simAriaLabel={guidesCopy.simBuildRailAriaLabel}
    />
  </div>

  {hasRotation && (
    <div class="panel-box guide-rail-card" data-testid="guide-rail-rotation">
      <span class="label">{guidesCopy.rotationRailLabel(rotationBandLabel)}</span>
      <ul class="guide-rail-rotation-lines">
        {rotationLines.map((line) => (
          <li class="guide-rail-rotation-line" data-testid={`guide-rail-rotation-line-${line.spellId}`}>
            {line.icon !== undefined ? (
              <img
                src={dataUrl(build, `icons/${line.icon}.webp`)}
                alt=""
                width="28"
                height="28"
                loading="eager"
                decoding="async"
                class="guide-rail-rotation-icon"
              />
            ) : (
              <span
                class="guide-rail-rotation-icon guide-rail-rotation-icon-placeholder"
                aria-hidden="true"
              />
            )}
            <span class="guide-rail-rotation-body">
              <span class="guide-rail-rotation-name-line">
                <span class="guide-rail-rotation-name">{line.name}</span>
                {line.rank !== undefined && (
                  <span class="text-muted guide-rail-rotation-rank">Rank {line.rank}</span>
                )}
              </span>
              <span class="guide-rail-rotation-condition">{line.condition}</span>
            </span>
          </li>
        ))}
      </ul>
      <a class="guide-rail-full-priority" href="#rotation-and-priority">
        {guidesCopy.fullPriorityLink}
      </a>
    </div>
  )}

  {hasStatPriority && (
    <div class="panel-box guide-rail-card" data-testid="guide-rail-stat-priority">
      <span class="label">{guidesCopy.statPriorityRailLabel}</span>
      <div class="guide-rail-stat-rows">
        {statRows.map((row, index) => (
          <div class="guide-rail-stat-row">
            <span class="guide-rail-stat-label">
              <span class="font-mono tabular guide-rail-stat-index">{index + 1}</span>
              {row.label}
            </span>
            {row.value === undefined ? (
              <span class="text-muted guide-rail-stat-value">Not significant</span>
            ) : (
              <span class="font-mono tabular guide-rail-stat-value">
                {row.value.toFixed(2)}
                {row.perPercent ? ' per 1%' : ''}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  /* Round-1 fix: the column count comes through a custom property (set inline, read here),
     never a literal inline `grid-template-columns` -- an inline style outranks every
     stylesheet rule regardless of specificity, which silently defeated the phone media
     query below (the rail stayed 3-up past 1023px wide, overflowing 390px, round-1
     side-by-side finding). The media query's own literal `1fr` still wins at narrow
     widths because both rules now live in this one stylesheet. */
  .guide-rail {
    display: grid;
    grid-template-columns: repeat(var(--guide-rail-cols, 3), minmax(0, 1fr));
    gap: 16px;
    /* A 1-up or 2-up rail (a healer with no ranked list or rotation lines) keeps each card
       at its 3-up width instead of stretching one card across the page (owner 2026-10-04,
       Holy Paladin): 3 x 405px + 2 x 16px = the 1248px inner width at 1344 - 2 x 48. */
    max-width: calc(var(--guide-rail-cols, 3) * 405px + (var(--guide-rail-cols, 3) - 1) * 16px);
  }
  .panel-box {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .guide-rail-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 20px;
  }

  /* Build card */
  /* Live defect 2026-10-05: an 18px, left-packed primary-tree strip read as noise. The
     card now shows all three trees, each placed on its real tier/column grid at 28px
     (22px on phones), so the build reads like the in-game talent pane. */
  /* Three trees always fit the card: each takes a third, and each tree's own grid sizes its
     cells to the column count (4 in every Forever tree today) up to 28px, square. */
  .guide-rail-trees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    pointer-events: none;
  }
  .guide-rail-tree {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .guide-rail-tree-name {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .guide-rail-tree-grid {
    display: grid;
    grid-template-columns: repeat(var(--tree-cols, 4), minmax(0, 28px));
    gap: 4px;
    /* 2026-10-05 audit finding: the rank badge (below) sits 4px outside its own cell on
       purpose, so a maxed-out talent in the grid's last column or last row pushed the
       whole rail 4px past its container -- real horizontal overflow on every guide with a
       rank in that corner, confirmed by the DOM check's scrollWidth-vs-clientWidth probe on
       every spec at both 1440 and 390. `border-box` plus this exact 4px reservation gives
       the badge room inside the grid's own box instead of bleeding into the card/page. */
    box-sizing: border-box;
    padding: 0 4px 4px 0;
  }
  .guide-rail-tree-cell {
    position: relative;
    display: block;
    aspect-ratio: 1;
  }
  .guide-rail-tree-cell img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }
  .guide-rail-tree-rank {
    position: absolute;
    bottom: -4px;
    right: -4px;
    font-size: 10px;
    background: var(--color-line-soft);
    color: var(--color-gold);
    border-radius: 2px;
    padding: 0 2px;
    line-height: 1.3;
  }

  /* Rotation card */
  .guide-rail-rotation-lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guide-rail-rotation-line {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .guide-rail-rotation-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-line);
    object-fit: cover;
  }
  .guide-rail-rotation-icon-placeholder {
    background: var(--color-bg);
  }
  .guide-rail-rotation-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }
  .guide-rail-rotation-name-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .guide-rail-rotation-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    color: var(--color-strong);
  }
  .guide-rail-rotation-rank {
    font-size: 11px;
  }
  .guide-rail-rotation-condition {
    font-size: 13px;
    color: var(--color-text);
  }
  .guide-rail-full-priority {
    margin-top: auto;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Stat priority card */
  .guide-rail-stat-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .guide-rail-stat-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .guide-rail-stat-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-strong);
  }
  .guide-rail-stat-index {
    color: var(--color-gold);
    font-size: 11px;
  }
  .guide-rail-stat-value {
    font-size: 12px;
    color: var(--color-strong);
  }

  @media (max-width: 1023px) {
    .guide-rail {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
