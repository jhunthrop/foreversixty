---
// web/src/components/guides/GuideGlance.astro
// The guide's one framed Plate, At a glance (guides spec 2026-11-08 §4.3, rulings 0A): the described
// build's three trees with Load this build (the page's one primary) and Sim this build, the
// first four priority lines every character casts at their level 60 clause with the filler
// always there, and the stats a player can gear for with the hit cap and unit lines. A column
// with no data is left out; with none, no plate.
import Button from '../ui/Button.svelte';
import Meter from '../ui/Meter.svelte';
import PlateColumn from '../ui/PlateColumn.svelte';
import PlateColumns from '../ui/PlateColumns.svelte';
import StatRow from '../ui/StatRow.svelte';
import StatTable from '../ui/StatTable.svelte';
import TalentTrees from '../ui/TalentTrees.svelte';
import type { TalentTreeView } from '../../lib/ui/talent-tree';
import GuideSpellRow from './GuideSpellRow.astro';
import { LINK } from '../../lib/ui/primitives';
import { guidesCopy } from '../../lib/guides/copy';
import { loadBuildHref, simBuildHref } from '../../lib/guides/build-links';
import type { GlanceRotation } from '../../lib/guides/glance';
import type { StatLane } from '../../lib/guides/stat-lane';

interface Props {
  /** The guide spec (`hunter-survival`): Load this build opens the planner in its levelling order. */
  spec?: string;
  build: string;
  /** The build the plate describes (the raid build when the guide has its own). */
  code?: string;
  trees: readonly TalentTreeView[];
  isRaidBuild: boolean;
  rotation: GlanceRotation;
  rotationTitle: string;
  stats?: StatLane;
}
const { spec, build, code, trees, isRaidBuild, rotation, rotationTitle, stats } = Astro.props;
const hasBuild = code !== undefined && trees.length > 0;
const hasRotation = rotation.rows.length > 0;
const hasStats = stats !== undefined && stats.glanceRows.length > 0;
const count = [hasBuild, hasRotation, hasStats].filter(Boolean).length;
let rank = 0;
const statRank = (reading: string): string => (reading === 'value' ? String(++rank) : '');
---

{count > 0 && (
  <div class="guide-glance">
    <PlateColumns count={count} label={guidesCopy.glance} frame="framed" firstWide testid="guide-glance">
      {hasBuild && (
        <PlateColumn
          label={isRaidBuild ? guidesCopy.raidBuild : guidesCopy.buildRailLabel}
          testid="guide-glance-build"
        >
          <TalentTrees mode="compact" trees={trees} build={build} testid="guide-glance-trees" />
          <Fragment slot="foot">
            <Button tone="primary" href={loadBuildHref(code!, spec)} testid="guide-load-build">
              {guidesCopy.loadThisBuild}
            </Button>
            <Button href={simBuildHref(code!)} testid="guide-sim-build">
              {guidesCopy.simThisBuild}
            </Button>
          </Fragment>
        </PlateColumn>
      )}
      {hasRotation && (
        <PlateColumn
          label={rotationTitle}
          meta={guidesCopy.levelRangeLabel(60)}
          testid="guide-glance-rotation"
        >
          <div class="guide-glance-rows">
            {rotation.rows.map((item) => (
              <GuideSpellRow build={build} item={item} />
            ))}
          </div>
          {rotation.filler !== undefined && (
            <p class="text-small text-muted guide-glance-filler" data-testid="guide-glance-filler">
              {guidesCopy.glanceFiller(rotation.filler.name)}
            </p>
          )}
          <Fragment slot="foot">
            <a class={LINK} href="#rotation-and-priority" data-testid="guide-full-priority">
              {guidesCopy.fullPriorityLink}
            </a>
          </Fragment>
        </PlateColumn>
      )}
      {hasStats && (
        <PlateColumn
          label={guidesCopy.statPriorityRailLabel}
          meta={stats!.weightHead}
          testid="guide-glance-stats"
        >
          <StatTable
            columns={[{ id: 'weight', label: stats!.weightHead }]}
            open
            label={guidesCopy.statPriorityRailLabel}
          >
            {stats!.glanceRows.map((row) => (
              <StatRow figures={[{ value: row.valueText, muted: row.reading !== 'value' }]}>
                <span slot="icon" class="guide-glance-rank tabular-nums">
                  {statRank(row.reading)}
                </span>
                <span slot="name">{row.label}</span>
                {row.reading === 'value' && row.value !== undefined && (
                  <Meter slot="meter" value={row.value} />
                )}
              </StatRow>
            ))}
          </StatTable>
          {stats!.hitCap !== undefined && (
            <p class="text-small text-muted" title={stats!.hitCap.title} data-testid="guide-glance-hit-cap">
              <b class="text-strong">{stats!.hitCap.cap}</b>
              {stats!.hitCap.detail !== undefined && <> · {stats!.hitCap.detail}</>}
            </p>
          )}
          {stats!.unitLine !== undefined && <p class="text-small text-muted">{stats!.unitLine}</p>}
        </PlateColumn>
      )}
    </PlateColumns>
  </div>
)}

<style>
  /* The plate's labels in the lane heading's cream, not a grey caps eyebrow. */
  .guide-glance :global(.ui-pcol-head h2) {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    color: var(--color-cream);
  }
  :global(.guide-glance .ui-st-name) {
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text);
    overflow-wrap: normal;
  }
  .guide-glance-rows {
    display: flex;
    flex-direction: column;
  }
  .guide-glance-rank {
    display: inline-block;
    width: 24px;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-muted);
  }
  .guide-glance-filler {
    margin: 0;
    padding-top: 8px;
  }
  .guide-glance p {
    margin: 0;
  }
</style>
