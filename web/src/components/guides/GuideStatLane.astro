---
// web/src/components/guides/GuideStatLane.astro
// The Stat priority lane (guides spec 2026-11-08 §4.3): the cap lines, the weights table (stat,
// bar, the weight with the anchor at 1.00, the rate per point), the unit line, the
// rating note and the notes for the rows with no figure. A spec with no weights lists the
// guide's own order, unnumbered figures absent.
import Meter from '../ui/Meter.svelte';
import Row from '../ui/Row.svelte';
import StatRow from '../ui/StatRow.svelte';
import StatTable from '../ui/StatTable.svelte';
import { guidesCopy } from '../../lib/guides/copy';
import type { StatLane } from '../../lib/guides/stat-lane';

interface Props {
  stats: StatLane | undefined;
  /** The guide's own statPriority, for a spec with no weights. */
  fallback: readonly string[];
}
const { stats, fallback } = Astro.props;
// A stat no item carries is not a choice the player makes: the table lists only what gear offers.
const rows = stats?.rows.filter((row) => row.reading !== 'not-on-items') ?? [];
---

<div class="guide-stat-lane">
  <div class="guide-stat-block" data-testid="guide-stat-table">
    {stats === undefined ? (
      <div class="guide-stat-rows" data-wrap-list>
        {fallback.map((label, i) => (
          <Row title={label} rank={String(i + 1)} density="slim" open />
        ))}
      </div>
    ) : (
      <>
        {stats.hitCap !== undefined && (
          <p class="text-small text-muted" title={stats.hitCap.title} data-testid="guide-stat-table-hit-cap">
            <b class="text-strong">{stats.hitCap.cap}</b>
            {stats.hitCap.detail !== undefined && <> · {stats.hitCap.detail}</>}
          </p>
        )}
        {stats.expertiseCap !== undefined && <p class="text-small text-muted">{stats.expertiseCap.text}</p>}
        <StatTable
          columns={[
            { id: 'weight', label: stats.weightHead },
            { id: 'per-point', label: stats.perPointHead },
          ]}
          nameHead={guidesCopy.statColumn}
          open
          label={guidesCopy.statPriorityRailLabel}
        >
          {rows.map((row, index) => (
            <StatRow
              figures={[
                { value: row.valueText, muted: row.reading !== 'value' },
                { value: row.perPointText === '' ? '–' : row.perPointText, muted: row.perPointText === '' },
              ]}
              testid={`guide-stat-table-row-${index}`}
            >
              <span slot="name">{row.label}</span>
              {row.reading === 'value' && row.value !== undefined && row.perPercent === undefined && (
                <Meter slot="meter" value={row.value} />
              )}
            </StatRow>
          ))}
        </StatTable>
      </>
    )}
  </div>
</div>

<style>
  /* The section's heading names the table: no lane title above it, the lane block's 8 px rhythm. */
  .guide-stat-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  /* The stats read as a list of names, not headings (the mock's plain 16/24 names), and the
     empty lead cell takes no height. */
  :global(.guide-stat-lane .ui-st-name) {
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text);
    overflow-wrap: normal;
  }
  /* A stat's name stays on one line ("Healing power"); the bar takes what is left of the lane. */
  :global(.guide-stat-lane .ui-st) {
    --st-name: minmax(max-content, 2fr);
  }
  /* No stat has an icon: the lead track takes no width, so no empty socket sits before a name. */
  :global(.guide-stat-lane .ui-st) {
    --st-icon: 0px;
  }
  :global(.guide-stat-lane .ui-st-icon) {
    height: auto;
  }
  .guide-stat-rows {
    display: flex;
    flex-direction: column;
  }
  p {
    margin: 0;
  }
</style>
