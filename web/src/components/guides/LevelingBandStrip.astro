---
// web/src/components/guides/LevelingBandStrip.astro
// The Leveling section's band strip: one row per this spec's BiS band (one faction -- the
// guide's own first `recommendedRaces` entry decides which), each with the talent-point total, a direct "Load in planner" link built from that
// band's own verified talent string, and the band's talents as a list to work through: icon,
// name and rank, in the order a player spends the points: the ladder's own order
// (`guideLadderOrder`, lib/guides/leveling-builds.ts), the one the sim, the addon, the planner's
// band loads and the low-level home read, so the strip never invents its own. A talent that
// takes more points than in the band before is marked, so the strip also reads as what each
// range adds. Each row lists the build a player holds at the range's LAST level, every talent
// stamped with the levels its points come at inside the range (sim-accuracy round 18: a level
// 36 reader of "Level 30 to 39" saw only the level 30 build). Every row is wrapped in the same
// `decodeBandTalents` the rail and the full tree share.
import { CARD_QUIET } from '../../lib/ui/card';
import { decodeBandTalents } from '../../lib/guides/build-tree';
import { guidesCopy } from '../../lib/guides/copy';
import { levelingChipRows, levelRunsText } from '../../lib/guides/leveling-talents';
import { dataUrl } from '../../lib/planner/load';
import { talentTipKey } from '../../lib/tooltips/game-tip';

export interface LevelingBandRow {
  band: number;
  /** "Level 20 to 29". */
  bandLabel: string;
  /** "11 to 20 points". */
  pointsLabel: string;
  plannerHref: string;
  /** The build held at `lastLevel`, the range's last level. */
  talents: string;
  lastLevel: number;
  /** The first level whose point the row names (10 on the first row). */
  pointsFrom: number;
}

interface Props {
  build: string;
  classSlug: string;
  rows: LevelingBandRow[];
  /** One talent id per point, level 10 to 60, in the ladder's order (`guideLadderOrder`). */
  spendOrder: readonly number[];
}

const { build, classSlug, rows, spendOrder } = Astro.props;

const chipRows = levelingChipRows(
  rows.map((row) => ({
    trees: decodeBandTalents(build, classSlug, row.talents),
    from: row.pointsFrom,
    to: row.lastLevel,
  })),
  spendOrder,
);
---

<p class="leveling-legend" data-testid="guide-leveling-legend">
  {guidesCopy.levelingLegend}
</p>
<div class={`${CARD_QUIET} leveling-strip`} data-testid="guide-leveling-strip">
  {rows.map((row, index) => {
    const chips = chipRows[index] ?? [];
    return (
      <div class="leveling-row" data-testid={`guide-leveling-row-${row.band}`}>
        <div class="leveling-row-top">
          <span class="numeric leveling-row-band">{row.bandLabel}</span>
          <span class="leveling-row-points">{row.pointsLabel}</span>
          <a class="leveling-row-link" href={row.plannerHref}>
            {guidesCopy.loadInPlanner}
          </a>
        </div>
        {chips.length > 0 && (
          <ul class="leveling-chips" data-testid="guide-leveling-row-talents">
            {chips.map((chip) => (
              <li
                class:list={['leveling-chip', 'gtip', chip.isNew && 'leveling-chip-new']}
                data-new={chip.isNew}
                tabindex="0"
                data-game-tip={talentTipKey(chip.id, chip.rank)}
              >
                {chip.isNew && <span class="sr-only">{guidesCopy.levelingNewTitle}</span>}
                <img
                  src={dataUrl(build, `icons/${chip.icon}.webp`)}
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                />
                <span class="leveling-chip-name">{chip.name}</span>
                <span class="numeric leveling-chip-rank">{`${chip.rank}/${chip.maxRank}`}</span>
                {chip.levels.length > 0 && (
                  <span class="numeric leveling-chip-levels">
                    {guidesCopy.levelingChipLevels(levelRunsText(chip.levels))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    );
  })}
</div>

<style is:global>
  /* Global on purpose: a scoped style stamps a data-astro-cid attribute on every element it
       styles, and this block is ~100 rows of markup. Every selector carries this component's own
       prefix, so going global widens nothing. */
  .leveling-strip {
    padding: 4px 20px 6px 20px;
    /* Prose follows the strip under Levels 20 to 60: give the card room to read as closed. */
    margin: 0 0 24px;
  }
  .leveling-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .leveling-row:last-child {
    border-bottom: none;
  }
  .leveling-row-top {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 16px;
    align-items: center;
    min-height: 44px;
  }
  .leveling-row-band {
    font-size: 13px;
    color: var(--color-strong);
  }
  .leveling-row-points {
    font-size: 13px;
    color: var(--color-nav);
  }
  .leveling-legend {
    margin: 12px 0 0;
    font-size: 12px;
    color: var(--color-nav);
  }
  .leveling-row-link {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .leveling-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    max-width: none;
  }
  .leveling-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px 2px 2px;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-control);
    background: var(--color-bg);
    font-size: 13px;
  }
  .leveling-chip img {
    width: 24px;
    height: 24px;
    border-radius: 3px;
    border: 1px solid var(--color-line);
  }
  .leveling-chip-new {
    border-color: var(--color-gold);
  }
  .leveling-chip-name {
    color: var(--color-text);
  }
  .leveling-chip-rank {
    font-size: 12px;
    color: var(--color-gold);
  }
  .leveling-chip-levels {
    font-size: 12px;
    color: var(--color-text);
  }

  @media (max-width: 1023px) {
    .leveling-row-top {
      grid-template-columns: auto 1fr auto;
      gap: 10px;
    }
    .leveling-strip {
      padding: 4px 12px 6px 12px;
    }
  }
</style>
