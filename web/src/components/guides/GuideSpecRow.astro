---
// web/src/components/guides/GuideSpecRow.astro
// One spec as a link Row on /guides, a class landing and /bis (guides spec 2026-11-08 §4.1, §4.2;
// design/specs/2026-11-07-bis-landing.md): the
// spec icon, the name, its muted role or Melee Tag, and a hidden "Your spec" Tag the answer
// shows on the header character's spec (lib/guides/guide-answer-mount.ts marks the row
// `aria-current`). On a landing the tags follow the name and the row carries its line and
// "Read the guide ›"; on /guides they sit at the right.
import Row from '../ui/Row.svelte';
import Tag from '../ui/Tag.svelte';
import { guidesCopy } from '../../lib/guides/copy';
import type { TitleTone } from '../../lib/ui/primitives';

interface Props {
  /** `<class>/<spec>`: what the answer matches (the row's testid ends in it). */
  specKey: string;
  name: string;
  href: string;
  icon: string;
  iconSize: 28 | 40;
  tone?: TitleTone;
  tag?: string;
  sub?: string;
  /** A landing row's last line ("Read the guide ›"). */
  foot?: string;
  /** The row's testid before `specKey` (/bis: `bis-spec-row-`); the answer marks rows by it. */
  testidPrefix?: string;
  /** The hidden tag the answer shows on the header character's spec. */
  yoursLabel?: string;
}
const {
  specKey,
  name,
  href,
  icon,
  iconSize,
  tone,
  tag,
  sub,
  foot,
  testidPrefix = 'guide-spec-row-',
  yoursLabel = guidesCopy.yourSpecPill,
} = Astro.props;
const testid = `${testidPrefix}${specKey}`;
---

{foot === undefined ? (
  <Row title={name} titleTone={tone} {href} density="slim" wrapTrail {testid}>
    <img
      slot="lead"
      src={icon}
      alt=""
      width={iconSize}
      height={iconSize}
      loading="lazy"
      decoding="async"
      class="guide-spec-icon"
    />
    <span slot="trail" class="guide-spec-tags">
      <span data-your-spec hidden>
        <Tag>{yoursLabel}</Tag>
      </span>
      {tag !== undefined && <Tag tone="muted">{tag}</Tag>}
    </span>
  </Row>
) : (
  <Row title={name} titleTone={tone} {sub} {href} {testid}>
    <img
      slot="lead"
      src={icon}
      alt=""
      width={iconSize}
      height={iconSize}
      loading="lazy"
      decoding="async"
      class="guide-spec-icon"
    />
    <span slot="titleContent">
      {name}
      {tag !== undefined && (
        <>
          {' '}
          <Tag tone="muted">{tag}</Tag>
        </>
      )}
      <span data-your-spec hidden>
        {' '}
        <Tag>{yoursLabel}</Tag>
      </span>
    </span>
    <span slot="foot" class="guide-spec-foot">
      {foot}
    </span>
  </Row>
)}

<style>
  .guide-spec-icon {
    display: block;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--color-line);
  }
  /* The tags sit on the name's 20 px line, so a tagged row is as tall as any other. */
  .guide-spec-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
  }
  .guide-spec-foot {
    color: var(--color-gold);
    font-weight: 600;
    font-size: 15px;
    line-height: 24px;
  }
  /* On a phone the tags take their own line under the name; a row with none showing (no role
     tag, not your spec) keeps no empty line for them. */
  @media (max-width: 767px) {
    :global(.ui-row > span:has(> .guide-spec-tags > [data-your-spec][hidden]:only-child)) {
      display: none;
    }
  }
  :global(.ui-row[aria-current='true']:has([data-your-spec])) {
    background: var(--color-selected);
    box-shadow: inset 3px 0 0 var(--color-gold);
  }
  [data-your-spec][hidden] {
    display: none;
  }
</style>
