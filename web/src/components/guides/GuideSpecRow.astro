---
// web/src/components/guides/GuideSpecRow.astro
// One spec as a link Row on /guides, a class landing and /bis (ClassSpecPicker; directions mocks
// b2-guides, b2-guide-class): the spec icon and the name, the whole row the link. The header
// character's spec is marked by the row's accent rule (lib/guides/guide-answer-mount.ts sets
// `aria-current`) and a screen reader's "Your spec": no pill beside the rule (h-audit 2026-11-09).
// On a landing the row carries its line (role, top stats, point split) under the name.
import Row from '../ui/Row.svelte';
import { guidesCopy } from '../../lib/guides/copy';
import type { TitleTone } from '../../lib/ui/primitives';

interface Props {
  /** `<class>/<spec>`: what the answer matches (the row's testid ends in it). */
  specKey: string;
  name: string;
  href: string;
  icon: string;
  iconSize: 28 | 40;
  tone?: TitleTone;
  sub?: string;
  /** The row's testid before `specKey` (/bis: `bis-spec-row-`); the answer marks rows by it. */
  testidPrefix?: string;
  /** The hidden tag the answer shows on the header character's spec. */
  yoursLabel?: string;
}
const {
  specKey,
  name,
  href,
  icon,
  iconSize,
  tone,
  sub,
  testidPrefix = 'guide-spec-row-',
  yoursLabel = guidesCopy.yourSpecPill,
} = Astro.props;
const testid = `${testidPrefix}${specKey}`;
---

{sub === undefined ? (
  <Row title={name} titleTone={tone} {href} density="slim" {testid}>
    <img
      slot="lead"
      src={icon}
      alt=""
      width={iconSize}
      height={iconSize}
      loading="lazy"
      decoding="async"
      class="guide-spec-icon"
    />
    <span slot="titleContent">
      {name}
      <span class="sr-only" data-your-spec hidden>
        {yoursLabel}
      </span>
    </span>
  </Row>
) : (
  <Row title={name} titleTone={tone} {sub} {href} {testid}>
    <img
      slot="lead"
      src={icon}
      alt=""
      width={iconSize}
      height={iconSize}
      loading="lazy"
      decoding="async"
      class="guide-spec-icon"
    />
    <span slot="titleContent">
      {name}
      <span class="sr-only" data-your-spec hidden>
        {yoursLabel}
      </span>
    </span>
  </Row>
)}

<style>
  .guide-spec-icon {
    display: block;
    border-radius: var(--radius-icon);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  :global(.ui-row[aria-current='true']:has([data-your-spec])) {
    background: var(--color-selected);
    box-shadow: var(--shadow-selected-bar);
  }
  [data-your-spec][hidden] {
    display: none;
  }
</style>
