---
// web/src/components/guides/SpecCard.astro
// The class landing's spec card (spec design/specs/2026-11-02-class-landing.md §5): the whole
// card is the link to the spec guide. The spec's icon, its role, its name in the class colour,
// one line on how it plays (the guide's own Overview summary) and one call to action. No
// figure: the sim owns numbers. The page's own script adds the "Your spec" pill to the role
// row for a signed-in visitor of this class; the row reserves the pill's height, so nothing
// moves when it lands.
import { guidesCopy } from '../../lib/guides/copy';
import { dataUrl } from '../../lib/planner/load';

interface Props {
  className: string;
  classColor: string;
  specSlug: string;
  specName: string;
  role: 'dps' | 'healer' | 'tank';
  /** How the spec plays, plain text. */
  line: string;
  icon: string;
  href: string;
  build: string;
}

const { className, classColor, specSlug, specName, role, line, icon, href, build } = Astro.props;
---

<a
  href={href}
  class="spec-card card-surface-quiet"
  aria-label={guidesCopy.readTheGuideAriaLabel(specName, className)}
  data-testid={`guide-spec-card-${specSlug}`}
>
  <img
    src={dataUrl(build, `icons/${icon}.webp`)}
    alt=""
    width="44"
    height="44"
    loading="eager"
    decoding="async"
    class="spec-card-icon"
  />
  <span class="spec-card-text">
    <span
      class="label spec-card-role"
      data-spec-slug={specSlug}
      data-testid={`guide-spec-card-role-${specSlug}`}
    >
      {guidesCopy.roleLabel(role)}
    </span>
    <span class="heading-name spec-card-name" style={`color:${classColor}`}>
      {specName}
    </span>
    <span class="spec-card-line" data-testid="guide-spec-card-line">
      {line}
    </span>
  </span>
  <span class="spec-card-cta" aria-hidden="true">
    {guidesCopy.readTheGuide}
    <span class="spec-card-arrow">→</span>
  </span>
</a>

<style>
  /* Stacked (below 640 and from 1024): the icon beside the role and name, the line and the
     call to action under them, the call to action pinned to the card's foot. */
  .spec-card {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    grid-template-rows: 22px auto auto 1fr;
    grid-template-areas:
      'icon role'
      'icon name'
      'line line'
      'cta cta';
    column-gap: 12px;
    padding: 16px 18px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 140ms ease-out,
      border-color 140ms ease-out,
      background 140ms ease-out;
  }
  .spec-card,
  .spec-card :global(*) {
    text-decoration: none;
  }
  .spec-card-icon {
    grid-area: icon;
    align-self: start;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    object-fit: cover;
  }
  .spec-card-text {
    display: contents;
  }
  .spec-card-role {
    grid-area: role;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 22px;
    color: var(--color-muted);
  }
  .spec-card-role :global(.your-spec-pill) {
    text-transform: uppercase;
    font-size: 11px;
  }
  .spec-card-name {
    grid-area: name;
    margin-top: 2px;
    font-size: 20px;
    line-height: 1.1;
  }
  .spec-card-line {
    grid-area: line;
    margin-top: 12px;
    font-size: 15px;
    line-height: 22px;
    color: var(--color-text);
  }
  .spec-card-cta {
    grid-area: cta;
    align-self: end;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--tracking-button);
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .spec-card-arrow {
    transition: transform 140ms ease-out;
  }

  @media (hover: hover) {
    .spec-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-gold-deep);
      background: linear-gradient(var(--row-hover), var(--row-hover)), var(--surface-card);
    }
    .spec-card:hover .spec-card-cta {
      color: var(--color-gold-hover);
    }
    .spec-card:hover .spec-card-arrow {
      transform: translateX(3px);
    }
  }
  .spec-card:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
    border-color: var(--color-gold-deep);
    background: linear-gradient(var(--row-hover), var(--row-hover)), var(--surface-card);
  }
  .spec-card:active {
    transform: translateY(0);
    border-color: var(--color-gold);
    background:
      linear-gradient(var(--row-hover), var(--row-hover)),
      linear-gradient(var(--row-hover), var(--row-hover)), var(--surface-card);
  }

  /* 640 to 1023: a full-width row, icon | text | call to action. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .spec-card {
      grid-template-columns: 44px minmax(0, 1fr) auto;
      grid-template-rows: 22px auto auto;
      grid-template-areas:
        'icon role cta'
        'icon name cta'
        'icon line cta';
      column-gap: 16px;
      padding: 16px 20px;
    }
    .spec-card-line {
      margin-top: 6px;
    }
    .spec-card-cta {
      align-self: center;
      margin-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .spec-card {
      padding: 20px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spec-card,
    .spec-card-arrow {
      transition: none;
    }
    .spec-card:hover,
    .spec-card:hover .spec-card-arrow {
      transform: none;
    }
  }
</style>
