---
// web/src/components/guides/GuidesClassPicker.astro
// The `/guides` index's own nine-crest grid (rebuild spec §4.A): a `grid-cols-3` (desktop) /
// `grid-cols-1` (phone) row of nine class cards, each a real HD ringed crest (tenet 7), the
// class name in its own colour, and its three spec guides listed underneath in tree order --
// replaces the old page's flat `ClassTile` + text-link-row layout (spec §3's own "plain list
// where a panel was expected" defect).
import ClassCrest from '../ClassCrest.astro';
import classes from '../../data/classes.json';
import { guidesCopy } from '../../lib/guides/copy';

export interface ClassCardSpec {
  name: string;
  href: string;
  /** The spec's tree icon stem, absent when the build has none. */
  icon?: string;
  role: 'dps' | 'healer' | 'tank';
}

export interface ClassCardEntry {
  slug: string;
  specs: ClassCardSpec[];
}

interface Props {
  entries: ClassCardEntry[];
  build: string;
}

const { entries, build } = Astro.props;

function nameFor(slug: string): string {
  return classes.find((c) => c.slug === slug)?.name ?? slug;
}
function colorFor(slug: string): string {
  return classes.find((c) => c.slug === slug)?.color ?? '#ffffff';
}
---

<div class="class-picker" data-testid="guides-class-picker">
  {entries.map((entry) => (
    <div class="class-card panel" data-testid={`guides-class-card-${entry.slug}`}>
      <ClassCrest slug={entry.slug} size={56} priority />
      <div class="class-card-body">
        <span class="class-card-name" style={`color:${colorFor(entry.slug)}`}>
          {nameFor(entry.slug)}
        </span>
        <ul class="class-card-specs">
          {entry.specs.map((spec) => (
            <li>
              <a href={spec.href} class="class-card-spec">
                {spec.icon !== undefined && (
                  <img
                    src={`/data/${build}/icons/${spec.icon}.webp`}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                    decoding="async"
                    class="class-card-spec-icon"
                  />
                )}
                <span>{spec.name}</span>
                <span class="class-card-role">{guidesCopy.roleLabel(spec.role)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ))}
</div>

<style>
  .panel {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .class-picker {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .class-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 20px;
  }
  .class-card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .class-card-name {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 800;
  }
  .class-card-specs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .class-card-spec {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    font-size: 14px;
    color: var(--color-text);
  }
  .class-card-spec-icon {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-line);
  }
  .class-card-role {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-nav);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0 6px;
  }

  @media (max-width: 1023px) {
    .class-picker {
      grid-template-columns: 1fr;
    }
    .class-card {
      min-height: 44px;
    }
  }
</style>
