---
// web/src/components/guides/GuidesClassPicker.astro
// The `/guides` index's nine class cards. They are /bis's own class card (`BisClassCard`, site
// alignment 5.15: one recipe for one job), with each spec row linking to its guide.
import BisClassCard from '../bis/BisClassCard.astro';
import classes from '../../data/classes.json';
import { dataUrl } from '../../lib/planner/load';

export interface ClassCardSpec {
  name: string;
  href: string;
  /** The spec's tree icon stem, absent when the build has none. */
  icon?: string;
  role: 'dps' | 'healer' | 'tank';
}

export interface ClassCardEntry {
  slug: string;
  specs: ClassCardSpec[];
}

interface Props {
  entries: ClassCardEntry[];
  build: string;
}

const { entries, build } = Astro.props;
const classFor = (slug: string) => classes.find((c) => c.slug === slug);
---

<div class="class-picker" data-testid="guides-class-picker">
  {entries.map((entry) => (
    <BisClassCard
      name={classFor(entry.slug)?.name ?? entry.slug}
      slug={entry.slug}
      color={classFor(entry.slug)?.color ?? '#ffffff'}
      testid={`guides-class-card-${entry.slug}`}
      specs={entry.specs.map((spec) => ({
        key: `${entry.slug}-${spec.name}`,
        classSlug: entry.slug,
        specSlug: spec.name,
        name: spec.name,
        role: spec.role,
        iconSrc: spec.icon === undefined ? '' : dataUrl(build, `icons/${spec.icon}.webp`),
        href: spec.href,
      }))}
    />
  ))}
</div>

<style>
  .class-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 1023px) {
    .class-picker {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .class-picker {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
  }
</style>
