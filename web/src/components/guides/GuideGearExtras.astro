---
// web/src/components/guides/GuideGearExtras.astro
// The two small tables under "Enchants and consumables": slot -> enchant, and consumable ->
// what it gives. Both come from the build's data (lib/guides/gear-extras.ts); a table with no
// rows is left out rather than shown empty. The consumables are shown the way the sim applies
// them: the flask and the elixirs together (a Classic flask stacks with both elixir kinds), then
// food, oil and potions.
import { dataUrl } from '../../lib/planner/load';
import { guidesCopy } from '../../lib/guides/copy';
import { consumableLines, type ConsumableLine, type GearExtras } from '../../lib/guides/gear-extras';
import { consumableItemId } from '../../lib/guides/guide-tips';
import { enchantTipKey, type GuideTipBundle } from '../../lib/tooltips/game-tip';
import GuideTableBox from './GuideTableBox.astro';

interface Props {
  build: string;
  extras: GearExtras;
  /** The guide's tooltip data: an enchant opens its spell's tooltip and a consumable its
   *  item's, when the data carries them. */
  tips: GuideTipBundle;
}
const { build, extras, tips } = Astro.props;
const enchantKey = (id: number): string | undefined =>
  tips.tips[enchantTipKey(id)] === undefined ? undefined : enchantTipKey(id);
const consumableItem = (id: string): number | undefined => {
  const itemId = consumableItemId(build, id);
  return itemId !== undefined && tips.items[String(itemId)] !== undefined ? itemId : undefined;
};
// The build's icon tree does not ship every consumable's icon; when none of the rows has one,
// the column of empty frames is left out rather than drawn.
const consumableIcons = extras.consumables.some((row) => row.icon !== undefined);

const lines: ConsumableLine[] = consumableLines(extras.consumables);
---

<div data-testid="guide-gear-extras">
  {extras.enchants.length > 0 && (
    <section data-testid="guide-enchants">
      <h3 id="enchants">{guidesCopy.enchants}</h3>
      <p class="extras-note">{guidesCopy.enchantsNote}</p>
      <GuideTableBox label={guidesCopy.enchants}>
        <table>
          <thead>
            <tr>
              <th scope="col">{guidesCopy.slotColumn}</th>
              <th scope="col">{guidesCopy.enchantColumn}</th>
              <th scope="col">{guidesCopy.givesColumn}</th>
            </tr>
          </thead>
          <tbody>
            {extras.enchants.map((row) => (
              <tr data-testid={`guide-enchant-${row.slot}`}>
                <th scope="row" class="extras-label">
                  {row.slotLabel}
                </th>
                <td>
                  <span
                    class:list={['extras-item', enchantKey(row.id) !== undefined && 'gtip']}
                    tabindex={enchantKey(row.id) !== undefined ? 0 : undefined}
                    data-game-tip={enchantKey(row.id)}
                  >
                    {row.icon !== undefined && (
                      <img
                        src={dataUrl(build, `icons/${row.icon}.webp`)}
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                        class="extras-icon"
                      />
                    )}
                    <span class="extras-strong">{row.name}</span>
                  </span>
                </td>
                <td class="extras-gives">{row.gives}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </GuideTableBox>
    </section>
  )}
  {extras.consumables.length > 0 && (
    <section data-testid="guide-consumables">
      <h3 id="consumables">{guidesCopy.consumables}</h3>
      <p class="extras-note">{guidesCopy.consumablesNote}</p>
      <GuideTableBox label={guidesCopy.consumables}>
        <table>
          <thead>
            <tr>
              <th scope="col">{guidesCopy.consumableColumn}</th>
              <th scope="col">{guidesCopy.givesColumn}</th>
            </tr>
          </thead>
          <tbody>
            {lines.map((line) =>
              'header' in line ? (
                <tr class="extras-group" data-testid="guide-consumable-group">
                  <th scope="colgroup" colspan="2">
                    {line.header}
                  </th>
                </tr>
              ) : (
                <tr data-testid={`guide-consumable-${line.row.id.replace(/[^a-z0-9]+/gi, '-')}`}>
                  <td>
                    <span
                      class:list={['extras-item', consumableItem(line.row.id) !== undefined && 'gtip']}
                      tabindex={consumableItem(line.row.id) !== undefined ? 0 : undefined}
                      data-bis-item={consumableItem(line.row.id)}
                    >
                      {line.row.icon !== undefined ? (
                        <img
                          src={dataUrl(build, `icons/${line.row.icon}.webp`)}
                          alt=""
                          width="24"
                          height="24"
                          loading="lazy"
                          decoding="async"
                          class="extras-icon"
                        />
                      ) : (
                        consumableIcons && <span class="extras-icon" aria-hidden="true" />
                      )}
                      <span class="extras-strong">{line.row.name}</span>
                    </span>
                  </td>
                  <td class="extras-gives">{line.row.gives}</td>
                </tr>
              ),
            )}
          </tbody>
        </table>
      </GuideTableBox>
    </section>
  )}
</div>

<style>
  .extras-note {
    margin: 0 0 4px;
    font-size: 12px;
    color: var(--color-nav);
  }
  /* The quiet-label recipe (global.css): a table's row header. */
  .extras-label {
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .extras-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
  }
  .extras-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--color-bg);
  }
  .extras-strong {
    font-weight: 700;
    color: var(--color-strong);
  }
  .extras-gives {
    font-size: 14px;
  }
  .extras-group th {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }
</style>
