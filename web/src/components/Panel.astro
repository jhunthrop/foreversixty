---
// Superseded by ui/Card.astro (site alignment spec 2026-10-29 S1). The home page is its last
// user; the home lane moves it onto Card, and this file goes then.
interface Props {
  title?: string;
  sample?: boolean;
  class?: string;
  /** The title heading level: 2 by default; 3 inside a page section that has its own h2. */
  level?: 2 | 3;
}
const { title, sample = false, class: cls = '', level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const hasAside = Astro.slots.has('aside');
const showHeader = Boolean(title) || sample || hasAside;
---

<section class={`flex flex-col gap-4 ${cls}`}>
  {showHeader && (
    <div class="flex items-baseline justify-between">
      {title && <Heading class="section-title">{title}</Heading>}
      <div class="flex items-center gap-3 ml-auto">
        {sample && <span class="pill pill-sample">Sample</span>}
        <slot name="aside" />
      </div>
    </div>
  )}
  <div class="bg-raised border border-line rounded-panel flex flex-col">
    <slot />
  </div>
</section>
