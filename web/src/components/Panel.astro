---
interface Props {
  title?: string;
  sample?: boolean;
  class?: string;
}
const { title, sample = false, class: cls = '' } = Astro.props;
const hasAside = Astro.slots.has('aside');
const showHeader = Boolean(title) || sample || hasAside;
---

<section class={`flex flex-col gap-4 ${cls}`}>
  {showHeader && (
    <div class="flex items-baseline justify-between">
      {title && <h2 class="section-title">{title}</h2>}
      <div class="flex items-center gap-3 ml-auto">
        {sample && <span class="pill pill-sample">Sample</span>}
        <slot name="aside" />
      </div>
    </div>
  )}
  <div class="bg-raised border border-line rounded-panel flex flex-col">
    <slot />
  </div>
</section>
