---
// web/src/components/FactionMark.astro
// The game's own faction emblem (design/DESIGN-SYSTEM.md's Faction section, commit
// fdbf63d6): the client's UI-PVP-Alliance lion shield / UI-PVP-Horde red disc from the unit
// frame, upscaled 4x, transparency kept, "never boxed or framed" -- a plain <img>, no ring,
// no background, unlike ClassCrest. Three sizes, the design system's own documented set:
// "20px before the word, 16px in a row descriptor, 36px in a header." The upscaled art
// lives at web/public/icons/hd/faction/<faction>.webp -- resampled from the original
// scratchpad/faction/final 256px PNGs down to 72px (2x for this component's largest real
// size, 36px) and re-encoded WebP, lossy quality 90 with alpha kept (review round 2: index
// LCP budget, web/lighthouserc.json), 3-3.6KB apiece.
//
// Provenance, <faction>-512.webp (2026-10-04): the 256px sources above were lost with a
// wiped scratchpad, and the client ships no larger native version of this same emblem --
// confirmed by pulling interface/targetingframe/ui-pvp-alliance.blp (FileDataID 136998) and
// ui-pvp-horde.blp (FileDataID 137000) from wago.tools' CASC mirror (wow_beta 6.0.1.18379):
// both are BLP2/DXT3, native 64x64, identical to the texture this component has always used.
// Candidate larger Blizzard textures (interface/timer/alliance-logo.blp and horde-logo.blp,
// 256px battleground countdown logos) are a different emblem design, not this shield/disc, so
// using them would redraw the mark rather than upscale it -- ruled out. Upscaled instead: the
// 64x64 BLP2 decoded natively (DXT3 block decode via an ImageMagick DDS round-trip) then one
// Real-ESRGAN x4plus pass (alpha channel upsampled in lockstep) to 256x256, Lanczos-resampled
// to the final 512x512 (a plain resize, no further generative step) and re-encoded WebP,
// lossy quality 90, alpha kept, ~23-29KB apiece. Side-by-side check at
// design/mocks/renders/faction-emblem-check.png confirms shape/colour/proportion match the
// shipped 72px mark exactly. Not yet wired into factionMarkSrc()/this component -- consumed
// so far only by design/mocks/gen_guild_header.py's header watermark.
//
// Provenance, <faction>-logo-512.webp (2026-10-04): a second, deliberately different emblem --
// the owner asked for the flat iconic faction logo (Alliance lion-in-shield, Horde tusked "H"),
// not this component's unit-frame shield/disc, after reviewing third-party reference PNGs
// (design/mocks/data/faction-logos/, reference only, never shipped). The "ruled out" candidate
// two paragraphs up turns out to be exactly this look: interface/timer/alliance-logo.blp
// (FileDataID 516949) and horde-logo.blp (FileDataID 516953), wago.tools' CASC mirror (same
// wow_beta 6.0.1.18379), BLP2/DXT5, native 256x256 -- these are the battleground countdown
// logos, the game's own flat faction emblem, confirmed by eye against the owner's reference
// images. Same pipeline as above one step up the chain: 256x256 decoded natively, one
// Real-ESRGAN x4plus pass to 1024x1024 (alpha in lockstep), Lanczos-resampled down to the
// published 512x512 (plain resize, no further generative step), WebP lossy quality 90, alpha
// kept, ~34-40KB apiece. Also not wired into this component -- a third, visually distinct mark
// from both the 72px shield/disc and the <faction>-512.webp upscale of it; all three may end up
// serving different surfaces, never interchanged silently.
import { factionMarkSrc, type Faction } from '../lib/faction-mark';

export type FactionMarkSize = 16 | 20 | 36;

interface Props {
  faction: Faction;
  size: FactionMarkSize;
  class?: string;
}

const { faction, size, class: cls = '' } = Astro.props;
const label = faction === 'alliance' ? 'Alliance' : 'Horde';
---

<img
  src={factionMarkSrc(faction)}
  alt=""
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
  class={`inline-block shrink-0 object-contain ${cls}`}
  style={`width: ${size}px; height: ${size}px;`}
  data-testid={`faction-mark-${faction}`}
  data-faction-name={label}
/>
