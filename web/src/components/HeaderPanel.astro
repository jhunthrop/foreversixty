---
// web/src/components/HeaderPanel.astro
// One door's list of pages (spec 2026-10-15-grouped-header.md sections 2 and 3), rendered for
// both places it appears: `bar` is the hover panel under the desktop door (hidden until the
// header script opens it), `menu` is the same list as a section of the phone Menu. One body,
// two shells, so the rows, the Guides grid and the foot never drift apart.
import type { HTMLAttributes } from 'astro/types';
import { classCrestSrc } from '../lib/class-crest';
import { GUILD_OVERVIEW_TAB, GUILDLESS_SWAPS, navKey, type NavGroup, type NavItem } from '../lib/nav';
import type { GuideClass } from '../lib/nav-guides';
import { NAV_ROW_ICON_PATHS } from './nav-row-icons';

interface Props {
  group: NavGroup;
  place: 'bar' | 'menu';
  /** The Guides grid; read from the spec catalogue once at build time by Header.astro. */
  guideClasses: readonly GuideClass[];
  /** Guild rows carry the tab the session's guild fills in (applySessionGuild). */
  isGuild: boolean;
}

const { group, place, guideClasses, isGuild } = Astro.props;
const key = navKey(group.label);
const inBar = place === 'bar';
const testScope = inBar ? 'site-panel' : 'site-menu';
const itemRole = inBar ? 'menuitem' : undefined;

const Shell = 'div';
const shellProps: HTMLAttributes<'div'> = inBar
  ? { id: `site-panel-${key}`, class: 'site-panel', role: 'menu', 'aria-label': group.label, hidden: true }
  : { class: 'site-menu-list', 'data-menu-list': key };

/** The tab a Guild row opens: the hash, or the overview for the bare /guild row. */
const guildTab = (item: NavItem): string | undefined =>
  isGuild ? (item.href.split('#')[1] ?? GUILD_OVERVIEW_TAB) : undefined;

/** What a member-only door says without a guild (applySessionGuild reads these). */
const swapOf = (tab: string | undefined) => (tab === undefined ? undefined : GUILDLESS_SWAPS[tab]);
---

<Shell {...shellProps}>
  {group.rows.map((row, index) => (
    <a
      href={row.href}
      class="site-panel-row"
      role={itemRole}
      data-testid={`${testScope}-row-${navKey(row.label)}`}
      data-guild-tab={guildTab(row)}
      data-guildless-label={swapOf(guildTab(row))?.label}
      data-guildless-href={swapOf(guildTab(row))?.href}
      data-guildless-description={swapOf(guildTab(row))?.description}
    >
      <svg
        class="site-panel-icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={NAV_ROW_ICON_PATHS[row.label]}></path>
      </svg>
      <span class="site-panel-text">
        <span class="site-panel-title">
          {isGuild && index === 0 ? <span data-guild-name>{row.label}</span> : row.label}
        </span>
        <span class="site-panel-desc">{row.description}</span>
      </span>
      <span class="site-panel-trail" aria-hidden="true"></span>
    </a>
  ))}
  {group.rows.length === 0 && (
    <div class="site-panel-grid">
      {guideClasses.map((guideClass) => (
        <a
          href={`/guides/${guideClass.slug}`}
          class="site-panel-class"
          role={itemRole}
          style={`--c: ${guideClass.color}`}
          data-testid={`${testScope}-class-${guideClass.slug}`}
        >
          <img
            class="site-panel-crest"
            src={classCrestSrc(guideClass.slug)}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
          />
          <span class="site-panel-text">
            <span class="site-panel-class-name">{guideClass.name}</span>
            <span class="site-panel-desc">{guideClass.specs.join(' · ')}</span>
          </span>
        </a>
      ))}
    </div>
  )}
  {group.foot && (
    <a
      href={group.foot.href}
      class="site-panel-foot"
      role={itemRole}
      data-testid={`${testScope}-foot-${navKey(group.label)}`}
      data-guild-tab={isGuild ? 'settings' : undefined}
      data-guildless-label={isGuild ? swapOf('settings')?.label : undefined}
      data-guildless-href={isGuild ? swapOf('settings')?.href : undefined}
    >
      {group.foot.label}
    </a>
  )}
</Shell>
