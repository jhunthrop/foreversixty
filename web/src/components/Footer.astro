---
// web/src/components/Footer.astro
import communityLinks from '../data/links.json';

const footerLinks = [
  ['About', '/about'],
  ['Sources', '/sources'],
  ['Changelog', '/changelog'],
  ['Contribute', `${communityLinks.githubRepo}/issues`],
] as const;
---
<footer class="mt-auto flex items-center justify-between gap-8 px-12 py-7 border-t border-line text-[13px]">
  <p class="max-w-[720px] leading-relaxed text-muted">Forever Sixty is a fan-run reference. Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft and Warcraft are trademarks of Blizzard Entertainment, Inc.</p>
  <nav class="flex gap-[18px]">
    {footerLinks.map(([label, href]) => <a href={href} class="text-nav hover:text-strong">{label}</a>)}
  </nav>
</footer>
