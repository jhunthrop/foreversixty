---
// web/src/components/Footer.astro
import communityLinks from '../data/links.json';

const footerLinks = [
  ['About', '/about'],
  ['Sources', '/sources'],
  ['Changelog', '/changelog'],
  ['Contribute', `${communityLinks.githubRepo}/issues`],
] as const;
---

<!-- Phone: links above the disclaimer (design/Mobile.dc.html); desktop keeps them side by side. -->
<footer class="mt-auto flex flex-col-reverse md:flex-row md:items-center md:justify-between gap-4 md:gap-8 px-[18px] md:px-12 py-6 md:py-7 border-t border-line text-[13px]">
  <p class="max-w-[720px] leading-relaxed text-muted">
    Forever Sixty is a fan-run reference. Not affiliated with or endorsed by Blizzard Entertainment. World of
    Warcraft and Warcraft are trademarks of Blizzard Entertainment, Inc.
  </p>
  <nav aria-label="Footer" class="flex flex-wrap gap-x-[18px]">
    {footerLinks.map(([label, href]) => (
      <a
        href={href}
        class:list={[
          'inline-flex items-center min-h-11 md:min-h-0 text-nav hover:text-strong',
          // "About" is the one label here short enough (34px) to miss the 44px hit-target
          // floor on its width alone -- the others all clear it on text length. A little
          // horizontal padding, only on this one link, closes the gap without widening
          // every other footer entry to match.
          label === 'About' && 'px-2',
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</footer>
