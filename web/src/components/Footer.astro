---
// web/src/components/Footer.astro
// Round 5's footer, one row as the mock draws it (design/mocks/directions/png/g-home-1440.png):
// their brown-black under a black rule; our painted seal and name in Marcellus, the seven links,
// and at the right the fan-made line. The full trademark sentence and the operator line are on
// /about and /terms (lib/legal-notice.ts). Copy lives in lib/footer-copy.ts. Below lg the row
// wraps: the seal and name, the links, then the line. Every link is a 44 px target on a phone
// (tenet 4).
import { FOOTER_FAN_LINE, FOOTER_LINKS } from '../lib/footer-copy';
import Seal from './Seal.astro';
import { REGION } from '../lib/ui/regions';
import { SITE_NAME } from '../lib/seo';

const LINK_CLASS =
  'inline-flex items-center min-h-11 lg:min-h-8 text-[14px] text-strong/80 transition-colors duration-[120ms] hover:text-gold active:text-gold-hover';
---

<footer data-region={REGION.siteFooter} class="bg-foot mt-auto border-t border-black">
  <div class="page-column flex flex-wrap items-center gap-x-8 gap-y-3 px-[18px] pt-7 pb-8 lg:flex-nowrap lg:py-8">
    <a href="/" class="inline-flex shrink-0 items-center gap-3.5">
      <Seal size={88} class="size-16 lg:size-[88px]" />
      <span class="font-title text-cream-2 text-[24px] leading-none">{SITE_NAME}</span>
    </a>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 lg:gap-x-6">
      {FOOTER_LINKS.map((link) => (
        <a href={link.href} class={LINK_CLASS}>
          {link.label}
        </a>
      ))}
    </nav>
    <p class="text-muted basis-full text-[13px] leading-5 lg:ml-auto lg:basis-auto lg:text-right">
      {FOOTER_FAN_LINE}
    </p>
  </div>
</footer>
