---
// web/src/components/Footer.astro
// design/specs/2026-10-28-polish.md section 2: a brand block beside four labelled link
// columns, the trademark and operator lines small and last. Copy lives in lib/footer-copy.ts.
// Phone: the columns stay a 2 x 2 grid of 44px rows, never one long column (tenet 4).
import {
  FOOTER_COLUMNS,
  FOOTER_CONTRIBUTE_BUTTON,
  FOOTER_DISCORD_BUTTON,
  FOOTER_LEGAL_LINKS,
  FOOTER_PROMISE,
  FOOTER_TRADEMARK,
  footerOperatorLine,
} from '../lib/footer-copy';
import DiscordMark from './DiscordMark.astro';
import GithubMark from './GithubMark.astro';
import Seal from './Seal.astro';

const LINK_CLASS =
  'inline-flex items-center min-h-11 lg:min-h-8 text-[14px] text-nav transition-colors duration-[120ms] hover:text-strong active:text-gold-hover';
const BUTTON_CLASS =
  'inline-flex items-center gap-2 h-11 lg:h-9 px-3.5 rounded-control border border-line-warm-strong bg-raised text-[14px] font-semibold text-strong transition-colors duration-[120ms] hover:border-gold-hover hover:text-gold-hover';
---

<footer class="mt-auto border-t border-white/[.06] bg-[linear-gradient(180deg,rgba(255,255,255,.025),transparent_70%)]">
  <div class="page-column px-[18px]">
    <div class="grid gap-8 pt-9 pb-5 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,4fr)] lg:pt-12 lg:pb-9">
      <div class="flex flex-col">
        <div class="inline-flex items-center gap-2.5">
          <Seal size={30} gradientId="footer-seal" />
          <span class="font-display text-[17px] font-bold tracking-[0.10em] uppercase text-strong">
            Forever Sixty
          </span>
        </div>
        <p class="mt-3.5 max-w-[340px] text-[15px] leading-[22px] text-text">{FOOTER_PROMISE}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={FOOTER_DISCORD_BUTTON.href} class={BUTTON_CLASS}>
            <span class="text-[#9aa4ff]">
              <DiscordMark size={18} />
            </span>
            {FOOTER_DISCORD_BUTTON.label}
          </a>
          <a href={FOOTER_CONTRIBUTE_BUTTON.href} class={BUTTON_CLASS}>
            <GithubMark size={16} />
            {FOOTER_CONTRIBUTE_BUTTON.label}
          </a>
        </div>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-4 gap-y-7 md:grid-cols-4 lg:gap-x-8">
        {FOOTER_COLUMNS.map((column) => (
          <div class="flex min-w-0 flex-col">
            <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-muted">{column.heading}</p>
            {column.links.map((link) => (
              <a href={link.href} class={LINK_CLASS}>
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </div>
    <div class="flex flex-col gap-1 border-t border-line-soft pt-[18px] pb-7 lg:flex-row lg:items-center lg:justify-between">
      <nav aria-label="Legal" class="-mx-2 flex lg:order-last">
        {FOOTER_LEGAL_LINKS.map((link) => (
          <a href={link.href} class={`${LINK_CLASS} px-2 text-[13px]`}>
            {link.label}
          </a>
        ))}
      </nav>
      <div class="text-[12px] leading-[18px] text-muted">
        <p>{FOOTER_TRADEMARK}</p>
        <p>{footerOperatorLine(new Date().getFullYear())}</p>
      </div>
    </div>
  </div>
</footer>
