---
// web/src/components/ForeverChangeList.astro
// The per-row list of Forever changes and their sources. Shared by the Classes and Races
// panels on /classes so the "what changed, and who says so" markup exists in one place.
import SourcePill from './SourcePill.astro';
import type { ForeverChange } from '../lib/planner/types';

interface Props {
  changes: ForeverChange[];
}
const { changes } = Astro.props;
---

{changes.map((change) => (
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-[14px]">{change.text}</span>
    {change.sources.map((source) => (
      <a href={source.url} rel="noreferrer">
        <SourcePill kind={source.kind} label={source.label} />
      </a>
    ))}
  </div>
))}
