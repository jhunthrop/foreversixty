---
// web/src/components/bis/SourceKindIcon.astro
// The source line's own small glyph (tenet 1 applied to a row's source, the same way
// SlotIcon.astro applies it to the row's slot): a quest scroll, a dungeon/raid skull, a
// crafted hammer, a vendor coin, a reputation banner, a map pin for a zone/world drop, and
// crossed swords for PvP -- one shape per `source-cell.ts`'s own `SourceCell['kind']`, so a
// row never repeats the kind as a word twice (the "CRAFTED chip followed by 'Crafted:
// Engineering'" duplication the owner's screenshot review called out). `currentColor`
// throughout, sized to sit inline with the source line's own small text.
interface Props {
  kind: SourceCell['kind'];
  class?: string;
}

import { sourceKindGlyphKey } from '../../lib/bis/glyphs';
import type { SourceCell } from '../../lib/bis/source-cell';

const { kind, class: className = '' } = Astro.props;

const glyphKey = sourceKindGlyphKey(kind);
---

<svg class={`bis-source-kind-icon ${className}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <use href={`#bis-kind-${glyphKey}`} />
</svg>

<style is:global>
  /* `is:global` (deploy-gate LCP fix, 2026-09-30): see VerifiedGlyph.astro's own note --
     same trade, same guarantee (selector stays namespaced under this component's own
     class, so nothing broadens). */
  .bis-source-kind-icon {
    flex-shrink: 0;
    opacity: 0.75;
    /* width/height/fill/stroke/stroke-width/stroke-linecap/stroke-linejoin used to be
       attributes on every one of this glyph's instances (every row's source line, every
       alternative's source line) -- none of it varies per instance, so it moved here
       (deploy-gate LCP fix, 2026-09-30). `focusable="false"` and `aria-hidden="true"` stay
       as attributes: real per-browser/AT behaviour, not styling. */
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
