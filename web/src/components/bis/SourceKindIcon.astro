---
// web/src/components/bis/SourceKindIcon.astro
// The source line's own small glyph (tenet 1 applied to a row's source, the same way
// SlotIcon.astro applies it to the row's slot): a quest scroll, a dungeon/raid skull, a
// crafted hammer, a vendor coin, a reputation banner, a map pin for a zone/world drop, and
// crossed swords for PvP -- one shape per `source-cell.ts`'s own `SourceCell['kind']`, so a
// row never repeats the kind as a word twice (the "CRAFTED chip followed by 'Crafted:
// Engineering'" duplication the owner's screenshot review called out). `currentColor`
// throughout, sized to sit inline with the source line's own small text.
interface Props {
  kind: 'quest' | 'dungeon' | 'raid' | 'crafted' | 'vendor' | 'rep' | 'zone' | 'world' | 'pvp' | 'unknown';
  class?: string;
}

import { sourceKindGlyphKey } from '../../lib/bis/glyphs';

const { kind, class: className = '' } = Astro.props;

const glyphKey = sourceKindGlyphKey(kind);
---

<svg
  class={`bis-source-kind-icon ${className}`}
  width="13"
  height="13"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <use href={`#bis-kind-${glyphKey}`} />
</svg>

<style>
  .bis-source-kind-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }
</style>
