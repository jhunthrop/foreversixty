---
// web/src/components/bis/SourceKindIcon.astro
// The source line's own small glyph (tenet 1 applied to a row's source, the same way
// SlotIcon.astro applies it to the row's slot): a quest scroll, a dungeon/raid skull, a
// crafted hammer, a vendor coin, a reputation banner, a map pin for a zone/world drop, and
// crossed swords for PvP -- one shape per `source-cell.ts`'s own `SourceCell['kind']`, so a
// row never repeats the kind as a word twice (the "CRAFTED chip followed by 'Crafted:
// Engineering'" duplication the owner's screenshot review called out). `currentColor`
// throughout, sized to sit inline with the source line's own small text.
interface Props {
  kind: 'quest' | 'dungeon' | 'raid' | 'crafted' | 'vendor' | 'rep' | 'zone' | 'world' | 'pvp' | 'unknown';
  class?: string;
}

const { kind, class: className = '' } = Astro.props;

const PATHS: Record<string, string> = {
  quest: 'M6 3h9l3 3v15H6V3ZM15 3v3h3 M9 10h6M9 13h6M9 16h4',
  dungeon:
    'M12 3a6 6 0 0 1 6 6c0 3-2 4-2 6H8c0-2-2-3-2-6a6 6 0 0 1 6-6ZM9 17h6l-1 4H10l-1-4ZM9.5 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM14.5 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  crafted: 'M14 3 21 10l-2.5 2.5L11 5 14 3ZM11 5 4 12l1.5 4.5L10 18l7-7 M4.5 19.5l3-1-2-2-1 3Z',
  vendor: 'M12 2a4 4 0 0 1 4 4v2H8V6a4 4 0 0 1 4-4ZM6 8h12l1 12H5L6 8ZM10 12v2M14 12v2',
  rep: 'M6 3h12v10l-6 8-6-8V3ZM9 8h6M9 11h6',
  zone: 'M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12ZM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  pvp: 'M4 5l8 8M20 5l-8 8M4 19l6-6M20 19l-6-6M4 5l3-1M20 5l-3-1M4 19l3 1M20 19l-3 1',
};

const glyph = PATHS[kind === 'raid' ? 'dungeon' : kind === 'world' ? 'zone' : kind] ?? PATHS.zone;
---

<svg
  class={`bis-source-kind-icon ${className}`}
  width="13"
  height="13"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={`<path d="${glyph}" />`}
/>

<style>
  .bis-source-kind-icon {
    flex-shrink: 0;
    opacity: 0.75;
  }
</style>
