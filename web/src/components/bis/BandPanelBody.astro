---
// web/src/components/bis/BandPanelBody.astro
// One band's three-panel row, "The list" and footer -- the part of a /bis band panel that
// differs by preset. The page renders it once per preset a band offers (level 60), so
// `testSuffix` keeps the non-default copy's test ids distinct.
import ThisSetPanel from './ThisSetPanel.astro';
import HealerSetPanel from './HealerSetPanel.astro';
import StatWeightsPanel from './StatWeightsPanel.astro';
import PlayItPanel from './PlayItPanel.astro';
import GearRow from './GearRow.astro';
import { bisCopy } from '../../lib/bis/copy';
import { bandTopLevel } from '../../lib/bis/rotation-view';
import type { BandView } from '../../lib/bis/band-view';
import type { Faction } from '../../lib/bis/types';

interface Props {
  view: BandView;
  faction: Faction;
  specName: string;
  guideHref: string;
  build: string;
  testSuffix?: string;
}

const { view, faction, specName, guideHref, build, testSuffix = '' } = Astro.props;
---

<section class="three-panel-row">
  {view.info.healer !== undefined ? (
    <HealerSetPanel
      healer={view.info.healer}
      characterLevel={bandTopLevel(view.band)}
      race={view.info.race}
      talentPoints={view.info.talentPoints}
      generatedAtDate={view.generatedAtDate}
      plannerHref={view.plannerHref}
    />
  ) : (
    <ThisSetPanel
      setDps={view.info.setDps}
      characterLevel={bandTopLevel(view.band)}
      race={view.info.race}
      talentPoints={view.info.talentPoints}
      generatedAtDate={view.generatedAtDate}
      simHref={view.simHref}
      plannerHref={view.plannerHref}
    />
  )}
  <StatWeightsPanel
    bandLabel={view.bandLabel}
    scaleRows={view.info.scaleRows}
    scaleNoteLine={view.info.scaleNoteLine}
    hasteCaptionLine={view.info.hasteCaptionLine}
    hitCap={view.info.hitCap}
    unit={view.info.unit}
    testId={`bis-weights-${faction}-${view.band}${testSuffix}`}
  />
  <PlayItPanel
    bandLabel={view.bandLabel}
    lines={view.rotationLines}
    specName={specName}
    guideHref={guideHref}
    build={build}
  />
</section>

<section class="the-list-section">
  <div class="the-list-heading-row">
    <h2 class="section-title">{bisCopy.theListHeading}</h2>
    <span class="text-muted text-[12px]">{bisCopy.hoverOrTapCaption}</span>
  </div>
  <div class="panel-box the-list-panel">
    {/* No `role="row"` here (a11y fix, 2026-09-30): the rows below are a
                            plain `<ul>` of `<li>` cards (`GearRow.astro`), never ARIA
                            `row`/`cell`s -- a lone `role="row"` with no table/rowgroup
                            ancestor and no sibling row structure is exactly the broken
                            half-pattern axe's `aria-required-parent`/`aria-required-children`
                            flag, and the mobile breakpoint collapses this into a single
                            stacked column anyway, so a real ARIA table here would describe
                            a structure that stops existing at 1024px. The three column
                            labels stay plain, visible text -- sighted users lose nothing. */}
    <div class="the-list-header">
      <span class="label">{bisCopy.slotHeaderLabel}</span>
      <span class="label">{bisCopy.pickHeaderLabel}</span>
      <span class="label">{bisCopy.runnersUpHeaderLabel(view.info.unit)}</span>
    </div>
    <ul class="the-list-rows" data-testid={`bis-list-${faction}-${view.band}${testSuffix}`}>
      {view.info.rows.map((row) => (
        <GearRow
          row={row}
          isNew={view.info.newSlots.has(row.slot)}
          build={build}
          faction={faction}
          unit={view.info.unit}
          slotTestId={`bis-slot-${faction}-${view.band}${testSuffix}-${row.slot}`}
        />
      ))}
    </ul>
  </div>
</section>

<section class="footer-row">
  <div class="footer-col">
    <h2 class="section-title">{bisCopy.whereToGetItHeading}</h2>
    <div
      class="panel-box footer-groups-panel"
      data-testid={`bis-source-groups-${faction}-${view.band}${testSuffix}`}
    >
      {view.sourceGroups.map((group) => (
        <div class="footer-group">
          <span class="footer-group-name">
            {group.label}{' '}
            <span class="font-mono tabular footer-group-count">
              {bisCopy.groupCountSuffix(group.items.length)}
            </span>
          </span>
          <span class="footer-group-items">
            {group.items.map((item) => (
              <span
                class="footer-group-item"
                data-bis-item={item.itemId}
                tabindex="0"
                role="button"
                aria-haspopup="true"
              >
                {item.itemName}
              </span>
            ))}
          </span>
        </div>
      ))}
    </div>
  </div>
  <div class="footer-col">
    <h2 class="section-title">{bisCopy.newAtThisBandHeading}</h2>
    <div class="new-at-band-card" data-testid={`bis-new-at-band-${faction}-${view.band}${testSuffix}`}>
      <p class="new-at-band-line">{view.newAtBand.sentence1}</p>
      {view.newAtBand.sentence2 !== undefined && (
        <p class="text-muted new-at-band-line">{view.newAtBand.sentence2}</p>
      )}
      {view.nextBand !== undefined && (
        <a class="new-at-band-see-link" href={`#band-${faction}-${view.nextBand}`}>
          {bisCopy.seeBandLink(view.nextBandLabel!)}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .three-panel-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    padding: 28px 48px 0 48px;
  }

  .the-list-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 48px 0 48px;
  }
  .the-list-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .panel-box {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .the-list-panel {
    padding: 4px 20px 6px 20px;
  }
  .the-list-header {
    display: grid;
    grid-template-columns: 90px 1fr 1fr;
    gap: 16px;
    padding: 12px 0 6px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .the-list-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    align-items: start;
    padding: 28px 48px 28px 48px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-groups-panel {
    display: flex;
    flex-direction: column;
    padding: 4px 20px 8px 20px;
  }
  .footer-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .footer-group:last-child {
    border-bottom: none;
  }
  .footer-group-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-strong);
  }
  .footer-group-count {
    color: var(--color-muted);
    font-weight: 500;
  }
  .footer-group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .footer-group-item {
    font-size: 13px;
    cursor: pointer;
  }
  .new-at-band-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    background: var(--color-card-top);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .new-at-band-line {
    margin: 0;
    font-size: 13px;
    color: var(--color-nav);
  }
  .new-at-band-see-link {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  @media (max-width: 1023px) {
    .three-panel-row {
      grid-template-columns: 1fr;
      padding: 22px 18px 0 18px;
      gap: 22px;
    }
    .the-list-section,
    .footer-row {
      padding: 22px 18px 0 18px;
    }
    .footer-row {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-bottom: 22px;
    }
    .the-list-header {
      display: none;
    }
  }
</style>
