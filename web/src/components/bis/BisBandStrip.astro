---
// web/src/components/bis/BisBandStrip.astro
// The /bis landing's band strip (design/specs/2026-10-10-bis-landing.md section 2.3), now the
// "Level range" Card (site alignment 5.2): says where the spec links open. The five pills are links to
// `?band=` for no-script and a radiogroup with the page script; the selected pill (gold) rewrites
// every spec link's band and nothing above the grid. The character's own band is marked inside
// its pill (the word `you` from 480px, a gold dot below) by the page script. Every pill has a
// caption computed at build time from the BiS files.
import { DEFAULT_LANDING_BAND, type BandCaption } from '../../lib/bis/landing-bands';
import { landingCopy } from '../../lib/bis/landing-copy';
import Card from '../ui/Card.astro';

interface Props {
  captions: BandCaption[];
  /** The raid preset's label as the note reads it mid-sentence, "raid-ready, Phase 1". */
  raidLabel: string;
}

const { captions, raidLabel } = Astro.props;
---

<Card
  glyph="layers"
  title={landingCopy.stripTitle}
  meta={landingCopy.stripHead}
  testid="bis-band-strip"
  class="strip"
>
  <p class="strip-note" data-testid="bis-strip-note">
    {landingCopy.stripNote(raidLabel)}
  </p>
  <div class="strip-bands" data-bis-strip role="radiogroup" aria-label={landingCopy.bandGroupLabel}>
    {captions.map((caption) => {
      const selected = caption.band === DEFAULT_LANDING_BAND;
      return (
        <div class="col" data-band-col={caption.band} data-selected={selected ? 'true' : undefined}>
          <a
            class="pb"
            href={`/bis?band=${caption.band}`}
            role="radio"
            aria-checked={selected ? 'true' : 'false'}
            aria-current={selected ? 'true' : undefined}
            data-band-pill={caption.band}
            data-testid={`bis-landing-band-${caption.band}`}
          >
            <span class="pb-label">{caption.label}</span>
            <span class="pb-you" aria-hidden="true">
              {landingCopy.you}
            </span>
            <i class="pb-dot" aria-hidden="true" />
          </a>
          <span
            class:list={['cap', caption.same && 'cap-same']}
            data-testid={`bis-landing-band-caption-${caption.band}`}
          >
            {caption.text}
          </span>
        </div>
      );
    })}
  </div>
</Card>

<style>
  .strip-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-muted);
  }
  /* The SegmentedControl recipe (polish 4.2): a 3 px padded track, 44 px segments, the checked one
     a 16% gold ground with a 1 px gold inset border. Pills sit in grid row 1, their captions in
     row 2; the track is drawn behind row 1 only (an absolute layer, so it takes no grid cell). */
  .strip-bands {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    row-gap: 8px;
  }
  .strip-bands::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 52px;
    border: 1px solid var(--color-line-card);
    border-radius: var(--radius-control);
    background: var(--color-raised);
  }
  .col {
    display: contents;
  }
  .pb {
    grid-row: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 44px;
    margin: 4px;
    z-index: 1;
    border-radius: calc(var(--radius-control) - 2px);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-strong);
    white-space: nowrap;
    transition:
      color 120ms ease-out,
      background-color 120ms ease-out,
      box-shadow 120ms ease-out;
  }
  .pb-you {
    display: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .pb-dot {
    display: none;
    position: absolute;
    top: 5px;
    right: 5px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-gold);
  }
  .pb:hover {
    background: var(--color-row-hover);
  }
  .pb:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 1px;
  }
  .pb[aria-current='true'] {
    color: var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 16%, transparent);
    box-shadow: inset 0 0 0 1px rgb(229 185 85 / 55%);
  }
  .cap {
    grid-row: 2;
    padding: 0 6px;
    font-size: 12px;
    line-height: 1.35;
    color: var(--color-text);
  }
  .cap-same {
    color: var(--color-muted);
  }
  /* The character's band: the word from 480px, a corner dot below. */
  .pb[data-you] .pb-you {
    display: inline;
  }

  @media (max-width: 899px) {
    /* Only the selected band's caption shows, across the full width under the control. */
    .cap {
      display: none;
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 0;
      font-size: 13px;
    }
    .col[data-selected='true'] .cap {
      display: block;
    }
  }
  @media (max-width: 559px) {
    /* Two rows (3 + 2), every segment 44 px, the label never touching an edge. */
    .strip-bands {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .strip-bands::before {
      height: 104px;
    }
    .pb {
      grid-row: auto;
    }
    .cap {
      grid-row: 3;
    }
  }
  @media (max-width: 479px) {
    .pb[data-you] .pb-you {
      display: none;
    }
    .pb[data-you] .pb-dot {
      display: block;
    }
  }
</style>
