---
// web/src/components/bis/BisBandStrip.astro
// The /bis landing's band strip (design/specs/2026-10-10-bis-landing.md section 2.3): one compact
// row, the grid's own header, that says where the spec links open. The five pills are links to
// `?band=` for no-script and a radiogroup with the page script; the selected pill (gold) rewrites
// every spec link's band and nothing above the grid. The character's own band is marked inside
// its pill (the word `you` from 480px, a gold dot below) by the page script. Every pill has a
// caption computed at build time from the BiS files.
import { DEFAULT_LANDING_BAND, type BandCaption } from '../../lib/bis/landing-bands';
import { landingCopy } from '../../lib/bis/landing-copy';

interface Props {
  captions: BandCaption[];
  /** The raid preset's label as the note reads it mid-sentence, "raid-ready, Phase 1". */
  raidLabel: string;
}

const { captions, raidLabel } = Astro.props;
---

<div class="strip" data-bis-strip data-testid="bis-band-strip">
  <div class="strip-text">
    <p class="strip-head" data-testid="bis-strip-head">
      {landingCopy.stripHead}
    </p>
    <p class="strip-note" data-testid="bis-strip-note">
      {landingCopy.stripNote(raidLabel)}
    </p>
  </div>
  <div class="strip-bands" role="radiogroup" aria-label={landingCopy.bandGroupLabel}>
    {captions.map((caption) => {
      const selected = caption.band === DEFAULT_LANDING_BAND;
      return (
        <div class="col" data-band-col={caption.band} data-selected={selected ? 'true' : undefined}>
          <a
            class="pb"
            href={`/bis?band=${caption.band}`}
            role="radio"
            aria-checked={selected ? 'true' : 'false'}
            aria-current={selected ? 'true' : undefined}
            data-band-pill={caption.band}
            data-testid={`bis-landing-band-${caption.band}`}
          >
            <span class="pb-label">{caption.label}</span>
            <span class="pb-you" aria-hidden="true">
              {landingCopy.you}
            </span>
            <i class="pb-dot" aria-hidden="true" />
          </a>
          <span
            class:list={['cap', caption.same && 'cap-same']}
            data-testid={`bis-landing-band-caption-${caption.band}`}
          >
            {caption.text}
          </span>
        </div>
      );
    })}
  </div>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: 440px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 14px 18px;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .strip-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .strip-head {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-strong);
  }
  .strip-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .strip-bands {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .cap {
    font-size: 12px;
    line-height: 1.35;
    color: #c9c2b2;
  }
  .cap-same {
    color: var(--color-muted);
  }
  .pb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-nav);
    white-space: nowrap;
    transition:
      color 120ms ease-out,
      border-color 120ms ease-out,
      background-color 120ms ease-out;
  }
  .pb-you {
    display: none;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .pb-dot {
    display: none;
    position: absolute;
    top: 5px;
    right: 5px;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-gold);
  }
  .pb:hover {
    color: var(--color-strong);
    border-color: var(--color-line-warm-strong);
  }
  .pb:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .pb:active {
    background: #0a0d15;
    color: #fff;
    border-color: var(--color-line-warm-strong);
  }
  .pb[aria-current='true'] {
    border-color: var(--color-gold);
    color: var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 8%, transparent);
  }
  .pb[aria-current='true']:hover {
    border-color: var(--color-gold-hover);
    color: var(--color-gold-hover);
    background: color-mix(in srgb, var(--color-gold) 14%, transparent);
  }
  .pb[aria-current='true']:active {
    background: color-mix(in srgb, var(--color-gold) 4%, transparent);
  }
  /* The character's band: the word from 480px, a corner dot below. */
  .pb[data-you] .pb-you {
    display: inline;
  }

  @media (max-width: 899px) {
    /* Stacked: head line, the five pills in one row, the selected band's caption, then the note. */
    .strip {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 14px 16px;
    }
    .strip-text {
      display: contents;
    }
    .strip-head {
      order: 1;
    }
    .strip-bands {
      order: 2;
      gap: 3px;
      row-gap: 10px;
    }
    .strip-note {
      order: 3;
    }
    .col {
      display: contents;
    }
    .cap {
      display: none;
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 13px;
    }
    .col[data-selected='true'] .cap {
      display: block;
    }
    .pb {
      font-size: 12px;
      letter-spacing: -0.04em;
    }
  }
  @media (max-width: 479px) {
    .strip {
      padding: 14px 10px;
    }
    .pb[data-you] .pb-you {
      display: none;
    }
    .pb[data-you] .pb-dot {
      display: block;
    }
  }
</style>
