---
// web/src/components/bis/VerifiedGlyph.astro
// The small gold check mark a verified pick's name line shows -- confirmed by a real Top
// Gear sim pass, not just ranked by weights. Also reused on a `verified: true`
// alternative's own delta (fix round 1, wow-player review 2026-09-29: the ranker now
// publishes `verified` on the one alternative it actually simmed against the pick), so the
// same glyph means the same thing everywhere it appears rather than inventing a second
// "confirmed" mark for the same fact.
import { bisCopy } from '../../lib/bis/copy';

interface Props {
  /** Square size in px -- 13 by default (the main pick's own name-line glyph); the alt
   *  row's own delta passes a smaller size to match its 11px text. */
  size?: number;
  /** Overrides the default "confirmed by a Top Gear pass" title -- the main pick's own
   *  glyph passes a sim-DPS-specific title (`panel-view.ts`'s `verifiedGlyphTitleFor`) when
   *  the row has real sim evidence but no swap narrative to name. */
  title?: string;
  /** True for a purely decorative reuse -- the evidence line's own prefix icon, where the
   *  adjacent text already states the fact this glyph means, so it carries no accessible
   *  name of its own rather than making a screen reader announce the same sentence twice. */
  decorative?: boolean;
}

const { size = 13, title = bisCopy.verifiedGlyphTitle, decorative = false } = Astro.props;
---

<span
  class="verified-glyph"
  title={decorative ? undefined : title}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : title}
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <use href="#bis-verified" />
  </svg>
</span>

<style>
  .verified-glyph {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    color: var(--color-gold, #c9a35e);
  }
</style>
