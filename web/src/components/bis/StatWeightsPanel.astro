---
// web/src/components/bis/StatWeightsPanel.astro
// "Stat weights at {band label}" (bis rebuild spec §4.C.2) -- the design system's own
// SimulationCraft-familiar convention, in Forever Sixty's own words. Reads the view-model
// `lib/bis/panel-view.ts`'s `bandInfosFor` already computes (`scaleRows`/`scaleNoteLine`/
// `hasteCaptionLine`, landed on main by the bis-weights-simc lane, merged into this branch)
// rather than a second stat-weights formula: this component's own job is the mock's exact
// 4-column table layout (Stat / bar / Scale / Per point / Error) that view-model's own
// interim page render did not yet use, one component so a later merge only has to reconcile
// markup, never two competing sets of numbers.
//
// The addon button's own `/addon` href is NOT a live Astro route -- `check-no-removed-
// routes.mjs` (postbuild) fails the build if `dist/addon.html` exists at all, since spec
// 2026-09-25 §3.4 replaced that page with `/setup`. `/addon` still works as a link target
// site-wide (`ImportBox.svelte`/`SourceSwitcher.svelte` already link to it the same way)
// because `public/_redirects` 301s it to `/setup` at the CDN, the one place that
// redirect lives; a second Astro page at this path would shadow that rule, which is
// exactly what tripped the postbuild guard when this lane first tried it.
import { bisCopy } from '../../lib/bis/copy';
import type { HitCapLine } from '../../lib/bis/hit-cap';
import type { ScaleRow } from '../../lib/bis/panel-view';
import type { RateUnit } from '../../lib/bis/types';
import { SECONDARY_BUTTON } from '../../lib/planner/styles';

interface Props {
  bandLabel: string;
  scaleRows: ScaleRow[];
  scaleNoteLine: string;
  hasteCaptionLine: string | undefined;
  /** Absent when the band publishes no `hit_to_cap`: the line is then not rendered at all. */
  hitCap?: HitCapLine | undefined;
  /** `bis-weights-<faction>-<band>` -- assembled by the caller, which alone knows the
   *  faction and band this panel belongs to (one instance per band/faction pair renders on
   *  the page, so the generic `bis-stat-weights` class name alone is not unique -- same
   *  pattern as `GearRow`'s own caller-assembled `slotTestId`). */
  testId: string;
  /** `HPS` on a healer band: the "Per point" column's unit. */
  unit?: RateUnit;
}

const { bandLabel, scaleRows, scaleNoteLine, hasteCaptionLine, hitCap, testId, unit = 'DPS' } = Astro.props;
const caption = hasteCaptionLine === undefined ? scaleNoteLine : `${scaleNoteLine} ${hasteCaptionLine}`;
---

<div class="panel-box stat-weights-panel" data-testid={testId}>
  <span class="label">{bisCopy.statWeightsAtBand(bandLabel)}</span>
  <p class="stat-weights-caption text-muted">{caption}</p>
  <div class="stat-weights-table" role="table">
    <div class="stat-weights-header" role="row">
      <span class="label" role="columnheader">
        Stat
      </span>
      <span aria-hidden="true"></span>
      <span class="label stat-weights-num-header" role="columnheader">
        Scale
      </span>
      <span class="label stat-weights-num-header" role="columnheader">
        Per point
      </span>
      <span class="label stat-weights-num-header" role="columnheader">
        Error
      </span>
    </div>
    {scaleRows.map((row) => (
      <div
        class:list={['stat-weights-row', !row.significant && 'stat-weights-row-faint']}
        role="row"
        title={row.significant ? row.ratingFactorTitle : `${row.label} not significant`}
        data-testid={`bis-weight-row-${row.stat}`}
      >
        <span class="stat-weights-stat" role="cell">
          {row.label}
        </span>
        <span class="stat-weights-bar" aria-hidden="true">
          {row.significant && <span class="stat-weights-bar-fill" style={`width:${row.barPercent}%`} />}
        </span>
        <span class="font-mono tabular stat-weights-num" role="cell">
          {row.significant ? row.scaleFactor.toFixed(2) : bisCopy.weightsNotSignificant}
        </span>
        <span class="font-mono tabular stat-weights-num stat-weights-num-muted" role="cell">
          {row.significant && row.dpsPerPoint !== undefined ? `${row.dpsPerPoint.toFixed(3)} ${unit}` : ''}
        </span>
        <span class="font-mono tabular stat-weights-num stat-weights-num-muted" role="cell">
          {row.significant ? `±${row.scaleError.toFixed(2)}` : ''}
        </span>
      </div>
    ))}
  </div>
  {hitCap !== undefined && (
    <p class="stat-weights-hit-cap text-muted" title={hitCap.title} data-testid={`${testId}-hit-cap`}>
      {hitCap.text}
    </p>
  )}
  <p class="stat-weights-addon-blurb text-muted">{bisCopy.weightsAddonBlurb}</p>
  <a
    href="/addon"
    class={`${SECONDARY_BUTTON} border-line-warm text-text justify-center px-4`}
    data-testid="bis-weights-addon-button"
  >
    {bisCopy.weightsAddonButton}
  </a>
</div>

<style>
  .panel-box {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
  }
  .stat-weights-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 20px;
  }
  .stat-weights-caption {
    margin: 0 0 4px;
    font-size: 12px;
  }
  /* `display:contents` (the same convention `TreeGrid.svelte`'s own `role="row"` wrapper
     already uses): the ARIA table role needs a real element to sit on, but generates no box
     of its own, so the header/row divs below stay direct flex children of `.stat-weights-
     panel`, exactly as before this element existed. */
  .stat-weights-table {
    display: contents;
  }
  .stat-weights-header,
  .stat-weights-row {
    display: grid;
    grid-template-columns: 140px 1fr 56px 70px 56px;
    gap: 10px;
    align-items: center;
  }
  .stat-weights-header {
    padding-bottom: 6px;
  }
  .stat-weights-num-header {
    text-align: right;
  }
  .stat-weights-row-faint {
    opacity: 0.5;
  }
  .stat-weights-stat {
    font-size: 13px;
    color: var(--color-strong);
    line-height: 1.2;
  }
  .stat-weights-bar {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--color-line-soft);
    overflow: hidden;
  }
  .stat-weights-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--color-gold);
  }
  .stat-weights-num {
    text-align: right;
    font-size: 13px;
    color: var(--color-strong);
  }
  .stat-weights-num-muted {
    font-size: 11px;
    color: var(--color-muted);
  }
  .stat-weights-hit-cap {
    margin: 4px 0 0;
    font-size: 12px;
    cursor: help;
  }
  .stat-weights-addon-blurb {
    margin: 4px 0 0;
    font-size: 12px;
  }

  @media (max-width: 1023px) {
    .stat-weights-header,
    .stat-weights-row {
      grid-template-columns: 90px 1fr 48px 60px 48px;
      gap: 6px;
    }
  }
</style>
