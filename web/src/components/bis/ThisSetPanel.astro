---
// web/src/components/bis/ThisSetPanel.astro
// "This set" (bis rebuild spec §4.C.1) -- the DPS figure tenet 14 calls the phone's one
// answer needing zero scroll. `characterLevel` is the band's own training-dummy level
// (`sim/cmd/leveling-bis/leveling-bis` fixes it per band), never a signed-in character's
// real level -- the two are unrelated facts that happen to coincide in the mock's own
// worked example (spec's own explicit warning).
import { bisCopy, tankCopy } from '../../lib/bis/copy';
import { button } from '../../lib/ui/button';
import StatTile from '../ui/StatTile.svelte';
import type { TankHeadline } from '../../lib/bis/tank-view';
import Card from '../ui/Card.astro';

interface Props {
  setDps: number;
  characterLevel: number;
  race: string;
  talentPoints: number;
  generatedAtDate: string;
  simHref: string;
  plannerHref: string;
  /** A tank band's headline: shown in place of the DPS figure when present. */
  tank?: TankHeadline | undefined;
}

const { setDps, characterLevel, race, talentPoints, generatedAtDate, simHref, plannerHref, tank } =
  Astro.props;
---

<Card
  glyph="bolt"
  title={bisCopy.thisSetLabel}
  meta={bisCopy.simmedLine(generatedAtDate)}
  compact
  testid="bis-this-set"
>
  <div class="this-set-panel">
    {tank === undefined ? (
      <StatTile
        value={setDps.toFixed(1)}
        label={bisCopy.thisSetFigureLine(characterLevel, race, talentPoints)}
        figureTestid="bis-this-set-figure"
      />
    ) : (
      <>
        <span class="tank-figures">
          {tank.figures.map((figure) => (
            <span class="tank-figure" title={figure.title} data-testid={`bis-tank-figure-${figure.id}`}>
              <span class="tank-figure-label">{figure.label}</span>
              <span class="numeric tank-figure-value">{figure.value}</span>
            </span>
          ))}
        </span>
        <span class="this-set-figure-caption" title={tank.secondaryTitle} data-testid="bis-tank-secondary">
          {tank.secondaryLine}
        </span>
        <span class="this-set-figure-caption">{tankCopy.figureLine(characterLevel, race, talentPoints)}</span>
      </>
    )}
    <span class="this-set-actions">
      <a class={button('secondary', 'sm')} href={simHref}>
        {bisCopy.openInSimulator}
      </a>
      <a class={button('secondary', 'sm')} href={plannerHref}>
        {bisCopy.talentsInPlanner}
      </a>
    </span>
  </div>
</Card>

<style>
  .this-set-panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .this-set-figure-caption {
    font-size: 13px;
    color: var(--color-muted);
  }
  .tank-figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
  }
  .tank-figure {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tank-figure-label {
    font-size: 12px;
    color: var(--color-muted);
  }
  .tank-figure-value {
    font-size: 22px;
    color: var(--color-strong);
  }
  .this-set-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
</style>
