---
// web/src/components/bis/GlyphSheet.astro
// One hidden <svg> of <symbol>s for every glyph the BiS page draws (lib/bis/glyphs.ts);
// SlotIcon / SourceKindIcon and the verified check mark reference them with <use>, so a
// page with hundreds of rows carries each path once. Included once per page, before the
// first row.
import { SLOT_GLYPH_PATHS, SOURCE_KIND_GLYPH_PATHS, VERIFIED_GLYPH_PATH } from '../../lib/bis/glyphs';
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  {Object.entries(SLOT_GLYPH_PATHS).map(([key, d]) => (
    <symbol id={`bis-slot-${key}`} viewBox="0 0 24 24">
      <path d={d} />
    </symbol>
  ))}
  {Object.entries(SOURCE_KIND_GLYPH_PATHS).map(([key, d]) => (
    <symbol id={`bis-kind-${key}`} viewBox="0 0 24 24">
      <path d={d} />
    </symbol>
  ))}
  <symbol id="bis-verified" viewBox="0 0 24 24">
    <path d={VERIFIED_GLYPH_PATH} />
  </symbol>
</svg>
