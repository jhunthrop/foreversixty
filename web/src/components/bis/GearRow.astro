---
// web/src/components/bis/GearRow.astro
// "The list"'s own per-slot row (bis rebuild spec §4.D) -- extended from the character-
// panel redesign's row (lane bis-character-panel, 2026-09-29), not forked: the same pick/
// alternatives/flags markup, now laid out as the design system's Pick row grid (`90px /
// 1fr / 300px / 190px`, the last column collapsing away entirely while the `you` prop is
// absent -- see below) instead of the paperdoll's flex column. Two changes from that
// version: the lead glyph is gone in favour of the plain 90px slot label the design system
// asks for (a second small icon next to the pick's own 40px one is redundant, tenet 11), and
// the alternatives list is its own grid column beside the pick rather than stacked under it.
import type { RowView } from '../../lib/bis/panel-view';
import { bisCopy } from '../../lib/bis/copy';
import { dataUrl } from '../../lib/planner/load';
import { rarityBorderColorFor, rarityClassFor } from '../../lib/planner/items';
import type { Slot } from '../../lib/planner/types';
import { SLOT_DISPLAY_LABELS } from '../../lib/bis/slot-display-labels';
import type { Faction } from '../../lib/bis/types';
import { gapLabelFor } from '../../lib/bis/tank-view';
import FactionMark from '../FactionMark.astro';
import SourceKindIcon from './SourceKindIcon.astro';
import VerifiedGlyph from './VerifiedGlyph.astro';

/** The row's own gain-over-worn-gear column (design system's Pick row: "a 'You' column
 *  with the gain over what you wear or an 'equipped' tick") -- always `undefined` today,
 *  the same blocked-on-worn-gear-data gap §4.B's Character card names (spec §9, out of
 *  scope). Typed and threaded through now so a future lane that closes that gap only has
 *  to start passing it, never fork this component to add it. */
export type YouView = { kind: 'equipped' } | { kind: 'delta'; wornItemName: string; dpsDelta: number };

interface Props {
  row: RowView;
  isNew: boolean;
  build: string;
  you?: YouView;
  /** This band's own faction -- a `rep`-kind source line's own emblem (spec §7: "16px in a
   *  row descriptor") shows the band's faction, since a rep-kind pick only ever appears in
   *  that faction's own panel. */
  faction: Faction;
  /** `bis-slot-<faction>-<band>-<slot>` -- assembled by the caller, which alone knows the
   *  faction and band this row belongs to. */
  slotTestId: string;
}

const { row, isNew, build, you, faction, slotTestId } = Astro.props;

// `inv_misc_questionmark` is the item pipeline's own placeholder for an id it has no real
// icon for -- the client's literal red-bordered "?" texture, and the exact icon the owner's
// screenshot review named (tenet 4: "never a red '?' icon"). A row with it falls back to
// the same neutral slot glyph an unresolved item gets.
function hasRealIcon(icon: string | undefined): icon is string {
  return icon !== undefined && icon !== 'inv_misc_questionmark';
}

const slotLabel = SLOT_DISPLAY_LABELS[row.slot as Slot] ?? row.slot;
---

<li
  class:list={['gear-row-list', isNew && 'gear-row-new', you !== undefined && 'gear-row-list-4col']}
  data-testid={slotTestId}
>
  <span class="gear-row-slot-label">{slotLabel}</span>
  {row.empty ? (
    <div class="gear-row-empty">
      <span class="gear-row-icon gear-row-icon-empty rounded-control border" aria-hidden="true" />
      <span class="text-muted text-[12px]">{row.emptyCopy}</span>
    </div>
  ) : (
    <Fragment>
      <div class="gear-row-pick">
        <span class="gear-row-item">
          {/* `display: contents` (below): a pure hover-delegation wrapper, not a layout
              box -- an `<img>` cannot itself be `data-bis-item`'s host, since
              `BisTooltipHost.svelte` mounts the tooltip panel INTO its host element, and a
              void `<img>` never renders a mounted child. Wrapping it like this gives the
              icon's own pixels the same tooltip the name gets (hover-scope fix,
              2026-09-30: "the trigger wraps exactly the icon and the name") without this
              span ever generating a box of its own -- the icon sits exactly where it did
              before, a direct flex item of `.gear-row-item`, in the layout's eyes. */}
          <span class="gear-row-icon-trigger" data-bis-item={row.itemId}>
            {hasRealIcon(row.model?.icon) ? (
              <img
                src={dataUrl(build, `icons/${row.model!.icon}.webp`)}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="gear-row-icon rounded-control border object-cover"
                style={`border-color:${rarityBorderColorFor(row.model?.quality ?? 1)}`}
              />
            ) : (
              <span
                class="gear-row-icon gear-row-icon-placeholder rounded-control border"
                style={`border-color:${rarityBorderColorFor(row.model?.quality ?? 1)}`}
                aria-hidden="true"
              />
            )}
          </span>
          <span class="gear-row-content">
            <span
              class="gear-row-name-line"
              data-testid={`item-hover-${row.itemId}`}
              data-bis-item={row.itemId}
              tabindex="0"
              role="button"
              aria-haspopup="true"
            >
              <span class="sr-only">{slotLabel}:</span>
              <span class:list={['gear-row-name', rarityClassFor(row.model?.quality ?? 1)]}>
                {row.itemName}
              </span>
              {isNew && (
                <span
                  class="gear-row-new-pill"
                  data-testid="bis-row-new"
                  title={bisCopy.newPillTitle(row.replacedName)}
                >
                  {bisCopy.newPillLabel}
                </span>
              )}
              {row.verified ? (
                <VerifiedGlyph title={row.verifiedGlyphTitle} />
              ) : (
                <span class="text-muted text-[11px]" title={bisCopy.unverifiedGlyphTitle}>
                  {bisCopy.unverified}
                </span>
              )}
              {row.notSimChecked && (
                <span
                  class="gear-row-flag-tag"
                  data-testid="bis-row-not-sim-checked"
                  title={bisCopy.notSimCheckedTitle}
                >
                  {bisCopy.notSimCheckedTag}
                </span>
              )}
              {row.effectUnmodelled && (
                <span
                  class="gear-row-flag-tag"
                  data-testid="bis-row-effect-unmodelled"
                  title={bisCopy.effectUnmodelledTitle}
                >
                  {bisCopy.effectUnmodelledTag}
                </span>
              )}
              {row.model?.clientUnconfirmed && (
                <span
                  class="gear-row-flag-tag"
                  data-testid="bis-row-client-unconfirmed"
                  title={bisCopy.clientUnconfirmedTitle}
                >
                  {bisCopy.clientUnconfirmedTag}
                </span>
              )}
              {row.lowValue && (
                <span class="gear-row-flag-tag" data-testid="bis-row-low-value" title={bisCopy.lowValueTitle}>
                  {bisCopy.lowValueTag}
                </span>
              )}
            </span>
            {row.keyStatsLine && <span class="gear-row-stats text-muted">{row.keyStatsLine}</span>}
            <span class="gear-row-source text-muted">
              <SourceKindIcon kind={row.sourceKind ?? 'unknown'} />
              {row.sourceKind === 'rep' && <FactionMark faction={faction} size={16} />}
              {row.sourceDetail}
              {row.itemLevel !== undefined && (
                <span class="gear-row-ilvl tabular">· {bisCopy.itemLevelShort(row.itemLevel)}</span>
              )}
            </span>
            {row.evidenceLine && (
              <span class="gear-row-evidence text-muted" data-testid="bis-row-evidence">
                <VerifiedGlyph size={11} decorative />
                {row.evidenceLine}
              </span>
            )}
          </span>
        </span>
      </div>

      <div class="gear-row-runners">
        {row.alternatives && row.alternatives.length > 0 && (
          <span class="gear-row-alts">
            <span class="gear-row-alts-label label text-muted">{bisCopy.alternativesLabel}</span>
            <span class="gear-row-alts-list">
              {row.alternatives.map((alt) => (
                <span
                  class="gear-row-alt"
                  data-testid={`item-hover-${alt.itemId}`}
                  data-bis-item={alt.itemId}
                  tabindex="0"
                  role="button"
                  aria-haspopup="true"
                  title={`${alt.itemName} · ${gapLabelFor(alt.dpsDelta, alt.unit ?? 'dps')}`}
                >
                  {hasRealIcon(alt.model?.icon) ? (
                    <img
                      src={dataUrl(build, `icons/${alt.model!.icon}.webp`)}
                      alt=""
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                      class="gear-row-alt-icon rounded-control border object-cover"
                      style={`border-color:${rarityBorderColorFor(alt.model?.quality ?? 1)}`}
                    />
                  ) : (
                    <span
                      class="gear-row-alt-icon gear-row-icon-placeholder rounded-control border"
                      style={`border-color:${rarityBorderColorFor(alt.model?.quality ?? 1)}`}
                      aria-hidden="true"
                    />
                  )}
                  <span class="gear-row-alt-name-line">
                    <span class:list={['gear-row-alt-name', rarityClassFor(alt.model?.quality ?? 1)]}>
                      {alt.itemName}
                    </span>
                    {alt.effectUnmodelled && (
                      <span
                        class="gear-row-flag-tag gear-row-flag-tag-tiny"
                        data-testid="bis-alt-effect-unmodelled"
                        title={bisCopy.effectUnmodelledTitle}
                      >
                        {bisCopy.effectUnmodelledTag}
                      </span>
                    )}
                    {alt.model?.clientUnconfirmed && (
                      <span
                        class="gear-row-flag-tag gear-row-flag-tag-tiny"
                        data-testid="bis-alt-client-unconfirmed"
                        title={bisCopy.clientUnconfirmedTitle}
                      >
                        {bisCopy.clientUnconfirmedTag}
                      </span>
                    )}
                  </span>
                  <span class="gear-row-alt-source text-muted" title={alt.sourceDetail}>
                    <SourceKindIcon kind={alt.sourceKind} class="gear-row-alt-source-icon" />
                    {alt.sourceKind === 'rep' && <FactionMark faction={faction} size={16} />}
                    <span class="gear-row-alt-source-text">{alt.sourceDetail}</span>
                  </span>
                  <span class="gear-row-alt-gap text-muted">
                    {alt.verified && <VerifiedGlyph size={11} />}
                    {gapLabelFor(alt.dpsDelta, alt.unit ?? 'dps')}
                  </span>
                  {alt.metaLabel && <span class="gear-row-alt-level text-muted">{alt.metaLabel}</span>}
                </span>
              ))}
            </span>
          </span>
        )}
      </div>

      {you !== undefined && (
        <div class="gear-row-you tabular" data-testid="bis-row-you">
          {you.kind === 'equipped' ? (
            <span class="gear-row-you-equipped">
              <VerifiedGlyph size={12} decorative />
              {bisCopy.equippedTickLabel}
            </span>
          ) : (
            <span class="gear-row-you-delta">{bisCopy.youGainOverWorn(you.dpsDelta, you.wornItemName)}</span>
          )}
        </div>
      )}
    </Fragment>
  )}
</li>

<style is:global>
  /* `is:global` (deploy-gate LCP fix, 2026-09-30): this used to be a scoped `<style>`, which
     stamps a `data-astro-cid-*` attribute on every element this component renders -- at 10
     rows x up to ~6 alternatives each x 10 bands/factions on this page, that's the single
     largest source of the page's bloat. Every selector below is namespaced under either
     `.gear-row-*` or one of `.gear-row-new-pill`/`.gear-row-flag-tag*` (renamed from
     `.new-pill`/`.flag-tag*` in this same change so every selector here carries the
     component's own prefix), so going global widens nothing: confirmed no other component
     in src/ defines any of these class names (grepped before this change). */
  /* Design system's Pick row grid: 90px slot label, the pick, the runners-up, and (only
     once real worn-gear data exists) a 190px You column -- 90px/1fr/1fr today, spec §4.D's
     own explicit "never a 4th column rendered blank" rule for the blocked state. */
  .gear-row-list {
    display: grid;
    grid-template-columns: 90px 1fr 1fr;
    column-gap: 16px;
    align-items: start;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line-soft, #222);
  }
  .gear-row-list-4col {
    grid-template-columns: 90px 1fr 300px 190px;
  }
  .gear-row-new {
    background: color-mix(in srgb, var(--color-gold, #c9a35e) 6%, transparent);
  }
  .gear-row-slot-label {
    padding-top: 2px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-muted, #999);
  }
  .gear-row-empty {
    grid-column: 2 / -1;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.6rem;
  }
  .gear-row-icon-empty {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: transparent;
    border-color: var(--color-line-soft, #222);
    border-style: dashed;
  }
  .gear-row-pick {
    min-width: 0;
  }
  .gear-row-item {
    /* `position: relative` stays here (not on `.gear-row-name-line` below): the tooltip
       panel BisTooltipHost.svelte mounts into the hover host is still absolutely
       positioned against the nearest positioned ancestor, and this is it -- unchanged from
       before the hover-scope fix, so the panel still opens relative to the whole pick, not
       just the trigger's own small box. */
    position: relative;
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.6rem;
  }
  /* See the markup's own comment: a layout no-op, so the icon stays a direct flex item of
     `.gear-row-item` exactly as before this fix. */
  .gear-row-icon-trigger {
    display: contents;
  }
  /* 40px, 1px border in the item's own quality colour -- the in-game socket look (ruling
     6): a worn slot's icon is bordered in the colour of what fills it, the same way the
     client's own paperdoll frame does. */
  .gear-row-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    object-fit: cover;
    cursor: pointer;
  }
  .gear-row-icon-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-raised, #111);
    color: var(--color-muted, #999);
  }
  .gear-row-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 2px;
  }
  /* The pick's own hover/focus trigger (hover-scope fix, 2026-09-30 -- owner report: the
     tooltip used to open from anywhere in the cell, including the stats and source lines
     below). `data-bis-item`/`tabindex`/`role`/`aria-haspopup`/the `item-hover-<id>`
     testid moved here from the old `.gear-row-item` wrapper, which is now a plain layout
     box; `.gear-row-stats`/`.gear-row-source`/`.gear-row-evidence` stay its siblings
     inside `.gear-row-content`, outside this element, so hovering them never opens the
     tooltip. Nothing in the grid/flex layout itself changes -- this span already held
     exactly the name text and its same-line badges, so moving the attributes here moves
     no pixels.
     The 44px minimum hit height (design system) is added as `padding-top` cancelled by an
     equal negative `margin-top`: the padding grows this element's own hit/focus box
     upward (into the blank space above the name, beside the icon) without adding any
     height to the flex column's own flow, so `.gear-row-stats` right below still starts
     at its original position -- never downward, which would swallow the stats line into
     the trigger the owner's report is about. */
  .gear-row-name-line {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    padding-top: 28px;
    margin-top: -28px;
  }
  /* Suppresses the sitewide default ring (global.css's own `:focus-visible`, which would
     otherwise draw tightly around this element's own small box) in favour of the
     `::before` below, which is sized to visually cover the icon too. */
  .gear-row-name-line:focus-visible {
    outline: none;
  }
  .gear-row-name-line:focus-visible::before {
    content: '';
    position: absolute;
    top: 28px;
    left: calc(-1 * (40px + 0.6rem));
    width: calc(100% + 40px + 0.6rem);
    height: 40px;
    border-radius: var(--radius-control);
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
    pointer-events: none;
  }
  .gear-row-name {
    font-weight: 600;
    font-size: 13px;
  }
  .gear-row-stats {
    font-size: 12px;
  }
  .gear-row-source {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 12px;
  }
  .gear-row-ilvl {
    color: var(--color-muted, #999);
  }
  .gear-row-new-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-gold, #c9a35e);
    background: transparent;
    color: var(--color-gold, #c9a35e);
    padding: 0 0.4rem;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }
  /* Muted sibling of `.gear-row-new-pill` for a pick or alternative's own flags (`effect_unmodelled`,
     `low_value`, fourth wow-player sweep day 3): same shape, no gold -- these mark a
     limitation of the pick, not an achievement of it, so they never borrow the "new" pill's
     celebratory colour. */
  .gear-row-flag-tag {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--color-line-soft, #333);
    color: var(--color-muted, #999);
    padding: 0 0.4rem;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .gear-row-flag-tag-tiny {
    padding: 0 0.3rem;
    font-size: 9px;
  }
  /* The evidence line (spec item 1): one more muted line under the source line, prefixed by
     the same verified glyph the name line uses, this time decorative -- the line's own text
     already states the fact. */
  .gear-row-evidence {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 11px;
  }
  /* --- runners-up (spec §4.D): its own grid column beside the pick, not stacked under it.
     Each alternative is its own CSS grid (UX-designer review, carried over unchanged): icon |
     name (row 1) / source (row 2, ellipsis-truncated, full text in its own `title`) | delta
     (row 1, always at the right edge of the NAME's line) / item level (row 2, right edge of
     the SOURCE's line) -- a long source name can never strand the delta on a line of its
     own, at any width down to 360px, because the delta's grid cell never depends on how
     much text wrapped above it. --- */
  .gear-row-runners {
    min-width: 0;
  }
  .gear-row-alts {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .gear-row-alts-label {
    color: var(--color-muted, #999);
  }
  .gear-row-alts-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .gear-row-alt {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 0.45rem;
    row-gap: 1px;
    align-items: center;
    cursor: pointer;
  }
  .gear-row-alt-icon {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 24px;
    height: 24px;
    object-fit: cover;
  }
  .gear-row-alt-name-line {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.3rem;
  }
  .gear-row-alt-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 600;
  }
  .gear-row-alt-source {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.25rem;
    font-size: 12px;
  }
  .gear-row-alt-source-icon {
    flex-shrink: 0;
    /* Lines up with the wrapped text's own first line, not centred across both (this icon
       sits beside a source line that can now wrap to two lines -- see
       .gear-row-alt-source-text's own note). */
    margin-top: 2px;
  }
  /* Wraps at its own " · "/word boundaries rather than a single-line ellipsis (wow-player
     review round 3): a level requirement is real, load-bearing information ("Level 22"),
     never something an ellipsis is allowed to hide, unlike the item NAME above it
     (.gear-row-alt-name), which stays a deliberate single-line truncation with the full
     text in its own `title`. The "Level N"/"ilvl N" tokens this can still wrap AROUND stay
     unbreakable via `copy.ts`'s own non-breaking space between the word and its number
     (round 2's fix) -- this rule only removes the OUTER line's own single-line cap. */
  .gear-row-alt-source-text {
    min-width: 0;
  }
  .gear-row-alt-gap {
    grid-column: 3;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: 3px;
    white-space: nowrap;
    font-size: 11px;
  }
  .gear-row-alt-level {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
    white-space: nowrap;
    font-size: 10px;
  }
  .gear-row-you {
    text-align: right;
    font-size: 12px;
  }
  .gear-row-you-equipped {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-gold, #c9a35e);
  }
  .gear-row-you-delta {
    color: var(--color-kill, #7fd48a);
  }

  /* Phone: one stacked card per slot (spec §6) -- slot label -> pick -> runners-up -> You,
     the same left-to-right, top-to-bottom read order as desktop's columns. */
  @media (max-width: 1023px) {
    .gear-row-list,
    .gear-row-list-4col {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }
    .gear-row-empty {
      grid-column: 1;
    }
    .gear-row-you {
      text-align: left;
    }
  }
</style>
