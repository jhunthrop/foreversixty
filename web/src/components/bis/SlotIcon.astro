---
// web/src/components/bis/SlotIcon.astro
// The row's own gear-slot icon (tenet 1: "a plain table where an icon ... was available is
// a defect" applies to the slot column too, not only the item). The client's empty-slot
// socket textures would be the fuller answer (this lane's brief names `public/data/<build>/
// icons/`), but the pipeline ships none there yet -- so this is the brief's fallback, a
// small stroke SVG per slot, one glyph per the planner's 17 slots (`finger1`/`finger2` and
// `trinket1`/`trinket2` share a glyph, matching how GearPanel already treats the pair as one
// kind of thing). `currentColor` throughout, so it inherits the row's own (muted) text
// colour in both themes rather than carrying its own.
import type { Slot } from '../../lib/planner/types';

interface Props {
  slot: Slot;
  class?: string;
}

const { slot, class: className = '' } = Astro.props;

// One <path> (or small group) per glyph, 0 0 24 24, stroke-based so a single `stroke`
// currentColor covers every one of them.
const PATHS: Record<string, string> = {
  head: 'M6 11a6 6 0 0 1 12 0v3H6v-3ZM5 14h14v2a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-2Z',
  neck: 'M7 4c0 3 2 5 5 5s5-2 5-5 M12 9v3 M12 12a4 4 0 1 0 0.01 0Z',
  shoulder: 'M4 10a8 8 0 0 1 16 0v2h-5l-3-2-3 2H4v-2Z',
  back: 'M12 4 5 8v12l7-3 7 3V8l-7-4Z',
  chest: 'M8 4 4 7v13h16V7l-4-3-4 2-4-2Z',
  wrist: 'M5 10h14v4H5z M8 10v4M16 10v4',
  hands:
    'M7 21v-7a2 2 0 1 1 4 0v-3a1.5 1.5 0 1 1 3 0v2a1.5 1.5 0 1 1 3 0v2a1.5 1.5 0 1 1 3 0v3a4 4 0 0 1-4 4H7Z',
  waist: 'M4 11h16v2H4z M10 10h4v4h-4z',
  legs: 'M8 4h8l1 16h-4l-1-9-1 9H7L8 4Z',
  feet: 'M7 4h4v9l4 3v4H7a2 2 0 0 1-2-2v-9a5 5 0 0 1 2-5Z',
  finger: 'M12 21a6 6 0 1 0 0-12 6 6 0 0 0 0 12ZM10 9l1-6h2l1 6',
  trinket: 'M12 3 3 9l9 12 9-12-9-6Z',
  main_hand: 'M6 20 18 8M15 5l4 4-2 2-4-4 2-2ZM4 22l3-1 1-3-3 1-1 3Z',
  off_hand: 'M12 3 4 6v6c0 5 3.5 7.5 8 9 4.5-1.5 8-4 8-9V6l-8-3Z',
  ranged: 'M5 4a16 16 0 0 1 0 16M9 12h9m-3-3 3 3-3 3',
};

const glyph =
  PATHS[
    slot === 'finger1' || slot === 'finger2'
      ? 'finger'
      : slot === 'trinket1' || slot === 'trinket2'
        ? 'trinket'
        : slot
  ] ?? PATHS.trinket;
---

<svg
  class={`bis-slot-icon ${className}`}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={`<path d="${glyph}" />`}
/>

<style>
  .bis-slot-icon {
    flex-shrink: 0;
    opacity: 0.85;
  }
</style>
