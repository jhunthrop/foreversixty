---
// web/src/components/bis/SlotIcon.astro
// The row's own gear-slot icon (tenet 1: "a plain table where an icon ... was available is
// a defect" applies to the slot column too, not only the item). The client's empty-slot
// socket textures would be the fuller answer (this lane's brief names `public/data/<build>/
// icons/`), but the pipeline ships none there yet -- so this is the brief's fallback, a
// small stroke SVG per slot, one glyph per the planner's 17 slots (`finger1`/`finger2` and
// `trinket1`/`trinket2` share a glyph, matching how GearPanel already treats the pair as one
// kind of thing). `currentColor` throughout, so it inherits the row's own (muted) text
// colour in both themes rather than carrying its own.
import type { Slot } from '../../lib/planner/types';
import { slotGlyphKey } from '../../lib/bis/glyphs';

interface Props {
  slot: Slot;
  class?: string;
  /** Square size in px -- 18 by default (the row's own lead glyph and its icon-less
   *  placeholder fallback); the paperdoll redesign's 16px lead and 12px alternative-chip
   *  placeholder both pass their own size rather than scaling the default via CSS, which
   *  would fight the SVG's own `width`/`height` attributes. */
  size?: number;
}

const { slot, class: className = '', size = 18 } = Astro.props;

const glyphKey = slotGlyphKey(slot);
---

<svg
  class={`bis-slot-icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <use href={`#bis-slot-${glyphKey}`} />
</svg>

<style>
  .bis-slot-icon {
    flex-shrink: 0;
    opacity: 0.85;
  }
</style>
