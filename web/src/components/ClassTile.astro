---
import classes from '../data/classes.json';
interface Props {
  name: string;
  slug: string;
  /** 36px row tile for the Planner product panel's live element (spec 2026-09-23 §2 item
   *  3), instead of the 84px guide-index tile below. Same class-colour top stroke, smaller
   *  type, and it links to the planner rather than a class guide. */
  compact?: boolean;
}
const { name, slug, compact = false } = Astro.props;
const color = classes.find((c) => c.slug === slug)?.color ?? '#ffffff';
const href = compact ? `/planner?class=${slug}` : `/guides/${slug}`;
---

{compact ? (
  <a
    href={href}
    class="h-9 rounded-control bg-raised border border-line flex items-center justify-center text-[11px] font-bold tracking-[0.06em] uppercase"
    style={`box-shadow: inset 0 2px 0 ${color}; color: ${color};`}
  >
    {name}
  </a>
) : (
  <a
    href={href}
    class="h-[84px] rounded-control bg-raised border border-line flex items-end justify-center pb-3 text-[13px] font-bold tracking-[0.08em] uppercase"
    style={`box-shadow: inset 0 2px 0 ${color}; color: ${color};`}
  >
    {name}
  </a>
)}
