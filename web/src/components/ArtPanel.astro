---
// web/src/components/ArtPanel.astro
// The class page header's background panel (bis rebuild spec §4.A/§7): class-specific tree
// art behind a night-to-`--bg` gradient in the design system's own words. Asset sourcing is
// out of scope for this spec (§8) -- this ships a flat `--bg-raised` panel background until
// the art lane delivers the per-class tree art, never a placeholder texture invented here.
// New (design/DESIGN-SYSTEM.md's "Class page header": `ArtPanel` + `ClassHeader`, neither
// exists in web/src/components/ today -- confirmed by search).
// Callers pass classSlug for the per-class tree art; it is read once the art lane delivers
// it, so it is declared here as an accepted prop without being destructured (an unused
// binding fails lint).
export interface Props {
  classSlug: string;
}
---

<div class="art-panel full-bleed">
  <div class="page-column">
    <slot />
  </div>
</div>

<style>
  .art-panel {
    /* No band (site alignment D1): the head sits on the page ground, like every other page. */
    background: transparent;
  }
</style>
