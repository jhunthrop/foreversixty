---
// web/src/components/Header.astro
import communityLinks from '../data/links.json';
import { TRAILING_NAV_ITEMS, PRIMARY_NAV_ITEMS, isNavItemCurrent } from '../lib/nav';
import Seal from './Seal.astro';

interface Props {
  /** The current page's path, e.g. `/sim/gear` -- Base.astro's own `path` prop, passed
   * through so aria-current can mark the active tool. Defaults to `''` for callers that
   * render this component with no routing context at all (e.g. planner-island.test.ts,
   * which only cares that the Tailwind build still covers its classes) -- no real href is
   * ever the empty string, so isNavItemCurrent simply evaluates to "nothing is current"
   * instead of throwing on a missing prop. */
  path?: string;
}

const { path = '' } = Astro.props;

// "Logs" is the one label here short enough (37px) to miss the 44px hit-target floor on
// its width alone -- the others all clear it on text length. "Get set up" clears it on text
// length too. A little horizontal padding, only where needed, closes the gap without
// widening every other nav entry to match.
const NARROW_LABELS = new Set(['Logs']);

// "Leveling BiS" (98.75px of text, tracking included) is wider than its own 80px phone-grid
// column and, forced onto one line, spilled ~10px past its cell into "Get set up" next
// door -- the two labels visually ran together as "LEVELING BISGET SET UP" with no gap
// between them at 390px. Wrapping this one label onto two lines keeps it inside its column
// (13px font, leading-tight: ~33px tall, well under the 44px cell) instead of bleeding into
// the neighbor; every other label stays single-line since none of them are wide enough to
// need it.
const WRAPPING_LABELS = new Set(['Leveling BiS']);

function itemClass(label: string, current: boolean): (string | false)[] {
  return [
    'inline-flex items-center justify-center md:justify-start min-h-11 md:min-h-0 text-nav hover:text-strong',
    WRAPPING_LABELS.has(label) ? 'whitespace-normal text-center leading-tight' : 'whitespace-nowrap',
    NARROW_LABELS.has(label) && 'px-2',
    current && 'text-gold hover:text-gold',
  ];
}

const NAV_ITEMS = [...PRIMARY_NAV_ITEMS, ...TRAILING_NAV_ITEMS];

// Not an HTML comment: that would ship in every page and in the API's chrome snapshot.
// Phone: an explicit three-row grid -- wordmark and Discord on the first row, the seven nav
// items (2026-09-28: "Leveling BiS" joined the six) wrapped four-then-three on the second.
// A fixed two-row height is the CLS reservation now (design/DESIGN-SYSTEM.md's "nothing
// moves"), in place of the old horizontally-scrolling row's scroll-fade trick -- four
// columns wraps seven items into two full rows (4 + 3) with no ragged last row, same as six
// items did at three columns. No hamburger, so no client JS on a content page.
---

<header class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 px-[18px] md:flex md:justify-between md:px-12 py-3 md:py-[18px] border-b border-line/60">
  <a href="/" class="col-start-1 row-start-1 inline-flex items-center gap-2 min-h-11">
    <Seal size={34} gradientId="header-seal" />
    <span class="font-display text-[20px] font-bold tracking-[0.10em] uppercase text-strong whitespace-nowrap"
      >Forever Sixty</span
    >
  </a>
  <nav
    aria-label="Primary"
    data-testid="primary-nav"
    class="col-span-2 row-start-2 md:row-auto grid grid-cols-4 gap-x-3 gap-y-2 md:flex md:flex-nowrap md:gap-x-[22px] text-[13px] font-semibold tracking-[0.12em] uppercase"
  >
    {NAV_ITEMS.map((item) => {
      const current = isNavItemCurrent(item, path);
      return (
        <a
          href={item.href}
          aria-current={current ? 'page' : undefined}
          class:list={itemClass(item.label, current)}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
  <div class="col-start-2 row-start-1 flex items-center justify-self-end gap-3">
    <slot name="session" />
    <a
      href={communityLinks.discordInvite}
      class="inline-flex items-center gap-2 h-11 md:h-[38px] px-3 border border-line-warm rounded-control text-text bg-bg/50 font-semibold text-[13px]"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M8 12a4 4 0 0 0 8 0M5 8a7 7 0 0 1 14 0v7l2 3H3l2-3z" />
      </svg>
      <!-- sr-only below md: the header logo column (1fr) and this column (auto) share one
           phone-width row, and the "Discord" text's own width was the reason "Forever Sixty"
           lost the room to stay on one line at 390px (ux-designer review round 1). The icon
           alone still identifies the button (an aria-label would fight the visible text on
           desktop, so the label stays the real text, just visually hidden on phone instead of
           swapped for a shorter one). -->
      <span class="sr-only md:not-sr-only">Discord</span>
    </a>
  </div>
</header>
