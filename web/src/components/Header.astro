---
// web/src/components/Header.astro
import communityLinks from '../data/links.json';

const nav = [
  ['Guides', '/guides'],
  ['Zones', '/zones'],
  ['Dungeons', '/dungeons'],
  ['Changelog', '/changelog'],
] as const;
---

<!-- Phone: wordmark and Discord on the first line, the nav wrapping onto its own full-width
     line below. No hamburger, so no client JS on a content page. -->
<header class="relative flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-[18px] md:px-12 py-3 md:py-[18px] border-b border-line/60">
  <a href="/" class="font-display text-[20px] font-bold tracking-[0.08em] uppercase gold-text">
    Forever Sixty
  </a>
  <nav
    aria-label="Primary"
    class="order-last w-full md:order-none md:w-auto flex flex-wrap gap-x-5 md:gap-x-[26px] text-[13px] font-semibold tracking-[0.12em] uppercase"
  >
    {nav.map(([label, href]) => (
      <a href={href} class="inline-flex items-center min-h-11 md:min-h-0 text-nav hover:text-strong">
        {label}
      </a>
    ))}
  </nav>
  <a
    href={communityLinks.discordInvite}
    class="inline-flex items-center gap-2 h-11 md:h-[38px] px-3 border border-line-warm rounded-control text-text bg-bg/50 font-semibold text-[13px]"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M8 12a4 4 0 0 0 8 0M5 8a7 7 0 0 1 14 0v7l2 3H3l2-3z" />
    </svg>
    <span>Discord</span>
  </a>
</header>
