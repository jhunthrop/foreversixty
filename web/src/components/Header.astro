---
// web/src/components/Header.astro
import communityLinks from '../data/links.json';
import { TRAILING_NAV_ITEMS, PRIMARY_NAV_ITEMS, isNavItemCurrent } from '../lib/nav';
import { OPEN_SELECTOR_EVENT } from '../lib/character-selector/config';
import DiscordMark from './DiscordMark.astro';
import HeaderSearch from './HeaderSearch.astro';
import Seal from './Seal.astro';

interface Props {
  /** The current page's path, e.g. `/sim/gear` -- Base.astro's own `path` prop, passed
   * through so aria-current can mark the active tool. Defaults to `''` for callers that
   * render this component with no routing context at all (e.g. planner-island.test.ts,
   * which only cares that the Tailwind build still covers its classes) -- no real href is
   * ever the empty string, so isNavItemCurrent simply evaluates to "nothing is current"
   * instead of throwing on a missing prop. */
  path?: string;
}

const { path = '' } = Astro.props;

const NAV_ITEMS = [...PRIMARY_NAV_ITEMS, ...TRAILING_NAV_ITEMS];

// Not an HTML comment: that would ship in every page and in the API's chrome snapshot.
// Styling lives in styles/nav.css (spec 2026-10-09-nav-character-selector.md), not in
// utility classes, so the bar's breakpoints are in one readable place. Desktop (1024 and up):
// wordmark, the eight doors, the character selector, Discord. Below 1024: one 56px bar --
// wordmark, the selector's crest, a Menu button -- with the character row, the eight doors
// in a grid and Discord opening beneath it. The compact character lookup (HeaderSearch.astro,
// Task L8.2 fix round 2 item 7) is a magnifier button in the bar from 1024 and the Menu's
// first row below it; the processed script at the end wires it and the "/" key (`.site-menu`; the selector island renders the
// character row, which nav.css places first in the Menu). The only script is the few lines
// below the markup that toggle the menu through `data-menu-open`.
---

<header class="site-header" data-site-header>
  <a href="/" class="site-wordmark">
    <Seal size={30} gradientId="header-seal" />
    <span>Forever Sixty</span>
  </a>
  <div class="site-right">
    <HeaderSearch place="bar" />
    <slot name="session" />
    <a
      href={communityLinks.discordInvite}
      class="site-discord"
      aria-label="Discord"
      data-testid="discord-link"
    >
      <DiscordMark />
      <span class="site-discord-label">Discord</span>
      <span class="site-tip" role="tooltip">
        Discord
      </span>
    </a>
  </div>
  <button
    type="button"
    class="site-menu-button"
    aria-expanded="false"
    aria-controls="site-menu"
    aria-label="Menu"
    data-testid="menu-button"
    data-menu-button
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>
  <div id="site-menu" class="site-menu" data-menu-panel>
    <HeaderSearch place="menu" />
    <nav id="primary-nav" aria-label="Primary" data-testid="primary-nav" class="site-doors">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} aria-current={isNavItemCurrent(item, path) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <a href={communityLinks.discordInvite} class="site-menu-discord">
      <DiscordMark />
      Discord
    </a>
  </div>
  <script is:inline define:vars={{ openEvent: OPEN_SELECTOR_EVENT }}>
    // The phone menu: the bar stays one 56px row and the character row, doors and Discord
    // open beneath it (CSS keys off data-menu-open). Plain DOM, no island. Opening the
    // character sheet from the Menu's first row closes the Menu behind it.
    (() => {
      const header = document.querySelector('[data-site-header]');
      const button = header && header.querySelector('[data-menu-button]');
      if (!header || !button) return;
      const setOpen = (open) => {
        if (open) header.setAttribute('data-menu-open', '');
        else header.removeAttribute('data-menu-open');
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(!header.hasAttribute('data-menu-open')));
      window.addEventListener(openEvent, () => setOpen(false));
      header.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !header.hasAttribute('data-menu-open')) return;
        setOpen(false);
        button.focus();
      });
    })();
  </script>
  <script>
    import { isTypingTarget, wireSearchForm } from '../lib/character-search-dom';

    // The compact lookup and the "/" key (HeaderSearch.astro). "/" outside a text field
    // focuses the home page's own box where there is one; otherwise it opens the bar's panel
    // (from 1024px) or the Menu (below), cursor in the box.
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    for (const form of header?.querySelectorAll<HTMLFormElement>('form[data-character-search]') ?? []) {
      wireSearchForm(form);
    }
    const toggle = header?.querySelector<HTMLButtonElement>('[data-header-search-toggle]') ?? null;
    const panel = header?.querySelector<HTMLElement>('[data-header-search-panel]') ?? null;
    const setPanel = (open: boolean): void => {
      if (toggle === null || panel === null) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) panel.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    };
    toggle?.addEventListener('click', () => setPanel(panel !== null && panel.hidden === true));
    document.addEventListener('click', (event) => {
      if (panel === null || panel.hidden) return;
      const target = event.target;
      if (target instanceof Node && (panel.contains(target) || toggle?.contains(target))) return;
      setPanel(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel !== null && !panel.hidden) {
        setPanel(false);
        toggle?.focus();
        return;
      }
      if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
      if (isTypingTarget(event.target)) return;
      const primary = document.querySelector<HTMLInputElement>(
        'form[data-character-search-primary] input[name="name"]',
      );
      event.preventDefault();
      if (primary !== null && primary.offsetParent !== null) {
        primary.focus();
        return;
      }
      if (window.matchMedia('(min-width: 1024px)').matches) {
        setPanel(true);
        return;
      }
      const menuButton = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
      if (menuButton !== null && menuButton !== undefined && !header?.hasAttribute('data-menu-open'))
        menuButton.click();
      header?.querySelector<HTMLInputElement>('[data-header-search-menu] input[name="name"]')?.focus();
    });
  </script>
</header>
