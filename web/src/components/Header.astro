---
// web/src/components/Header.astro
import classes from '../data/classes.json';
import { readSpecCatalog } from '../lib/bis/load';
import {
  GUILD_GROUP_INDEX,
  GUILD_OVERVIEW_TAB,
  NAV_GROUPS,
  PREMIUM_NAV_ITEM,
  SETUP_NAV_ITEM,
  isNavGroupCurrent,
  isNavItemCurrent,
  navKey,
} from '../lib/nav';
import { guideClasses } from '../lib/nav-guides';
import { OPEN_SELECTOR_EVENT } from '../lib/character-selector/config';
import { PREMIUM_SOURCE_KEY, STORED_SOURCES } from '../lib/account/premium-hint';
import HeaderPanel from './HeaderPanel.astro';
import HeaderSearch from './HeaderSearch.astro';
import Seal from './Seal.astro';

interface Props {
  /** The current page's path, e.g. `/sim/gear` -- Base.astro's own `path` prop, passed
   * through so aria-current can mark the active tool. Defaults to `''` for callers that
   * render this component with no routing context at all (e.g. planner-island.test.ts,
   * which only cares that the Tailwind build still covers its classes) -- no real href is
   * ever the empty string, so isNavGroupCurrent simply evaluates to "nothing is current"
   * instead of throwing on a missing prop. */
  path?: string;
}

const { path = '' } = Astro.props;

// Build time only, as pages/guides/index.astro reads it: the Guides panel's spec names.
const guideEntries = guideClasses(classes, readSpecCatalog());

// Not an HTML comment: that would ship in every page and in the API's chrome snapshot.
// Styling lives in styles/nav.css (spec 2026-10-09-nav-character-selector.md), not in
// utility classes, so the bar's breakpoints are in one readable place. Desktop (1024 and up):
// wordmark, the four doors (each with a hover panel, spec 2026-10-15-grouped-header.md), the
// Get set up as a plain fifth door, the account control (the character selector). Below 1024: one 56px
// bar -- wordmark, the selector's crest, a Menu button -- with the character row, the four
// groups as headed sections and Get set up opening beneath it. The compact character lookup (HeaderSearch.astro,
// Task L8.2 fix round 2 item 7) is a magnifier button in the bar from 1024 and the Menu's
// first row below it; the processed script at the end wires it and the "/" key (`.site-menu`; the selector island renders the
// character row, which nav.css places first in the Menu). The only script is the few lines
// below the markup that toggle the menu through `data-menu-open`.
---

<header class="site-header" data-site-header>
  <script is:inline define:vars={{ key: PREMIUM_SOURCE_KEY, sources: STORED_SOURCES }}>
    // Who pays for Premium, before the doors are parsed (spec 2026-10-29-premium-entry section 4).
    // It lives in the header, not the site's head, so the API's /b/{id} page (which wears this
    // header and none of Base.astro's head) hides the tag too. The stored hint
    // (lib/account/premium-hint.ts) becomes data-premium, which /premium's cards key off, and
    // data-premium-nav="hide" takes the Premium tag out when the hint, or the cached /v1/me's
    // server sims (data-server-sims, from Base.astro's head script on the site), says Premium.
    // After paint the tag is only ever held (lib/premium-nav.ts), never removed.
    const root = document.documentElement;
    try {
      const source = localStorage.getItem(key);
      if (sources.includes(source)) root.dataset.premium = source;
    } catch {
      // Storage blocked: the cards keep their default state and the tag shows.
    }
    if (root.dataset.premium || root.dataset.serverSims) root.dataset.premiumNav = 'hide';
  </script>
  <a href="/" class="site-wordmark">
    <Seal size={30} gradientId="header-seal" />
    <span>Forever Sixty</span>
  </a>
  <div class="site-right">
    <HeaderSearch place="bar" />
    <slot name="session" />
  </div>
  <button
    type="button"
    class="site-menu-button"
    aria-expanded="false"
    aria-controls="site-menu"
    aria-label="Menu"
    data-testid="menu-button"
    data-menu-button
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>
  <div id="site-menu" class="site-menu" data-menu-panel>
    <HeaderSearch place="menu" />
    <nav id="primary-nav" aria-label="Primary" data-testid="primary-nav" class="site-doors">
      {NAV_GROUPS.map((group, index) => {
        const key = navKey(group.label);
        const panel = { group, guideClasses: guideEntries, isGuild: index === GUILD_GROUP_INDEX };
        return (
          <div class="site-group" data-group={key}>
            <h2 class="site-menu-heading">{group.label}</h2>
            <a
              href={group.href}
              class="site-door"
              data-door={key}
              aria-current={isNavGroupCurrent(group, path) ? 'page' : undefined}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={`site-panel-${key}`}
              data-guild-tab={index === GUILD_GROUP_INDEX ? GUILD_OVERVIEW_TAB : undefined}
            >
              {group.label}
            </a>
            <button
              type="button"
              class="site-door-toggle"
              aria-label={`Open the ${group.label} list`}
              aria-expanded="false"
              aria-controls={`site-panel-${key}`}
              data-door-toggle={key}
            >
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <HeaderPanel {...panel} place="bar" />
            <HeaderPanel {...panel} place="menu" />
          </div>
        );
      })}
      <a
        href={SETUP_NAV_ITEM.href}
        class="site-door site-door-setup"
        data-door="setup"
        aria-current={isNavItemCurrent(SETUP_NAV_ITEM, path) ? 'page' : undefined}
      >
        {SETUP_NAV_ITEM.label}
      </a>
      <a
        href={PREMIUM_NAV_ITEM.href}
        class="site-door site-door-premium"
        data-door="premium"
        data-testid="nav-premium"
        aria-current={isNavItemCurrent(PREMIUM_NAV_ITEM, path) ? 'page' : undefined}
      >
        <span class="pill pill-site">{PREMIUM_NAV_ITEM.label}</span>
      </a>
    </nav>
  </div>
  <script is:inline define:vars={{ openEvent: OPEN_SELECTOR_EVENT }}>
    // The phone menu: the bar stays one 56px row and the character row and doors
    // open beneath it (CSS keys off data-menu-open). Plain DOM, no island. Opening the
    // character sheet from the Menu's first row closes the Menu behind it.
    (() => {
      const header = document.querySelector('[data-site-header]');
      const button = header && header.querySelector('[data-menu-button]');
      if (!header || !button) return;
      const setOpen = (open) => {
        if (open) header.setAttribute('data-menu-open', '');
        else header.removeAttribute('data-menu-open');
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(!header.hasAttribute('data-menu-open')));
      window.addEventListener(openEvent, () => setOpen(false));
      header.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !header.hasAttribute('data-menu-open')) return;
        setOpen(false);
        button.focus();
      });
    })();
  </script>
  <script>
    import { afterPaint } from '../lib/after-paint';

    // The wiring (src/lib/header-wiring.ts) runs after first paint (src/lib/after-paint.ts):
    // the header is complete markup without it, and its module chain was about 150 ms of
    // simulated LCP on every page (W.16). The header gets `data-header-wired` when it is
    // done; specs that drive the panels or the "/" key wait for it.
    afterPaint(() => void import('../lib/header-wiring').then((m) => m.wireHeader()));
  </script>
</header>
