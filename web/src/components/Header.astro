---
// web/src/components/Header.astro
import communityLinks from '../data/links.json';
import { TRAILING_NAV_ITEMS, PRIMARY_NAV_ITEMS, isNavItemCurrent } from '../lib/nav';
import Seal from './Seal.astro';

interface Props {
  /** The current page's path, e.g. `/sim/gear` -- Base.astro's own `path` prop, passed
   * through so aria-current can mark the active tool. Defaults to `''` for callers that
   * render this component with no routing context at all (e.g. planner-island.test.ts,
   * which only cares that the Tailwind build still covers its classes) -- no real href is
   * ever the empty string, so isNavItemCurrent simply evaluates to "nothing is current"
   * instead of throwing on a missing prop. */
  path?: string;
}

const { path = '' } = Astro.props;

// "Logs" is the one label here short enough (37px) to miss the 44px hit-target floor on
// its width alone -- the others all clear it on text length. "Get set up" clears it on text
// length too. A little horizontal padding, only where needed, closes the gap without
// widening every other nav entry to match.
const NARROW_LABELS = new Set(['Logs']);

function itemClass(label: string, current: boolean): (string | false)[] {
  return [
    'inline-flex items-center justify-center md:justify-start min-h-11 md:min-h-0 text-nav hover:text-strong whitespace-nowrap',
    NARROW_LABELS.has(label) && 'px-2',
    current && 'text-gold hover:text-gold',
  ];
}

const NAV_ITEMS = [...PRIMARY_NAV_ITEMS, ...TRAILING_NAV_ITEMS];

// Not an HTML comment: that would ship in every page and in the API's chrome snapshot.
// Phone: an explicit grid -- wordmark and session/Discord on the first row, the eight nav
// items below it. Three columns, not four: at 390px a 4-column cell (~80px) was narrower
// than "Leveling BiS" itself (84.875px measured with whitespace-nowrap, ux-designer review
// round 2), so it wrapped onto two lines while its neighbours stayed on one -- the fix is
// room, not a per-label wrap exception. Three columns gives each cell 100px at 360px (the
// narrowest width this header is specced for) and 110px at 390px, clearing every label (the
// widest, "Leveling BiS" at 84.875px) with 15-25px to spare, so every item stays on one
// line; the cost is a ragged three-item last row instead of four's clean two full rows,
// which reads better than a wrapped label. A fixed three-row height is still the CLS
// reservation (design/DESIGN-SYSTEM.md's "nothing moves"), in place of the old
// horizontally-scrolling row's scroll-fade trick. No hamburger, so no client JS on a
// content page.
//
// The header's own outer grid-cols is `minmax(0,1fr)` for the logo column, not a bare
// `1fr`: a bare `1fr` track's automatic minimum is its content's min-content size, and once
// every nav label below went whitespace-nowrap, the eight-item row (which spans both outer
// columns) had a min-content wide enough to push that track past the viewport -- the header
// stayed at the viewport's width, but its content silently overflowed past the right edge
// (measured: nav items ran ~15px past the header's own box at 360px). `minmax(0, 1fr)`
// gives the track an explicit 0 floor, so it fills only what the session/Discord column
// (auto) leaves behind, and the grid's own `minmax(0,1fr)` nav columns do the rest.
//
// That same `minmax(0,1fr)` floor is also why the session column is a phone-only stack
// (Sign in above the Discord icon, `flex-col`) rather than the desktop row: going nowrap
// forced the logo column down to its exact leftover (container width minus the session
// column's own width), and the session row's un-stacked width (~108px: "Sign in" plus the
// gap plus the icon button) left only ~200px for a 233px-wide seal-and-wordmark at 360px --
// the seal silently shrank to ~1px wide rather than overflow (a replaced SVG has no
// min-content floor of its own the way the nowrap text does). Stacking the two session
// controls instead of sitting them side by side shrinks that column to its wider single
// item (~54px), handing the logo column back ~54px -- comfortably more than the ~33px it
// was short -- at the cost of a taller (still fixed) first row on phone only.
---

<header class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 px-[18px] md:flex md:justify-between md:px-12 py-3 md:py-[18px] border-b border-line/60">
  <a href="/" class="col-start-1 row-start-1 inline-flex items-center gap-2 min-h-11">
    <Seal size={34} gradientId="header-seal" />
    <span class="font-display text-[20px] font-bold tracking-[0.10em] uppercase text-strong whitespace-nowrap">
      Forever Sixty
    </span>
  </a>
  <nav
    aria-label="Primary"
    data-testid="primary-nav"
    class="col-span-2 row-start-2 md:row-auto grid grid-cols-3 gap-x-3 gap-y-2 md:flex md:flex-wrap xl:flex-nowrap md:gap-x-[22px] text-[13px] font-semibold tracking-[0.12em] uppercase"
  >
    {NAV_ITEMS.map((item) => {
      const current = isNavItemCurrent(item, path);
      return (
        <a
          href={item.href}
          aria-current={current ? 'page' : undefined}
          class:list={itemClass(item.label, current)}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
  <div class="col-start-2 row-start-1 flex flex-col items-end gap-2 justify-self-end md:flex-row md:items-center md:gap-3">
    <slot name="session" />
    <a
      href={communityLinks.discordInvite}
      class="inline-flex items-center justify-center gap-2 h-11 min-w-11 md:h-[38px] md:min-w-0 px-3 border border-line-warm rounded-control text-text bg-bg/50 font-semibold text-[13px]"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M8 12a4 4 0 0 0 8 0M5 8a7 7 0 0 1 14 0v7l2 3H3l2-3z" />
      </svg>
      <!-- sr-only below md: the header logo column (1fr) and this column (auto) share one
           phone-width row, and the "Discord" text's own width was the reason "Forever Sixty"
           lost the room to stay on one line at 390px (ux-designer review round 1). The icon
           alone still identifies the button (an aria-label would fight the visible text on
           desktop, so the label stays the real text, just visually hidden on phone instead of
           swapped for a shorter one). -->
      <span class="sr-only md:not-sr-only">Discord</span>
    </a>
  </div>
</header>
