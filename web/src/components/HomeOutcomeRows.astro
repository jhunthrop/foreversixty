---
// web/src/components/HomeOutcomeRows.astro
// The landing's three outcome rows (P.1): "Plan your talents", "Sim your gear", "Upload tonight's
// raid", each with one short line. The links are the tools' own pages in the static page; the
// script at the foot points the first two at the visitor's current character when there is one.
import { outcomeRows, outcomeRowsHeading } from '../lib/home/outcome-rows';
---

<section class="flex flex-col gap-[14px]" data-testid="home-outcomes">
  <h2 class="display text-[18px] font-bold tracking-[0.10em] text-strong">{outcomeRowsHeading}</h2>
  <ul class="border-line bg-raised rounded-panel flex flex-col border">
    {outcomeRows.map((row) => (
      <li class="border-line-soft border-b last:border-b-0">
        <a
          href={row.href}
          class="hover:bg-card-top flex min-h-14 items-center justify-between gap-4 px-[18px] py-3 transition-colors duration-150"
          data-testid={`home-outcome-${row.key}`}
          data-outcome={row.key}
        >
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="font-display text-strong text-[15px] font-bold">{row.title}</span>
            <span class="text-muted text-[13px] leading-snug">{row.line}</span>
          </span>
          <span class="text-gold shrink-0 text-[18px]" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  import { readCurrent } from '../lib/current-character';
  import { outcomeHrefs, type OutcomeRowKey } from '../lib/home/outcome-rows';

  const current = readCurrent();
  if (current !== null) {
    const hrefs = outcomeHrefs(current);
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      '[data-testid="home-outcomes"] a[data-outcome]',
    )) {
      const href = hrefs[link.dataset.outcome as OutcomeRowKey];
      if (href !== undefined) link.setAttribute('href', href);
    }
  }
</script>
