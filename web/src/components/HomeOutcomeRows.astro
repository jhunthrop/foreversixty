---
// web/src/components/HomeOutcomeRows.astro
// The landing's three outcome rows (P.1): "Plan your talents", "Sim your gear", "Upload tonight's
// raid", each with one short line. The links are the tools' own pages in the static page; the
// script at the foot points the first two at the visitor's current character when there is one.
import { outcomeRows, outcomeRowsHeading } from '../lib/home/outcome-rows';
import type { GlyphName } from '../lib/ui/glyphs';
import Card from './ui/Card.astro';
import SettingsRow from './ui/SettingsRow.svelte';

/** Each row's tile: the tool it opens (site alignment spec 2026-10-29 §5.1). */
const ROW_GLYPHS: Record<string, GlyphName> = { planner: 'tree', sim: 'bolt', logs: 'upload' };
---

<Card glyph="star" title={outcomeRowsHeading} body="rows" testid="home-outcomes">
  {outcomeRows.map((row) => (
    <SettingsRow
      href={row.href}
      glyph={ROW_GLYPHS[row.key]}
      label={row.title}
      sub={row.line}
      testid={`home-outcome-${row.key}`}
    />
  ))}
</Card>

<script>
  import { afterPaint } from '../lib/after-paint';

  // The rows' links follow the stored character; they already work as rendered, so the
  // retarget runs after first paint (src/lib/after-paint.ts), at `load` for a visitor who has one.
  afterPaint(() => {
    void Promise.all([import('../lib/current-character'), import('../lib/home/outcome-rows')]).then(
      ([{ readCurrent }, { outcomeHrefs }]) => {
        const current = readCurrent();
        if (current === null) return;
        const hrefs = outcomeHrefs(current);
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          '[data-testid="home-outcomes"] a[data-testid^="home-outcome-"]',
        )) {
          const href = (hrefs as Record<string, string | undefined>)[
            (link.dataset.testid ?? '').replace('home-outcome-', '')
          ];
          if (href !== undefined) link.setAttribute('href', href);
        }
      },
    );
  });
</script>
