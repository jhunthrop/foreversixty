---
// web/src/components/EntryTable.astro
// The dungeon and zone indexes are the same table with different column headings, so they
// share one component: name, one piece of context (zone / continent), and a level range.
import { levelColorClass, levelRange } from '../lib/levels';

export interface EntryRow {
  href: string;
  title: string;
  meta: string;
  levelMin?: number;
  levelMax?: number;
}

interface Props { nameHeading: string; metaHeading: string; rows: EntryRow[] }
const { nameHeading, metaHeading, rows } = Astro.props;

// Phone: two columns, with the zone/continent dropping onto a second line under the name.
// The column headings only make sense over the three-column desktop grid, so they are hidden
// below md rather than relabelled.
const columns = 'grid-cols-[1fr_auto] md:grid-cols-[1fr_180px_110px]';
---
<div class="bg-raised border border-line rounded-panel">
  <div class={`hidden md:grid ${columns} gap-3 px-4 py-[10px] label text-muted border-b border-line`}>
    <span>{nameHeading}</span><span>{metaHeading}</span><span>Level</span>
  </div>
  {rows.map((row, i) => (
    <a href={row.href} class={`grid ${columns} gap-x-3 gap-y-1 px-4 py-[14px] text-[15px] md:items-center hover:bg-card-top ${i < rows.length - 1 ? 'border-b border-line-soft' : ''}`}>
      <span class="col-start-1 row-start-1 font-semibold text-strong">{row.title}</span>
      <span class="col-start-1 row-start-2 md:col-start-2 md:row-start-1 text-[13px] md:text-[15px] text-muted">{row.meta}</span>
      <span class={`col-start-2 row-start-1 md:col-start-3 md:row-start-1 text-right md:text-left font-mono tabular ${levelColorClass(row.levelMin)}`}>{levelRange(row.levelMin, row.levelMax)}</span>
    </a>
  ))}
</div>
