<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lane F4: the reminder ask (spec F4.4) asks for it in context, after a first In. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lane F16: the Forever Sixty raids calendar, asked for only after the switch is flipped. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".ForeverApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForeverSixty">

        <!-- Sentry starts only from CrashReporting.start, under its privacy policy. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lane F15: the long-press shortcuts and the Assistant's Open app feature (spec F15.1, F15.2). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!--
                App Links (spec 2026-11-08 F6): the site's pages open their screen in the app; the
                site's /.well-known/assetlinks.json names this app. A path the app has no screen for
                opens the site (MainActivity.openInBrowser).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="foreversixty.gg" />
                <data android:pathPrefix="/app/" />
                <data android:pathPrefix="/b/" />
                <data android:pathPrefix="/bis/" />
                <data android:pathPrefix="/guides/" />
                <data android:pathPrefix="/sim/" />
                <data android:pathPrefix="/reports/" />
                <data android:pathPrefix="/character/" />
                <data android:pathPattern="/guild/.*/raids/.*" />
                <data android:path="/tiers" />
            </intent-filter>
        </activity>

        <!-- Lane F14: the Next raid and Next upgrade widgets, their character setting, the tile. Off in
             the manifest; WidgetComponents turns them on while the `widgets` switch is on. -->
        <receiver android:name=".widgets.glance.NextRaidWidgetReceiver" android:enabled="false" android:exported="false" android:label="@string/widget_nextRaid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_raid" />
        </receiver>
        <receiver android:name=".widgets.glance.NextUpgradeWidgetReceiver" android:enabled="false" android:exported="false" android:label="@string/widget_nextUpgrade">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_upgrade" />
        </receiver>
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_characterSetting">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".widgets.tile.NextRaidTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_tile_raid"
            android:label="@string/live_tile_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- Lane F15: `Sign up In` from the launcher: no UI, out of Recents; it toasts and finishes. Not
             exported: the launcher starts shortcuts as this app, and no other app may sign the player up. -->
        <activity
            android:name=".system.platform.SignupShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- In, Late, Bench and Out (and Late's minutes) answered from the notification, in the background. -->
        <receiver android:name=".raids.push.RaidActionReceiver" android:exported="false" />
        <receiver android:name=".raids.push.OfficerActionReceiver" android:exported="false" />

        <!-- The flat seal and its turquoise for any notification FCM draws itself. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_seal" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Push (spec 2026-11-08 F1, F4): FCM tokens and data messages, drawn by PushNotifier. -->
        <service android:name=".push.ForeverMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
