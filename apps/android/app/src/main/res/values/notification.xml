<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The notification accent behind the small icon, for FCM's default notification (the manifest)
         and the app's own builders (PushNotifier): the flat seal's turquoise, fs_seal, generated from
         tokens.json into core/designsystem's colors_gen.xml. Names only; no value is written here. -->
    <color name="notification_accent">@color/fs_seal</color>
    <!-- A progress bar's track: the same turquoise at 30% (fs_seal_track). -->
    <color name="notification_accent_track">@color/fs_seal_track</color>
</resources>
