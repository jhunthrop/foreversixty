<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the house background, so launch shows no white flash. -->
    <style name="Theme.ForeverSixty" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/forever_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- FsColor.bg (Tokens.kt): the window shows before Compose can read the token. -->
    <color name="forever_bg">#FF07090D</color>
    <!-- FsColor.tealEdge (Tokens.kt): the selected answer, in the raid notification's RemoteViews. -->
    <color name="forever_teal_edge">#FF408076</color>
    <!-- One of raid night's four answers in its notification (layout notification_raid_live). -->
    <style name="LiveAnswer" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_live_answer</item>
    </style>
</resources>
