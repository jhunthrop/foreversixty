<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose, and so the launch splash: the house background (fs_bg, generated
         from tokens.json into core/designsystem's colors_gen.xml), so launch shows no white flash. -->
    <style name="Theme.ForeverSixty" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fs_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- One of raid night's four answers in its notification (layout notification_raid_live). -->
    <style name="LiveAnswer" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_live_answer</item>
    </style>
</resources>
