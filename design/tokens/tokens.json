  },
  "gradient": {
    "$description": "Opacity ramps a surface masks its art with: stops of black at an alpha, positions from the top (0) to the foot (1).",
    "$type": "gradient",
    "bandFade": {
      "$description": "The band's fade into the ground over size.bandFade: an eased ramp, since a straight one shows its start as a line (web ui/band.css mask-image, which tokens.test.mjs holds to these stops).",
      "$value": [
        { "color": "rgba(0, 0, 0, 1)", "position": 0 },
        { "color": "rgba(0, 0, 0, 0.82)", "position": 0.25 },
        { "color": "rgba(0, 0, 0, 0.5)", "position": 0.5 },
        { "color": "rgba(0, 0, 0, 0.18)", "position": 0.75 },
        { "color": "rgba(0, 0, 0, 0)", "position": 1 }
      ]
    }
  },
  "motion": {
    "$description": "Every animation is skipped under Reduce Motion / Remove animations.",
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" },
    "tooltipDelay": { "$value": "150ms" },
    "livePulse": { "$value": "1600ms" },
    "easeStandard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
