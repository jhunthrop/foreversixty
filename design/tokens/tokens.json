  "font": {
    "$type": "fontFamily",
    "body": {
      "$description": "Barlow 400, 600 and 700: body, labels, figures and every heading but the page title. 'Barlow Fallback' (Base.astro) is a size-adjusted Helvetica Neue/Arial matching Barlow's em-box, so the swap does not reflow text.",
      "$value": ["Barlow", "Barlow Fallback", "Helvetica Neue", "Arial", "sans-serif"],
      "$extensions": {
        "gg.foreversixty": {
          "css": "--font-body",
          "cssAliases": ["--font-heading"],
          "faces": {
            "400": "Barlow-Regular",
            "600": "Barlow-SemiBold",
            "700": "Barlow-Bold"
          }
        }
      }
    },
    "title": {
      "$description": "The page title's face (web layout spec 2026-11-05 section 3.3): Marcellus 400, once per page or screen, set only by PageHeader. Its two size-adjusted fallbacks (fonts.css) are Georgia, then Times New Roman, so the swap moves no line.",
      "$value": ["Marcellus", "Marcellus Fallback", "Marcellus Fallback Times", "Georgia", "serif"],
      "$extensions": {
        "gg.foreversixty": {
          "css": "--font-title",
          "faces": { "400": "Marcellus-Regular" }
        }
      }
    },
    "code": {
      "$description": "JetBrains Mono 500, literal codes only (export strings, build strings, slash commands). Not bundled in the apps, which use the system monospaced face.",
      "$value": ["JetBrains Mono", "SF Mono", "Menlo", "monospace"],
      "$extensions": {
        "gg.foreversixty": { "css": "--font-mono", "native": false }
      }
    }
