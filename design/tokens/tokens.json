        "color": "rgba(0, 0, 0, 0.6)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      },
      "$extensions": { "gg.foreversixty": { "css": "--shadow-overlay" } }
    },
    "rowBandRing": {
      "$value": {
        "color": "rgba(229, 185, 85, 0.22)",
