              "color": "rgba(255, 255, 255, 0.12)",
              "offsetX": "0px",
              "offsetY": "0px",
              "blur": "0px",
              "spread": "1px",
              "inset": true
            }
          }
        }
      }
    },
    "selectedBar": {
      "$description": "The selected mark on a row, cell or list item: a 3 px accent bar on its left edge, over the selected ground.",
