# dependencies
node_modules/
.pnpm-store/
data/.venv/

# build output
dist/
.astro/
api/bin/
coverage/
# sim.wasm, sim.js and forever-sim, built by `make artifacts` at the
# pinned engine sha. Only what `make publish-wasm` copies into
# web/public/_sim/<sha>/ is committed.
artifacts/

# environment
.env
.env.*
!.env.example

# editor / os
.DS_Store
.idea/
.vscode/

# seeded design canvas (regenerated from the .dc.html files)
design/forever-sixty-look-and-feel.html

# large raw game data (normalized JSON is committed; raw DB2 exports are not)
data/builds/*/raw/
data/.icon-cache/

# git worktrees for parallel plan execution
.worktrees/

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage

# fetched combat-log samples (never committed; the retail sample is AGPL-3.0)
logs/testdata/cache/

# go workspace checksum file (regenerated; the modules are local)
go.work.sum
