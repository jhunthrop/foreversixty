# dependencies
node_modules/
.pnpm-store/
data/.venv/

# build output
dist/
.astro/
api/bin/
coverage/
# sim.wasm, sim.js and forever-sim, built by `make artifacts` at the
# pinned engine sha. Nothing built is committed from here. `make
# publish-wasm` stages the browser pair under web/public/_sim/<sha>/ for
# a deploy; whether that directory is committed or produced by the
# deploy is the web lane's call, and nothing is committed there today.
artifacts/
# a manual `GOOS=js GOARCH=wasm go build ./cmd/wasm` from sim/, with no
# -o, names its output after the package directory rather than failing
# - a 20+ MB binary landing here, untracked, one `git add -A` away from
# being committed. `make artifacts` always passes -o and never produces
# this; the target stays ignored so the mistake is silent, not a commit.
sim/wasm
# a manual `go build ./cmd/leveling-bis` from sim/, with no -o, names
# its output after the package directory the same way the wasm build
# above does - a 25+ MB binary landing here, untracked, one `git add
# -A` away from being committed. Nothing in this repo's Makefile builds
# leveling-bis without -o.
sim/leveling-bis
# the coverage profile the sim workflow's floor check writes; the
# figure is CI's, not an artefact
sim/cover.out

# the active build's item database, copied here by `make simdb` so both
# artifacts can //go:embed it; data/builds/<build>/simdb.bin is the
# committed original
sim/internal/simdb/simdb.bin
# the active build's enchant table, copied here by `make simdb` for the
# same reason; data/builds/<build>/enchants.json is the committed
# original
sim/internal/simdb/enchants.json
# the active build's spell rank table, copied here by `make simdb` for
# the same reason; data/builds/<build>/spellranks.json is the committed
# original
sim/internal/spellranks/spellranks.json

# environment
.env
.env.*
!.env.example

# editor / os
.DS_Store
.idea/
.vscode/

# seeded design canvas (regenerated from the .dc.html files)
design/forever-sixty-look-and-feel.html

# large raw game data (normalized JSON is committed; raw DB2 exports are not)
# ...except the small, committed merged quest-level table (2026-09-28
# quest-levels lane): classic-db's ~4,245 quests plus wowhead's fill-in
# for the ids classic-db lacks, two integers and a source tag each, with
# a provenance header -- see data/pipeline/quest_levels.py's own doc for
# why this is committed rather than re-fetched on every `loot` run. The
# wowhead HTML page cache alongside it (raw/quests/<id>.html) stays
# ignored -- large, and reconstructable from quest-levels.json's own
# `source: "wowhead"` entries plus a rerun, unlike the two-source merge
# itself. A directory-matching pattern (a bare `raw/`) cannot be
# re-included file by file -- git never descends into an excluded
# directory node at all -- so this ignores raw/'s CONTENTS (`raw/*`)
# instead, which still excludes the directory's own listing but lets
# the two rules below reach inside it.
data/builds/*/raw/*
!data/builds/*/raw/quests/
data/builds/*/raw/quests/*
!data/builds/*/raw/quests/quest-levels.json
# night-item-sources lane, 2026-09-28: the same exception, for the
# wowhead item-source scrape's own committed merge table
# (pipeline.item_sources) -- raw/items/<id>.html stays ignored (large,
# reconstructable from item-sources.json plus a rerun).
!data/builds/*/raw/items/
data/builds/*/raw/items/*
!data/builds/*/raw/items/item-sources.json
# src-classicdb lane, 2026-09-29: the same exception, for the parsed
# cmangos/classic-db dump cache (pipeline.classic_sources) -- the 73MB
# dump itself is never committed, only this compact per-item-id parse.
!data/builds/*/raw/classicdb/
data/builds/*/raw/classicdb/*
!data/builds/*/raw/classicdb/sources.json
data/.icon-cache/

# git worktrees for parallel plan execution
.worktrees/

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage

# fetched combat-log samples (never committed; the retail sample is AGPL-3.0)
logs/testdata/cache/

# go workspace checksum file (regenerated; the modules are local)
go.work.sum

# the engine fork, cloned at the pin by CI (sim.yml's rotations job and
# data.yml's fetch job) and by anyone reproducing them locally
.engine/

# The BigWigs packager's own output. addon-release.yml never writes here --
# it packages a throwaway checkout under $RUNNER_TEMP, entirely outside this
# repository. This entry only guards a local run of release.sh pointed
# directly at this directory after temporarily `git init`-ing it (release.sh
# requires its `-t topdir` to itself be a VCS checkout root, so a plain
# `-t addon/ForeverSixty` against this monorepo checkout fails first --
# see addon/README.md's Releasing section for the throwaway-checkout shape
# that actually works).
addon/ForeverSixty/.release/

# sim/cmd/leveling-bis's own JSON and markdown output (lane bis-proto,
# docs/superpowers/specs/2026-09-28-leveling-bis-design.md). Data,
# regenerated by running the command; one sample is committed
# separately at sim/cmd/leveling-bis/testdata/hunter-marksmanship.sample.md.
sim/cmd/leveling-bis/out/
